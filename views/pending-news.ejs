            function updateTitleCounter(newsId) {
                const input = document.getElementById(`editTitle-${newsId}`);
                const count = document.getElementById(`editTitleCount-${newsId}`);
                if (!input || !count) return;
                
                let plainText = stripTags(input.value);
                let current = plainText.length;
                
                if (current > TITLE_MAX) {
                    // Trim to limit
                    input.value = trimToPlainLimit(input.value, TITLE_MAX);
                    plainText = stripTags(input.value);
                    current = plainText.length;
                }
                
                count.style.color = current >= TITLE_MAX ? '#dc3545' : '#777';
                count.style.fontWeight = current >= TITLE_MAX ? 'bold' : '';
                count.textContent = `${current}/${TITLE_MAX}`;
            }

            function updateContentCounter(newsId) {
                const input = document.getElementById(`editContent-${newsId}`);
                const count = document.getElementById(`editContentCount-${newsId}`);
                if (!input || !count) return;
                
                let plainText = stripTags(input.value);
                let current = plainText.length;
                
                if (current > CONTENT_MAX) {
                    // Trim to limit
                    input.value = trimToPlainLimit(input.value, CONTENT_MAX);
                    plainText = stripTags(input.value);
                    current = plainText.length;
                }
                
                count.style.color = current >= CONTENT_MAX ? '#dc3545' : '#777';
                count.style.fontWeight = current >= CONTENT_MAX ? 'bold' : '';
                count.textContent = `${current}/${CONTENT_MAX}`;
            }

            async function savePendingChanges(newsId, approveAfterSave = false) {
                const titleInput = document.getElementById(`editTitle-${newsId}`);
                const categoryInput = document.getElementById(`editCategory-${newsId}`);
                const locationInput = document.getElementById(`editLocation-${newsId}`);
                const contentInput = document.getElementById(`editContent-${newsId}`);

                if (!titleInput || !categoryInput || !locationInput || !contentInput) {
                    alert('Edit form is not ready. Please reopen preview.');
                    return;
                }

                const payload = {
                    title: titleInput.value.trim(),
                    category: categoryInput.value.trim(),
                    location: locationInput.value.trim(),
                    content: contentInput.value.trim(),
                    readFullLink: newsDataCache[newsId]?.readFullLink || '',
                    ePaperLink: newsDataCache[newsId]?.ePaperLink || ''
                };

                if (!payload.title || !payload.content || !payload.category) {
                    alert('Title, Content, Category are required.');
                    return;
                }

                if (stripTags(payload.title).length > TITLE_MAX) {
                    alert(`Title must be ${TITLE_MAX} characters or less (excluding color tags).`);
                    return;
                }

                if (stripTags(payload.content).length > CONTENT_MAX) {
                    alert(`Content must be ${CONTENT_MAX} characters or less (excluding color tags).`);
                    return;
                }

                try {
                    const response = await fetch(`/admin/api/news/${newsId}/update-pending`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        alert(`❌ ${data.error || 'Failed to save changes'}`);
                        return;
                    }

                    newsDataCache[newsId] = {
                        ...newsDataCache[newsId],
                        ...payload
                    };

                    if (approveAfterSave) {
                        approveNews(newsId, payload.title);
                        return;
                    }

                    alert('✅ Changes saved. You can approve now.');
                    openPreview(newsId);
                } catch (error) {
                    console.error('Save pending changes error:', error);
                    alert('❌ Failed to save changes');
                }
            }

            function closePreview() {
                document.getElementById('previewModal').classList.remove('active');
            }

            function updatePendingEmptyState() {
                const countBadge = document.getElementById('pendingCount');
                if (countBadge) {
                    const currentCount = parseInt(countBadge.textContent || '0', 10);
                    countBadge.textContent = Math.max(0, currentCount - 1);
                }
                const grid = document.getElementById('newsGrid');
                if (grid && grid.children.length === 0) {
                    const tableWrapper = document.querySelector('.table-wrapper');
                    if (tableWrapper) {
                        tableWrapper.innerHTML = `
                            <div class="empty-state pn-empty">
                                <div class="empty-state-icon pn-empty-icon"><i class="fas fa-circle-check"></i></div>
                                <h3>All caught up</h3>
                                <p>No pending submissions waiting for review.</p>
                            </div>
                        `;
                    }
                }
            }

            function approveNews(newsId, newsTitle, ignoreLanguageWarning = false) {
                if (!ignoreLanguageWarning) {
                    Swal.fire({
                        title: 'Confirm Approval',
                        text: `Do you want to publish "${newsTitle}"?`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Publish',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            executeApproval(newsId, newsTitle, false);
                        }
                    });
                } else {
                    executeApproval(newsId, newsTitle, true);
                }
            }

            function executeApproval(newsId, newsTitle, ignoreLanguageWarning) {
                fetch(`/admin/api/news/${newsId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ignoreLanguageWarning })
                })
                .then(async res => {
                    if (res.status === 409) {
                        const errorData = await res.json();
                        Swal.fire({
                            title: 'Language Mismatch',
                            html: errorData.message + '<br><br><b>Do you want to publish it anyway?</b>',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Publish Anyway',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                executeApproval(newsId, newsTitle, true);
                            }
                        });
                        return null; // Skip next then block
                    }
                    return res.json();
                })
                .then(data => {
                    if (!data) return; // Handled by language warning

                    if (data.success) {
                        Swal.fire({
                            title: 'News Approved!',
                            text: 'Do you want to send a Push Notification? (OneSignal)',
                            icon: 'success',
                            showCancelButton: true,
                            confirmButtonColor: '#28a745',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, Send Push',
                            cancelButtonText: 'No, Just Publish'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                sendPushNotificationForNews(newsId, newsTitle, data.news);
                            } else {
                                Swal.fire('Published!', 'News published without push notification.', 'success');
                            }
                            
                            const card = document.querySelector(`.news-card[data-id="${newsId}"]`);
                            if (card) card.remove();
                            closePreview();
                            updatePendingEmptyState();
                        });
                    } else {
                        Swal.fire('Error', data.error, 'error');
                    }
                })
                .catch(err => {
                    console.error('Error:', err);
                    Swal.fire('Error', 'Failed to approve news', 'error');
                });
            }

            // 🔔 Send OneSignal push notification for approved news
            function sendPushNotificationForNews(newsId, newsTitle, newsData) {
                const notificationData = {
                    title: `Latest News: ${newsTitle}`,
                    message: newsData?.content ? newsData.content.substring(0, 100) + '...' : newsTitle,
                    newsId: newsId,
                    imageUrl: newsData?.mediaUrl || newsData?.imageUrl || null,
                    launchUrl: `/news/${newsId}`,
                    priority: 'normal'
                };

                fetch('/admin/api/send-notification', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(notificationData)
                })
                .then(res => {
                    if (!res.ok) {
                        return res.json().then(err => { throw new Error(err.error || 'Failed to send'); });
                    }
                    return res.json();
                })
                .then(result => {
                    console.log('🔔 Push notification sent:', result);
                    alert('✅ Push Notification sent successfully!');
                })
                .catch(err => {
                    console.error('❌ Push notification error:', err);
                    alert('⚠️ ' + err.message);
                });
            }

            function rejectNews(newsId, newsTitle) {
                pendingRejectNewsId = newsId;
                document.getElementById('rejectNewsTitle').textContent = `Rejecting: "${newsTitle}"`;

                // Reset form
                document.getElementById('rejectReason').value = '';
                selectedReason = null;
                document.getElementById('selectedReasonDisplay').style.display = 'none';
                document.querySelectorAll('.rejection-reason-btn').forEach(btn => btn.classList.remove('active'));

                const modal = new bootstrap.Modal(document.getElementById('rejectModal'));
                modal.show();
            }

            let selectedReason = null;

            function selectReason(reason) {
                selectedReason = reason;

                // Update button styles
                document.querySelectorAll('.rejection-reason-btn').forEach(btn => btn.classList.remove('active'));
                event.target.closest('.rejection-reason-btn').classList.add('active');

                // Show selected reason display
                document.getElementById('selectedReasonDisplay').style.display = 'block';
                document.getElementById('selectedReasonText').textContent = reason;
            }

            function confirmReject() {
                if (!pendingRejectNewsId) return;

                const customFeedback = document.getElementById('rejectReason').value;
                const rejectReason = selectedReason;

                if (!rejectReason) {
                    alert('Please select a rejection reason.');
                    return;
                }
                
                if (!customFeedback || customFeedback.trim() === '') {
                    alert('Please provide feedback for the rejection.');
                    return;
                }

                fetch(`/admin/api/news/${pendingRejectNewsId}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        reason: rejectReason,
                        feedback: customFeedback
                    })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert('❌ News rejected and feedback sent to reporter');
                            // location.reload();
                            // Instead of reloading, remove card from DOM
                            const card = document.querySelector(`.news-card[data-id="${pendingRejectNewsId}"]`);
                            if (card) card.remove();
                            
                            // Hide bootstrap modal
                            const modalEl = document.getElementById('rejectModal');
                            if (modalEl) {
                                const bsModal = bootstrap.Modal.getInstance(modalEl);
                                if (bsModal) bsModal.hide();
                            }
                            
                            // Update badge count
                            const countBadge = document.getElementById('pendingCount');
                            if (countBadge) {
                                const currentCount = parseInt(countBadge.textContent || '0', 10);
                                countBadge.textContent = Math.max(0, currentCount - 1);
                            }
                            
                            // Show empty state if grid is empty
                            const grid = document.getElementById('newsGrid');
                            if (grid && grid.children.length === 0) {
                                const tableWrapper = document.querySelector('.table-wrapper');
                                if (tableWrapper) {
                                    tableWrapper.innerHTML = `
                                        <div class="empty-state pn-empty">
                                            <div class="empty-state-icon pn-empty-icon"><i class="fas fa-circle-check"></i></div>
                                            <h3>All caught up</h3>
                                            <p>No pending submissions waiting for review.</p>
                                        </div>
                                    `;
                                }
                            }
                        } else {
                            alert('Error: ' + data.error);
                        }
                    })
                    .catch(err => {
                        console.error('Error:', err);
                        alert('Failed to reject news');
                    });
            }

            // Close modal when clicking outside
            document.getElementById('previewModal').addEventListener('click', (e) => {
                if (e.target.id === 'previewModal') closePreview();
            });
            // Listen for global custom event to update grid dynamically
            document.addEventListener('new_pending_news_received', function (e) {
