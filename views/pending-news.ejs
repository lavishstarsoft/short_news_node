<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Pending News Review' }) %>
    <link rel="stylesheet" href="/css/editors-directory.css">
    <link rel="stylesheet" href="/css/news-directory.css">
    <link rel="stylesheet" href="/css/pending-news.css">

    <body>

        <%- include('partials/top-nav', { pageTitle: 'Pending News Review', backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'pending-news' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <% 
                                const pendingNews = typeof teamPendingNews !== 'undefined' ? teamPendingNews : [];
                                const pendingLangLabels = typeof newsLanguageLabels !== 'undefined' ? newsLanguageLabels : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' };
                                const pnTotal = pendingNews.length;
                                let pnWithMedia = 0;
                                const pnAuthors = new Set();
                                if (pendingNews && pendingNews.length) {
                                    pendingNews.forEach(function(n) {
                                        if (n.mediaUrl) pnWithMedia++;
                                        if (n.author) pnAuthors.add(n.author);
                                    });
                                }
                                const pnCategories = pendingNews && pendingNews.length ? [...new Set(pendingNews.map(n => n.category).filter(Boolean))].sort() : [];
                                const pnLocations = pendingNews && pendingNews.length ? [...new Set(pendingNews.map(n => n.location).filter(Boolean))].sort() : [];
                                const currentLang = typeof selectedLanguage !== 'undefined' ? selectedLanguage : '';
                            %>

                            <div class="pn-page content-area mt-4">
                                <div class="team-page-header">
                                    <div>
                                        <h1 class="team-page-title">Pending News Review</h1>
                                        <p class="team-page-subtitle">Review, edit, and approve reporter submissions before they go live.</p>
                                    </div>
                                </div>

                                <div class="team-stats">
                                    <div class="team-stat">
                                        <div class="team-stat-value"><%= pnTotal %></div>
                                        <div class="team-stat-label">Total pending</div>
                                    </div>
                                    <div class="team-stat">
                                        <div class="team-stat-value" id="pendingCount"><%= pnTotal %></div>
                                        <div class="team-stat-label">Matching filters</div>
                                    </div>
                                    <div class="team-stat">
                                        <div class="team-stat-value"><%= pnWithMedia %></div>
                                        <div class="team-stat-label">With media</div>
                                    </div>
                                    <div class="team-stat">
                                        <div class="team-stat-value"><%= pnAuthors.size %></div>
                                        <div class="team-stat-label">Reporters</div>
                                    </div>
                                </div>

                                <div class="news-filters-card pn-filters-card">
                                    <div class="news-filters-top">
                                        <div class="news-filters-heading">
                                            <span class="news-filters-icon"><i class="fas fa-sliders"></i></span>
                                            <div>
                                                <h2 class="news-filters-title">Filter submissions</h2>
                                                <p class="news-filters-subtitle">Search and narrow pending articles on this page</p>
                                            </div>
                                        </div>
                                        <button type="button" class="news-filters-reset" onclick="resetFilters()">
                                            <i class="fas fa-rotate-left"></i> Reset filters
                                        </button>
                                    </div>

                                    <div class="news-filters-search-row">
                                        <div class="news-search-field">
                                            <i class="fas fa-search"></i>
                                            <input type="text" id="searchInput" class="news-search-input" placeholder="Search by title or reporter..." oninput="filterNews()">
                                        </div>
                                    </div>

                                    <div class="news-filters-facets">
                                        <div class="news-facet">
                                            <label class="news-facet-label" for="categoryFilter"><i class="fas fa-folder"></i> Category</label>
                                            <div class="news-facet-select-wrap">
                                                <select id="categoryFilter" class="news-facet-select" onchange="filterNews()">
                                                    <option value="">All categories</option>
                                                    <% pnCategories.forEach(function(cat) { %>
                                                        <option value="<%= cat %>"><%= cat %></option>
                                                    <% }); %>
                                                </select>
                                                <i class="fas fa-chevron-down news-facet-chevron"></i>
                                            </div>
                                        </div>

                                        <div class="news-facet">
                                            <label class="news-facet-label" for="locationFilter"><i class="fas fa-map-marker-alt"></i> Location</label>
                                            <div class="news-facet-select-wrap">
                                                <select id="locationFilter" class="news-facet-select" onchange="filterNews()">
                                                    <option value="">All locations</option>
                                                    <% pnLocations.forEach(function(loc) { %>
                                                        <option value="<%= loc %>"><%= loc %></option>
                                                    <% }); %>
                                                </select>
                                                <i class="fas fa-chevron-down news-facet-chevron"></i>
                                            </div>
                                        </div>

                                        <div class="news-facet">
                                            <label class="news-facet-label" for="languageFilter"><i class="fas fa-language"></i> Language</label>
                                            <div class="news-facet-select-wrap<%= currentLang ? ' is-active' : '' %>">
                                                <select id="languageFilter" class="news-facet-select" onchange="applyLanguageFilter()">
                                                    <option value="">All languages</option>
                                                    <% Object.keys(pendingLangLabels).forEach(function(code) { %>
                                                        <option value="<%= code %>" <%= currentLang === code ? 'selected' : '' %>><%= pendingLangLabels[code] %></option>
                                                    <% }); %>
                                                </select>
                                                <i class="fas fa-chevron-down news-facet-chevron"></i>
                                            </div>
                                        </div>

                                        <div class="news-facet">
                                            <label class="news-facet-label" for="dateFilter"><i class="fas fa-calendar-alt"></i> Submitted</label>
                                            <div class="news-facet-select-wrap">
                                                <select id="dateFilter" class="news-facet-select" onchange="filterNews()">
                                                    <option value="">All time</option>
                                                    <option value="today">Today</option>
                                                    <option value="week">This week</option>
                                                    <option value="month">This month</option>
                                                </select>
                                                <i class="fas fa-chevron-down news-facet-chevron"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="pn-toolbar">
                                    <span class="pn-toolbar-label">Sort by</span>
                                    <div class="sort-options pn-sort-pills">
                                        <button type="button" onclick="sortNews('recent')" class="active" data-sort="recent"><i class="fas fa-arrow-down-wide-short"></i> Most recent</button>
                                        <button type="button" onclick="sortNews('oldest')" data-sort="oldest"><i class="fas fa-arrow-up-wide-short"></i> Oldest</button>
                                        <button type="button" onclick="sortNews('views')" data-sort="views"><i class="fas fa-chart-line"></i> Title length</button>
                                    </div>
                                </div>

                                <div class="pn-split" id="pnSplit">
                                <div class="team-panel pn-panel pn-split-list">
                                    <div class="table-wrapper" id="pendingTableWrapper">
                                        <% 
                                            const showFullDetails = admin.role === 'superadmin' || (admin.permissions && admin.permissions.canViewReporterDetails);
                                            const canApproveNews = admin.role === 'superadmin' || admin.role === 'admin' || (admin.role === 'subeditor' && admin.permissions && admin.permissions.canApproveNews);
                                        %>
                                        <% if (pendingNews.length > 0) { %>
                                            <div class="news-grid" id="newsGrid">
                                                <% pendingNews.forEach((news) => { %>
                                                    <%- include('partials/pending-news-card', {
                                                        news: news,
                                                        isAIQueue: false,
                                                        pendingLangLabels: pendingLangLabels,
                                                        showFullDetails: showFullDetails,
                                                        canApproveNews: canApproveNews,
                                                        isSuperAdmin: (admin.role === 'superadmin')
                                                    }) %>
                                                <% }); %>
                                            </div>
                                        <% } else { %>
                                            <div class="empty-state pn-empty">
                                                <div class="empty-state-icon pn-empty-icon"><i class="fas fa-circle-check"></i></div>
                                                <h3>All caught up</h3>
                                                <p>No pending submissions waiting for review.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <aside class="pn-preview-pane" id="pnPreviewPane" aria-label="Selected news preview">
                                    <div class="pn-preview-topbar">
                                        <button type="button" class="pn-preview-back" id="pnPreviewBack" aria-label="Back to list"><i class="fas fa-arrow-left"></i></button>
                                        <div class="pn-preview-counter" id="pnPreviewCounter">–</div>
                                        <div class="pn-preview-navbtns">
                                            <button type="button" class="pn-nav-btn" id="pnPrevBtn" title="Previous (K / ↑)"><i class="fas fa-chevron-up"></i></button>
                                            <button type="button" class="pn-nav-btn" id="pnNextBtn" title="Next (J / ↓)"><i class="fas fa-chevron-down"></i></button>
                                        </div>
                                    </div>
                                    <div class="pn-preview-scroll" id="pnPreviewBody">
                                        <div class="pn-preview-empty" id="pnPreviewEmpty">
                                            <i class="fas fa-hand-pointer"></i>
                                            <h4>Select a submission</h4>
                                            <p>Pick an item from the list to review it here.<br>Shortcuts: <kbd>J</kbd>/<kbd>K</kbd> navigate · <kbd>A</kbd> approve · <kbd>R</kbd> reject · <kbd>B</kbd> send back</p>
                                        </div>
                                    </div>
                                </aside>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

        <!-- Preview Modal -->
        <div class="modal-backdrop pn-modal-backdrop" id="previewModal">
            <div class="modal-content pn-preview-modal">
                <div class="modal-header pn-modal-header">
                    <h3 id="previewTitle"></h3>
                    <button type="button" class="modal-close pn-modal-close" onclick="closePreview()" aria-label="Close"><i class="fas fa-xmark"></i></button>
                </div>
                <div id="previewBody" class="pn-modal-body">
                    <!-- Content will be loaded here -->
                </div>
            </div>
        </div>

        <!-- Compare Articles Modal (AI Queue) -->
        <div class="modal-backdrop pn-modal-backdrop" id="compareArticlesModal" style="display: none; z-index: 1050;">
            <div class="modal-content pn-preview-modal" style="max-width: 1200px; width: 95%;">
                <div class="modal-header pn-modal-header" style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <h3 style="color: #0f172a; margin: 0;"><i class="fas fa-code-compare" style="color: #f59e0b;"></i> Compare Articles</h3>
                    <button type="button" class="modal-close pn-modal-close" onclick="closeCompareArticlesModal()" aria-label="Close"><i class="fas fa-xmark"></i></button>
                </div>
                <div id="compareArticlesBody" class="pn-modal-body" style="padding: 20px; background-color: #f1f5f9; max-height: 80vh; overflow-y: auto;">
                    <!-- Content will be injected here -->
                </div>
            </div>
        </div>

        <!-- Rejection Modal -->
        <div class="modal fade pn-reject-modal" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="rejectModalLabel">Reject news article</h5>
                            <p id="rejectNewsTitle" class="text-muted small mb-0 mt-1"></p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <span class="pn-reject-label">Select rejection reason</span>
                        <div class="pn-reason-grid">
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Factually Inaccurate')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-circle-xmark"></i></div>
                                <div style="font-weight:600;color:#333;">Factually inaccurate</div>
                                <div style="font-size:0.75rem;color:#999;">Contains false information</div>
                            </button>
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Inappropriate Content')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-ban"></i></div>
                                <div style="font-weight:600;color:#333;">Inappropriate content</div>
                                <div style="font-size:0.75rem;color:#999;">Violates guidelines</div>
                            </button>
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Poor Quality')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-triangle-exclamation"></i></div>
                                <div style="font-weight:600;color:#333;">Poor quality</div>
                                <div style="font-size:0.75rem;color:#999;">Needs improvement</div>
                            </button>
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Plagiarism')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-clone"></i></div>
                                <div style="font-weight:600;color:#333;">Plagiarism</div>
                                <div style="font-size:0.75rem;color:#999;">Copied from elsewhere</div>
                            </button>
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Missing Attribution')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-link-slash"></i></div>
                                <div style="font-weight:600;color:#333;">Missing attribution</div>
                                <div style="font-size:0.75rem;color:#999;">Source not cited</div>
                            </button>
                            <button type="button" class="rejection-reason-btn" onclick="selectReason('Incomplete Article')">
                                <div style="font-size:1rem;margin-bottom:0.35rem;"><i class="fas fa-file-circle-xmark"></i></div>
                                <div style="font-weight:600;color:#333;">Incomplete article</div>
                                <div style="font-size:0.75rem;color:#999;">Missing details</div>
                            </button>
                        </div>

                        <div id="selectedReasonDisplay" class="pn-selected-reason">
                            <div class="pn-selected-reason-label">Selected reason</div>
                            <div id="selectedReasonText" style="color:#111827;font-weight:600;font-size:0.9375rem;"></div>
                        </div>

                        <span class="pn-reject-label">Additional details (optional)</span>
                        <textarea id="rejectReason" class="form-control pn-reject-textarea" rows="4" placeholder="Add specific feedback for the reporter..."></textarea>
                        <small class="text-muted d-block mt-2">This message helps reporters improve future submissions.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" onclick="confirmReject()"><i class="fas fa-paper-plane"></i> Reject &amp; send feedback</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Send Back for Edit Modal -->
        <div class="modal fade pn-sendback-modal" id="sendBackModal" tabindex="-1" aria-labelledby="sendBackModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="sendBackModalLabel">Send back for edit</h5>
                            <p id="sendBackNewsTitle" class="text-muted small mb-0 mt-1"></p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="pn-sendback-help">Explain what the reporter must fix. Remarks are required and will be shown on their Needs Revision article.</p>
                        <span class="pn-reject-label">Revision remarks <span class="text-danger">*</span></span>
                        <textarea id="sendBackRemarks" class="form-control pn-reject-textarea" rows="5" maxlength="2000" placeholder="Example: Fix the headline spelling, update the location, and replace the unclear image."></textarea>
                        <div class="pn-sendback-meta">
                            <small id="sendBackCharCount">0 / 2000</small>
                            <small class="text-muted">Minimum 5 characters</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning" id="confirmSendBackBtn" onclick="confirmSendBack()"><i class="fas fa-rotate-left"></i> Send Back for Edit</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Compare Versions Modal -->
        <div class="modal-backdrop pn-modal-backdrop" id="compareVersionsModal" aria-hidden="true">
            <div class="modal-content pn-compare-modal" role="dialog" aria-labelledby="compareModalTitle">
                <div class="modal-header pn-modal-header">
                    <div>
                        <h3 id="compareModalTitle">Compare versions</h3>
                        <p id="compareModalSubtitle" class="pn-dup-modal-subtitle">Previous (at send-back) → Current → Highlighted changes</p>
                    </div>
                    <button type="button" class="modal-close pn-modal-close" onclick="closeCompareVersions()" aria-label="Close"><i class="fas fa-xmark"></i></button>
                </div>
                <div id="compareVersionsBody" class="pn-compare-modal-body">
                    <div class="pn-dup-loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>Loading comparison…</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Duplicate Review Modal -->
        <div class="modal-backdrop pn-modal-backdrop" id="duplicateModal" aria-hidden="true">
            <div class="modal-content pn-dup-modal" role="dialog" aria-labelledby="dupModalTitle">
                <div class="modal-header pn-modal-header pn-dup-modal-header">
                    <div>
                        <h3 id="dupModalTitle">Duplicate review</h3>
                        <p id="dupModalSubtitle" class="pn-dup-modal-subtitle">Left = this pending submission (not published). Right = matched news. Use the list to open every match.</p>
                    </div>
                    <button type="button" class="modal-close pn-modal-close" onclick="closeDuplicateModal()" aria-label="Close"><i class="fas fa-xmark"></i></button>
                </div>
                <div id="duplicateModalBody" class="pn-dup-modal-body">
                    <div class="pn-dup-loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>Loading matches…</span>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>

        <script>
            let pendingRejectNewsId = null;
            let pendingSendBackNewsId = null;
            let newsDataCache = {};
            let duplicateDataCache = {};
            let revisionDataCache = {};
            const TITLE_MAX_GLOBAL = <%= newsTitleMax %>;
            const CONTENT_MAX_GLOBAL = <%= newsContentMax %>;
            const DISPLAY_CONFIG_BY_LANGUAGE = <%- JSON.stringify(typeof displayConfigByLanguage !== 'undefined' ? displayConfigByLanguage : {}) %>;
            const CURRENT_USER_ROLE = '<%= adminRole %>';

            function getDisplayConfigForLanguage(code) {
                const normalized = String(code || 'te').trim().toLowerCase();
                const cfg = DISPLAY_CONFIG_BY_LANGUAGE[normalized];
                if (cfg) return cfg;
                return DISPLAY_CONFIG_BY_LANGUAGE.te || { titleMax: TITLE_MAX_GLOBAL, contentMax: CONTENT_MAX_GLOBAL, contentMin: 0 };
            }
            const categoryOptions = <%- JSON.stringify([...(pendingNews ? new Set(pendingNews.map(n => n.category).filter(Boolean)) : [])]) %>;
            const locationOptions = <%- JSON.stringify([...(pendingNews ? new Set(pendingNews.map(n => n.location).filter(Boolean)) : [])]) %>;

            function renderRichContent(text) {
                if (typeof window.renderRichText === 'function') {
                    return window.renderRichText(text || '');
                }
                return escapeHtml(stripTags(text || ''));
            }

            function renderRichExcerpt(text, maxPlain) {
                if (typeof window.renderRichText === 'function' && typeof window.stripRichTags === 'function' && typeof window.trimTagsToPlainLimit === 'function') {
                    const plain = window.stripRichTags(text || '');
                    if (plain.length <= maxPlain) {
                        return window.renderRichText(text || '');
                    }
                    return window.renderRichText(window.trimTagsToPlainLimit(text || '', maxPlain)) + '…';
                }
                const plain = stripTags(text || '');
                return escapeHtml(plain.length > maxPlain ? plain.substring(0, maxPlain) + '…' : plain);
            }

            function stripTags(text) {
                if (!text) return '';
                return text.replace(/\[c=#[0-9a-fA-F]{6}\]/gi, '').replace(/\[\/c\]/gi, '');
            }

            // Trim text to a specific plain-text length while keeping tags intact
            function trimToPlainLimit(text, max) {
                if (!text) return '';
                let plainLength = 0;
                let result = '';
                let i = 0;
                while (i < text.length && plainLength < max) {
                    // Check for opening or closing color tags
                    const tagMatch = text.substring(i).match(/^\[c=#[0-9a-fA-F]{6}\]|^\[\/c\]/i);
                    if (tagMatch) {
                        result += tagMatch[0];
                        i += tagMatch[0].length;
                    } else {
                        result += text[i];
                        plainLength++;
                        i++;
                    }
                }
                return result;
            }

            function escapeHtml(str = '') {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            const canViewReporterDetails = <%= admin.role === 'superadmin' || (admin.permissions && admin.permissions.canViewReporterDetails) ? 'true' : 'false' %>;
            const canApproveNewsJs = <%= admin.role === 'superadmin' || admin.role === 'admin' || (admin.role === 'subeditor' && admin.permissions && admin.permissions.canApproveNews) ? 'true' : 'false' %>;
            const newsLanguageLabels = <%- JSON.stringify(typeof newsLanguageLabels !== 'undefined' ? newsLanguageLabels : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' }) %>;

            function getLanguageLabel(code) {
                const normalized = (code || 'te').toLowerCase();
                return newsLanguageLabels[normalized] || 'Telugu';
            }

            function renderSelectOptions(options, selectedValue) {
                return options.map(opt => {
                    const selected = opt === selectedValue ? 'selected' : '';
                    return `<option value="${escapeHtml(opt)}" ${selected}>${escapeHtml(opt)}</option>`;
                }).join('');
            }

            // Store all news data for preview
            <% if (pendingNews && pendingNews.length > 0) { %>
                <% pendingNews.forEach(news => { %>
                    newsDataCache['<%= news._id %>'] = {
                        title: <%- JSON.stringify(news.title || '') %>,
                        author: <%- JSON.stringify(news.author || '') %>,
                        authorDetails: <%- JSON.stringify(news.authorDetails || null) %>,
                        category: <%- JSON.stringify(news.category || 'Uncategorized') %>,
                        location: <%- JSON.stringify(news.location || 'Not specified') %>,
                        language: <%- JSON.stringify(news.language || 'te') %>,
                        content: <%- JSON.stringify(news.content || '') %>,
                        mediaUrl: <%- JSON.stringify(news.mediaUrl || '') %>,
                        imageUrls: <%- JSON.stringify(news.imageUrls || []) %>,
                        mediaType: <%- JSON.stringify(news.mediaType || 'image') %>,
                        readFullLink: <%- JSON.stringify(news.readFullLink || '') %>,
                        ePaperLink: <%- JSON.stringify(news.ePaperLink || '') %>,
                        publishedAt: <%- JSON.stringify(new Date(news.publishedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true })) %>,
                        revisionStatus: <%- JSON.stringify(news.revisionStatus || null) %>,
                        actionHistory: <%- JSON.stringify(Array.isArray(news.actionHistory) ? news.actionHistory.filter(h => h && (h.action === 'needs_revision' || h.action === 'resubmitted')) : []) %>
                    };
                    <% if (news.duplicateCheck && news.duplicateCheck.similarArticles) { %>
                        duplicateDataCache['<%= news._id %>'] = {
                            isDuplicate: <%= news.duplicateCheck.isDuplicate %>,
                            isSuspicious: <%= news.duplicateCheck.isSuspicious %>,
                            score: <%= news.duplicateCheck.score %>,
                            matchCount: <%= news.duplicateCheck.matchCount %>,
                            similarArticles: <%- JSON.stringify(news.duplicateCheck.similarArticles) %>
                        };
                    <% } %>
                <% }); %>
            <% } %>

            function filterNews() {
                const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                const categoryFilter = document.getElementById('categoryFilter').value.toLowerCase();
                const locationFilter = document.getElementById('locationFilter').value.toLowerCase();
                const languageFilterEl = document.getElementById('languageFilter');
                const languageFilter = languageFilterEl ? languageFilterEl.value.toLowerCase() : '';
                const dateFilter = document.getElementById('dateFilter').value;

                const cards = document.querySelectorAll('.news-card');
                let visibleCount = 0;

                cards.forEach(card => {
                    const title = card.dataset.title;
                    const author = card.dataset.author;
                    const category = card.dataset.category;
                    const location = card.dataset.location;
                    const language = card.dataset.language || 'te';
                    const cardDate = parseInt(card.dataset.date);

                    // Search filter
                    const matchesSearch = !searchTerm || title.includes(searchTerm) || author.includes(searchTerm);

                    // Category filter
                    const matchesCategory = !categoryFilter || category === categoryFilter;

                    // Location filter
                    const matchesLocation = !locationFilter || location === locationFilter;

                    // Language filter (client-side within loaded results)
                    const matchesLanguage = !languageFilter || language === languageFilter;

                    // Date filter
                    let matchesDate = true;
                    if (dateFilter) {
                        const now = new Date();
                        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                        const cardDateObj = new Date(cardDate);

                        switch(dateFilter) {
                            case 'today':
                                matchesDate = cardDateObj >= today;
                                break;
                            case 'week':
                                const weekAgo = new Date(today);
                                weekAgo.setDate(weekAgo.getDate() - 7);
                                matchesDate = cardDateObj >= weekAgo;
                                break;
                            case 'month':
                                const monthAgo = new Date(today);
                                monthAgo.setMonth(monthAgo.getMonth() - 1);
                                matchesDate = cardDateObj >= monthAgo;
                                break;
                        }
                    }

                    if (matchesSearch && matchesCategory && matchesLocation && matchesLanguage && matchesDate) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Update pending count
                document.getElementById('pendingCount').textContent = visibleCount;
            }

            function applyLanguageFilter() {
                const languageFilter = document.getElementById('languageFilter');
                const selected = languageFilter ? languageFilter.value : '';
                const params = new URLSearchParams(window.location.search);
                params.set('language', selected || 'all');
                window.location.search = params.toString();
            }

            function resetFilters() {
                window.location.href = `${window.location.pathname}?language=all`;
            }

            function sortNews(type) {
                const grid = document.getElementById('newsGrid');
                const cards = Array.from(grid.querySelectorAll('.news-card'));

                cards.sort((a, b) => {
                    if (type === 'recent') {
                        const dateA = parseInt(a.dataset.date);
                        const dateB = parseInt(b.dataset.date);
                        return dateB - dateA;
                    } else if (type === 'oldest') {
                        const dateA = parseInt(a.dataset.date);
                        const dateB = parseInt(b.dataset.date);
                        return dateA - dateB;
                    } else if (type === 'views') {
                        // For views, we can use title length as a proxy (just for demo)
                        return b.dataset.title.length - a.dataset.title.length;
                    }
                });

                cards.forEach(card => grid.appendChild(card));

                // Update active button
                document.querySelectorAll('.sort-options button').forEach(btn => btn.classList.remove('active'));
                if (event && event.currentTarget) {
                    event.currentTarget.classList.add('active');
                }
            }

            window.changePreviewCarousel = function(carouselId, totalSlides, direction) {
                const stateKey = 'carouselState_' + carouselId.replace(/-/g, '_');
                if (typeof window[stateKey] === 'undefined') window[stateKey] = 0;
                
                // Hide current
                const currentSlide = document.getElementById(carouselId + '-slide-' + window[stateKey]);
                if (currentSlide) currentSlide.style.display = 'none';
                
                // Update state
                window[stateKey] = (window[stateKey] + direction + totalSlides) % totalSlides;
                
                // Show new
                const newSlide = document.getElementById(carouselId + '-slide-' + window[stateKey]);
                if (newSlide) newSlide.style.display = 'block';
            };

