                        mediaUrl: news.mediaUrl || "",
                        imageUrls: news.imageUrls || [],
                        mediaType: news.mediaType || "image",
                        readFullLink: news.readFullLink || "",
                        ePaperLink: news.ePaperLink || "",
                        publishedAt: publishDate.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true })
                    };
