<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Registration Form Builder' }) %>
<link rel="stylesheet" href="/css/editors-directory.css">
<link rel="stylesheet" href="/css/form-builder.css">

<body>
    <%- include('partials/top-nav', { pageTitle: 'Form Builder', backButton: true, backUrl: '/' }) %>

    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar', { activePage: 'registration-fields' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                <% 
                    const fmbFields = typeof fields !== 'undefined' ? fields : [];
                    let fmbRequired = 0;
                    const fmbTypes = {};
                    fmbFields.forEach(function(f) {
                        if (f.required) fmbRequired++;
                        fmbTypes[f.type] = (fmbTypes[f.type] || 0) + 1;
                    });
                    function fmbTypeIcon(type) {
                        const icons = { text: 'fa-font', email: 'fa-envelope', tel: 'fa-phone', textarea: 'fa-align-left', date: 'fa-calendar', file: 'fa-file-arrow-up', select: 'fa-list' };
                        return icons[type] || 'fa-input-text';
                    }
                    function fmbTypeClass(type) {
                        return ['text','email','tel','textarea','date','file','select'].indexOf(type) >= 0 ? type : 'default';
                    }
                %>
                <div class="fmb-page content-area mt-4">
                    <header class="fmb-hero">
                        <div>
                            <p class="fmb-eyebrow"><i class="fas fa-wand-magic-sparkles"></i> Dynamic form studio</p>
                            <h1 class="fmb-hero-title">Reporter registration builder</h1>
                            <p class="fmb-hero-sub">Design the onboarding form reporters fill before joining. Add fields, set validation, and preview the mobile experience in real time.</p>
                        </div>
                        <div class="fmb-hero-actions">
                            <button type="button" class="fmb-btn-outline" data-bs-toggle="modal" data-bs-target="#previewModal" onclick="generatePreview()">
                                <i class="fas fa-expand"></i> Full preview
                            </button>
                            <button type="button" class="team-btn-primary" data-bs-toggle="modal" data-bs-target="#fieldModal" onclick="resetForm()">
                                <i class="fas fa-plus"></i> Add field
                            </button>
                        </div>
                    </header>

                    <div class="fmb-kpi-grid">
                        <div class="fmb-kpi">
                            <div>
                                <div class="fmb-kpi-value"><%= fmbFields.length %></div>
                                <div class="fmb-kpi-label">Total fields</div>
                            </div>
                            <span class="fmb-kpi-icon fmb-kpi-icon--cyan"><i class="fas fa-list-ul"></i></span>
                        </div>
                        <div class="fmb-kpi">
                            <div>
                                <div class="fmb-kpi-value"><%= fmbRequired %></div>
                                <div class="fmb-kpi-label">Required fields</div>
                            </div>
                            <span class="fmb-kpi-icon fmb-kpi-icon--rose"><i class="fas fa-asterisk"></i></span>
                        </div>
                        <div class="fmb-kpi">
                            <div>
                                <div class="fmb-kpi-value"><%= Object.keys(fmbTypes).length %></div>
                                <div class="fmb-kpi-label">Field types used</div>
                            </div>
                            <span class="fmb-kpi-icon fmb-kpi-icon--amber"><i class="fas fa-shapes"></i></span>
                        </div>
                        <div class="fmb-kpi">
                            <div>
                                <div class="fmb-kpi-value"><%= fmbFields.filter(function(f){ return f.isActive !== false; }).length %></div>
                                <div class="fmb-kpi-label">Active in form</div>
                            </div>
                            <span class="fmb-kpi-icon fmb-kpi-icon--indigo"><i class="fas fa-mobile-screen"></i></span>
                        </div>
                    </div>

                    <script id="fieldsData" type="application/json"><%- JSON.stringify(fmbFields) %></script>

                    <div class="fmb-layout">
                        <div class="fmb-panel">
                            <div class="fmb-panel-head">
                                <h2 class="fmb-panel-title"><i class="fas fa-table-list me-2"></i>Field inventory</h2>
                                <a href="/reporter-applications" class="fmb-btn-outline" style="color:#0891b2!important;border-color:#a5f3fc;background:#ecfeff;padding:8px 12px;font-size:0.78rem;">
                                    <i class="fas fa-inbox"></i> View applications
                                </a>
                            </div>

                            <% if (fmbFields.length === 0) { %>
                            <div class="fmb-empty">
                                <div class="fmb-empty-icon"><i class="fas fa-file-circle-plus"></i></div>
                                <h4 style="margin:0 0 8px;color:#111827;">No fields yet</h4>
                                <p style="margin:0 0 16px;color:#6b7280;">Start with Name, Email, and Phone — then add custom questions.</p>
                                <button type="button" class="team-btn-primary" data-bs-toggle="modal" data-bs-target="#fieldModal" onclick="resetForm()">
                                    <i class="fas fa-plus"></i> Add first field
                                </button>
                            </div>
                            <% } else { %>
                            <div class="fmb-field-list" id="fieldsList">
                                <% fmbFields.forEach(function(field) { %>
                                <div class="fmb-field-row" data-id="<%= field._id %>">
                                    <span class="fmb-order-badge"><%= field.order != null ? field.order : 0 %></span>
                                    <div class="fmb-field-main">
                                        <span class="fmb-type-icon fmb-type-icon--<%= fmbTypeClass(field.type) %>">
                                            <i class="fas <%= fmbTypeIcon(field.type) %>"></i>
                                        </span>
                                        <div class="fmb-field-text">
                                            <p class="fmb-field-label"><%= field.label %></p>
                                            <div class="fmb-field-meta">
                                                <span class="fmb-pill fmb-pill--type"><%= field.type %></span>
                                                <% if (field.required) { %>
                                                <span class="fmb-pill fmb-pill--required">Required</span>
                                                <% } else { %>
                                                <span class="fmb-pill fmb-pill--optional">Optional</span>
                                                <% } %>
                                                <span class="fmb-field-code"><%= field.name %></span>
                                                <% if (field.placeholder) { %>
                                                <span>· <%= field.placeholder %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="fmb-field-actions">
                                        <button type="button" class="fmb-action-btn fmb-action-btn--edit" title="Edit" onclick="editFieldById('<%= field._id %>')"><i class="fas fa-pen"></i></button>
                                        <button type="button" class="fmb-action-btn fmb-action-btn--delete" title="Delete" onclick="deleteField('<%= field._id %>')"><i class="fas fa-trash"></i></button>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                        <aside class="fmb-preview-sticky">
                            <div class="fmb-panel">
                                <div class="fmb-panel-head">
                                    <h2 class="fmb-panel-title"><i class="fas fa-mobile-alt me-2"></i>Live mobile preview</h2>
                                </div>
                                <div style="padding:16px;">
                                    <div class="fmb-phone">
                                        <div class="fmb-phone-notch"></div>
                                        <h3 class="fmb-phone-title">Join as Reporter</h3>
                                        <p class="fmb-phone-sub">Preview how applicants see your form</p>
                                        <div id="livePreviewContent"></div>
                                        <button type="button" class="fmb-preview-submit" disabled>Submit application</button>
                                    </div>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Field modal -->
    <div class="modal fade fmb-modal" id="fieldModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="fas fa-sliders me-2"></i>Add field</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="fieldForm">
                        <input type="hidden" id="fieldId">
                        <div class="fmb-form-field">
                            <label for="label">Field label</label>
                            <input type="text" id="label" placeholder="e.g. Full Name" required>
                        </div>
                        <div class="fmb-form-field">
                            <label for="name">Field name (ID)</label>
                            <input type="text" id="name" placeholder="e.g. Name or phone_number" required>
                            <div class="fmb-form-hint">No spaces — use underscores or PascalCase (e.g. Name, Email)</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="fmb-form-field">
                                    <label for="type">Input type</label>
                                    <select id="type" required>
                                        <option value="text">Short text</option>
                                        <option value="email">Email</option>
                                        <option value="tel">Phone number</option>
                                        <option value="textarea">Long text</option>
                                        <option value="date">Date</option>
                                        <option value="file">File upload</option>
                                        <option value="select">Dropdown</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fmb-form-field">
                                    <label for="order">Display order</label>
                                    <input type="number" id="order" value="0" min="0">
                                </div>
                            </div>
                        </div>
                        <div class="fmb-form-field">
                            <label for="placeholder">Placeholder text</label>
                            <input type="text" id="placeholder" placeholder="Hint shown inside the field">
                        </div>
                        <div class="fmb-form-field d-none" id="optionsContainer">
                            <label for="options">Dropdown options</label>
                            <input type="text" id="options" placeholder="Option 1, Option 2, Option 3">
                            <div class="fmb-form-hint">Comma-separated list</div>
                        </div>
                        <div class="fmb-switch-row">
                            <label for="required" style="font-size:0.84rem;font-weight:600;color:#374151;">Required field</label>
                            <label class="fmb-switch">
                                <input type="checkbox" id="required">
                                <span class="fmb-switch-slider"></span>
                            </label>
                        </div>
                        <button type="submit" class="fmb-save-btn mt-2"><i class="fas fa-save me-1"></i> Save field</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Full preview modal -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body p-0">
                    <div class="fmb-phone mx-auto" style="max-width:400px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fmb-phone-title mb-0">Join as Reporter</h3>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div id="previewFormContent"></div>
                        <button type="button" class="fmb-preview-submit" disabled>Submit application</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        const GRAPHQL_ENDPOINT = '/graphql';
        let fieldsCache = [];

        document.addEventListener('DOMContentLoaded', function () {
            fieldsCache = JSON.parse(document.getElementById('fieldsData').textContent);
            renderPreviewInto(document.getElementById('livePreviewContent'));
            setupMobileMenu();
        });

        document.getElementById('type').addEventListener('change', function () {
            document.getElementById('optionsContainer').classList.toggle('d-none', this.value !== 'select');
        });

        document.getElementById('label').addEventListener('input', function () {
            const nameInput = document.getElementById('name');
            if (!document.getElementById('fieldId').value && !nameInput.dataset.manual) {
                nameInput.value = this.value.trim().replace(/\s+/g, '_');
            }
        });

        document.getElementById('name').addEventListener('input', function () {
            this.dataset.manual = '1';
        });

        function resetForm() {
            document.getElementById('fieldForm').reset();
            document.getElementById('fieldId').value = '';
            document.getElementById('name').removeAttribute('data-manual');
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-sliders me-2"></i>Add field';
            document.getElementById('optionsContainer').classList.add('d-none');
        }

        function editFieldById(fieldId) {
            const field = fieldsCache.find(function (f) { return String(f._id) === String(fieldId); });
            if (!field) return;
            document.getElementById('fieldId').value = field._id;
            document.getElementById('label').value = field.label;
            document.getElementById('name').value = field.name;
            document.getElementById('name').dataset.manual = '1';
            document.getElementById('type').value = field.type;
            document.getElementById('placeholder').value = field.placeholder || '';
            document.getElementById('order').value = field.order || 0;
            document.getElementById('required').checked = !!field.required;
            if (field.type === 'select') {
                document.getElementById('optionsContainer').classList.remove('d-none');
                document.getElementById('options').value = field.options ? field.options.join(', ') : '';
            } else {
                document.getElementById('optionsContainer').classList.add('d-none');
            }
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-pen me-2"></i>Edit field';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('fieldModal')).show();
        }

        document.getElementById('fieldForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const id = document.getElementById('fieldId').value;
            const variables = {
                id: id || undefined,
                label: document.getElementById('label').value.trim(),
                name: document.getElementById('name').value.trim(),
                type: document.getElementById('type').value,
                placeholder: document.getElementById('placeholder').value.trim(),
                order: parseInt(document.getElementById('order').value, 10) || 0,
                required: document.getElementById('required').checked,
                options: document.getElementById('type').value === 'select'
                    ? document.getElementById('options').value.split(',').map(function (o) { return o.trim(); }).filter(Boolean)
                    : []
            };

            const query = 'mutation UpdateRegistrationField($id: ID, $label: String, $name: String, $type: String, $placeholder: String, $order: Int, $required: Boolean, $options: [String]) { updateRegistrationField(id: $id, label: $label, name: $name, type: $type, placeholder: $placeholder, order: $order, required: $required, options: $options) { success message } }';

            try {
                const response = await fetch(GRAPHQL_ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: query, variables: variables })
                });
                const result = await response.json();
                if (result.data?.updateRegistrationField?.success) {
                    location.reload();
                } else {
                    alert(result.data?.updateRegistrationField?.message || 'Failed to save field');
                }
            } catch (error) {
                console.error('Error saving field:', error);
                alert('An error occurred while saving the field.');
            }
        });

        async function deleteField(id) {
            if (!confirm('Delete this field from the registration form?')) return;
            const query = 'mutation DeleteRegistrationField($id: ID!) { deleteRegistrationField(id: $id) { success message } }';
            try {
                const response = await fetch(GRAPHQL_ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: query, variables: { id: id } })
                });
                const result = await response.json();
                if (result.data?.deleteRegistrationField?.success) {
                    location.reload();
                } else {
                    alert(result.data?.deleteRegistrationField?.message || 'Delete failed');
                }
            } catch (error) {
                console.error('Error deleting field:', error);
            }
        }

        function renderPreviewInto(container) {
            if (!container) return;
            container.innerHTML = '';
            const fields = fieldsCache.slice().sort(function (a, b) { return (a.order || 0) - (b.order || 0); });
            if (fields.length === 0) {
                container.innerHTML = '<div class="fmb-preview-empty"><i class="fas fa-plus-circle mb-2"></i><br>Add fields to see preview</div>';
                return;
            }
            fields.forEach(function (field) {
                const wrapper = document.createElement('div');
                wrapper.className = 'fmb-preview-field';
                const label = document.createElement('label');
                label.className = 'fmb-preview-label';
                label.innerHTML = field.label + (field.required ? ' <span style="color:#ef4444">*</span>' : '');
                wrapper.appendChild(label);

                if (field.type === 'textarea') {
                    const el = document.createElement('textarea');
                    el.className = 'fmb-preview-input';
                    el.placeholder = field.placeholder || '';
                    el.rows = 3;
                    el.disabled = true;
                    wrapper.appendChild(el);
                } else if (field.type === 'select') {
                    const el = document.createElement('select');
                    el.className = 'fmb-preview-input';
                    el.disabled = true;
                    const def = document.createElement('option');
                    def.textContent = 'Select ' + field.label;
                    el.appendChild(def);
                    (field.options || []).forEach(function (opt) {
                        const o = document.createElement('option');
                        o.textContent = opt;
                        el.appendChild(o);
                    });
                    wrapper.appendChild(el);
                } else {
                    const el = document.createElement('input');
                    el.type = field.type === 'file' ? 'text' : field.type;
                    el.className = 'fmb-preview-input';
                    el.placeholder = field.placeholder || (field.type === 'file' ? 'Choose file...' : '');
                    el.disabled = true;
                    wrapper.appendChild(el);
                }
                container.appendChild(wrapper);
            });
        }

        function generatePreview() {
            renderPreviewInto(document.getElementById('previewFormContent'));
        }

        function setupMobileMenu() {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            if (menuToggle && sidebar) {
                menuToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    sidebar.classList.toggle('active');
                    mainContent.classList.toggle('sidebar-active');
                });
            }
            document.addEventListener('click', function (event) {
                if (window.innerWidth < 768 && sidebar && sidebar.classList.contains('active') &&
                    !sidebar.contains(event.target) && event.target !== menuToggle &&
                    (!menuToggle || !menuToggle.contains(event.target))) {
                    sidebar.classList.remove('active');
                    if (mainContent) mainContent.classList.remove('sidebar-active');
                }
            });
        }
    </script>
</body>

</html>
