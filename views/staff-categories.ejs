<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Staff Categories' }) %>

<body>
    <%- include('partials/top-nav', { pageTitle: 'Staff Categories', backButton: true, backUrl: '/editors' }) %>

    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar', { activePage: 'staff-categories' }) %>

            <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                <div class="content-area py-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="mb-1">Staff Categories (Display Roles)</h3>
                            <p class="text-muted mb-0">These are the Display Role options shown on the Editors page. Disabling one hides it from new pickers without changing existing staff.</p>
                        </div>
                        <button type="button" class="btn btn-primary" onclick="openCatModal()">
                            <i class="fas fa-plus me-2"></i>Add Category
                        </button>
                    </div>

                    <div class="card">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-center">Staff Record PDF</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Sort</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="catTableBody">
                                    <% (categories || []).forEach(function(c){ %>
                                        <tr data-id="<%= c._id %>"
                                            data-name="<%= c.name %>"
                                            data-pdf="<%= c.pdfEligible %>"
                                            data-active="<%= c.isActive %>"
                                            data-sort="<%= c.sortOrder %>">
                                            <td class="fw-semibold"><%= c.name %></td>
                                            <td class="text-center">
                                                <span class="badge <%= c.pdfEligible ? 'bg-success' : 'bg-secondary' %>">
                                                    <%= c.pdfEligible ? 'Eligible' : 'No' %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge <%= c.isActive ? 'bg-success' : 'bg-secondary' %>">
                                                    <%= c.isActive ? 'Active' : 'Disabled' %>
                                                </span>
                                            </td>
                                            <td class="text-center"><%= c.sortOrder %></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary" onclick="editCatFromRow('<%= c._id %>')">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add / Edit modal -->
    <div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="catModalTitle">Add Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="catId">
                    <div class="mb-3">
                        <label class="form-label">Name *</label>
                        <input type="text" id="catName" class="form-control" placeholder="e.g. Bureau" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sort Order</label>
                        <input type="number" id="catSort" class="form-control" value="0">
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="catPdf">
                        <label class="form-check-label" for="catPdf">Eligible for Official Staff Record PDF</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="catActive" checked>
                        <label class="form-check-label" for="catActive">Active (visible in Display Role dropdown)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="catSaveBtn" onclick="saveCat()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let _catModal;
        function catModal() { if (!_catModal) _catModal = new bootstrap.Modal(document.getElementById('catModal')); return _catModal; }

        function openCatModal() {
            document.getElementById('catId').value = '';
            document.getElementById('catName').value = '';
            document.getElementById('catSort').value = '0';
            document.getElementById('catPdf').checked = false;
            document.getElementById('catActive').checked = true;
            document.getElementById('catModalTitle').textContent = 'Add Category';
            catModal().show();
        }

        function editCatFromRow(id) {
            const row = document.querySelector('tr[data-id="' + id + '"]');
            if (!row) return;
            document.getElementById('catId').value = id;
            document.getElementById('catName').value = row.dataset.name;
            document.getElementById('catSort').value = row.dataset.sort;
            document.getElementById('catPdf').checked = row.dataset.pdf === 'true';
            document.getElementById('catActive').checked = row.dataset.active === 'true';
            document.getElementById('catModalTitle').textContent = 'Edit Category';
            catModal().show();
        }

        async function saveCat() {
            const id = document.getElementById('catId').value;
            const body = {
                name: document.getElementById('catName').value.trim(),
                sortOrder: Number(document.getElementById('catSort').value) || 0,
                pdfEligible: document.getElementById('catPdf').checked,
                isActive: document.getElementById('catActive').checked
            };
            if (!body.name) { alert('Name is required'); return; }
            const btn = document.getElementById('catSaveBtn');
            btn.disabled = true;
            try {
                const url = id ? '/staff-categories/api/' + id : '/staff-categories/api';
                const res = await fetch(url, {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Save failed');
                window.location.reload();
            } catch (e) {
                alert(e.message || 'Save failed');
            } finally {
                btn.disabled = false;
            }
        }
    </script>

    <%- include('partials/footer') %>
</body>

</html>
