<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header') %>
    <title>Polls Management - Short News</title>
</head>
<body class="bg-light">
    <%- include('partials/top-nav', { pageTitle: 'Polls Management', backButton: true, backUrl: '/admin/dashboard' }) %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar', { activePage: 'polls', admin: admin }) %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Polls Management</h1>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPollModal">
                        <i class="fas fa-plus me-2"></i> Create Poll
                    </button>
                </div>

                <!-- Alert for messages -->
                <div id="alertContainer"></div>

                <!-- Polls List -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Question</th>
                                        <th>Language</th>
                                        <th>Total Votes</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (polls && polls.length > 0) { %>
                                        <% polls.forEach(poll => { %>
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <% if (poll.imageUrl) { %>
                                                            <img src="<%= poll.imageUrl %>" alt="" class="rounded" style="width:44px;height:44px;object-fit:cover;flex:0 0 auto;" onerror="this.style.display='none'">
                                                        <% } %>
                                                        <div class="fw-bold"><%= poll.question %></div>
                                                    </div>
                                                    <div class="small text-muted mt-1">
                                                        <% poll.options.forEach((opt, idx) => { %>
                                                            <span class="me-2"><%= idx + 1 %>. <%= opt.text %> (<%= opt.votes %>)</span>
                                                        <% }) %>
                                                    </div>
                                                </td>
                                                <td><span class="badge bg-info text-dark"><%= poll.language ? poll.language.toUpperCase() : 'TE' %></span></td>
                                                <td><span class="badge bg-primary rounded-pill"><%= poll.totalVotes %></span></td>
                                                <td><%= new Date(poll.createdAt).toLocaleDateString() %></td>
                                                <td>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" role="switch" onchange="togglePollStatus('<%= poll._id %>', this.checked)" <%= poll.isActive ? 'checked' : '' %>>
                                                    </div>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-sm btn-outline-primary me-2" onclick='openEditModal(<%- JSON.stringify(poll).replace(/'/g, "\\'") %>)'>
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="deletePoll('<%= poll._id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="fas fa-poll fa-3x mb-3 text-light"></i>
                                                <h5>No Polls Found</h5>
                                                <p>Create your first poll to engage with users.</p>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Create Poll Modal -->
    <div class="modal fade" id="createPollModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Poll</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="createPollForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Poll Question</label>
                            <input type="text" class="form-control" id="pollQuestion" required placeholder="E.g., What is your favorite color?">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Target Language</label>
                            <select class="form-select" id="pollLanguage" required>
                                <% if (languages && languages.length > 0) { %>
                                    <% languages.forEach(lang => { %>
                                        <option value="<%= lang.code %>"><%= lang.name %> (<%= lang.code %>)</option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="te">Telugu (te)</option>
                                    <option value="en">English (en)</option>
                                    <option value="hi">Hindi (hi)</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Options</label>
                            <div id="optionsContainer">
                                <input type="text" class="form-control mb-2 poll-option" required placeholder="Option 1">
                                <input type="text" class="form-control mb-2 poll-option" required placeholder="Option 2">
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="addOptionField()">
                                <i class="fas fa-plus me-1"></i> Add Option
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Background Image <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="file" class="form-control" id="pollImageFile" accept="image/*" onchange="uploadPollImage(this,'pollImage','pollImagePreview','pollImageStatus','createPollBtn')">
                            <input type="hidden" id="pollImage">
                            <div id="pollImageStatus" class="form-text"></div>
                            <div class="form-text">App లో poll వెనుక full-page background గా కనిపిస్తుంది. Image select చేశాక <b>"✅ Image uploaded" వచ్చాకే</b> Create నొక్కండి.</div>
                            <img id="pollImagePreview" src="" alt="" class="mt-2 rounded" style="max-height:120px;display:none;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="createPollBtn" onclick="submitPoll()">Create Poll</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Poll Modal -->
    <div class="modal fade" id="editPollModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Poll</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="editPollForm">
                        <input type="hidden" id="editPollId">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Poll Question</label>
                            <input type="text" class="form-control" id="editPollQuestion" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Target Language</label>
                            <select class="form-select" id="editPollLanguage" required>
                                <% if (languages && languages.length > 0) { %>
                                    <% languages.forEach(lang => { %>
                                        <option value="<%= lang.code %>"><%= lang.name %> (<%= lang.code %>)</option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="te">Telugu (te)</option>
                                    <option value="en">English (en)</option>
                                    <option value="hi">Hindi (hi)</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Options</label>
                            <div id="editOptionsContainer">
                                <!-- Options populated by JS -->
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="addEditOptionField()">
                                <i class="fas fa-plus me-1"></i> Add Option
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Background Image <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="file" class="form-control" id="editPollImageFile" accept="image/*" onchange="uploadPollImage(this,'editPollImage','editPollImagePreview','editPollImageStatus','editPollBtn')">
                            <input type="hidden" id="editPollImage">
                            <div id="editPollImageStatus" class="form-text"></div>
                            <div class="form-text">కొత్త image ఎంచుకుంటే మారుతుంది. తీసేయాలంటే <button type="button" class="btn btn-link btn-sm p-0 align-baseline" onclick="clearPollImage('editPollImage','editPollImagePreview')">remove</button>.</div>
                            <img id="editPollImagePreview" src="" alt="" class="mt-2 rounded" style="max-height:120px;display:none;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="editPollBtn" onclick="submitEditPoll()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showAlert(message, type = 'success') {
            const container = document.getElementById('alertContainer');
            container.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            setTimeout(() => container.innerHTML = '', 5000);
        }

        // Upload a poll background image with progress. While uploading, the
        // Create/Save button is DISABLED and a status line shows inside the modal.
        // (Previously, tapping Save mid-upload reloaded the page and cut the
        // upload off → poll saved with no image. Errors also showed on the page
        // top, hidden behind the modal.)
        window._pollImageUploading = false;
        function uploadPollImage(input, hiddenId, previewId, statusId, btnId) {
            const file = input.files && input.files[0];
            if (!file) return;
            const status = document.getElementById(statusId);
            const btn = document.getElementById(btnId);
            const setStatus = (cls, text) => { if (status) { status.className = 'form-text ' + cls; status.textContent = text; } };
            const finish = () => { window._pollImageUploading = false; if (btn) btn.disabled = false; };

            window._pollImageUploading = true;
            if (btn) btn.disabled = true;
            document.getElementById(hiddenId).value = '';
            setStatus('text-primary fw-bold', '⏳ Uploading… 0% — please wait, do NOT click Save yet');

            const fd = new FormData();
            fd.append('image', file, file.name);
            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/admin/api/polls/upload-image');
            xhr.upload.onprogress = (e) => {
                if (!e.lengthComputable) return;
                const pct = Math.round((e.loaded / e.total) * 100);
                setStatus('text-primary fw-bold', pct >= 100 ? '⚙️ Processing image on server… please wait' : ('⏳ Uploading… ' + pct + '% — please wait, do NOT click Save yet'));
            };
            xhr.onload = () => {
                finish();
                let d = {};
                try { d = JSON.parse(xhr.responseText || '{}'); } catch (_) {}
                if (xhr.status >= 200 && xhr.status < 300 && d.imageUrl) {
                    document.getElementById(hiddenId).value = d.imageUrl;
                    const img = document.getElementById(previewId);
                    img.src = d.imageUrl; img.style.display = 'block';
                    setStatus('text-success fw-bold', '✅ Image uploaded. Now click Save / Create.');
                } else {
                    setStatus('text-danger fw-bold', '❌ Upload failed: ' + (d.error || d.message || ('HTTP ' + xhr.status)));
                }
            };
            xhr.onerror = () => { finish(); setStatus('text-danger fw-bold', '❌ Upload failed: network error. Check connection and try again.'); };
            xhr.onabort = () => { finish(); setStatus('text-danger fw-bold', '❌ Upload cancelled.'); };
            xhr.send(fd);
        }
        // Don't let the page navigate/reload while an image is still uploading.
        window.addEventListener('beforeunload', (e) => {
            if (window._pollImageUploading) { e.preventDefault(); e.returnValue = ''; }
        });

        function clearPollImage(hiddenId, previewId) {
            document.getElementById(hiddenId).value = '';
            const img = document.getElementById(previewId);
            img.src = ''; img.style.display = 'none';
        }

        function addOptionField() {
            const container = document.getElementById('optionsContainer');
            const inputs = container.querySelectorAll('.poll-option');
            if (inputs.length >= 6) {
                alert('Maximum 6 options allowed.');
                return;
            }
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control mb-2 poll-option';
            input.placeholder = `Option ${inputs.length + 1}`;
            input.required = true;
            container.appendChild(input);
        }

        async function submitPoll() {
            if (window._pollImageUploading) { alert('Image is still uploading. Please wait for "✅ Image uploaded", then click Create.'); return; }
            const question = document.getElementById('pollQuestion').value.trim();
            const language = document.getElementById('pollLanguage').value;
            const imageUrl = document.getElementById('pollImage').value;
            const optionInputs = document.querySelectorAll('.poll-option');
            const options = Array.from(optionInputs).map(inp => inp.value.trim()).filter(v => v);

            if (!question || options.length < 2) {
                alert('Please provide a question and at least 2 options.');
                return;
            }

            try {
                const res = await fetch('/admin/api/polls', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question, language, options, imageUrl })
                });
                
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    showAlert(data.message || 'Error creating poll', 'danger');
                }
            } catch (err) {
                showAlert('Failed to connect to server', 'danger');
            }
        }

        async function deletePoll(id) {
            if (!confirm('Are you sure you want to delete this poll?')) return;
            
            try {
                const res = await fetch(`/admin/api/polls/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    showAlert(data.message || 'Error deleting poll', 'danger');
                }
            } catch (err) {
                showAlert('Failed to connect to server', 'danger');
            }
        }

        async function togglePollStatus(id, isActive) {
            try {
                const res = await fetch(`/admin/api/polls/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isActive })
                });
                const data = await res.json();
                if (!data.success) {
                    showAlert(data.message || 'Error updating status', 'danger');
                    // Revert UI if fail
                    setTimeout(() => window.location.reload(), 1500);
                }
            } catch (err) {
                showAlert('Failed to connect to server', 'danger');
                setTimeout(() => window.location.reload(), 1500);
            }
        }

        let editModal;
        function openEditModal(poll) {
            document.getElementById('editPollId').value = poll._id;
            document.getElementById('editPollQuestion').value = poll.question;
            document.getElementById('editPollLanguage').value = poll.language || 'te';
            document.getElementById('editPollImage').value = poll.imageUrl || '';
            document.getElementById('editPollImageFile').value = '';
            const editPreview = document.getElementById('editPollImagePreview');
            if (poll.imageUrl) { editPreview.src = poll.imageUrl; editPreview.style.display = 'block'; }
            else { editPreview.src = ''; editPreview.style.display = 'none'; }

            const container = document.getElementById('editOptionsContainer');
            container.innerHTML = '';
            poll.options.forEach((opt, idx) => {
                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'form-control mb-2 edit-poll-option';
                input.value = opt.text;
                input.required = true;
                container.appendChild(input);
            });
            
            if (!editModal) {
                editModal = new bootstrap.Modal(document.getElementById('editPollModal'));
            }
            editModal.show();
        }

        function addEditOptionField() {
            const container = document.getElementById('editOptionsContainer');
            const inputs = container.querySelectorAll('.edit-poll-option');
            if (inputs.length >= 6) {
                alert('Maximum 6 options allowed.');
                return;
            }
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control mb-2 edit-poll-option';
            input.placeholder = `Option ${inputs.length + 1}`;
            input.required = true;
            container.appendChild(input);
        }

        async function submitEditPoll() {
            if (window._pollImageUploading) { alert('Image is still uploading. Please wait for "✅ Image uploaded", then click Save.'); return; }
            const id = document.getElementById('editPollId').value;
            const question = document.getElementById('editPollQuestion').value.trim();
            const language = document.getElementById('editPollLanguage').value;
            const imageUrl = document.getElementById('editPollImage').value;
            const optionInputs = document.querySelectorAll('.edit-poll-option');
            const options = Array.from(optionInputs).map(inp => inp.value.trim()).filter(v => v);

            if (!question || options.length < 2) {
                alert('Please provide a question and at least 2 options.');
                return;
            }

            try {
                const res = await fetch(`/admin/api/polls/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question, language, options, imageUrl })
                });
                
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    showAlert(data.message || 'Error updating poll', 'danger');
                }
            } catch (err) {
                showAlert('Failed to connect to server', 'danger');
            }
        }
    </script>
</body>
</html>
