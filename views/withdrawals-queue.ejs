<%- include('partials/header') %>
<body>
<%- include('partials/top-nav', { pageTitle: 'Withdrawals Queue', backButton: true, backUrl: '/' }) %>
<%- include('partials/sidebar') %>

<style>
  .settings-card { border-radius:12px; border:none; box-shadow:0 4px 6px rgba(0,0,0,.04); }
  .settings-card .card-header { background:#fff; border-bottom:1px solid #f0f0f0; padding:16px 20px; border-radius:12px 12px 0 0; }
  .stat-card { background:#fff; border-radius:12px; padding:18px; border:1px solid #f0f0f0; display:flex; align-items:center; gap:14px; }
  .stat-icon { width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px; }
  .status-tabs .nav-link { border-radius:8px; font-weight:600; color:#495057; padding:8px 18px; }
  .status-tabs .nav-link.active { background:#0d6efd; color:#fff; }
  .badge-status { font-size:11px; font-weight:700; padding:5px 10px; border-radius:999px; }
</style>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content pb-5">
  <div class="pt-4 pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1 class="h2 page-title mb-1">Withdrawals Queue</h1>
      <p class="text-muted mb-0">Approve or reject reporter payout requests. Every action is audit-logged.</p>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-danger fw-bold" id="downloadPdfBtn"><i class="fas fa-file-pdf me-2"></i>Download PDF (Accounts)</button>
      <button type="button" class="btn btn-outline-primary fw-bold" id="refreshBtn"><i class="fas fa-sync-alt me-2"></i>Refresh</button>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="stat-card">
        <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="fas fa-clock"></i></div>
        <div>
          <h6 class="text-muted mb-1 fw-bold small">PENDING</h6>
          <h4 class="mb-0 fw-bold"><span id="statPendingCount">0</span> <small class="text-muted fs-6" id="statPendingAmt"></small></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="stat-card">
        <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="fas fa-check-circle"></i></div>
        <div>
          <h6 class="text-muted mb-1 fw-bold small">APPROVED (PAID)</h6>
          <h4 class="mb-0 fw-bold"><span id="statApprovedCount">0</span> <small class="text-muted fs-6" id="statApprovedAmt"></small></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="stat-card">
        <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="fas fa-times-circle"></i></div>
        <div>
          <h6 class="text-muted mb-1 fw-bold small">REJECTED</h6>
          <h4 class="mb-0 fw-bold"><span id="statRejectedCount">0</span> <small class="text-muted fs-6" id="statRejectedAmt"></small></h4>
        </div>
      </div>
    </div>
  </div>

  <ul class="nav nav-pills status-tabs mb-3" id="statusTabs">
    <li class="nav-item"><button class="nav-link active" data-status="pending">Pending</button></li>
    <li class="nav-item"><button class="nav-link" data-status="approved">Approved</button></li>
    <li class="nav-item"><button class="nav-link" data-status="rejected">Rejected</button></li>
    <li class="nav-item"><button class="nav-link" data-status="all">All</button></li>
  </ul>

  <!-- Advanced filters -->
  <div class="card settings-card mb-3">
    <div class="card-body py-3">
      <div class="row g-2 align-items-end">
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">Search (name / mobile)</label>
          <input type="text" class="form-control form-control-sm" id="fSearch" placeholder="Name / mobile…">
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">State</label>
          <select class="form-select form-select-sm" id="fState"><option value="">All states</option></select>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">State In-Charge</label>
          <select class="form-select form-select-sm" id="fIncharge"><option value="">All in-charges</option></select>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">Type</label>
          <select class="form-select form-select-sm" id="fType">
            <option value="">All types</option>
            <option value="district_incharge">District In-charge</option>
            <option value="stringer">Stringer</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">Payout</label>
          <select class="form-select form-select-sm" id="fPay">
            <option value="">All</option>
            <option value="upi">UPI</option>
            <option value="phonepe">PhonePe</option>
            <option value="bank">Bank</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-bold text-muted mb-1">Sort</label>
          <select class="form-select form-select-sm" id="fSort">
            <option value="new">Newest first</option>
            <option value="old">Oldest first</option>
            <option value="amt_hi">Amount high→low</option>
            <option value="amt_lo">Amount low→high</option>
          </select>
        </div>
        <div class="col-md-1 d-grid">
          <button class="btn btn-sm btn-outline-secondary" id="fClear" title="Clear filters"><i class="fas fa-times"></i></button>
        </div>
      </div>
      <div class="mt-2 small text-muted" id="filterSummary"></div>
    </div>
  </div>

  <div class="card settings-card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4">Reporter</th>
              <th>State</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Payment Details</th>
              <th>Requested</th>
              <th>Status</th>
              <th>Processed By</th>
              <th>UTR / Remarks</th>
              <th class="text-end pe-4">Action</th>
            </tr>
          </thead>
          <tbody id="tableBody">
            <tr><td colspan="10" class="text-center py-4 text-muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Reporter full-info modal -->
<div class="modal fade" id="userModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:14px;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-user-circle me-2 text-primary"></i>Reporter Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="userModalBody"></div>
    </div>
  </div>
</div>

<!-- Process modal -->
<div class="modal fade" id="processModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content" style="border-radius:14px;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="processModalTitle">Process Withdrawal</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="bg-light rounded p-3 mb-3" id="processModalInfo"></div>
        <div class="mb-3" id="utrGroup">
          <label class="form-label fw-bold small">UTR / Transaction Reference <span class="text-muted fw-normal">(bank/UPI reference after payment)</span></label>
          <input type="text" class="form-control" id="utrInput" placeholder="e.g. 415XXXXXXXXX">
        </div>
        <div class="mb-2">
          <label class="form-label fw-bold small" id="remarksLabel">Remarks</label>
          <textarea class="form-control" id="remarksInput" rows="2" placeholder="Note..."></textarea>
        </div>
        <div class="alert alert-danger d-none" id="processModalError"></div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn fw-bold" id="processConfirmBtn">Confirm</button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  let currentStatus = 'pending';
  let currentAction = null;
  let currentId = null;
  let allRows = [];
  const tableBody = document.getElementById('tableBody');
  const modalEl = document.getElementById('processModal');
  const modal = new bootstrap.Modal(modalEl);

  const esc = (s) => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const inr = (n) => '₹' + Number(n || 0).toLocaleString('en-IN');
  const dt = (d) => d ? new Date(d).toLocaleString('en-IN', { day:'2-digit', month:'short', year:'2-digit', hour:'2-digit', minute:'2-digit' }) : '-';

  const statusBadge = (s) => {
    const map = { pending: 'bg-warning bg-opacity-25 text-warning', approved: 'bg-success bg-opacity-25 text-success', rejected: 'bg-danger bg-opacity-25 text-danger' };
    return `<span class="badge-status ${map[s] || 'bg-secondary bg-opacity-25'}">${esc(s).toUpperCase()}</span>`;
  };

  async function load() {
    tableBody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Loading...</td></tr>';
    try {
      const res = await fetch(`/admin/api/wallet/withdrawals?status=${currentStatus}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');

      const c = data.counts || {}, a = data.amounts || {};
      document.getElementById('statPendingCount').textContent = c.pending || 0;
      document.getElementById('statPendingAmt').textContent = inr(a.pending);
      document.getElementById('statApprovedCount').textContent = c.approved || 0;
      document.getElementById('statApprovedAmt').textContent = inr(a.approved);
      document.getElementById('statRejectedCount').textContent = c.rejected || 0;
      document.getElementById('statRejectedAmt').textContent = inr(a.rejected);

      allRows = data.withdrawals || [];
      populateStateFilter(allRows);
      populateInchargeFilter(allRows);
      render();
    } catch (err) {
      tableBody.innerHTML = `<tr><td colspan="10" class="text-center py-4 text-danger">${esc(err.message)}</td></tr>`;
    }
  }

  const tierLabel = (t) => t === 'district_incharge' ? 'DI' : (t === 'stringer' ? 'Stringer' : 'Other');
  const tierBadge = (t) => {
    const cls = t === 'district_incharge' ? 'bg-primary bg-opacity-10 text-primary'
      : (t === 'stringer' ? 'bg-warning bg-opacity-25 text-warning' : 'bg-secondary bg-opacity-10 text-secondary');
    return `<span class="badge-status ${cls}">${tierLabel(t)}</span>`;
  };
  const payKind = (w) => {
    const s = String(w.paymentDetails || '').toLowerCase();
    if (w.payoutType) return w.payoutType;
    if (/phonepe/.test(s)) return 'phonepe';
    return /upi|@/.test(s) ? 'upi' : (/bank|a\/c|ifsc|account/.test(s) ? 'bank' : '');
  };

  function populateStateFilter(list) {
    const sel = document.getElementById('fState');
    const cur = sel.value;
    const states = [...new Set(list.map(w => (w.reporter || {}).state).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All states</option>' + states.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
    sel.value = cur; // keep selection across reloads
  }

  // In-charge list depends on the selected State: pick the state's reporters,
  // then the distinct State In-Charges among them. No state selected → all
  // in-charges across the loaded list. Selection is kept if still valid.
  function populateInchargeFilter(list) {
    const sel = document.getElementById('fIncharge');
    const cur = sel.value;
    const st = document.getElementById('fState').value;
    const scoped = st ? (list || []).filter(w => (w.reporter || {}).state === st) : (list || []);
    const incs = [...new Set(scoped.map(w => (w.reporter || {}).stateIncharge).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All in-charges</option>'
      + incs.map(n => `<option value="${esc(n)}">${esc(n)}</option>`).join('');
    sel.value = incs.includes(cur) ? cur : ''; // reset if no longer valid for this state
  }

  // Single source of truth for "what the admin sees": the same filters + the
  // same Sort selection are applied to the on-screen table AND to the PDF, so
  // the export always matches the selected order exactly.
  function applyFiltersAndSort(rows) {
    const q = (document.getElementById('fSearch').value || '').trim().toLowerCase();
    const st = document.getElementById('fState').value;
    const inc = document.getElementById('fIncharge').value;
    const ty = document.getElementById('fType').value;
    const pk = document.getElementById('fPay').value;
    const sort = document.getElementById('fSort').value;

    const list = (rows || []).filter((w) => {
      const r = w.reporter || {};
      if (q && !((r.name || '').toLowerCase().includes(q) || (r.mobileNumber || '').toLowerCase().includes(q))) return false;
      if (st && r.state !== st) return false;
      if (inc && (r.stateIncharge || '') !== inc) return false;
      if (ty) {
        const t = r.reporterTier || 'other';
        if (ty === 'other' ? (t === 'district_incharge' || t === 'stringer') : t !== ty) return false;
      }
      if (pk && payKind(w) !== pk) return false;
      return true;
    });

    list.sort((a, b) => {
      if (sort === 'old') return new Date(a.createdAt) - new Date(b.createdAt);
      if (sort === 'amt_hi') return (b.amount || 0) - (a.amount || 0);
      if (sort === 'amt_lo') return (a.amount || 0) - (b.amount || 0);
      return new Date(b.createdAt) - new Date(a.createdAt);
    });
    return list;
  }

  function render() {
    const list = applyFiltersAndSort(allRows);

    const total = list.reduce((s, w) => s + (Number(w.amount) || 0), 0);
    document.getElementById('filterSummary').innerHTML =
      `Showing <b>${list.length}</b> of ${allRows.length} · Total <b class="text-success">${inr(total)}</b>`;

    if (!list.length) {
      tableBody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-muted">No requests match the filters.</td></tr>';
      return;
    }

    tableBody.innerHTML = list.map((w) => {
      const r = w.reporter || {};
      // Reporter Security hold: same UPI / bank / mobile as other reporter accounts →
      // cannot be paid until the Super Admin clears it (the server enforces this too).
      const hold = w.fraudHold || null;
      const onHold = w.status === 'pending' && hold && hold.active;
      const holdInfo = hold
        ? (hold.active
            ? `<div class="mt-1"><span class="badge bg-danger" title="${esc((hold.reasons || []).join(' · '))}"><i class="fas fa-hand me-1"></i>ON HOLD</span>
               <div class="small text-danger">${esc((hold.reasons || []).join(' · '))} · ${hold.linkedCount} other account(s)</div></div>`
            : `<div class="small text-success mt-1"><i class="fas fa-check me-1"></i>Hold cleared by ${esc(hold.clearedByName || 'Super Admin')}</div>`)
        : '';
      const actions = w.status === 'pending'
        ? (onHold
            ? `<a class="btn btn-sm btn-outline-danger me-1" href="/admin/reporter-security">Review hold</a>`
            : `<button class="btn btn-sm btn-success me-1" onclick="openProcess('${w.id}','approve','${esc(r.name)}',${w.amount})">Approve</button>`)
          + `<button class="btn btn-sm btn-outline-danger" onclick="openProcess('${w.id}','reject','${esc(r.name)}',${w.amount})">Reject</button>`
        : '<span class="text-muted small">—</span>';
      const utrRemarks = [w.utr ? `<span class="fw-bold">${esc(w.utr)}</span>` : '', esc(w.remarks)].filter(Boolean).join('<br>') || '-';
      return `<tr>
        <td class="ps-4">
          <a href="#" class="fw-semibold text-decoration-none" onclick="openUser('${r.id || ''}');return false;">${esc(r.name || 'Unknown')} <i class="fas fa-circle-info text-primary small"></i></a>
          <div class="small text-muted">${esc(r.mobileNumber || '')} · Bal: ${inr(r.walletBalance)}</div>
        </td>
        <td class="small">${esc(r.state || '-')}</td>
        <td>${tierBadge(r.reporterTier)}</td>
        <td class="fw-bold text-success">${inr(w.amount)}</td>
        <td style="max-width:220px;white-space:pre-wrap;font-size:12.5px;">${esc(w.paymentDetails)}</td>
        <td class="small text-muted">${dt(w.createdAt)}</td>
        <td>${statusBadge(w.status)}${holdInfo}</td>
        <td class="small">${esc(w.processedBy || '-')}<div class="text-muted">${w.processedAt ? dt(w.processedAt) : ''}</div></td>
        <td class="small" style="max-width:180px;">${utrRemarks}</td>
        <td class="text-end pe-4">${actions}</td>
      </tr>`;
    }).join('');
  }

  window.openProcess = function (id, action, name, amount) {
    currentId = id;
    currentAction = action;
    document.getElementById('processModalTitle').textContent = action === 'approve' ? 'Approve & Pay' : 'Reject Request';
    document.getElementById('processModalInfo').innerHTML =
      `<strong>${esc(name)}</strong> — <span class="text-success fw-bold">${inr(amount)}</span>`;
    document.getElementById('utrGroup').style.display = action === 'approve' ? '' : 'none';
    document.getElementById('remarksLabel').textContent = action === 'approve' ? 'Remarks (optional)' : 'Rejection reason (required)';
    document.getElementById('utrInput').value = '';
    document.getElementById('remarksInput').value = '';
    document.getElementById('processModalError').classList.add('d-none');
    const btn = document.getElementById('processConfirmBtn');
    btn.className = `btn fw-bold ${action === 'approve' ? 'btn-success' : 'btn-danger'}`;
    btn.textContent = action === 'approve' ? 'Approve & Debit Wallet' : 'Reject';
    modal.show();
  };

  document.getElementById('processConfirmBtn').addEventListener('click', async () => {
    const btn = document.getElementById('processConfirmBtn');
    const errBox = document.getElementById('processModalError');
    const remarks = document.getElementById('remarksInput').value.trim();
    const utr = document.getElementById('utrInput').value.trim();

    if (currentAction === 'reject' && !remarks) {
      errBox.textContent = 'Rejection reason is required.';
      errBox.classList.remove('d-none');
      return;
    }

    btn.disabled = true;
    try {
      const res = await fetch(`/admin/api/wallet/withdrawals/${currentId}/process`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: currentAction, remarks, utr })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Failed');
      modal.hide();
      load();
    } catch (err) {
      errBox.textContent = err.message || 'Failed to process';
      errBox.classList.remove('d-none');
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelectorAll('#statusTabs .nav-link').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#statusTabs .nav-link').forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      currentStatus = b.dataset.status;
      load();
    });
  });

  document.getElementById('refreshBtn').addEventListener('click', load);

  // Advanced filters (client-side over the loaded list).
  ['fSearch','fType','fPay','fSort','fIncharge'].forEach((id) => {
    const el = document.getElementById(id);
    el.addEventListener(id === 'fSearch' ? 'input' : 'change', render);
  });
  // Changing the State rebuilds the In-Charge list for that state, then renders.
  document.getElementById('fState').addEventListener('change', () => {
    populateInchargeFilter(allRows);
    render();
  });
  document.getElementById('fClear').addEventListener('click', () => {
    document.getElementById('fSearch').value = '';
    document.getElementById('fState').value = '';
    document.getElementById('fType').value = '';
    document.getElementById('fPay').value = '';
    document.getElementById('fSort').value = 'new';
    populateInchargeFilter(allRows);
    document.getElementById('fIncharge').value = '';
    render();
  });

  // ---- Click a reporter → full info modal ----
  window.openUser = async function (id) {
    if (!id) return;
    const m = new bootstrap.Modal(document.getElementById('userModal'));
    document.getElementById('userModalBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
    m.show();
    try {
      const res = await fetch(`/admin/api/wallet/withdrawals/user/${id}`);
      const d = await res.json();
      if (!res.ok) throw new Error(d.error || 'Failed to load');
      document.getElementById('userModalBody').innerHTML = renderUser(d);
    } catch (e) {
      document.getElementById('userModalBody').innerHTML = `<div class="alert alert-danger">${esc(e.message)}</div>`;
    }
  };

  function renderUser(d) {
    const r = d.reporter || {}, s = d.summary || {};
    const tb = tierBadge(r.tier);
    const pendingReqs = (d.withdrawals || []).filter(w => w.status === 'pending');
    const clearedMonths = (d.months || []).filter(m => m.cleared > 0).map(m => m.label);
    const warn = (pendingReqs.length && clearedMonths.length)
      ? `<div class="alert alert-warning py-2 small mb-3"><b>⚠️ Double-pay check:</b> ${pendingReqs.length} pending request(s) AND already-cleared month(s): <b>${esc(clearedMonths.join(', '))}</b>. Verify these are new earnings before approving.</div>`
      : '';

    const stat = (label, val, cls) => `<div class="col-6 col-md-3"><div class="border rounded p-2 text-center h-100"><div class="text-muted" style="font-size:11px;">${label}</div><div class="fw-bold ${cls||''}" style="font-size:16px;">${val}</div></div></div>`;

    const monthRows = (d.months || []).length
      ? d.months.map(m => {
          const status = m.done ? '<span class="badge bg-secondary">Cleared</span>'
            : (m.cleared > 0 ? '<span class="badge bg-warning text-dark">Partly</span>' : '<span class="badge bg-success">Active</span>');
          return `<tr><td>${esc(m.label)}</td><td class="text-end">${inr(m.earned)}</td><td class="text-end text-muted">${inr(m.cleared)}</td><td class="text-end fw-bold">${inr(m.remaining)}</td><td class="text-end">${status}</td></tr>`;
        }).join('')
      : '<tr><td colspan="5" class="text-center text-muted py-2">No month-wise earnings.</td></tr>';

    const wRows = (d.withdrawals || []).length
      ? d.withdrawals.map(w => `<tr>
          <td>${dt(w.createdAt)}</td>
          <td class="fw-bold">${inr(w.amount)}</td>
          <td>${statusBadge(w.status)}</td>
          <td style="font-size:11.5px;max-width:180px;white-space:pre-wrap;">${esc(w.paymentDetails)}</td>
          <td style="font-size:11.5px;">${[w.utr?('UTR: '+esc(w.utr)):'', esc(w.remarks)].filter(Boolean).join('<br>')||'-'}</td>
        </tr>`).join('')
      : '<tr><td colspan="5" class="text-center text-muted py-2">No withdrawal requests.</td></tr>';

    return `
      ${warn}
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
          <div class="fw-bold" style="font-size:18px;">${esc(r.name || '-')} ${tb}</div>
          <div class="text-muted small">${esc(r.mobileNumber || '-')} ${r.email ? '· ' + esc(r.email) : ''}</div>
          <div class="text-muted small">${esc([r.district, r.state].filter(Boolean).join(', ') || '-')} · Joined ${dateOnly(r.joinedAt)}${r.salaryBased ? ' · <span class="text-info fw-bold">Salary-based</span>' : ''}</div>
        </div>
      </div>
      <div class="row g-2 mb-3">
        ${stat('Wallet Now', inr(r.walletBalance), 'text-success')}
        ${stat('Total Earned', inr(s.totalEarned), '')}
        ${stat('Total Cleared', inr(s.totalCleared), 'text-warning')}
        ${stat('Paid (approved)', inr(s.withdrawnPaid), 'text-primary')}
      </div>
      <h6 class="fw-bold small text-muted mb-2">MONTH-WISE EARNINGS</h6>
      <div class="table-responsive mb-3"><table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light"><tr><th>Month</th><th class="text-end">Earned</th><th class="text-end">Cleared</th><th class="text-end">Remaining</th><th class="text-end">Status</th></tr></thead>
        <tbody>${monthRows}</tbody></table></div>
      <h6 class="fw-bold small text-muted mb-2">WITHDRAWAL HISTORY</h6>
      <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Date</th><th>Amount</th><th>Status</th><th>Payment</th><th>UTR / Remarks</th></tr></thead>
        <tbody>${wRows}</tbody></table></div>`;
  }

  // ---- Accounts Department PDF (up to 500 records, A4 landscape, multi-page) ----
  const dateOnly = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : '-';
  const statusLabel = { pending:'PENDING', approved:'PAID', rejected:'REJECTED' };

  async function downloadWithdrawalsPdf() {
    const btn = document.getElementById('downloadPdfBtn');
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Preparing...';
    try {
      // Fetch up to 500 for the current status filter.
      const res = await fetch(`/admin/api/wallet/withdrawals?status=${currentStatus}&limit=500`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to load withdrawals');
      // Apply EXACTLY the on-screen filters + selected Sort order (never raw DB order),
      // over the up-to-500 fetch so no record beyond the screen's default page is lost.
      const list = applyFiltersAndSort(data.withdrawals || []);
      if (!list.length) { alert('No withdrawal records to export for this filter.'); return; }
      const sortLabels = { new: 'Newest first', old: 'Oldest first', amt_hi: 'Amount high→low', amt_lo: 'Amount low→high' };
      const orderText = sortLabels[document.getElementById('fSort').value] || 'Newest first';
      const activeFilters = [
        document.getElementById('fSearch').value.trim() ? 'Search: ' + document.getElementById('fSearch').value.trim() : '',
        document.getElementById('fState').value ? 'State: ' + document.getElementById('fState').value : '',
        document.getElementById('fIncharge').value ? 'In-Charge: ' + document.getElementById('fIncharge').value : '',
        document.getElementById('fType').value ? 'Type: ' + document.getElementById('fType').options[document.getElementById('fType').selectedIndex].text : '',
        document.getElementById('fPay').value ? 'Payout: ' + document.getElementById('fPay').value.toUpperCase() : ''
      ].filter(Boolean).join(' · ');

      // Today's totals (requests created today) — "eroju entha amount vachindi".
      const startOfToday = new Date(); startOfToday.setHours(0,0,0,0);
      let todayCount = 0, todayAmount = 0, totalAmount = 0;
      list.forEach(w => {
        totalAmount += Number(w.amount) || 0;
        if (w.createdAt && new Date(w.createdAt) >= startOfToday) { todayCount++; todayAmount += Number(w.amount) || 0; }
      });

      const statusText = currentStatus === 'all' ? 'All' : (statusLabel[currentStatus] || currentStatus);
      const genOn = new Date().toLocaleString('en-IN', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });

      const brand = `
        <div style="display:flex;align-items:center;border-bottom:3px solid #E31E24;padding-bottom:10px;margin-bottom:12px;">
          <img src="/images/logo.png" alt="Tehelka News" style="max-height:52px;width:auto;margin-right:16px;">
          <div style="flex:1;">
            <h1 style="margin:0;color:#E31E24;font-size:20px;font-weight:bold;text-transform:uppercase;letter-spacing:.5px;">Withdrawal Payout Report</h1>
            <p style="margin:2px 0 0;font-size:12px;color:#555;font-weight:600;">Tehelka News · Accounts Department</p>
          </div>
          <div style="text-align:right;font-size:11px;color:#444;">
            <div><strong>Status:</strong> ${esc(statusText)}</div>
            <div><strong>Order:</strong> ${esc(orderText)}${activeFilters ? ' · <strong>Filters:</strong> ' + esc(activeFilters) : ''}</div>
            <div><strong>Generated:</strong> ${esc(genOn)}</div>
          </div>
        </div>`;

      const summary = `
        <div style="display:flex;gap:10px;margin-bottom:12px;font-size:11.5px;">
          <div style="flex:1;border:1px solid #e5e5e2;border-radius:6px;padding:8px 10px;"><div style="color:#777;">Total Requests</div><div style="font-weight:bold;font-size:15px;">${list.length}</div></div>
          <div style="flex:1;border:1px solid #e5e5e2;border-radius:6px;padding:8px 10px;"><div style="color:#777;">Total Amount</div><div style="font-weight:bold;font-size:15px;color:#198754;">${inr(totalAmount)}</div></div>
          <div style="flex:1;border:1px solid #e5e5e2;border-radius:6px;padding:8px 10px;"><div style="color:#777;">Today's Requests</div><div style="font-weight:bold;font-size:15px;">${todayCount}</div></div>
          <div style="flex:1;border:1px solid #e5e5e2;border-radius:6px;padding:8px 10px;"><div style="color:#777;">Today's Amount</div><div style="font-weight:bold;font-size:15px;color:#0d6efd;">${inr(todayAmount)}</div></div>
        </div>`;

      const colgroup = `<colgroup>
        <col style="width:4%"><col style="width:16%"><col style="width:11%"><col style="width:10%">
        <col style="width:23%"><col style="width:9%"><col style="width:8%"><col style="width:19%">
      </colgroup>`;
      const thead = `<thead style="display:table-header-group;">
        <tr style="background:#f1f3f5;">
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:center;font-weight:bold;">#</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:left;font-weight:bold;">Reporter / Mobile</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:left;font-weight:bold;">Joined On</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:right;font-weight:bold;">Amount</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:left;font-weight:bold;">Payment Details</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:left;font-weight:bold;">Type</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:center;font-weight:bold;">Status</th>
          <th style="padding:6px 7px;border:1px solid #dee2e6;text-align:left;font-weight:bold;">Requested / UTR</th>
        </tr>
      </thead>`;

      const rowHtml = (w, i) => {
        const r = w.reporter || {};
        const utr = [w.utr ? 'UTR: ' + esc(w.utr) : '', w.remarks ? esc(w.remarks) : ''].filter(Boolean).join(' · ') || '-';
        return `<tr style="background:${i % 2 === 0 ? '#ffffff' : '#f9fafb'};">
          <td style="padding:5px 7px;border:1px solid #dee2e6;text-align:center;">${i + 1}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;"><div style="font-weight:600;">${esc(r.name || 'Unknown')}</div><div style="color:#777;">${esc(r.mobileNumber || '')}</div></td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;white-space:nowrap;">${dateOnly(r.joinedAt)}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;text-align:right;font-weight:bold;color:#198754;white-space:nowrap;">${inr(w.amount)}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;font-size:10.5px;word-break:break-word;">${esc(w.paymentDetails)}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;text-transform:uppercase;">${esc(w.payoutType || '-')}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;text-align:center;font-weight:bold;">${esc(statusLabel[w.status] || w.status)}</td>
          <td style="padding:5px 7px;border:1px solid #dee2e6;font-size:10.5px;"><div>${dt(w.createdAt)}</div><div style="color:#777;">${utr}</div></td>
        </tr>`;
      };

      // ONE continuous document (no hand-made page chunks, no forced page breaks).
      // Rows are marked break-inside:avoid so a row that doesn't fit moves whole to
      // the next page; html2pdf 'css' mode honours that and 'legacy' fills the rest.
      // Page numbers / footer are stamped per real page by jsPDF after rendering.
      // ── State-wise grouping: State In-Charge is the primary heading; each reporter
      // sits under THEIR in-charge. A state with two in-charges yields two blocks.
      // Reporters with no resolved in-charge / no state fall into a clear last block.
      const groupsMap = new Map();
      list.forEach((w) => {
        const r = w.reporter || {};
        const state = (r.state || '').trim();
        const inc = (r.stateIncharge || '').trim();
        const key = (state || '~') + '||' + (inc || '~');
        if (!groupsMap.has(key)) groupsMap.set(key, { state, incharge: inc, incRole: (r.stateInchargeRole || '').trim(), items: [], amount: 0 });
        const g = groupsMap.get(key);
        g.items.push(w);
        g.amount += Number(w.amount) || 0;
      });
      const groups = Array.from(groupsMap.values()).sort((a, b) => {
        // Real states first (alpha), then "No State"; within a state, in-charge alpha,
        // an unassigned in-charge last.
        const as = a.state || '\uffff', bs = b.state || '\uffff';
        if (as !== bs) return as.localeCompare(bs);
        const ai = a.incharge || '\uffff', bi = b.incharge || '\uffff';
        return ai.localeCompare(bi);
      });

      const groupHead = (g) => {
        const stateTxt = g.state ? esc(g.state.toUpperCase()) : 'NO STATE ASSIGNED';
        const incTxt = g.incharge
          ? ('State In-Charge: ' + esc(g.incharge) + (g.incRole && g.incRole !== 'State In-Charge' ? ' (' + esc(g.incRole) + ')' : ''))
          : 'No In-Charge assigned';
        return `<tr style="background:#E31E24;color:#fff;break-inside:avoid;break-after:avoid;page-break-after:avoid;">
          <td colspan="8" style="padding:7px 9px;border:1px solid #E31E24;">
            <span style="font-size:12.5px;font-weight:bold;letter-spacing:.4px;">${stateTxt}</span>
            <span style="opacity:.9;">&nbsp;·&nbsp;${incTxt}</span>
            <span style="float:right;font-weight:bold;">${g.items.length} request(s) · ${inr(g.amount)}</span>
          </td>
        </tr>`;
      };

      const rows = groups.map((g) =>
        groupHead(g) + g.items.map((w, i) => rowHtml(w, i)).join('')
      ).join('');

      const reportHtml = `
        <style>
          #withdrawalReportPages tr { page-break-inside: avoid; break-inside: avoid; }
          #withdrawalReportPages table { page-break-inside: auto; break-inside: auto; }
        </style>
        <div style="padding:0 2px;">
          ${brand}
          ${summary}
          <table style="width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed;">
            ${colgroup}${thead}<tbody>${rows}</tbody>
          </table>
          <div style="margin-top:8px;font-size:10px;color:#777;">End of report · ${list.length} record(s) · ${groups.length} state/in-charge group(s)</div>
        </div>`;

      document.getElementById('withdrawalReportPages').innerHTML = reportHtml;

      const element = document.getElementById('withdrawalReportContainer').cloneNode(true);
      element.style.display = 'block';
      const holder = document.createElement('div');
      holder.style.position = 'absolute';
      holder.style.left = '-9999px';
      holder.style.top = '0';
      // Fixed printable width (A4 landscape 11.69in minus 0.6in side margins) so the
      // layout is identical regardless of the admin's window size.
      holder.style.width = '1064px';
      holder.appendChild(element);
      document.body.appendChild(holder);

      // Very large exports produce one very tall canvas; keep it under browser
      // canvas limits (which otherwise yield blank pages) by lowering scale a little.
      const scale = list.length > 250 ? 1.5 : 2;
      const MARGIN_TOP = 0.45, MARGIN_BOTTOM = 0.5, MARGIN_SIDE = 0.3;
      const filename = `Withdrawals_${statusText}_${new Date().toISOString().slice(0,10)}.pdf`;
      try {
        await html2pdf().set({
          margin: [MARGIN_TOP, MARGIN_SIDE, MARGIN_BOTTOM, MARGIN_SIDE],
          filename,
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale, useCORS: true, scrollX: 0, scrollY: 0 },
          jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' },
          pagebreak: { mode: ['css', 'legacy'] }
        }).from(element).toPdf().get('pdf').then((pdf) => {
          const total = pdf.internal.getNumberOfPages();
          const pw = pdf.internal.pageSize.getWidth();
          const ph = pdf.internal.pageSize.getHeight();
          for (let p = 1; p <= total; p++) {
            pdf.setPage(p);
            pdf.setFontSize(8);
            pdf.setTextColor(140);
            if (p > 1) {
              pdf.text(`Withdrawal Payout Report · ${statusText} · continued`, MARGIN_SIDE, 0.3);
            }
            pdf.text('Confidential · For Accounts Department use only', MARGIN_SIDE, ph - 0.25);
            pdf.text(`Page ${p} of ${total}`, pw - MARGIN_SIDE, ph - 0.25, { align: 'right' });
          }
        }).save();
      } finally {
        document.body.removeChild(holder);
      }
    } catch (err) {
      alert('Error generating PDF: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  }

  document.getElementById('downloadPdfBtn').addEventListener('click', downloadWithdrawalsPdf);
  load();
});
</script>

<!-- Hidden A4 (landscape) report for the Accounts Department. Pages built by JS. -->
<div id="withdrawalReportContainer" style="display:none;">
  <div id="withdrawalReportPages" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#222;background:#fff;"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

