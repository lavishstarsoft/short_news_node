<%- include('partials/header') %>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                <div>
                    <h1 class="h2"><i class="fas fa-shield-alt text-primary me-2"></i>Security & Fraud Control</h1>
                    <p class="text-muted">Monitor suspicious activities and manage blocked devices/IPs.</p>
                </div>
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#blockModal">
                    <i class="fas fa-ban me-2"></i>Block IP/Device
                </button>
            </div>

            <ul class="nav nav-tabs mb-4" id="securityTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="devices-tab" data-bs-toggle="tab" data-bs-target="#devices" type="button" role="tab">Suspicious Devices</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="ips-tab" data-bs-toggle="tab" data-bs-target="#ips" type="button" role="tab">Suspicious IPs</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="blocklist-tab" data-bs-toggle="tab" data-bs-target="#blocklist" type="button" role="tab">Blocklist</button>
                </li>
            </ul>

            <div class="tab-content" id="securityTabsContent">
                <!-- Suspicious Devices Tab -->
                <div class="tab-pane fade show active" id="devices" role="tabpanel">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0">Multiple Claims from Same Device</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Device Fingerprint</th>
                                            <th>Total Claims</th>
                                            <th>Latest Activity</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (deviceAggregations && deviceAggregations.length > 0) { %>
                                            <% deviceAggregations.forEach(device => { %>
                                                <tr>
                                                    <td><span class="badge bg-secondary"><%= device._id %></span></td>
                                                    <td><span class="badge bg-warning text-dark"><%= device.claimCount %></span></td>
                                                    <td><%= new Date(device.latestClaim).toLocaleString() %></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger block-btn" data-id="<%= device._id %>" data-type="device">Block</button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="4" class="text-center py-4">No suspicious devices found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Suspicious IPs Tab -->
                <div class="tab-pane fade" id="ips" role="tabpanel">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0">Multiple Clicks from Same IP</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>IP Address</th>
                                            <th>Total Clicks</th>
                                            <th>Latest Activity</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (ipAggregations && ipAggregations.length > 0) { %>
                                            <% ipAggregations.forEach(ip => { %>
                                                <tr>
                                                    <td><span class="badge bg-info text-dark"><%= ip._id %></span></td>
                                                    <td><span class="badge bg-warning text-dark"><%= ip.clickCount %></span></td>
                                                    <td><%= new Date(ip.latestClick).toLocaleString() %></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger block-btn" data-id="<%= ip._id %>" data-type="ip">Block</button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="4" class="text-center py-4">No suspicious IPs found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Blocklist Tab -->
                <div class="tab-pane fade" id="blocklist" role="tabpanel">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0">Active Blocks</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Identifier</th>
                                            <th>Type</th>
                                            <th>Reason</th>
                                            <th>Blocked At</th>
                                            <th>Blocked By</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (blocklist && blocklist.length > 0) { %>
                                            <% blocklist.forEach(block => { %>
                                                <tr>
                                                    <td><strong><%= block.identifier %></strong></td>
                                                    <td>
                                                        <% if (block.type === 'ip') { %>
                                                            <span class="badge bg-info text-dark">IP</span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary">Device</span>
                                                        <% } %>
                                                    </td>
                                                    <td><%= block.reason %></td>
                                                    <td><%= new Date(block.blockedAt).toLocaleDateString() %></td>
                                                    <td><%= block.blockedBy ? block.blockedBy.username : 'System' %></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-success unblock-btn" data-id="<%= block._id %>">Unblock</button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="6" class="text-center py-4">No blocked entities found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Block Modal -->
<div class="modal fade" id="blockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Block IP / Device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="blockForm">
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" id="blockType" required>
                            <option value="ip">IP Address</option>
                            <option value="device">Device Fingerprint</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Identifier (IP or Fingerprint)</label>
                        <input type="text" class="form-control" id="blockIdentifier" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" id="blockReason" rows="2" placeholder="Suspicious behavior..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="submitBlock">Block</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Block from modal
    document.getElementById('submitBlock').addEventListener('click', async () => {
        const type = document.getElementById('blockType').value;
        const identifier = document.getElementById('blockIdentifier').value;
        const reason = document.getElementById('blockReason').value;

        if (!identifier) return alert('Please enter an identifier');

        try {
            const res = await fetch('/admin/security/block', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type, identifier, reason })
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Error blocking');
            }
        } catch (err) {
            console.error(err);
            alert('Server error');
        }
    });

    // Quick block from table
    document.querySelectorAll('.block-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const identifier = btn.getAttribute('data-id');
            const type = btn.getAttribute('data-type');
            document.getElementById('blockType').value = type;
            document.getElementById('blockIdentifier').value = identifier;
            new bootstrap.Modal(document.getElementById('blockModal')).show();
        });
    });

    // Unblock
    document.querySelectorAll('.unblock-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Are you sure you want to unblock this?')) return;
            const id = btn.getAttribute('data-id');
            try {
                const res = await fetch(`/admin/security/block/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error unblocking');
                }
            } catch (err) {
                alert('Server error');
            }
        });
    });
});
</script>

<%- include('partials/footer') %>
