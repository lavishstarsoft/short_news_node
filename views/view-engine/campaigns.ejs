<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content bg-light p-3 p-md-4">
    <div class="container-fluid p-0">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-layer-group me-2 text-primary"></i>Campaign Management</h3>
                <p class="text-muted mb-0">Monitor and control view distribution campaigns</p>
            </div>
            <div>
                <button class="btn btn-primary fw-bold px-4" data-bs-toggle="modal" data-bs-target="#newCampaignModal">
                    <i class="fas fa-plus me-2"></i>New Campaign
                </button>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search campaigns...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select">
                            <option value="">All Statuses</option>
                            <option value="active">Active</option>
                            <option value="paused">Paused</option>
                            <option value="completed">Completed</option>
                            <option value="draft">Draft</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select">
                            <option value="">All Strategies</option>
                            <option value="static">Static</option>
                            <option value="adaptive">Adaptive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100"><i class="fas fa-filter me-2"></i>Filter</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Grid -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Campaign Name</th>
                                <th>Status</th>
                                <th>Views Range</th>
                                <th>Duration</th>
                                <th>Progress</th>
                                <th>Strategy</th>
                                <th>Created / Started</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campaignsTableBody">
                            <% if (data.campaigns && data.campaigns.length > 0) { %>
                                <% data.campaigns.forEach(c => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark"><%= c.name || '(unnamed)' %></div>
                                            <div class="small text-muted font-monospace"><%= String(c._id).substring(18) %></div>
                                        </td>
                                        <td>
                                            <% 
                                            let badgeClass = 'bg-secondary';
                                            if (c.status === 'active') badgeClass = 'bg-success';
                                            if (c.status === 'paused') badgeClass = 'bg-warning text-dark';
                                            if (c.status === 'completed') badgeClass = 'bg-primary';
                                            if (c.status === 'cancelled' || c.status === 'reversed') badgeClass = 'bg-danger';
                                            %>
                                            <span class="badge <%= badgeClass %> rounded-pill px-3 py-2 text-uppercase"><%= c.status %></span>
                                        </td>
                                        <td><span class="fw-bold"><%= c.minViews %></span> - <span class="fw-bold"><%= c.maxViews %></span></td>
                                        <td><%= c.durationType === 'unlimited' ? 'Unlimited' : c.durationMinutes + ' Mins' %></td>
                                        <td>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: <%= c.progress %>%;"></div>
                                            </div>
                                            <div class="small text-muted mt-1"><%= c.progress %>%</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= c.strategy %></span></td>
                                        <td>
                                            <div class="small text-muted"><%= new Date(c.createdAt).toLocaleDateString() %></div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm">
                                                <% if (c.status === 'draft') { %>
                                                    <button class="btn btn-outline-success" onclick="actionCampaign('<%= c._id %>', 'activate')" title="Start"><i class="fas fa-play"></i></button>
                                                <% } %>
                                                <% if (c.status === 'active') { %>
                                                    <button class="btn btn-outline-warning" onclick="actionCampaign('<%= c._id %>', 'pause')" title="Pause"><i class="fas fa-pause"></i></button>
                                                <% } %>
                                                <% if (c.status === 'paused') { %>
                                                    <button class="btn btn-outline-success" onclick="actionCampaign('<%= c._id %>', 'activate')" title="Resume"><i class="fas fa-play"></i></button>
                                                <% } %>
                                                
                                                <button class="btn btn-outline-info" onclick="duplicateCampaign('<%= c._id %>')" title="Duplicate"><i class="fas fa-copy"></i></button>
                                                <button class="btn btn-outline-primary" onclick="restartCampaign('<%= c._id %>')" title="Restart"><i class="fas fa-redo"></i></button>
                                                <button class="btn btn-outline-danger" onclick="deleteCampaign('<%= c._id %>')" title="Delete"><i class="fas fa-trash"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="fas fa-box-open fs-1 text-muted mb-3 opacity-50"></i>
                                        <h5 class="text-muted">No campaigns found</h5>
                                        <p class="text-muted mb-0">Click 'New Campaign' to get started.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination (UI Mock) -->
                <div class="d-flex justify-content-between align-items-center p-3 border-top bg-white">
                    <div class="text-muted small">Showing all records</div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item disabled"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Simple API JS to power the buttons (Matches original implementations) -->
<script>
async function actionCampaign(id, action) {
    if (!confirm(`Are you sure you want to ${action} this campaign?`)) return;
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}/${action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.error || 'Action failed');
    } catch(e) { alert('Network error'); }
}

async function duplicateCampaign(id) {
    if (!confirm("Duplicate this campaign?")) return;
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}/duplicate`, { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.error || 'Failed');
    } catch(e) { alert('Network error'); }
}

async function restartCampaign(id) {
    if (!confirm("Create a fresh active copy of this campaign?")) return;
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}/restart`, { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.error || 'Failed');
    } catch(e) { alert('Network error'); }
}

async function deleteCampaign(id) {
    if (!confirm("Permanently delete this campaign?")) return;
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.error || 'Failed');
    } catch(e) { alert('Network error'); }
}
</script>

<%- include('../partials/footer') %>

<!-- New Campaign Modal -->
<div class="modal fade" id="newCampaignModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="newCampaignForm" onsubmit="createCampaign(event)">
                <div class="modal-header bg-light">
                    <h5 class="modal-title"><i class="fas fa-plus-circle me-2 text-primary"></i>Create New Campaign</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Campaign Name</label>
                            <input type="text" class="form-control" name="name" required placeholder="e.g. Breaking News Boost">
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Min Views (Per News)</label>
                            <input type="number" class="form-control" name="minViews" required min="1" placeholder="e.g. 1000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Max Views (Per News)</label>
                            <input type="number" class="form-control" name="maxViews" required min="1" placeholder="e.g. 3000">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Engine Mode</label>
                            <select class="form-select" id="campaignMode" name="mode" onchange="toggleMode(this.value)">
                                <option value="production">Production (adaptive curve)</option>
                                <option value="per_news_window">Per-News Window (frozen random target)</option>
                            </select>
                            <div class="form-text">Per-News Window: each news fills a random target (Min–Max) over its own interval, minute-by-minute, then stops permanently.</div>
                        </div>

                        <!-- Production mode -->
                        <div class="col-md-6 prod-only">
                            <label class="form-label fw-bold">Duration Type</label>
                            <select class="form-select" name="durationType" onchange="toggleDuration(this.value)">
                                <option value="finite">Finite (Fixed Time)</option>
                                <option value="unlimited">Unlimited (24x7)</option>
                            </select>
                        </div>
                        <div class="col-md-6 prod-only" id="durationMinutesContainer">
                            <label class="form-label fw-bold">Duration (Minutes)</label>
                            <input type="number" class="form-control" name="durationMinutes" id="durationMinutes" min="1" value="60">
                        </div>

                        <!-- Per-News Window mode -->
                        <div class="col-md-6 window-only d-none">
                            <label class="form-label fw-bold">Interval / Window (Minutes)</label>
                            <input type="number" class="form-control" id="intervalMinutes" name="intervalMinutes" min="1" max="1440" value="30">
                            <div class="form-text">Each news grows for this many minutes, then stops (e.g. 5, 30, 60, 120, 240).</div>
                        </div>
                        <div class="col-md-6 window-only d-none">
                            <label class="form-label fw-bold">Run For (Days)</label>
                            <input type="number" class="form-control" id="maxDays" name="maxDays" min="1" max="365" value="30">
                            <div class="form-text">How long the engine keeps onboarding new news (1–365).</div>
                        </div>

                        <div class="col-12">
                            <hr class="text-muted">
                            <h6 class="fw-bold mb-3"><i class="fas fa-shield-alt text-success me-2"></i>Safeguards & Protections</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Budget Protection (Max Item Share %)</label>
                            <div class="input-group">
                                <input type="number" class="form-control" name="maxItemSharePct" value="100" min="1" max="100" required>
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="form-text">Max % of views one news can get.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Diversity (Max Category Share %)</label>
                            <div class="input-group">
                                <input type="number" class="form-control" name="maxBucketSharePct" value="100" min="1" max="100" required>
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="form-text">Max % of views one category can get.</div>
                        </div>
                        
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create Campaign</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function toggleDuration(val) {
    const input = document.getElementById('durationMinutes');
    if (val === 'unlimited') {
        input.value = 1;
        input.parentElement.style.display = 'none';
    } else {
        input.parentElement.style.display = 'block';
    }
}

function toggleMode(mode) {
    const prod = document.querySelectorAll('.prod-only');
    const win = document.querySelectorAll('.window-only');
    if (mode === 'per_news_window') {
        prod.forEach(el => el.classList.add('d-none'));
        win.forEach(el => el.classList.remove('d-none'));
    } else {
        prod.forEach(el => el.classList.remove('d-none'));
        win.forEach(el => el.classList.add('d-none'));
    }
}

async function createCampaign(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    
    // Formatting data to match model structure
    const mode = data.mode || 'production';
    const payload = {
        name: data.name,
        minViews: Number(data.minViews),
        maxViews: Number(data.maxViews),
        mode: mode,
        strategy: 'adaptive',
        intensity: 'balanced',
        budgetProtection: { maxItemSharePct: Number(data.maxItemSharePct) },
        diversity: { maxBucketSharePct: Number(data.maxBucketSharePct), enabled: true }
    };
    if (mode === 'per_news_window') {
        payload.intervalMinutes = Number(data.intervalMinutes);
        payload.maxDays = Number(data.maxDays);
    } else {
        payload.durationType = data.durationType;
        payload.durationMinutes = Number(data.durationMinutes);
    }

    try {
        const res = await fetch('/admin/view-engine/campaigns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
            location.reload();
        } else {
            alert(result.error || 'Failed to create campaign');
        }
    } catch (err) {
        alert('Network error');
    }
}
</script>
