<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <div class="container-fluid py-4">
        
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h1 class="h2 mb-1"><i class="fas fa-bullhorn text-primary me-2"></i> Active Campaigns</h1>
                <p class="text-muted mb-0">Manage view distribution campaigns.</p>
            </div>
            <button class="btn btn-primary fw-bold shadow-sm" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i> New Campaign
            </button>
        </div>

        <!-- Filters & Search -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body bg-light">
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" id="searchName" class="form-control form-control-sm" placeholder="Search by name..." onkeyup="applyFilters()">
                    </div>
                    <div class="col-md-2">
                        <select id="filterStatus" class="form-select form-select-sm" onchange="applyFilters()">
                            <option value="">All Statuses</option>
                            <option value="draft">Draft</option>
                            <option value="active">Active</option>
                            <option value="paused">Paused</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                            <option value="reversed">Reversed</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="filterStrategy" class="form-select form-select-sm" onchange="applyFilters()">
                            <option value="">All Strategies</option>
                            <option value="static">Static</option>
                            <option value="adaptive">Adaptive</option>
                            <option value="ml">ML</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="date" id="filterDate" class="form-control form-control-sm" onchange="applyFilters()">
                    </div>
                    <div class="col-md-2 text-end">
                        <button class="btn btn-outline-secondary btn-sm" onclick="fetchCampaigns()">
                            <i class="fas fa-sync-alt"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive" style="min-height: 300px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th onclick="sortData('name')" style="cursor:pointer">Campaign Name <i class="fas fa-sort text-muted ms-1"></i></th>
                                <th onclick="sortData('status')" style="cursor:pointer">Status <i class="fas fa-sort text-muted ms-1"></i></th>
                                <th>Views Range</th>
                                <th onclick="sortData('durationMinutes')" style="cursor:pointer">Duration <i class="fas fa-sort text-muted ms-1"></i></th>
                                <th>Strategy</th>
                                <th>Created By</th>
                                <th onclick="sortData('createdAt')" style="cursor:pointer">Created At <i class="fas fa-sort text-muted ms-1"></i></th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campaignsTableBody">
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div> Loading campaigns...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light rounded-bottom">
                    <div class="text-muted small fw-bold" id="paginationInfo">Showing 0 of 0</div>
                    <ul class="pagination pagination-sm mb-0" id="paginationControls">
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Campaign Modal (Create/Edit) -->
<div class="modal fade" id="campaignModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white border-bottom-0">
        <h5 class="modal-title fw-bold" id="campaignModalTitle"><i class="fas fa-plus-circle me-2"></i> Create New Campaign</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 bg-light">
        <form id="campaignForm">
            <input type="hidden" id="editCampaignId">
            <input type="hidden" id="isDuplicateMode" value="false">
            
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Campaign Name</label>
                <input type="text" id="campaignName" class="form-control form-control-lg border-0 shadow-sm" placeholder="e.g. Summer Boost 2026" required>
            </div>
            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold text-secondary">Minimum Final Views</label>
                    <input type="number" id="minFinalViews" class="form-control form-control-lg border-0 shadow-sm" placeholder="e.g. 1" required min="1">
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold text-secondary">Maximum Final Views</label>
                    <input type="number" id="maxFinalViews" class="form-control form-control-lg border-0 shadow-sm" placeholder="e.g. 50" required min="1">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Duration (Minutes)</label>
                <select id="durationMinutes" class="form-select form-select-lg border-0 shadow-sm" onchange="toggleUnlimitedHint()" required>
                    <option value="" disabled selected>Select campaign duration...</option>
                    <option value="30">30 Minutes</option>
                    <option value="60">1 Hour</option>
                    <option value="120">2 Hours</option>
                    <option value="360">6 Hours</option>
                    <option value="720">12 Hours</option>
                    <option value="1440">24 Hours</option>
                    <option value="4320">3 Days</option>
                    <option value="10080">7 Days</option>
                    <option value="21600">15 Days</option>
                    <option value="43200">30 Days</option>
                    <option value="unlimited">Unlimited (24×7)</option>
                </select>
                <small id="unlimitedHint" class="text-warning fw-bold d-none">
                    <i class="fas fa-infinity me-1"></i> Running Until Manually Stopped — no end time.
                </small>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Strategy</label>
                <select id="strategy" class="form-select form-select-lg border-0 shadow-sm" required>
                    <option value="" disabled selected>Select strategy...</option>
                    <option value="static">Static</option>
                    <option value="adaptive">Adaptive</option>
                    <option value="ml">ML</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Speed Profile</label>
                <select id="intensity" class="form-select form-select-lg border-0 shadow-sm" required>
                    <option value="balanced" selected>Balanced</option>
                    <option value="aggressive">Aggressive</option>
                    <option value="conservative">Conservative</option>
                </select>
            </div>
        </form>
      </div>
      <div class="modal-footer bg-white border-top-0 justify-content-between px-4 pb-4 pt-3">
        <button type="button" class="btn btn-light fw-bold px-4 shadow-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary fw-bold px-5 shadow-sm" id="btnSaveCampaign" onclick="saveCampaign()">Create Campaign</button>
      </div>
    </div>
  </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white border-bottom-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-chart-bar me-2"></i> Campaign Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 bg-light" id="detailsModalBody">
        Loading...
      </div>
      <div class="modal-footer bg-white border-top-0">
        <button type="button" class="btn btn-secondary fw-bold px-4 shadow-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
// --- State ---
let allCampaigns = [];
let filteredCampaigns = [];
let currentPage = 1;
const pageSize = 10;
let sortCol = 'createdAt';
let sortDesc = true;

// --- Init ---
document.addEventListener('DOMContentLoaded', fetchCampaigns);

async function fetchCampaigns() {
    try {
        const response = await fetch('/admin/view-engine/campaigns');
        const data = await response.json();
        
        if (response.ok && data.success) {
            allCampaigns = data.campaigns || [];
            
            // Populate fallback name for backwards compatibility with old drafts
            allCampaigns.forEach(c => {
                if(!c.name) c.name = 'Campaign ' + c._id.slice(-6).toUpperCase();
            });
            
            applyFilters();
        } else {
            showToast('error', 'Failed to load campaigns.');
        }
    } catch (err) {
        console.error(err);
        showToast('error', 'Error loading campaigns.');
    }
}

// --- Data Table Logic ---
function applyFilters() {
    const search = document.getElementById('searchName').value.toLowerCase();
    const status = document.getElementById('filterStatus').value;
    const strategy = document.getElementById('filterStrategy').value;
    const date = document.getElementById('filterDate').value;

    filteredCampaigns = allCampaigns.filter(c => {
        if (search && !c.name.toLowerCase().includes(search)) return false;
        if (status && c.status !== status) return false;
        if (strategy && c.strategy !== strategy) return false;
        if (date) {
            const cDate = new Date(c.createdAt).toISOString().split('T')[0];
            if (cDate !== date) return false;
        }
        return true;
    });

    // Sort
    filteredCampaigns.sort((a, b) => {
        let valA = a[sortCol];
        let valB = b[sortCol];
        if (sortCol === 'createdAt') {
            valA = new Date(valA).getTime();
            valB = new Date(valB).getTime();
        } else if (typeof valA === 'string') {
            valA = valA.toLowerCase();
            valB = valB.toLowerCase();
        }
        
        if (valA < valB) return sortDesc ? 1 : -1;
        if (valA > valB) return sortDesc ? -1 : 1;
        return 0;
    });

    currentPage = 1;
    renderTable();
}

function sortData(col) {
    if (sortCol === col) sortDesc = !sortDesc;
    else {
        sortCol = col;
        sortDesc = true;
    }
    applyFilters(); // re-sorts and renders
}

function renderTable() {
    const tbody = document.getElementById('campaignsTableBody');
    const start = (currentPage - 1) * pageSize;
    const end = start + pageSize;
    const pageData = filteredCampaigns.slice(start, end);

    if (pageData.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-inbox mb-2 fs-3 d-block"></i> No campaigns found.</td></tr>';
        document.getElementById('paginationInfo').innerText = 'Showing 0 of 0';
        document.getElementById('paginationControls').innerHTML = '';
        return;
    }

    tbody.innerHTML = pageData.map(c => `
        <tr>
            <td class="fw-bold">${c.name}</td>
            <td><span class="badge bg-${getStatusColor(c.status)}">${c.status.toUpperCase()}</span></td>
            <td>${c.minViews} - ${c.maxViews}</td>
            <td>${formatDuration(c)}</td>
            <td><span class="badge bg-light text-secondary border">${c.strategy || 'N/A'}</span></td>
            <td>${c.createdByName || 'System'}</td>
            <td class="text-muted small">${new Date(c.createdAt).toLocaleString()}</td>
            <td>
                <div class="btn-group btn-group-sm shadow-sm">
                    ${getActionButtons(c)}
                </div>
            </td>
        </tr>
    `).join('');

    document.getElementById('paginationInfo').innerText = `Showing ${start + 1} to ${Math.min(end, filteredCampaigns.length)} of ${filteredCampaigns.length}`;
    
    // Render pagination
    const totalPages = Math.ceil(filteredCampaigns.length / pageSize);
    let pagHtml = '';
    for (let i = 1; i <= totalPages; i++) {
        pagHtml += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="event.preventDefault(); currentPage=${i}; renderTable();">${i}</a></li>`;
    }
    document.getElementById('paginationControls').innerHTML = pagHtml;
}

// ── Duration display helpers (UI only) ──────────────────────────────────
const DURATION_LABELS = { 30:'30 Minutes', 60:'1 Hour', 120:'2 Hours', 360:'6 Hours', 720:'12 Hours', 1440:'24 Hours', 4320:'3 Days', 10080:'7 Days', 21600:'15 Days', 43200:'30 Days' };
function durationLabel(min) { return DURATION_LABELS[min] || (min + ' min'); }
function formatDuration(c) {
    if (c.durationType === 'unlimited') {
        return '<span class="badge bg-warning text-dark"><i class="fas fa-infinity me-1"></i>Unlimited (24×7)</span>';
    }
    return durationLabel(c.durationMinutes);
}
function toggleUnlimitedHint() {
    const sel = document.getElementById('durationMinutes');
    const hint = document.getElementById('unlimitedHint');
    if (sel && hint) hint.classList.toggle('d-none', sel.value !== 'unlimited');
}

function getActionButtons(c) {
    let html = '';
    
    // Edit: Draft, Paused
    if (['draft', 'paused'].includes(c.status)) {
        html += `<button class="btn btn-outline-secondary" onclick="openEditModal('${c._id}')" title="Edit"><i class="fas fa-edit"></i></button>`;
    }
    // Activate: Draft only
    if (c.status === 'draft') {
        html += `<button class="btn btn-outline-success" onclick="actionCampaign('${c._id}', 'activate')" title="Activate"><i class="fas fa-play"></i></button>`;
    }
    // Pause: Active only
    if (c.status === 'active') {
        html += `<button class="btn btn-outline-warning" onclick="actionCampaign('${c._id}', 'pause')" title="Pause"><i class="fas fa-pause"></i></button>`;
    }
    // Resume: Paused only
    if (c.status === 'paused') {
        html += `<button class="btn btn-outline-success" onclick="actionCampaign('${c._id}', 'activate')" title="Resume"><i class="fas fa-play"></i></button>`;
    }
    // Duplicate: Create Draft
    html += `<button class="btn btn-outline-info" onclick="duplicateCampaign('${c._id}')" title="Duplicate"><i class="fas fa-copy"></i></button>`;
    
    // Restart: Create Active copy
    html += `<button class="btn btn-outline-primary" onclick="restartCampaign('${c._id}')" title="Restart"><i class="fas fa-redo"></i></button>`;
    
    // View Details
    html += `<button class="btn btn-outline-dark" onclick="viewDetails('${c._id}')" title="View Details"><i class="fas fa-chart-bar"></i></button>`;
    
    // Delete: Draft, Completed, Cancelled
    if (['draft', 'completed', 'cancelled', 'reversed'].includes(c.status)) {
        html += `<button class="btn btn-outline-danger" onclick="deleteCampaign('${c._id}')" title="Delete"><i class="fas fa-trash"></i></button>`;
    }
    
    return html;
}

function getStatusColor(status) {
    switch (status) {
        case 'active': return 'success';
        case 'draft': return 'secondary';
        case 'paused': return 'warning text-dark';
        case 'cancelled': return 'danger';
        case 'completed': return 'primary';
        case 'reversed': return 'dark';
        default: return 'light text-dark';
    }
}

// --- Modals & CRUD ---
const getModalInstance = (id) => bootstrap.Modal.getInstance(document.getElementById(id)) || new bootstrap.Modal(document.getElementById(id));

function openCreateModal() {
    document.getElementById('campaignForm').reset();
    document.getElementById('editCampaignId').value = '';
    document.getElementById('isDuplicateMode').value = 'false';
    document.getElementById('campaignModalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i> Create New Campaign';
    document.getElementById('btnSaveCampaign').innerText = 'Create Campaign';
    getModalInstance('campaignModal').show();
}

function openEditModal(id) {
    const c = allCampaigns.find(x => x._id === id);
    if(!c) return;
    
    document.getElementById('editCampaignId').value = c._id;
    document.getElementById('isDuplicateMode').value = 'false';
    document.getElementById('campaignName').value = c.name;
    document.getElementById('minFinalViews').value = c.minViews;
    document.getElementById('maxFinalViews').value = c.maxViews;
    document.getElementById('durationMinutes').value = c.durationType === 'unlimited' ? 'unlimited' : c.durationMinutes;
    toggleUnlimitedHint();
    document.getElementById('strategy').value = c.strategy || '';
    document.getElementById('intensity').value = c.intensity || 'balanced';
    
    document.getElementById('campaignModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i> Edit Campaign';
    document.getElementById('btnSaveCampaign').innerText = 'Save Changes';
    getModalInstance('campaignModal').show();
}

function duplicateCampaign(id) {
    const c = allCampaigns.find(x => x._id === id);
    if(!c) return;
    
    document.getElementById('editCampaignId').value = '';
    document.getElementById('isDuplicateMode').value = 'true'; // Signals to NOT activate automatically
    document.getElementById('campaignName').value = c.name + ' (Copy)';
    document.getElementById('minFinalViews').value = c.minViews;
    document.getElementById('maxFinalViews').value = c.maxViews;
    document.getElementById('durationMinutes').value = c.durationType === 'unlimited' ? 'unlimited' : c.durationMinutes;
    toggleUnlimitedHint();
    document.getElementById('strategy').value = c.strategy || '';
    document.getElementById('intensity').value = c.intensity || 'balanced';
    
    document.getElementById('campaignModalTitle').innerHTML = '<i class="fas fa-copy me-2"></i> Duplicate Campaign';
    document.getElementById('btnSaveCampaign').innerText = 'Create Draft Copy';
    getModalInstance('campaignModal').show();
}

async function restartCampaign(id) {
    if(!confirm("Are you sure you want to restart this configuration as a NEW active campaign?")) return;
    
    const c = allCampaigns.find(x => x._id === id);
    if(!c) return;
    
    const payload = {
        name: c.name + ' (Restarted)',
        minViews: c.minViews,
        maxViews: c.maxViews,
        strategy: c.strategy,
        intensity: c.intensity
    };
    if (c.durationType === 'unlimited') payload.durationType = 'unlimited';
    else payload.durationMinutes = c.durationMinutes;
    
    try {
        const response = await fetch('/admin/view-engine/campaigns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        
        if (response.ok && data.success) {
            // Immediately activate the new restarted campaign
            await fetch('/admin/view-engine/campaigns/' + data.campaign._id + '/activate', { method: 'POST' });
            showToast('success', 'Campaign restarted successfully!');
            fetchCampaigns();
        } else {
            showToast('error', data.error || data.errors?.join(', '));
        }
    } catch (err) {
        showToast('error', 'Error restarting campaign.');
    }
}

async function saveCampaign() {
    const id = document.getElementById('editCampaignId').value;
    const isDuplicate = document.getElementById('isDuplicateMode').value === 'true';
    
    const name = document.getElementById('campaignName').value;
    const minStr = document.getElementById('minFinalViews').value;
    const maxStr = document.getElementById('maxFinalViews').value;
    const duration = document.getElementById('durationMinutes').value;
    const strategy = document.getElementById('strategy').value;
    const intensity = document.getElementById('intensity').value;
    
    if (!name || !minStr || !maxStr || !duration || !strategy) {
        showToast('error', 'Please fill in all required fields.');
        return;
    }

    const min = parseInt(minStr, 10);
    const max = parseInt(maxStr, 10);

    if (min < 1 || max < 1) {
        showToast('error', 'Views must be at least 1.');
        return;
    }
    if (max < min) {
        showToast('error', 'Maximum views cannot be less than minimum.');
        return;
    }
    
    const payload = {
        name: name,
        minViews: min,
        maxViews: max,
        strategy: strategy,
        intensity: intensity
    };
    // Unlimited => send durationType; finite => send durationMinutes (as today).
    if (duration === 'unlimited') {
        payload.durationType = 'unlimited';
    } else {
        payload.durationMinutes = parseInt(duration, 10);
    }
    
    const btn = document.getElementById('btnSaveCampaign');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Saving...';
    btn.disabled = true;

    try {
        let url = '/admin/view-engine/campaigns';
        let method = 'POST';
        if (id && !isDuplicate) {
            url += '/' + id;
            method = 'PUT';
        }
        
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (response.ok && data.success) {
            // New Campaign (Not Edit, Not Duplicate) -> Active
            if (!id && !isDuplicate) {
                try {
                    await fetch('/admin/view-engine/campaigns/' + data.campaign._id + '/activate', { method: 'POST' });
                } catch(e) {
                    console.error("Auto-activate failed", e);
                }
            }
            
            getModalInstance('campaignModal').hide();
            showToast('success', 'Campaign saved successfully!');
            fetchCampaigns();
        } else {
            showToast('error', data.error || data.errors?.join(', ') || 'Failed to save campaign.');
        }
    } catch (err) {
        console.error(err);
        showToast('error', 'An unexpected error occurred.');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

async function actionCampaign(id, action) {
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}/${action}`, { method: 'POST' });
        if(res.ok) {
            showToast('success', `Campaign ${action}d successfully!`);
            fetchCampaigns();
        } else {
            const data = await res.json();
            showToast('error', data.error || `Failed to ${action} campaign.`);
        }
    } catch(err) {
        showToast('error', `Error executing ${action}.`);
    }
}

async function deleteCampaign(id) {
    if(!confirm("Are you sure you want to permanently delete this campaign?")) return;
    try {
        const res = await fetch(`/admin/view-engine/campaigns/${id}`, { method: 'DELETE' });
        if(res.ok) {
            showToast('success', `Campaign deleted.`);
            fetchCampaigns();
        } else {
            const data = await res.json();
            showToast('error', data.error || `Failed to delete campaign.`);
        }
    } catch(err) {
        showToast('error', `Error deleting campaign.`);
    }
}

function viewDetails(id) {
    const c = allCampaigns.find(x => x._id === id);
    if(!c) return;
    
    const detailsHtml = `
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded bg-white h-100">
                    <h6 class="text-muted fw-bold mb-3 border-bottom pb-2">Configuration</h6>
                    <p class="mb-1"><strong>Name:</strong> ${c.name}</p>
                    <p class="mb-1"><strong>Status:</strong> <span class="badge bg-${getStatusColor(c.status)}">${c.status.toUpperCase()}</span></p>
                    <p class="mb-1"><strong>Views Range:</strong> ${c.minViews} - ${c.maxViews}</p>
                    <p class="mb-1"><strong>Duration:</strong> ${c.durationType === 'unlimited' ? 'Unlimited (24×7)' : durationLabel(c.durationMinutes)}</p>
                    ${c.durationType === 'unlimited' ? '<p class="mb-1"><span class="badge bg-warning text-dark"><i class="fas fa-infinity me-1"></i>Running Until Manually Stopped</span></p>' : ''}
                    <p class="mb-1"><strong>Strategy:</strong> <span class="text-capitalize">${c.strategy}</span></p>
                    <p class="mb-0"><strong>Speed Profile:</strong> <span class="text-capitalize">${c.intensity}</span></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded bg-white h-100">
                    <h6 class="text-muted fw-bold mb-3 border-bottom pb-2">Execution Stats</h6>
                    <p class="mb-1"><strong>Start Time:</strong> ${c.startAt ? new Date(c.startAt).toLocaleString() : 'Not Started'}</p>
                    <p class="mb-1"><strong>End Time:</strong> ${c.endAt ? new Date(c.endAt).toLocaleString() : 'Not Set'}</p>
                    <p class="mb-1"><strong>Progress:</strong> <span class="text-primary fw-bold">Live Data Fetch Required</span></p>
                    <p class="mb-1"><strong>Eligible News:</strong> Engine Calculated</p>
                    <p class="mb-1"><strong>Processed News:</strong> Engine Calculated</p>
                    <p class="mb-1"><strong>Remaining News:</strong> Engine Calculated</p>
                    <p class="mb-1"><strong>Distributed Views:</strong> Engine Calculated</p>
                    <p class="mb-0"><strong>Remaining Views:</strong> Engine Calculated</p>
                </div>
            </div>
            <div class="col-12 mt-3">
                <div class="p-3 border rounded bg-white">
                    <h6 class="text-muted fw-bold mb-3 border-bottom pb-2">Audit Information</h6>
                    <p class="mb-1"><strong>Created By:</strong> ${c.createdByName || 'System'} (ID: ${c.createdBy || 'N/A'})</p>
                    <p class="mb-0"><strong>Created At:</strong> ${new Date(c.createdAt).toLocaleString()}</p>
                    <p class="mb-0 mt-2 text-muted small"><i class="fas fa-info-circle"></i> Note: Full real-time distribution stats require a separate API call to the Engine Allocator.</p>
                </div>
            </div>
        </div>
    `;
    
    document.getElementById('detailsModalBody').innerHTML = detailsHtml;
    getModalInstance('detailsModal').show();
}

function showToast(type, message) {
    alert((type === 'success' ? 'SUCCESS: ' : 'ERROR: ') + message);
}
</script>

