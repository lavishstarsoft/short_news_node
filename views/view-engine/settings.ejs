<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content bg-light p-3 p-md-4">
    <div class="container-fluid p-0">
        <!-- Header -->
        <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4 pb-3">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-cogs text-primary me-2"></i>Engine Settings</h3>
                <p class="text-muted mb-0">Configure View Engine parameters and safety limits.</p>
            </div>
            <button id="saveConfigBtn" class="btn btn-success fw-bold px-4">
                <i class="fas fa-save me-2"></i>Save Configuration
            </button>
        </div>

        <div class="row g-4">
            <!-- Global Limits -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white pb-0 pt-3 border-bottom">
                        <h5 class="fw-bold"><i class="fas fa-shield-alt text-info me-2"></i>Global Limits (Safeguards)</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Max Campaign View Target</label>
                            <input type="number" class="form-control" id="maxTarget" value="<%= settings.maxTargetViews %>">
                            <div class="form-text">Absolute maximum views any single campaign can target.</div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Max Concurrent Campaigns</label>
                            <input type="number" class="form-control" id="maxCampaigns" value="<%= settings.maxConcurrentCampaigns %>">
                            <div class="form-text">Hard limit on simultaneous active campaigns.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tuning & Strategy -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white pb-0 pt-3 border-bottom">
                        <h5 class="fw-bold"><i class="fas fa-sliders-h text-warning me-2"></i>Engine Tuning</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Default Strategy</label>
                            <select class="form-select" id="defaultStrategy">
                                <option value="static" <%= settings.defaultStrategy === 'static' ? 'selected' : '' %>>Static Allocation</option>
                                <option value="adaptive" <%= settings.defaultStrategy === 'adaptive' ? 'selected' : '' %>>Adaptive Learning</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Worker Batch Size</label>
                            <input type="number" class="form-control" id="batchSize" value="<%= settings.batchSize %>">
                            <div class="form-text">How many news items a single worker processes per cycle.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('saveConfigBtn').addEventListener('click', async () => {
    // Collect settings data
    const payload = {
        maxTargetViews: parseInt(document.getElementById('maxTarget').value, 10),
        maxConcurrentCampaigns: parseInt(document.getElementById('maxCampaigns').value, 10),
        defaultStrategy: document.getElementById('defaultStrategy').value,
        batchSize: parseInt(document.getElementById('batchSize').value, 10)
    };

    try {
        const res = await fetch('/admin/view-engine/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert('Settings saved successfully!');
        } else {
            alert(data.error || 'Failed to save settings');
        }
    } catch (err) {
        alert('Network error. Please try again.');
    }
});
</script>

<%- include('../partials/footer') %>
