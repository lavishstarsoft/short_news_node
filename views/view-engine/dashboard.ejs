<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <div class="container-fluid py-4">
        
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h1 class="h2 mb-1"><i class="fas fa-server text-primary me-2"></i> View Engine Dashboard</h1>
                <p class="text-muted mb-0">Monitor and control the synthetic view distribution engine.</p>
            </div>
            
            <div class="d-flex gap-3 align-items-center">
                <!-- Live Auto Refresh Indicator -->
                <div class="d-flex align-items-center bg-light px-3 py-2 rounded-pill shadow-sm">
                    <div class="spinner-grow spinner-grow-sm text-success me-2" role="status" style="width: 1rem; height: 1rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="text-muted fw-bold small">Live Sync (5s)</span>
                </div>
                
                <!-- Dry Run Toggle -->
                <div class="form-check form-switch fs-5 mb-0">
                    <input class="form-check-input" type="checkbox" id="dryRunToggle" <%= data.dryRun ? 'checked' : '' %>>
                    <label class="form-check-label h6 mb-0 mt-1" for="dryRunToggle">Dry Run</label>
                </div>

                <!-- Engine ON/OFF (Kill Switch) -->
                <div class="form-check form-switch fs-4 mb-0 ms-3">
                    <input class="form-check-input bg-<%= data.killSwitchEnabled ? 'success' : 'danger' %>" type="checkbox" id="killSwitch" <%= data.killSwitchEnabled ? 'checked' : '' %>>
                    <label class="form-check-label h5 mb-0 mt-1 fw-bold text-<%= data.killSwitchEnabled ? 'success' : 'danger' %>" for="killSwitch">
                        <%= data.killSwitchEnabled ? 'ENGINE ON' : 'ENGINE OFF' %>
                    </label>
                </div>

                <!-- Emergency STOP -->
                <button class="btn btn-danger btn-lg fw-bold ms-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#emergencyStopModal">
                    <i class="fas fa-exclamation-triangle me-2"></i> EMERGENCY STOP
                </button>
            </div>
        </div>

        <!-- Metrics Row -->
        <div class="row g-4 mb-4">
            <!-- Running Status -->
            <div class="col-12 col-md-4 col-xl-3">
                <div class="card shadow-sm border-0 h-100 bg-primary text-white">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="text-white-50 text-uppercase fw-bold mb-2">Engine Status</h6>
                            <h2 class="display-6 fw-bold mb-0"><%= data.engineStatus %></h2>
                        </div>
                        <div class="mt-3">
                            <span class="badge bg-white text-primary rounded-pill px-3 py-2">
                                <i class="fas fa-heartbeat me-1"></i> Last: <%= new Date(data.lastHeartbeat).toLocaleTimeString() %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-8 col-xl-9">
                <div class="row g-4 h-100">
                    <!-- Queue Size -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Queue Size</h6>
                                <h3 class="fw-bold text-dark mb-0"><%= data.queueSize.toLocaleString() %></h3>
                                <small class="text-success fw-bold"><i class="fas fa-arrow-up me-1"></i> 12% from avg</small>
                            </div>
                        </div>
                    </div>
                    <!-- Workers -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Active Workers</h6>
                                <h3 class="fw-bold text-dark mb-0"><%= data.workers %></h3>
                                <small class="text-muted fw-bold">Leader: <%= data.leader %></small>
                            </div>
                        </div>
                    </div>
                    <!-- Active Campaigns -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Active Campaigns</h6>
                                <h3 class="fw-bold text-dark mb-0"><%= data.activeCampaigns %></h3>
                                <small class="text-primary fw-bold">View details <i class="fas fa-arrow-right"></i></small>
                            </div>
                        </div>
                    </div>
                    <!-- Synthetic Views -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Today's Views</h6>
                                <h3 class="fw-bold text-dark mb-0"><%= data.todaySyntheticViews %></h3>
                                <small class="text-muted fw-bold">Cycles: <%= data.processedCycles.toLocaleString() %></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Health Indicators -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom pb-0 pt-3">
                        <h5 class="fw-bold"><i class="fas fa-stethoscope text-info me-2"></i> System Health</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary">Redis Cache</span>
                                <span class="badge bg-<%= data.redisHealth === 'Healthy' ? 'success' : 'danger' %> rounded-pill px-3"><%= data.redisHealth %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary">MongoDB Cluster</span>
                                <span class="badge bg-<%= data.mongoHealth === 'Healthy' ? 'success' : 'danger' %> rounded-pill px-3"><%= data.mongoHealth %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary">Message Queue</span>
                                <span class="badge bg-<%= data.queueHealth === 'Healthy' ? 'success' : 'warning' %> rounded-pill px-3 text-dark"><%= data.queueHealth %></span>
                            </li>
                        </ul>
                        
                        <div class="mt-4 pt-3 border-top">
                            <h6 class="fw-bold mb-3">Controls</h6>
                            <div class="d-grid gap-2 d-md-block">
                                <button class="btn btn-outline-success btn-sm fw-bold me-2"><i class="fas fa-play me-1"></i> Start</button>
                                <button class="btn btn-outline-warning btn-sm fw-bold text-dark me-2"><i class="fas fa-pause me-1"></i> Pause</button>
                                <button class="btn btn-outline-info btn-sm fw-bold"><i class="fas fa-undo me-1"></i> Rollback</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Logs & Errors -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center pb-2 pt-3">
                        <h5 class="fw-bold mb-0"><i class="fas fa-clipboard-list text-primary me-2"></i> Activity & Diagnostics</h5>
                        <ul class="nav nav-pills" id="logTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-1 px-3" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit" type="button" role="tab">Audit Logs</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3 text-danger" id="errors-tab" data-bs-toggle="tab" data-bs-target="#errors" type="button" role="tab">Recent Errors</button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body p-0">
                        <div class="tab-content" id="logTabsContent">
                            <!-- Audit Logs Tab -->
                            <div class="tab-pane fade show active p-3" id="audit" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Time</th>
                                                <th>Event</th>
                                                <th>User / Source</th>
                                                <th>ID</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% data.recentLogs.forEach(log => { %>
                                            <tr>
                                                <td class="text-muted small"><%= log.time %></td>
                                                <td class="fw-bold text-dark"><%= log.event %></td>
                                                <td><span class="badge bg-light text-secondary border"><i class="fas fa-user-circle me-1"></i> <%= log.user %></span></td>
                                                <td class="text-muted small"><code><%= log.id %></code></td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- Errors Tab -->
                            <div class="tab-pane fade p-3" id="errors" role="tabpanel">
                                <% if(data.recentErrors && data.recentErrors.length > 0) { %>
                                    <ul class="list-group list-group-flush">
                                        <% data.recentErrors.forEach(err => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-start border-start border-danger border-4 ms-2 bg-light mb-2 rounded">
                                            <div class="ms-2 me-auto">
                                                <div class="fw-bold text-danger"><%= err.message %></div>
                                                <small class="text-muted"><%= err.time %></small>
                                            </div>
                                            <span class="badge bg-danger rounded-pill"><%= err.id %></span>
                                        </li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <div class="text-center py-5">
                                        <i class="fas fa-check-circle text-success fs-1 mb-3"></i>
                                        <p class="text-muted fw-bold">No recent errors detected.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Emergency Stop Modal -->
<div class="modal fade" id="emergencyStopModal" tabindex="-1" aria-labelledby="emergencyStopModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger border-3">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title fw-bold" id="emergencyStopModalLabel"><i class="fas fa-exclamation-triangle me-2"></i> Confirm Emergency Stop</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center py-4">
        <i class="fas fa-power-off text-danger" style="font-size: 4rem; margin-bottom: 1rem;"></i>
        <h4 class="fw-bold mt-3 text-dark">Are you absolutely sure?</h4>
        <p class="text-muted">This will immediately halt all synthetic view workers and drop the current queue. This action cannot be easily undone and may cause metric inconsistencies.</p>
      </div>
      <div class="modal-footer justify-content-center bg-light">
        <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger fw-bold px-4">YES, STOP ENGINE</button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const killSwitch = document.getElementById('killSwitch');
    if (killSwitch) {
        killSwitch.addEventListener('change', async function() {
            const isEnabled = this.checked;
            const label = this.nextElementSibling;
            
            try {
                // Update UI Optimistically
                this.className = `form-check-input bg-${isEnabled ? 'success' : 'danger'}`;
                label.className = `form-check-label h5 mb-0 mt-1 fw-bold text-${isEnabled ? 'success' : 'danger'}`;
                label.textContent = isEnabled ? 'ENGINE ON' : 'ENGINE OFF';
                
                const response = await fetch('/admin/view-engine/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: isEnabled })
                });
                
                if (!response.ok) throw new Error('Failed to toggle engine');
                
                // Show a toast or alert (optional, can just reload)
                window.location.reload();
            } catch (err) {
                console.error(err);
                alert('Error toggling Engine. Please try again.');
                // Revert
                this.checked = !isEnabled;
                this.className = `form-check-input bg-${!isEnabled ? 'success' : 'danger'}`;
                label.className = `form-check-label h5 mb-0 mt-1 fw-bold text-${!isEnabled ? 'success' : 'danger'}`;
                label.textContent = !isEnabled ? 'ENGINE ON' : 'ENGINE OFF';
            }
        });
    }
});
</script>

<%- include('../partials/footer') %>
