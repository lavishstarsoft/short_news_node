<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content bg-light p-3 p-md-4">
    <div class="container-fluid p-0">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Engine Dashboard</h3>
                <p class="text-muted mb-0">Control Center & System Health</p>
            </div>
            <div>
                <div class="form-check form-switch form-switch-lg mb-0 d-flex align-items-center">
                    <input class="form-check-input" type="checkbox" role="switch" id="engineToggle" 
                        <%= data.killSwitchEnabled ? 'checked' : '' %>
                        onchange="toggleEngine(this.checked)">
                    <label class="form-check-label fw-bold ms-2 mt-1" id="engineStatusLabel" 
                        for="engineToggle" style="font-size: 1.1rem; color: <%= data.killSwitchEnabled ? '#198754' : '#dc3545' %>;">
                        <%= data.killSwitchEnabled ? 'ENGINE ON' : 'ENGINE OFF' %>
                    </label>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Summary Stats -->
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Active Campaigns</div>
                        <h2 class="fw-bold mb-0 text-primary"><%= data.activeCampaigns %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Queue Size</div>
                        <h2 class="fw-bold mb-0 text-info"><%= data.queueSize %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Active Workers</div>
                        <h2 class="fw-bold mb-0 text-success"><%= data.workers %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Today's Synthetic Views</div>
                        <h2 class="fw-bold mb-0 text-warning text-dark"><%= data.todaySyntheticViews %></h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Health Indicators -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom pb-0 pt-3">
                        <h5 class="fw-bold"><i class="fas fa-stethoscope text-info me-2"></i> Infrastructure Health</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary"><i class="fas fa-database me-2"></i>Redis Cache</span>
                                <span class="badge bg-<%= data.redisHealth === 'Healthy' ? 'success' : 'danger' %> rounded-pill px-3 py-2"><%= data.redisHealth %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary"><i class="fas fa-leaf me-2"></i>MongoDB Cluster</span>
                                <span class="badge bg-<%= data.mongoHealth === 'Healthy' ? 'success' : 'danger' %> rounded-pill px-3 py-2"><%= data.mongoHealth %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-secondary"><i class="fas fa-exchange-alt me-2"></i>Message Queue</span>
                                <span class="badge bg-<%= data.queueHealth === 'Healthy' ? 'success' : 'warning' %> rounded-pill px-3 py-2"><%= data.queueHealth %></span>
                            </li>
                        </ul>
                        
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-flex align-items-center text-muted">
                                <i class="fas fa-heartbeat me-2 text-primary"></i> 
                                <span class="fw-bold">Last Heartbeat:</span> 
                                <span class="ms-2"><%= data.lastHeartbeat %></span>
                            </div>
                            <div class="d-flex align-items-center text-muted mt-2">
                                <i class="fas fa-crown me-2 text-warning"></i> 
                                <span class="fw-bold">Leader Node:</span> 
                                <span class="ms-2"><%= data.leader %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100 bg-light border border-danger">
                    <div class="card-header bg-white border-bottom pb-0 pt-3">
                        <h5 class="fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i> Emergency Actions</h5>
                    </div>
                    <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                        <p class="text-muted mb-4">Use the Emergency Stop only if you suspect fraudulent activity or database runaway. This instantly kills all workers and pauses campaigns.</p>
                        <button class="btn btn-danger btn-lg px-5 py-3 fw-bold shadow-sm" onclick="emergencyStop()">
                            <i class="fas fa-power-off me-2"></i> EMERGENCY STOP
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.form-switch-lg .form-check-input {
    width: 3rem;
    height: 1.5rem;
}
.form-switch-lg .form-check-input:checked {
    background-color: #198754;
    border-color: #198754;
}
</style>

<script>
async function toggleEngine(enabled) {
    const label = document.getElementById('engineStatusLabel');
    try {
        const res = await fetch('/admin/view-engine/flag', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled })
        });
        const data = await res.json();
        
        if (data.success) {
            label.innerText = enabled ? 'ENGINE ON' : 'ENGINE OFF';
            label.style.color = enabled ? '#198754' : '#dc3545';
            showToast('Success', `Engine ${enabled ? 'started' : 'stopped'} successfully.`, 'success');
        } else {
            document.getElementById('engineToggle').checked = !enabled;
            showToast('Error', data.error || 'Failed to toggle engine', 'danger');
        }
    } catch (err) {
        document.getElementById('engineToggle').checked = !enabled;
        showToast('Error', 'Network error. Try again.', 'danger');
    }
}

async function emergencyStop() {
    if (!confirm("CRITICAL: Are you sure you want to stop all active campaigns and kill the engine?")) return;
    
    // Uses the same API to disable engine. Rollback is managed per campaign in Campaigns page.
    await toggleEngine(false);
    document.getElementById('engineToggle').checked = false;
    alert("Emergency Stop executed. Engine is now OFF.");
}

function showToast(title, message, type) {
    alert(title + ": " + message); // Simple fallback, or use a proper toast library
}
</script>

<%- include('../partials/footer') %>
