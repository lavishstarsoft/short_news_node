<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Long Video Studio' }) %>
    <link rel="stylesheet" href="/css/long-video-studio.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Long Videos / Programs', backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <%- include('partials/sidebar', { activePage: 'long-videos' }) %>

                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                            <div class="content-area mt-4 lv-page">
                                <div class="lv-hero">
                                    <div>
                                        <p class="lv-eyebrow"><i class="fas fa-clapperboard"></i> Program studio</p>
                                        <h1 class="lv-hero-title">Long Video & Programs</h1>
                                        <p class="lv-hero-sub">Curate YouTube programs, news bulletins, and folk shows — organize by category and control what goes live in the app.</p>
                                    </div>
                                    <div>
                                        <button type="button" class="lv-btn-primary" onclick="openAddVideoModal()">
                                            <i class="fas fa-plus"></i> Add program
                                        </button>
                                    </div>
                                </div>

                                <div class="lv-stats">
                                    <div class="lv-stat">
                                        <div class="lv-stat-value" id="totalVideos">0</div>
                                        <div class="lv-stat-label">Total programs</div>
                                    </div>
                                    <div class="lv-stat">
                                        <div class="lv-stat-value" id="activeVideos">0</div>
                                        <div class="lv-stat-label">Live now</div>
                                    </div>
                                    <div class="lv-stat">
                                        <div class="lv-stat-value" id="totalViews">0</div>
                                        <div class="lv-stat-label">Total views</div>
                                    </div>
                                    <div class="lv-stat">
                                        <div class="lv-stat-value" id="totalLikes">0</div>
                                        <div class="lv-stat-label">Total likes</div>
                                    </div>
                                </div>

                                <div class="lv-panel">
                                    <div class="lv-panel-toolbar">
                                        <div class="lv-search-wrap">
                                            <i class="fas fa-search"></i>
                                            <input type="text" id="videoSearchInput" class="lv-search" placeholder="Search title, description, category...">
                                        </div>
                                        <select id="categoryFilter" class="lv-filter-select">
                                            <option value="">All categories</option>
                                        </select>
                                        <div class="lv-segments" role="tablist">
                                            <button type="button" class="lv-segment active" data-status="">All</button>
                                            <button type="button" class="lv-segment" data-status="active">Live</button>
                                            <button type="button" class="lv-segment" data-status="inactive">Hidden</button>
                                        </div>
                                    </div>

                                    <div id="videosGrid" class="lv-grid">
                                        <div class="lv-empty">
                                            <div class="lv-empty-icon"><i class="fas fa-spinner fa-spin"></i></div>
                                            <h3>Loading programs...</h3>
                                        </div>
                                    </div>

                                    <div class="lv-pagination" id="videosPagination" style="display:none;">
                                        <div class="lv-pagination-info" id="paginationInfo"></div>
                                        <div class="lv-pagination-nav" id="paginationNav"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Add / Edit Modal -->
            <div class="modal fade" id="addVideoModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="lv-modal-header">
                            <div>
                                <h2 class="lv-modal-title" id="videoModalTitle">Add program</h2>
                                <p class="lv-modal-sub">Paste a YouTube link — thumbnail auto-fetches from YouTube.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-4 py-3">
                            <form id="videoForm">
                                <div class="mb-3">
                                    <label class="lv-form-label" for="videoTitle">Title *</label>
                                    <input type="text" class="form-control lv-form-control" id="videoTitle" required placeholder="Program or episode title">
                                </div>
                                <div class="mb-3">
                                    <label class="lv-form-label" for="videoDescription">Description</label>
                                    <textarea class="form-control lv-form-control" id="videoDescription" rows="3" placeholder="Brief summary for the app listing"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="lv-form-label" for="videoUrl">YouTube link *</label>
                                    <input type="url" class="form-control lv-form-control" id="videoUrl" placeholder="https://www.youtube.com/watch?v=..." required>
                                </div>
                                <div class="mb-0">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="lv-form-label mb-0" for="videoCategory">Category *</label>
                                        <a href="/categories?type=program" class="btn btn-sm btn-link p-0 text-decoration-none">
                                            <i class="fas fa-plus-circle me-1"></i>Manage categories
                                        </a>
                                    </div>
                                    <select class="form-control lv-form-control" id="videoCategory"></select>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" onclick="saveVideo()">
                                <i class="fas fa-save me-1"></i> Save program
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preview Modal -->
            <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="lv-modal-header">
                            <div>
                                <h2 class="lv-modal-title" id="previewTitle">Preview</h2>
                                <p class="lv-modal-sub" id="previewCategory"></p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="lv-preview-frame" id="previewFrame"></div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <script>
                    let currentVideoId = null;
                    let currentPage = 1;
                    let currentStatus = '';
                    let currentSearch = '';
                    let currentCategory = '';
                    let searchDebounce = null;
                    let cachedCategories = [];
                    let videosCache = {};

                    document.addEventListener('DOMContentLoaded', function () {
                        setupMobileMenu();
                        setupFilters();
                        loadProgramCategories();
                        loadVideos(1);
                    });

                    function setupFilters() {
                        document.getElementById('videoSearchInput').addEventListener('input', function (e) {
                            clearTimeout(searchDebounce);
                            searchDebounce = setTimeout(function () {
                                currentSearch = e.target.value.trim();
                                loadVideos(1);
                            }, 350);
                        });

                        document.getElementById('categoryFilter').addEventListener('change', function (e) {
                            currentCategory = e.target.value;
                            loadVideos(1);
                        });

                        document.querySelectorAll('.lv-segment').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                document.querySelectorAll('.lv-segment').forEach(function (b) { b.classList.remove('active'); });
                                btn.classList.add('active');
                                currentStatus = btn.dataset.status || '';
                                loadVideos(1);
                            });
                        });
                    }

                    window.openAddVideoModal = function () {
                        currentVideoId = null;
                        document.getElementById('videoForm').reset();
                        document.getElementById('videoModalTitle').textContent = 'Add program';
                        new bootstrap.Modal(document.getElementById('addVideoModal')).show();
                    };

                    window.editVideoById = function (id) {
                        if (videosCache[id]) editVideo(videosCache[id]);
                    };

                    window.editVideo = function (video) {
                        currentVideoId = video._id;
                        document.getElementById('videoModalTitle').textContent = 'Edit program';
                        document.getElementById('videoTitle').value = video.title || '';
                        document.getElementById('videoDescription').value = video.description || '';
                        document.getElementById('videoUrl').value = video.videoUrl || '';
                        document.getElementById('videoCategory').value = video.category || '';
                        new bootstrap.Modal(document.getElementById('addVideoModal')).show();
                    };

                    window.previewVideoById = function (id) {
                        const video = videosCache[id];
                        if (!video || !video.videoUrl) return;
                        document.getElementById('previewTitle').textContent = video.title;
                        document.getElementById('previewCategory').textContent = video.category || 'Program';
                        document.getElementById('previewFrame').innerHTML = getEmbedIframe(video.videoUrl);
                        new bootstrap.Modal(document.getElementById('previewModal')).show();
                    };

                    function getYouTubeThumbnail(url) {
                        if (!url) return '';
                        let videoId = '';
                        if (url.includes('youtube.com/watch?v=')) {
                            videoId = url.split('v=')[1].split('&')[0];
                        } else if (url.includes('youtu.be/')) {
                            videoId = url.split('youtu.be/')[1].split('?')[0];
                        } else if (url.includes('youtube.com/shorts/')) {
                            videoId = url.split('shorts/')[1].split('?')[0];
                        }
                        return videoId ? 'https://img.youtube.com/vi/' + videoId + '/hqdefault.jpg' : '';
                    }

                    function getYouTubeId(url) {
                        if (!url) return '';
                        if (url.includes('youtube.com/watch?v=')) return url.split('v=')[1].split('&')[0];
                        if (url.includes('youtu.be/')) return url.split('youtu.be/')[1].split('?')[0];
                        if (url.includes('youtube.com/shorts/')) return url.split('shorts/')[1].split('?')[0];
                        return '';
                    }

                    function getEmbedIframe(url) {
                        const id = getYouTubeId(url);
                        if (id) {
                            return '<iframe src="https://www.youtube.com/embed/' + escapeAttr(id) + '?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
                        }
                        return '<div class="lv-thumb-fallback"><a href="' + escapeAttr(url) + '" target="_blank" rel="noopener" style="color:#fff">Open video</a></div>';
                    }

                    window.saveVideo = async function () {
                        const title = document.getElementById('videoTitle').value.trim();
                        const description = document.getElementById('videoDescription').value.trim();
                        const videoUrl = document.getElementById('videoUrl').value.trim();
                        const category = document.getElementById('videoCategory').value;

                        if (!title || !videoUrl) {
                            alert('Please enter title and YouTube link');
                            return;
                        }

                        const thumbnailUrl = getYouTubeThumbnail(videoUrl);

                        try {
                            showLoader(currentVideoId ? 'Updating program...' : 'Saving program...');
                            const videoData = { title, description, videoUrl, category, thumbnailUrl };
                            let url = '/long-videos/api/videos';
                            let method = 'POST';
                            if (currentVideoId) {
                                url = '/long-videos/api/videos/' + currentVideoId;
                                method = 'PUT';
                            }

                            const response = await fetch(url, {
                                method: method,
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(videoData)
                            });

                            hideLoader();
                            if (response.ok) {
                                bootstrap.Modal.getInstance(document.getElementById('addVideoModal')).hide();
                                document.getElementById('videoForm').reset();
                                loadVideos(currentPage);
                            } else {
                                const error = await response.json();
                                alert('Error saving: ' + (error.error || 'Unknown error'));
                            }
                        } catch (error) {
                            hideLoader();
                            alert('Error: ' + error.message);
                        }
                    };

                    window.deleteVideo = async function (id) {
                        if (!confirm('Delete this program permanently?')) return;
                        try {
                            showLoader('Deleting...');
                            const response = await fetch('/long-videos/api/videos/' + id, { method: 'DELETE' });
                            hideLoader();
                            if (response.ok) loadVideos(currentPage);
                            else alert('Error deleting video');
                        } catch (error) {
                            hideLoader();
                            alert('Error deleting video');
                        }
                    };

                    window.toggleVideoStatus = async function (id) {
                        try {
                            showLoader('Updating status...');
                            const response = await fetch('/long-videos/api/videos/' + id + '/toggle-status', { method: 'PUT' });
                            hideLoader();
                            if (response.ok) loadVideos(currentPage);
                            else alert('Error updating status');
                        } catch (error) {
                            hideLoader();
                            alert('Error updating status');
                        }
                    };

                    function buildApiUrl(page) {
                        const params = new URLSearchParams();
                        params.set('page', page);
                        params.set('limit', '12');
                        if (currentSearch) params.set('search', currentSearch);
                        if (currentStatus) params.set('status', currentStatus);
                        if (currentCategory) params.set('category', currentCategory);
                        return '/long-videos/api/videos?' + params.toString();
                    }

                    function loadVideos(page) {
                        currentPage = page;
                        fetch(buildApiUrl(page))
                            .then(function (res) { return res.json(); })
                            .then(function (data) {
                                const videos = data.videos || [];
                                const stats = data.stats || {};
                                const pagination = data.pagination || { currentPage: 1, totalPages: 1, totalVideos: 0, limit: 12 };

                                document.getElementById('totalVideos').textContent = (stats.total || 0).toLocaleString();
                                document.getElementById('activeVideos').textContent = (stats.active || 0).toLocaleString();
                                document.getElementById('totalViews').textContent = (stats.totalViews || 0).toLocaleString();
                                document.getElementById('totalLikes').textContent = (stats.totalLikes || 0).toLocaleString();

                                updateCategoryFilter(data.categories || []);
                                renderVideosGrid(videos);
                                renderPagination(pagination);
                            })
                            .catch(function (err) {
                                console.error('Error loading videos:', err);
                                document.getElementById('videosGrid').innerHTML =
                                    '<div class="lv-empty"><div class="lv-empty-icon"><i class="fas fa-exclamation-triangle"></i></div><h3>Error loading programs</h3></div>';
                            });
                    }

                    function updateCategoryFilter(categories) {
                        const select = document.getElementById('categoryFilter');
                        const merged = [...new Set([...cachedCategories, ...categories])].filter(Boolean).sort();
                        cachedCategories = merged;
                        const prev = select.value;
                        select.innerHTML = '<option value="">All categories</option>' +
                            merged.map(function (cat) {
                                return '<option value="' + escapeAttr(cat) + '">' + escapeHtml(cat) + '</option>';
                            }).join('');
                        select.value = merged.includes(prev) ? prev : currentCategory;
                    }

                    function renderVideosGrid(videos) {
                        const grid = document.getElementById('videosGrid');
                        if (!videos.length) {
                            grid.innerHTML =
                                '<div class="lv-empty">' +
                                '<div class="lv-empty-icon"><i class="fas fa-clapperboard"></i></div>' +
                                '<h3>No programs found</h3>' +
                                '<p>' + (currentSearch || currentStatus || currentCategory ? 'Try adjusting your filters.' : 'Add your first YouTube program to get started.') + '</p>' +
                                '<button type="button" class="lv-btn-primary" onclick="openAddVideoModal()"><i class="fas fa-plus"></i> Add program</button>' +
                                '</div>';
                            return;
                        }

                        grid.innerHTML = videos.map(function (video) {
                            videosCache[video._id] = video;
                            const thumb = video.thumbnailUrl || getYouTubeThumbnail(video.videoUrl);
                            const statusClass = video.isActive ? 'live' : 'draft';
                            const statusLabel = video.isActive ? 'Live' : 'Hidden';
                            const toggleClass = video.isActive ? 'warning' : 'success';
                            const toggleIcon = video.isActive ? 'fa-eye-slash' : 'fa-eye';
                            const toggleLabel = video.isActive ? 'Hide' : 'Live';
                            const published = video.publishedAt ? new Date(video.publishedAt).toLocaleDateString() : '—';
                            const views = (video.views || 0).toLocaleString();
                            const likes = (video.likes || 0).toLocaleString();

                            const thumbHtml = thumb
                                ? '<img src="' + escapeAttr(thumb) + '" alt="" loading="lazy">'
                                : '<div class="lv-thumb-fallback"><i class="fas fa-play-circle"></i></div>';

                            return '<article class="lv-card">' +
                                '<button type="button" class="lv-thumb-wrap" onclick="previewVideoById(\'' + video._id + '\')" aria-label="Preview ' + escapeAttr(video.title) + '">' +
                                    thumbHtml +
                                    '<span class="lv-status-pill ' + statusClass + '">' + statusLabel + '</span>' +
                                    '<span class="lv-duration-badge"><i class="fab fa-youtube"></i> YouTube</span>' +
                                    '<span class="lv-play-overlay"><span class="lv-play-btn"><i class="fas fa-play"></i></span></span>' +
                                '</button>' +
                                '<div class="lv-card-body">' +
                                    '<h3 class="lv-card-title">' + escapeHtml(video.title) + '</h3>' +
                                    '<div class="lv-card-meta">' +
                                        '<span class="lv-category-pill">' + escapeHtml(video.category || 'Program') + '</span>' +
                                        '<span class="lv-card-date">' + published + '</span>' +
                                    '</div>' +
                                    '<div class="lv-metrics">' +
                                        '<div class="lv-metric"><span class="lv-metric-value">' + views + '</span><span class="lv-metric-label">Views</span></div>' +
                                        '<div class="lv-metric"><span class="lv-metric-value">' + likes + '</span><span class="lv-metric-label">Likes</span></div>' +
                                    '</div>' +
                                    '<div class="lv-card-actions">' +
                                        '<button type="button" class="lv-action-btn ' + toggleClass + '" onclick="toggleVideoStatus(\'' + video._id + '\')"><i class="fas ' + toggleIcon + '"></i><span>' + toggleLabel + '</span></button>' +
                                        '<button type="button" class="lv-action-btn" onclick="editVideoById(\'' + video._id + '\')"><i class="fas fa-pen"></i><span>Edit</span></button>' +
                                        '<button type="button" class="lv-action-btn danger" onclick="deleteVideo(\'' + video._id + '\')"><i class="fas fa-trash"></i><span>Delete</span></button>' +
                                    '</div>' +
                                '</div>' +
                            '</article>';
                        }).join('');
                    }

                    function renderPagination(pagination) {
                        const wrap = document.getElementById('videosPagination');
                        const info = document.getElementById('paginationInfo');
                        const nav = document.getElementById('paginationNav');
                        const total = pagination.totalVideos || 0;
                        const page = pagination.currentPage || 1;
                        const limit = pagination.limit || 12;
                        const totalPages = pagination.totalPages || 1;

                        if (total === 0 && totalPages <= 1) {
                            wrap.style.display = 'none';
                            return;
                        }

                        wrap.style.display = 'flex';
                        const start = total === 0 ? 0 : ((page - 1) * limit) + 1;
                        const end = Math.min(page * limit, total);
                        info.textContent = 'Showing ' + start + '–' + end + ' of ' + total + ' programs' +
                            (totalPages > 1 ? ' · Page ' + page + ' of ' + totalPages : '');

                        if (totalPages <= 1) {
                            nav.innerHTML = '';
                            return;
                        }

                        let startPage = Math.max(1, page - 2);
                        let endPage = Math.min(totalPages, page + 2);
                        if (endPage - startPage < 4) {
                            if (startPage === 1) endPage = Math.min(totalPages, startPage + 4);
                            else startPage = Math.max(1, endPage - 4);
                        }

                        let html = pageBtn(1, '<i class="fas fa-angles-left"></i>', page === 1);
                        html += pageBtn(page - 1, '<i class="fas fa-angle-left"></i>', page === 1);
                        for (let i = startPage; i <= endPage; i++) {
                            html += pageBtn(i, String(i), false, i === page);
                        }
                        html += pageBtn(page + 1, '<i class="fas fa-angle-right"></i>', page === totalPages);
                        html += pageBtn(totalPages, '<i class="fas fa-angles-right"></i>', page === totalPages);
                        nav.innerHTML = html;

                        nav.querySelectorAll('.lv-page-btn').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                const target = parseInt(btn.dataset.page, 10);
                                if (!btn.disabled && target >= 1 && target <= totalPages) {
                                    loadVideos(target);
                                    window.scrollTo({ top: 0, behavior: 'smooth' });
                                }
                            });
                        });
                    }

                    function pageBtn(page, label, disabled, active) {
                        return '<button type="button" class="lv-page-btn' + (active ? ' active' : '') + '" data-page="' + page + '"' + (disabled ? ' disabled' : '') + '>' + label + '</button>';
                    }

                    async function loadProgramCategories() {
                        try {
                            const response = await fetch('/categories/api/categories?type=program');
                            const categories = await response.json();
                            const select = document.getElementById('videoCategory');
                            if (categories && categories.length > 0) {
                                select.innerHTML = categories.map(function (cat) {
                                    return '<option value="' + escapeAttr(cat.name) + '">' + escapeHtml(cat.name) + '</option>';
                                }).join('');
                                cachedCategories = categories.map(function (c) { return c.name; });
                            } else {
                                select.innerHTML = '<option value="">No categories — add in Program Categories</option>';
                            }
                        } catch (err) {
                            console.error('Error loading program categories:', err);
                        }
                    }

                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                    }

                    function escapeAttr(str) {
                        return escapeHtml(str).replace(/'/g, '&#39;');
                    }

                    function setupMobileMenu() {
                        const menuToggle = document.getElementById('menuToggle');
                        const sidebar = document.getElementById('sidebar');
                        const mainContent = document.getElementById('mainContent');
                        if (menuToggle && sidebar) {
                            menuToggle.addEventListener('click', function (e) {
                                e.stopPropagation();
                                sidebar.classList.toggle('active');
                                mainContent.classList.toggle('sidebar-active');
                            });
                        }
                        document.addEventListener('click', function (event) {
                            if (window.innerWidth < 768 && sidebar && sidebar.classList.contains('active') && !sidebar.contains(event.target) && event.target !== menuToggle) {
                                sidebar.classList.remove('active');
                                if (mainContent) mainContent.classList.remove('sidebar-active');
                            }
                        });
                    }

                    document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
                        document.getElementById('previewFrame').innerHTML = '';
                    });
                </script>
    </body>

</html>
