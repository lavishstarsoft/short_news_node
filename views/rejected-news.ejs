<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Rejected News Queue' }) %>
    <link rel="stylesheet" href="/css/rejected-queue.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    <link rel="stylesheet" href="/css/news-directory.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Rejected News', backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <%- include('partials/sidebar', { activePage: 'rejected-news' }) %>

                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4 rn-page">
                                <% 
                                    const articles = rejectedNews || [];
                                    const pageSummary = typeof summary !== 'undefined' ? summary : { total: articles.length, thisWeek: 0, withFeedback: 0, filtered: articles.length };
                                    const reasons = typeof rejectionReasons !== 'undefined' ? rejectionReasons : [];
                                    const cats = typeof categories !== 'undefined' ? categories : [];
                                    const totalRows = (typeof pagination !== 'undefined' && pagination.totalRows !== undefined) ? pagination.totalRows : articles.length;
                                    const currentPage = (typeof pagination !== 'undefined' && pagination.currentPage) ? pagination.currentPage : 1;
                                    const totalPages = (typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1;
                                    const pageLimit = (typeof pagination !== 'undefined' && pagination.limit) ? pagination.limit : articles.length;
                                    const currentSearch = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
                                    const currentReason = (typeof reasonFilter !== 'undefined' && reasonFilter) ? reasonFilter : '';
                                    const currentCategory = (typeof categoryFilter !== 'undefined' && categoryFilter) ? categoryFilter : '';

                                    let paginationQuery = '';
                                    if (currentSearch) paginationQuery += '&search=' + encodeURIComponent(currentSearch);
                                    if (currentReason) paginationQuery += '&reason=' + encodeURIComponent(currentReason);
                                    if (currentCategory) paginationQuery += '&category=' + encodeURIComponent(currentCategory);
                                %>

                                <div class="rn-hero" style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <p class="rn-eyebrow"><i class="fas fa-ban"></i> Editorial queue</p>
                                        <h1 class="rn-hero-title">Rejected Articles</h1>
                                        <p class="rn-hero-sub">Audit declined submissions — review reasons, editor feedback, and rejection patterns across the newsroom.</p>
                                    </div>
                                    <div>
                                        <button class="btn btn-danger" onclick="openDeleteModal()"><i class="fas fa-trash"></i> Delete All</button>
                                    </div>
                                </div>

                                <div class="rn-stats">
                                    <div class="rn-stat">
                                        <div class="rn-stat-value"><%= pageSummary.total %></div>
                                        <div class="rn-stat-label">Total rejected</div>
                                    </div>
                                    <div class="rn-stat">
                                        <div class="rn-stat-value"><%= pageSummary.thisWeek %></div>
                                        <div class="rn-stat-label">This week</div>
                                    </div>
                                    <div class="rn-stat">
                                        <div class="rn-stat-value"><%= pageSummary.withFeedback %></div>
                                        <div class="rn-stat-label">With feedback</div>
                                    </div>
                                    <div class="rn-stat">
                                        <div class="rn-stat-value"><%= reasons.length %></div>
                                        <div class="rn-stat-label">Rejection reasons</div>
                                    </div>
                                </div>

                                <div class="rn-panel">
                                    <div class="rn-panel-toolbar">
                                        <form class="rn-search-form" method="GET" action="/admin/rejected-news">
                                            <div class="rn-search-wrap">
                                                <i class="fas fa-search"></i>
                                                <input type="text" name="search" class="rn-search" placeholder="Search title, author, reason, feedback..." value="<%= currentSearch %>">
                                            </div>
                                            <button type="submit" class="rn-search-btn"><i class="fas fa-filter"></i> Search</button>
                                            <% if (currentSearch || currentReason || currentCategory) { %>
                                                <a href="/admin/rejected-news" class="rn-clear-btn">Clear</a>
                                            <% } %>
                                        </form>

                                        <form method="GET" action="/admin/rejected-news" class="d-flex gap-2 flex-wrap">
                                            <% if (currentSearch) { %><input type="hidden" name="search" value="<%= currentSearch %>"><% } %>
                                            <select name="reason" class="rn-filter-select" onchange="this.form.submit()">
                                                <option value="">All reasons</option>
                                                <% reasons.forEach(function(reason) { %>
                                                    <option value="<%= reason %>" <%= currentReason === reason ? 'selected' : '' %>><%= reason %></option>
                                                <% }); %>
                                            </select>
                                            <select name="category" class="rn-filter-select" onchange="this.form.submit()">
                                                <option value="">All categories</option>
                                                <% cats.forEach(function(cat) { %>
                                                    <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>><%= cat %></option>
                                                <% }); %>
                                            </select>
                                        </form>
                                    </div>

                                    <% if (articles.length > 0) { %>
                                    <div class="rn-table-wrap">
                                        <table class="rn-table">
                                            <thead>
                                                <tr>
                                                    <th>Article</th>
                                                    <th>Author</th>
                                                    <th>Category</th>
                                                    <th>Rejection</th>
                                                    <th>Rejected</th>
                                                    <th>Reviewer</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% articles.forEach(function(article) {
                                                    const rejection = article.rejectionStatus || {};
                                                    const rejectedAt = rejection.rejectedAt ? new Date(rejection.rejectedAt) : null;
                                                %>
                                                <tr>
                                                    <td class="rn-article-cell">
                                                        <button type="button" class="rn-article-title-link" onclick="viewRejectedArticle('<%= article._id %>')"><span class="rich-text"><%- renderRichText(article.title) %></span></button>
                                                        <div class="rn-article-meta">
                                                            <% if (article.language) { %><%= article.language.toUpperCase() %><% } %>
                                                            <% if (article.views) { %> · <%= article.views %> views<% } %>
                                                        </div>
                                                    </td>
                                                    <% 
                                                        const showFullDetails = admin.role === 'superadmin' || (admin.permissions && admin.permissions.canViewReporterDetails);
                                                    %>
                                                    <td>
                                                        <div class="rn-author author-details-block" style="display:flex; flex-direction:column; gap:2px; min-width:160px;">
                                                            <% if (article.authorDetails && showFullDetails) { %>
                                                                <div style="font-weight: 600; color: #1e293b;"><i class="fas fa-user-circle" style="color:#3b82f6;"></i> <%= article.authorDetails.name || 'N/A' %></div>
                                                                <div style="font-size: 0.85rem; color: #64748b;"><%= article.authorDetails.email || article.author || 'N/A' %></div>
                                                                <% if (article.authorDetails.mobileNumber) { %>
                                                                    <div style="font-size: 0.85rem; color: #64748b;"><%= article.authorDetails.mobileNumber %></div>
                                                                <% } %>
                                                                <% if (article.authorDetails.constituency) { %>
                                                                    <div style="font-size: 0.85rem; color: #64748b;"><%= article.authorDetails.constituency %></div>
                                                                <% } %>
                                                            <% } else { %>
                                                                <div style="font-weight: 600; color: #1e293b;"><i class="fas fa-user-circle"></i> <%= article.author || 'N/A' %></div>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="rn-pill rn-pill-category"><%= article.category || 'N/A' %></span>
                                                        <% if (article.location) { %>
                                                            <span class="rn-pill rn-pill-location"><%= article.location %></span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (rejection.reason) { %>
                                                            <div class="rn-reason-box">
                                                                <p class="rn-reason-title"><%= rejection.reason %></p>
                                                                <% if (rejection.feedback) { %>
                                                                    <p class="rn-reason-feedback"><%= rejection.feedback %></p>
                                                                <% } %>
                                                            </div>
                                                        <% } else { %>
                                                            <span class="rn-reason-empty">No reason recorded</span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (rejectedAt) { %>
                                                            <div class="rn-date"><%= rejectedAt.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) %></div>
                                                            <div class="rn-date-time"><%= rejectedAt.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' }) %></div>
                                                        <% } else { %>
                                                            <span class="rn-reason-empty">—</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="rn-reviewer-cell">
                                                        <% if (article.reviewerDetails) { %>
                                                            <div class="rn-reviewer-name"><%= article.reviewerDetails.name || article.reviewerDetails.username || 'Unknown' %></div>
                                                            <% if (article.reviewerDetails.mobileNumber) { %>
                                                                <div style="font-size: 0.8rem; color: #64748b; margin-top: 2px;"><i class="fas fa-phone-alt" style="font-size:0.75rem;"></i> <%= article.reviewerDetails.mobileNumber %></div>
                                                            <% } %>
                                                            <span class="rn-reviewer-role mt-1 d-inline-block"><%= article.reviewerDetails.role ? article.reviewerDetails.role.charAt(0).toUpperCase() + article.reviewerDetails.role.slice(1) : (rejection.rejectedByRole || 'Editor') %></span>
                                                        <% } else { %>
                                                            <div class="rn-reviewer-name"><%= rejection.rejectedBy || 'Unknown' %></div>
                                                            <% if (rejection.rejectedByRole) { %>
                                                                <span class="rn-reviewer-role"><%= rejection.rejectedByRole %></span>
                                                            <% } %>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex gap-2">
                                                            <button type="button" class="rn-view-btn" onclick="viewRejectedArticle('<%= article._id %>')">
                                                                <i class="fas fa-newspaper"></i> View
                                                            </button>
                                                            <% if (admin && admin.role === 'superadmin') { %>
                                                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="quickRevert('<%= article._id %>', 'pending')" title="Move to Pending">
                                                                    <i class="fas fa-undo"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-sm btn-outline-success" onclick="quickRevert('<%= article._id %>', 'approved')" title="Approve Directly">
                                                                    <i class="fas fa-check-circle"></i>
                                                                </button>
                                                            <% } %>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="openSingleDeleteModal('<%= article._id %>')">
                                                                <i class="fas fa-trash"></i> Delete
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="rn-pagination">
                                        <div class="rn-pagination-info">
                                            Showing <%= totalRows === 0 ? 0 : ((currentPage - 1) * pageLimit) + 1 %>–<%= Math.min(currentPage * pageLimit, totalRows) %> of <%= totalRows %> articles
                                            <% if (totalPages > 1) { %> · Page <%= currentPage %> of <%= totalPages %><% } %>
                                        </div>
                                        <% if (totalPages > 1) { %>
                                        <div class="rn-pagination-nav">
                                            <a class="rn-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=1<%= paginationQuery %>" aria-label="First page"><i class="fas fa-angles-left"></i></a>
                                            <a class="rn-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=<%= currentPage - 1 %><%= paginationQuery %>" aria-label="Previous page"><i class="fas fa-angle-left"></i></a>
                                            <% 
                                                let startPage = Math.max(1, currentPage - 2);
                                                let endPage = Math.min(totalPages, currentPage + 2);
                                                if (endPage - startPage < 4) {
                                                    if (startPage === 1) endPage = Math.min(totalPages, startPage + 4);
                                                    else startPage = Math.max(1, endPage - 4);
                                                }
                                                for (let i = startPage; i <= endPage; i++) { %>
                                            <a class="rn-page-btn <%= i === currentPage ? 'active' : '' %>" href="?page=<%= i %><%= paginationQuery %>"><%= i %></a>
                                            <% } %>
                                            <a class="rn-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= currentPage + 1 %><%= paginationQuery %>" aria-label="Next page"><i class="fas fa-angle-right"></i></a>
                                            <a class="rn-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= totalPages %><%= paginationQuery %>" aria-label="Last page"><i class="fas fa-angles-right"></i></a>
                                        </div>
                                        <% } %>
                                    </div>
                                    <% } else { %>
                                    <div class="rn-empty">
                                        <div class="rn-empty-icon"><i class="fas fa-check"></i></div>
                                        <h3>No rejected articles</h3>
                                        <p><% if (currentSearch || currentReason || currentCategory) { %>No matches for your filters.<% } else { %>All submissions are published or pending review.<% } %></p>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Article Preview Modal -->
            <div class="modal fade" id="rejectDetailModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="rn-modal-header">
                            <div>
                                <h2 class="rn-modal-title" id="rejectModalTitle">Article preview</h2>
                                <p class="rn-modal-sub" id="rejectModalSub"></p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4" id="rejectModalBody">
                            <div class="rn-preview-loading"><i class="fas fa-spinner fa-spin me-2"></i>Loading article...</div>
                        </div>
                        <div class="modal-footer">
                            <% if (admin && admin.role === 'superadmin') { %>
                                <button type="button" class="btn btn-warning text-dark me-auto" onclick="revertRejectedArticle('pending')">
                                    <i class="fas fa-undo"></i> Move to Pending
                                </button>
                                <button type="button" class="btn btn-success me-2" onclick="revertRejectedArticle('approved')">
                                    <i class="fas fa-check-circle"></i> Approve Directly
                                </button>
                            <% } %>
                            <a href="#" id="rejectEditLink" class="btn btn-outline-primary" style="display:none;">
                                <i class="fas fa-pen me-1"></i> Edit article
                            </a>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete All Modal -->
            <div class="modal fade" id="deleteAllModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Delete All Rejected News</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete all rejected news? This action cannot be undone.</p>
                            <div class="mb-3">
                                <label for="deletePassword" class="form-label">Admin Password</label>
                                <input type="password" class="form-control" id="deletePassword" placeholder="Enter password to confirm">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" onclick="confirmDeleteAll()">Delete All</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Single Modal -->
            <div class="modal fade" id="deleteSingleModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Delete Rejected News</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete this rejected news article? This action cannot be undone.</p>
                            <div class="mb-3">
                                <label for="deleteSinglePassword" class="form-label">Admin Password</label>
                                <input type="password" class="form-control" id="deleteSinglePassword" placeholder="Enter password to confirm">
                                <input type="hidden" id="deleteSingleId">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" onclick="confirmDeleteSingle()">Delete</button>
                        </div>
                    </div>
                </div>
            </div>

            <script src="/js/rich-text.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>"></script>
            <script>
                window.rejectedArticlesData = <%- JSON.stringify(articles.map(function(a) {
                    return {
                        _id: a._id,
                        title: a.title,
                        author: a.author || '',
                        authorDetails: a.authorDetails || null,
                        reviewerDetails: a.reviewerDetails || null,
                        category: a.category || '',
                        location: a.location || '',
                        language: a.language || '',
                        views: a.views || 0,
                        rejectionStatus: a.rejectionStatus || {}
                    };
                })) %>;

                let rejectDetailModalInstance = null;
                let deleteAllModalInstance = null;
                let deleteSingleModalInstance = null;
                let currentArticleId = null;

                function openDeleteModal() {
                    const modalEl = document.getElementById('deleteAllModal');
                    if (!deleteAllModalInstance) {
                        deleteAllModalInstance = new bootstrap.Modal(modalEl);
                    }
                    document.getElementById('deletePassword').value = '';
                    deleteAllModalInstance.show();
                }

                function openSingleDeleteModal(id) {
                    const modalEl = document.getElementById('deleteSingleModal');
                    if (!deleteSingleModalInstance) {
                        deleteSingleModalInstance = new bootstrap.Modal(modalEl);
                    }
                    document.getElementById('deleteSinglePassword').value = '';
                    document.getElementById('deleteSingleId').value = id;
                    deleteSingleModalInstance.show();
                }

                async function confirmDeleteSingle() {
                    const password = document.getElementById('deleteSinglePassword').value;
                    const id = document.getElementById('deleteSingleId').value;
                    if (!password) {
                        alert('Please enter the password');
                        return;
                    }

                    try {
                        const response = await fetch('/admin/api/rejected-news/' + id, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ password })
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            alert(data.message);
                            window.location.reload();
                        } else {
                            alert(data.message || 'Error deleting rejected news');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('An error occurred while deleting rejected news.');
                    }
                }

                async function confirmDeleteAll() {
                    const password = document.getElementById('deletePassword').value;
                    if (!password) {
                        alert('Please enter the password');
                        return;
                    }

                    try {
                        const response = await fetch('/admin/api/rejected-news', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ password })
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            alert(data.message);
                            window.location.reload();
                        } else {
                            alert(data.message || 'Error deleting rejected news');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('An error occurred while deleting rejected news.');
                    }
                }

                function escapeHtml(str) {
                    if (typeof window.escapeHtml === 'function' && window.escapeHtml !== escapeHtml) {
                        return window.escapeHtml(str);
                    }
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                const canViewReporterDetails = <%= admin.role === 'superadmin' || (admin.permissions && admin.permissions.canViewReporterDetails) ? 'true' : 'false' %>;

                function formatDateTime(value) {
                    if (!value) return '—';
                    const d = new Date(value);
                    return d.toLocaleDateString() + ' at ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }

                function renderRichContent(text) {
                    if (typeof window.renderRichText === 'function') {
                        return window.renderRichText(text || '');
                    }
                    return escapeHtml(text || '').replace(/\n/g, '<br>');
                }

                function renderRejectedMedia(newsItem) {
                    const images = [];
                    if (Array.isArray(newsItem.imageUrls)) {
                        newsItem.imageUrls.filter(Boolean).forEach(function(url) { images.push(url); });
                    }
                    const primary = newsItem.mediaUrl || newsItem.imageUrl || newsItem.thumbnailUrl;
                    if (primary && images.indexOf(primary) === -1) {
                        images.unshift(primary);
                    }

                    if (newsItem.mediaType === 'video' && primary) {
                        return '<div class="rn-preview-media"><video controls playsinline preload="metadata"><source src="' +
                            escapeHtml(primary) + '" type="video/mp4"></video></div>';
                    }

                    if (images.length > 1) {
                        return '<div class="rn-preview-media"><div class="rn-preview-media-gallery">' +
                            images.map(function(url, index) {
                                return '<img src="' + escapeHtml(url) + '" alt="Photo ' + (index + 1) + '" loading="lazy">';
                            }).join('') + '</div></div>';
                    }

                    if (images.length === 1) {
                        return '<div class="rn-preview-media"><img src="' + escapeHtml(images[0]) + '" alt="Article image" loading="lazy"></div>';
                    }

                    return '';
                }

                function buildRejectionSidebar(article, rejection) {
                    let reviewerName = escapeHtml(rejection.rejectedBy || 'Unknown');
                    let reviewerRole = escapeHtml(rejection.rejectedByRole || 'Editor');
                    let reviewerPhone = '';

                    if (article.reviewerDetails) {
                        reviewerName = escapeHtml(article.reviewerDetails.name || article.reviewerDetails.username || 'Unknown');
                        if (article.reviewerDetails.role) {
                            reviewerRole = escapeHtml(article.reviewerDetails.role.charAt(0).toUpperCase() + article.reviewerDetails.role.slice(1));
                        }
                        if (article.reviewerDetails.mobileNumber) {
                            reviewerPhone = '<div class="rn-detail-item"><div class="rn-detail-label">Reviewer Phone</div><div class="rn-detail-value"><i class="fas fa-phone-alt" style="font-size:0.85rem; color:#64748b; margin-right:6px;"></i>' + escapeHtml(article.reviewerDetails.mobileNumber) + '</div></div>';
                        }
                    }

                    return '<div class="rn-preview-sidebar">' +
                        '<div class="rn-feedback-block">' +
                            '<h4><i class="fas fa-ban me-1"></i> ' + escapeHtml(rejection.reason || 'Rejected') + '</h4>' +
                            '<p>' + escapeHtml(rejection.feedback || 'No additional feedback was provided.') + '</p>' +
                        '</div>' +
                        '<div class="rn-detail-grid" style="grid-template-columns:1fr;">' +
                            '<div class="rn-detail-item"><div class="rn-detail-label">Rejected by</div><div class="rn-detail-value">' + reviewerName + '</div></div>' +
                            reviewerPhone +
                            '<div class="rn-detail-item"><div class="rn-detail-label">Role</div><div class="rn-detail-value">' + reviewerRole + '</div></div>' +
                            '<div class="rn-detail-item"><div class="rn-detail-label">Rejected at</div><div class="rn-detail-value">' + formatDateTime(rejection.rejectedAt) + '</div></div>' +
                            '<div class="rn-detail-item" style="grid-column: 1 / -1;"><div class="rn-detail-label">Reporter Details</div><div class="rn-detail-value" style="background:#f8f9fa; padding:10px; border-radius:8px;">' +
                                (article.authorDetails && canViewReporterDetails ? `
                                    <div style="font-weight:600; color:#1e293b;"><i class="fas fa-user-circle" style="color:#3b82f6;"></i> ${escapeHtml(article.authorDetails.name || 'N/A')}</div>
                                    <div style="font-size: 0.9rem; color:#475569;">${escapeHtml(article.authorDetails.email || article.author)}</div>
                                    ${article.authorDetails.mobileNumber ? `<div style="font-size: 0.9rem; color:#475569;">${escapeHtml(article.authorDetails.mobileNumber)}</div>` : ''}
                                    ${article.authorDetails.constituency ? `<div style="font-size: 0.9rem; color:#475569;">${escapeHtml(article.authorDetails.constituency)}</div>` : ''}
                                ` : escapeHtml(article.author || 'N/A')) +
                            '</div></div>' +
                            '<div class="rn-detail-item"><div class="rn-detail-label">Views</div><div class="rn-detail-value">' + (article.views || 0).toLocaleString() + '</div></div>' +
                        '</div>' +
                    '</div>';
                }

                function renderArticlePreview(newsItem) {
                    const rejection = newsItem.rejectionStatus || {};
                    const published = newsItem.publishedAt ? new Date(newsItem.publishedAt).toLocaleString() : '—';

                    document.getElementById('rejectModalTitle').textContent = 'Rejected article';
                    document.getElementById('rejectModalSub').textContent =
                        stripPlainText(newsItem.title || '') +
                        (newsItem.author ? ' · ' + newsItem.author : '');

                    const editLink = document.getElementById('rejectEditLink');
                    editLink.href = '/edit-news/' + newsItem._id;
                    editLink.style.display = 'inline-flex';

                    let sourceHtml = '';
                    if (newsItem.sourceLink) {
                        let sourceDisplay = escapeHtml(newsItem.sourceLink);
                        if (newsItem.sourceLink.startsWith('http')) {
                            sourceDisplay = '<a href="' + escapeHtml(newsItem.sourceLink) + '" target="_blank" rel="noopener" style="color: #d32f2f; text-decoration: underline;">' + escapeHtml(newsItem.sourceLink) + '</a>';
                        }
                        sourceHtml = '<div style="background-color: #ffeaea; border: 1px solid #ffb3b3; color: #cc0000; padding: 12px 16px; border-radius: 8px; margin-top: 16px; margin-bottom: 16px; font-size: 0.95rem;">' +
                            '<i class="fas fa-link me-2"></i><strong>Source:</strong> ' + sourceDisplay +
                        '</div>';
                    }

                    document.getElementById('rejectModalBody').innerHTML =
                        '<div class="rn-preview-layout">' +
                            '<div class="rn-preview-main">' +
                                renderRejectedMedia(newsItem) +
                                sourceHtml +
                                '<div class="rn-preview-meta">' +
                                    '<span class="rn-preview-pill rejected"><i class="fas fa-ban"></i> Rejected</span>' +
                                    '<span class="rn-preview-pill"><i class="fas fa-tag"></i> ' + escapeHtml(newsItem.category || 'General') + '</span>' +
                                    (newsItem.location ? '<span class="rn-preview-pill"><i class="fas fa-map-marker-alt"></i> ' + escapeHtml(newsItem.location) + '</span>' : '') +
                                    (newsItem.language ? '<span class="rn-preview-pill">' + escapeHtml(String(newsItem.language).toUpperCase()) + '</span>' : '') +
                                    '<span class="rn-preview-pill"><i class="far fa-clock"></i> ' + published + '</span>' +
                                '</div>' +
                                '<h1 class="rn-preview-title rich-content-area">' + renderRichContent(newsItem.title) + '</h1>' +
                                '<div class="rn-preview-content rich-content-area">' + renderRichContent(newsItem.content) + '</div>' +
                            '</div>' +
                            buildRejectionSidebar(newsItem, rejection) +
                        '</div>';
                }

                function stripPlainText(text) {
                    if (typeof window.stripRichTags === 'function') {
                        return window.stripRichTags(text || '');
                    }
                    return String(text || '').replace(/\[[^\]]*\]/g, '');
                }

                async function viewRejectedArticle(id) {
                    currentArticleId = id;
                    const cached = window.rejectedArticlesData.find(function(a) { return String(a._id) === String(id); });
                    const modalEl = document.getElementById('rejectDetailModal');
                    document.getElementById('rejectModalBody').innerHTML =
                        '<div class="rn-preview-loading"><i class="fas fa-spinner fa-spin me-2"></i>Loading article...</div>';
                    document.getElementById('rejectModalTitle').textContent = cached ? stripPlainText(cached.title) : 'Article preview';
                    document.getElementById('rejectModalSub').textContent = cached ? (cached.author || '') : '';
                    document.getElementById('rejectEditLink').style.display = 'none';

                    if (!rejectDetailModalInstance) {
                        rejectDetailModalInstance = new bootstrap.Modal(modalEl);
                    }
                    rejectDetailModalInstance.show();

                    try {
                        const response = await fetch('/news/api/news/' + id);
                        if (!response.ok) {
                            throw new Error('Could not load article');
                        }
                        const newsItem = await response.json();
                        renderArticlePreview(newsItem);
                    } catch (error) {
                        console.error(error);
                        document.getElementById('rejectModalBody').innerHTML =
                            '<div class="rn-empty"><div class="rn-empty-icon"><i class="fas fa-exclamation-triangle"></i></div>' +
                            '<h3>Unable to load article</h3><p>Please try again or open the edit page directly.</p></div>';
                        if (cached) {
                            const editLink = document.getElementById('rejectEditLink');
                            editLink.href = '/edit-news/' + id;
                            editLink.style.display = 'inline-flex';
                        }
                    }
                }

                async function revertRejectedArticle(targetState) {
                    if (!currentArticleId) return;
                    
                    const confirmMsg = targetState === 'pending' 
                        ? 'Are you sure you want to move this article back to Pending Review?' 
                        : 'Are you sure you want to Approve and Publish this article directly?';
                        
                    if (!confirm(confirmMsg)) return;

                    try {
                        const btn = event.currentTarget;
                        const originalHtml = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                        btn.disabled = true;

                        const response = await fetch(`/admin/api/rejected-news/${currentArticleId}/revert`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ targetState })
                        });
                        
                        const data = await response.json();
                        
                        if (response.ok && data.success) {
                            alert(data.message);
                            window.location.reload();
                        } else {
                            btn.innerHTML = originalHtml;
                            btn.disabled = false;
                            alert(data.error || data.message || 'Error updating article state');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('An error occurred. Please try again.');
                        const btn = event.currentTarget;
                        btn.disabled = false;
                    }
                }

                async function quickRevert(id, targetState) {
                    const confirmMsg = targetState === 'pending' 
                        ? 'Are you sure you want to move this article back to Pending Review?' 
                        : 'Are you sure you want to Approve and Publish this article directly?';
                        
                    if (!confirm(confirmMsg)) return;

                    try {
                        const btn = event.currentTarget;
                        const originalHtml = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                        btn.disabled = true;

                        const response = await fetch(`/admin/api/rejected-news/${id}/revert`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ targetState })
                        });
                        
                        const data = await response.json();
                        
                        if (response.ok && data.success) {
                            alert(data.message);
                            window.location.reload();
                        } else {
                            btn.innerHTML = originalHtml;
                            btn.disabled = false;
                            alert(data.error || data.message || 'Error updating article state');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('An error occurred. Please try again.');
                        const btn = event.currentTarget;
                        btn.disabled = false;
                    }
                }
            </script>

            <%- include('partials/footer') %>
    </body>

</html>
