<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: (typeof ad !=='undefined' ? 'Edit Ad' : 'Add Ad' ) + ' - Short News Admin' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <style>
        /* Image preview carousel */
        .image-preview-container {
            position: relative;
            width: 100%;
            max-width: 300px;
            margin: 0 auto;
        }

        .image-preview-item {
            display: none;
        }

        .image-preview-item.active {
            display: block;
        }

        .carousel-controls {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.5);
            color: white;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
        }

        .carousel-prev {
            left: 10px;
        }

        .carousel-next {
            right: 10px;
        }

        .image-indicators {
            display: flex;
            justify-content: center;
            margin-top: 10px;
            gap: 5px;
        }

        .indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ccc;
            cursor: pointer;
        }

        .indicator.active {
            background: #007bff;
        }

        .remove-image-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(255, 0, 0, 0.7);
            color: white;
            border: none;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            cursor: pointer;
        }

        /* Settings section */
        .settings-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        /* Crop Modal Styles */
        .crop-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
        }

        .crop-modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .crop-container {
            background: white;
            border-radius: 10px;
            padding: 20px;
            max-width: 90%;
            max-height: 90vh;
            overflow: auto;
        }

        .crop-image-container {
            max-width: 100%;
            max-height: 60vh;
            margin: 20px 0;
        }

        .crop-image-container img {
            max-width: 100%;
            display: block;
        }

        .crop-controls {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
        }

        .aspect-ratio-info {
            background: #e3f2fd;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            text-align: center;
        }

        /* Safe Area Indicator */
        .cropper-container {
            position: relative;
        }

        .safe-area-box {
            position: absolute;
            top: 5%;
            left: 5%;
            width: 90%;
            height: 90%;
            border: 2px dashed rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .safe-area-box::after {
            content: 'Safe Area';
            color: rgba(255, 255, 255, 0.6);
            font-size: 12px;
            background: rgba(0, 0, 0, 0.3);
            padding: 2px 8px;
            border-radius: 4px;
        }
    </style>
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: typeof ad !=='undefined' ? 'Edit Ad' : 'Add Ad' , backButton: true,
            backUrl: '/ads' , actions: [ { id: 'saveAdButtonDesktop' , icon: 'fas fa-save' , text: (typeof ad
            !=='undefined' ? 'Update Ad' : 'Save Ad' ), class: 'btn-primary' } ] }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'ads' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                            <div class="content-area">
                                <div class="row justify-content-center">
                                    <div class="col-lg-8">
                                        <div class="card">
                                            <div class="card-body">
                                                <h3 class="card-title mb-3">
                                                    <%= typeof ad !=='undefined' ? 'Edit Ad' : 'Create New Ad' %>
                                                </h3>

                                                <!-- 📖 Complete Telugu guide (bible) — collapsible -->
                                                <div class="mb-4">
                                                    <button class="btn btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#adsGuide" aria-expanded="false">
                                                        <span><i class="fas fa-book-open me-2"></i><b>📖 Ads పూర్తి గైడ్</b> — ఏ field ఎందుకు, ఎలా పెట్టాలి (తెలుగులో)</span>
                                                        <i class="fas fa-chevron-down"></i>
                                                    </button>
                                                    <div class="collapse mt-2" id="adsGuide">
                                                        <div class="p-3" style="background:#f7f9ff;border:1px solid #d9e2ff;border-radius:10px;font-size:13.5px;line-height:1.7;color:#2b3440">
                                                            <div style="color:#555;margin-bottom:10px">👉 ఒక ad పెట్టడం = ① భాష ② Title + Image ③ ఎక్కడికి వెళ్ళాలి (link) ④ ఎంత తరచుగా, ఎంత display. కింద ప్రతిదీ వివరంగా ఉంది.</div>

                                                            <div class="mb-2"><b>① Language</b> — ఈ ad ఏ భాష feed లో చూపించాలి. (Telugu ఎంచుకుంటే Telugu users కే కనిపిస్తుంది.)</div>
                                                            <div class="mb-2"><b>② Ad Format</b> — <b>Image Only</b> (full-screen image, సాధారణం) లేదా <b>News Format</b> (image + text + button). మొదటిది recommended.</div>
                                                            <div class="mb-2"><b>③ Title / Content</b> — Title తప్పనిసరి (మీ గుర్తుకి + news format లో చూపిస్తుంది). Content optional.</div>
                                                            <div class="mb-2"><b>④ Image</b> — <b>9:20 (1080×2400) portrait</b>. Upload నొక్కి crop చేయండి (ads అన్నీ ఇదే size). పూర్తి screen నిండుతుంది.</div>
                                                            <div class="mb-2"><b>⑤ Ad destination (link)</b> — ad మీద tap చేస్తే ఎక్కడికి వెళ్ళాలి: external website (https://…) లేదా in-app page (Quiz/Games/Viral… dropdown). ఖాళీగా ఉంటే ఎక్కడికీ వెళ్ళదు.</div>

                                                            <hr style="margin:12px 0">
                                                            <div style="font-weight:700;color:#1b5e20;margin-bottom:6px">💠 ఎంత తరచుగా / ఎంత display (ముఖ్యం)</div>
                                                            <div class="mb-2"><b>⑥ Position Interval</b> — ఈ ad <b>ప్రతి ఎన్ని news cards కి ఒకసారి</b> రావాలి. ⚠️ ఒకే భాషలో చాలా ads ఉంటే అవన్నీ కలిసి వస్తాయి — కింద 🟢/🟡/🔴 suggestion చూస్తూ పెట్టండి. <b>ప్రతి 6+ cards కి ఒక ad మంచిది</b> (irritation రాదు).</div>
                                                            <div class="mb-2"><b>⑦ Priority</b> — ఒకే spot లో రెండు ads వస్తే <b>High</b> ముందు (ఎక్కువసార్లు). important/paid → High, filler → Low. అన్నిటికీ High వద్దు.</div>
                                                            <div class="mb-2"><b>⑧ 💰 Bid / Amount</b> — advertiser ఎంత చెల్లిస్తున్నారో. <b>ఎక్కువ amount = ఎక్కువ display</b> (auction లా). ₹500 ad, ₹100 ad కన్నా ~5× ఎక్కువ కనిపిస్తుంది. 0 = bid లేదు.</div>
                                                            <div class="mb-2"><b>⑨ 🎯 Impression budget</b> — ఈ ad <b>మొత్తం ఎన్నిసార్లు</b> చూపించాలి. ఆ limit చేరగానే ad <b>automatic ఆగిపోతుంది</b>. 0 = unlimited. (paid ad కి advertiser కొన్న impressions పెట్టండి.)</div>

                                                            <hr style="margin:12px 0">
                                                            <div style="font-weight:700;color:#7a4f01;margin-bottom:6px">⚙️ Advanced (irritation రాకుండా)</div>
                                                            <div class="mb-2"><b>⑩ Max Views Per Day</b> — <b>ఒక user కి రోజుకి</b> ఈ ad max ఎన్నిసార్లు. (ఉదా 3 → ఒక్కొక్కరికి రోజుకి 3 సార్లే.)</div>
                                                            <div class="mb-2"><b>⑪ Cooldown (hours)</b> — ఒక user ఈ ad చూశాక <b>మళ్ళీ చూపించేలోపు కనీస gap</b> (గంటల్లో).</div>
                                                            <div class="mb-2"><b>⑫ Schedule</b> — ad ని <b>ఒక తేదీ నుంచి ఒక తేదీ వరకే</b> active చేయాలంటే ON చేసి dates పెట్టండి. (లేకపోతే ఎప్పుడూ active.)</div>
                                                            <div class="mb-2"><b>⑬ AdMob</b> — మన image కాకుండా <b>Google ads</b> చూపించాలంటే ON. (సాధారణ promotions కి OFF.)</div>
                                                            <div class="mb-2"><b>⑭ Show bottom bar</b> — ad కింద WhatsApp/Viral/Share నావిగేషన్ బార్. కావాల్సిన ad కే ON.</div>

                                                            <hr style="margin:12px 0">
                                                            <div style="font-weight:700;color:#0b4a8a;margin-bottom:6px">⭐ Professional tips</div>
                                                            <div style="color:#333">• ఒకే భాషలో <b>1–2 ముఖ్యమైన ads</b> + comfortable interval (6+) → users irritate అవ్వరు.<br>• paid ad కి <b>High priority + Bid + Budget</b> పెట్టండి → ఎక్కువ కనిపిస్తూ, డబ్బు విలువకి తగ్గట్టు ఆగుతుంది.<br>• ఎక్కువైతే Ads page లో <b>Auto-fix</b> నొక్కి intervals సరిచేయండి.</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <form id="addAdForm">
                                                    <input type="hidden" id="adId"
                                                        value="<%= typeof ad !== 'undefined' ? ad._id : '' %>">
                                                    <div class="mb-3">
                                                        <label for="language" class="form-label">Ad Language</label>
                                                        <select class="form-select" id="language" required>
                                                            <option value="" disabled <%= typeof ad === 'undefined' ? 'selected' : '' %>>Select Language</option>
                                                            <% if (typeof languages !== 'undefined' && languages.length > 0) { %>
                                                                <% languages.forEach(function(lang) { %>
                                                                    <option value="<%= lang.code %>" 
                                                                        <%= (typeof ad !== 'undefined' && ad.language === lang.code) ? 'selected' : '' %>>
                                                                        <%= lang.name %> (<%= lang.nativeName %>)
                                                                    </option>
                                                                <% }); %>
                                                            <% } else { %>
                                                                <option value="en" <%= (typeof ad !== 'undefined' && ad.language === 'en') ? 'selected' : '' %>>English (Default)</option>
                                                            <% } %>
                                                        </select>
                                                        <div class="form-text">The ad will only be shown to users who selected this language.</div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="category" class="form-label">Ad Category <span class="text-muted">(optional)</span></label>
                                                        <select class="form-select" id="category">
                                                            <option value="">General / No category</option>
                                                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                                                <% categories.forEach(function(cat) { %>
                                                                    <option value="<%= cat.name %>" <%= (typeof ad !== 'undefined' && ad.category === cat.name) ? 'selected' : '' %>><%= cat.name %></option>
                                                                <% }); %>
                                                            <% } %>
                                                        </select>
                                                        <div class="form-text">
                                                            A news category this ad best fits. Used later to show the ad more to users who read that kind of news. తెలుగు: ఈ ad ఏ రకం news కి సరిపోతుందో ఆ category ఎంచుకోండి — ఆ category చదివే users కి ఇది ఎక్కువ చూపిస్తాం. తెలీకపోతే "General" ఉంచండి.
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="adFormat" class="form-label">Ad Format</label>
                                                        <select class="form-select" id="adFormat">
                                                            <option value="image_only" <%= (typeof ad !== 'undefined' && ad.adFormat === 'image_only') ? 'selected' : '' %>>Image Only (Full Screen)</option>
                                                            <option value="news_format" <%= (typeof ad !== 'undefined' && ad.adFormat === 'news_format') ? 'selected' : '' %>>News Format (Text + Button)</option>
                                                        </select>
                                                        <div class="form-text">Choose how the ad is displayed in the app.</div>
                                                    </div>

                                                    <div class="mb-3" id="buttonTextContainer" style="display: <%= (typeof ad !== 'undefined' && ad.adFormat === 'news_format') ? 'block' : 'none' %>;">
                                                        <label for="buttonText" class="form-label">Button Text (For News Format)</label>
                                                        <input type="text" class="form-control" id="buttonText"
                                                            placeholder="e.g., Refer and Earn ₹5"
                                                            value="<%= typeof ad !== 'undefined' ? ad.buttonText : '' %>">
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="title" class="form-label">Ad Title</label>
                                                        <input type="text" class="form-control" id="title"
                                                            placeholder="Enter ad title"
                                                            value="<%= typeof ad !== 'undefined' ? ad.title : '' %>"
                                                            required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="content" class="form-label">Ad Content
                                                            (Optional)</label>
                                                        <textarea class="form-control" id="content" rows="4"
                                                            placeholder="Enter ad content"><%= typeof ad !== 'undefined' ? ad.content : '' %></textarea>
                                                    </div>

                                                    <!-- Multiple Image Upload Section -->
                                                    <div class="mb-3">
                                                        <label class="form-label">Ad Images</label>
                                                        <div class="border rounded p-3 mb-3">
                                                            <div class="d-flex flex-column align-items-center">
                                                                <!-- Hidden input to store all image URLs -->
                                                                <input type="hidden" id="imageUrls"
                                                                    value="<%= typeof ad !== 'undefined' && ad.imageUrls ? ad.imageUrls.join(',') : (typeof ad !== 'undefined' && ad.imageUrl ? ad.imageUrl : '') %>">

                                                                <!-- Image preview carousel -->
                                                                <div class="image-preview-container mb-3">
                                                                    <div id="imagePreviewCarousel"></div>
                                                                    <div class="image-indicators" id="imageIndicators">
                                                                    </div>
                                                                </div>

                                                                <button type="button"
                                                                    class="btn btn-outline-primary ripple"
                                                                    id="uploadImageButton">
                                                                    <i class="fas fa-upload me-1"></i> Upload Images
                                                                </button>
                                                                <input type="file" id="imageUpload" accept="image/*,video/*" multiple class="d-none">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="linkUrl" class="form-label">Ad destination (Optional)</label>
                                                        <select class="form-select mb-2" id="internalPage" onchange="if(this.value){document.getElementById('linkUrl').value=this.value;}">
                                                            <option value="">— External website URL (type below) —</option>
                                                            <option value="app://profile">In-app page: Profile</option>
                                                            <option value="app://quiz">In-app page: Quiz</option>
                                                            <option value="app://games">In-app page: Games</option>
                                                            <option value="app://viral">In-app page: Viral Videos</option>
                                                            <option value="app://long">In-app page: Long Videos</option>
                                                            <option value="app://home">In-app page: Home</option>
                                                            <option value="app://referral">In-app page: Referral</option>
                                                        </select>
                                                        <input type="text" class="form-control" id="linkUrl"
                                                            placeholder="https://example.com   OR   app://quiz"
                                                            value="<%= typeof ad !== 'undefined' ? ad.linkUrl : '' %>">
                                                        <div class="form-text">External website URL పెట్టండి, లేదా పైన in-app page ఎంచుకోండి (tap చేస్తే ఆ app page తెరుచుకుంటుంది).</div>
                                                        <script>
                                                          (function(){var lu=document.getElementById('linkUrl');var sel=document.getElementById('internalPage');if(lu&&sel&&lu.value.indexOf('app://')===0){for(var i=0;i<sel.options.length;i++){if(sel.options[i].value===lu.value){sel.selectedIndex=i;break;}}}})();
                                                        </script>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="positionInterval" class="form-label">Position
                                                            Interval</label>
                                                        <input type="number" class="form-control" id="positionInterval"
                                                            min="1" max="100" placeholder="e.g., 3"
                                                            value="<%= typeof ad !== 'undefined' ? ad.positionInterval : 3 %>">
                                                        <div class="form-text">Position where the ad should appear in
                                                            the news feed (e.g., every 5th news item)</div>
                                                        <!-- Live "feed comfort" suggestion -->
                                                        <div id="intervalHint" style="margin-top:8px;font-size:13px;border-radius:8px;padding:9px 11px;display:none"></div>
                                                        <button type="button" id="recBtn" class="btn btn-sm btn-outline-success mt-2" style="display:none"><i class="fas fa-magic me-1"></i>Recommended: <span id="recVal">6</span></button>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="priority" class="form-label">Ad Priority</label>
                                                        <select class="form-select" id="priority">
                                                            <option value="high" <%=(typeof ad !=='undefined' &&
                                                                ad.priority==='high' ) ? 'selected' : '' %>>High (Shown
                                                                first)</option>
                                                            <option value="medium" <%=(typeof ad !=='undefined' &&
                                                                (ad.priority==='medium' || !ad.priority)) ? 'selected'
                                                                : '' %>>Medium</option>
                                                            <option value="low" <%=(typeof ad !=='undefined' &&
                                                                ad.priority==='low' ) ? 'selected' : '' %>>Low</option>
                                                        </select>
                                                        <div class="form-text">
                                                            <b>Priority ఎలా పనిచేస్తుంది:</b> ఒకే spot లో రెండు ads వచ్చే సమయంలో <b>High</b> ad ముందు చూపిస్తుంది (అంటే అది <b>ఎక్కువసార్లు</b> కనిపిస్తుంది), Low తక్కువసార్లు.<br>
                                                            <b>సలహా:</b> paid/important ads కి <b>High</b>, సాధారణ promotions కి <b>Medium</b>, filler ads కి <b>Low</b> పెట్టండి. అన్నిటికీ High పెడితే priority కి అర్థం ఉండదు — ముఖ్యమైన 1–2 వాటికే High.
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="bidAmount" class="form-label">💰 Bid / Amount (advertiser ఎంత చెల్లిస్తున్నారు)</label>
                                                        <input type="number" class="form-control" id="bidAmount" min="0" step="1" placeholder="0"
                                                            value="<%= typeof ad !== 'undefined' && ad.bidAmount ? ad.bidAmount : 0 %>">
                                                        <div class="form-text"><b>ఎక్కువ amount = ఎక్కువ display.</b> ఒకే భాషలో ads మధ్య ఇది "auction" లా పనిచేస్తుంది — ఎక్కువ pay చేసిన ad proportionally ఎక్కువసార్లు కనిపిస్తుంది. 0 = bid లేదు (priority ఆధారంగా). ఉదా: ₹500 ad, ₹100 ad కన్నా ~5× ఎక్కువ.</div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="maxImpressions" class="form-label">🎯 Impression budget (మొత్తం ఎన్నిసార్లు చూపించాలి)</label>
                                                        <input type="number" class="form-control" id="maxImpressions" min="0" step="100" placeholder="0 = unlimited"
                                                            value="<%= typeof ad !== 'undefined' && ad.maxImpressions ? ad.maxImpressions : 0 %>">
                                                        <div class="form-text">
                                                            ఈ ad మొత్తం <b>ఎన్నిసార్లు (views)</b> చూపించాలో limit. ఆ సంఖ్య చేరగానే ad <b>automatic గా ఆగిపోతుంది</b> (paused). <b>0 = unlimited.</b> (paid ad కి advertiser కొన్న impressions పెట్టండి.)
                                                            <% if (typeof ad !== 'undefined' && ad._id) { %><br>ఇప్పటి వరకు చూపించినవి: <b><%= ad.impressionCount || 0 %></b><% } %>
                                                        </div>
                                                    </div>

                                                    <div class="form-check form-switch mb-3">
                                                        <input class="form-check-input" type="checkbox" id="showBottomBar"
                                                            <%= (typeof ad !== 'undefined' && ad.showBottomBar === true) ? 'checked' : '' %>>
                                                        <label class="form-check-label" for="showBottomBar">Show bottom bar (Viral / WhatsApp / 3-dots / Share)</label>
                                                        <div class="form-text">ఈ ఒక్క ad కింద మాత్రమే WhatsApp/Viral/Share నావిగేషన్ బార్ చూపిస్తుంది. Default: OFF.</div>
                                                    </div>

                                                    </div>

                                                    <!-- Ad Schedule -->
                                                    <div class="settings-section">
                                                        <h5 class="mb-1"><i class="fas fa-clock me-2"></i>Ad Schedule</h5>
                                                        <div class="text-muted small mb-3">ఈ ad ని ఒక తేదీ నుంచి ఒక తేదీ వరకే active చేయాలంటే వాడండి (optional).</div>
                                                        <div class="form-check form-switch mb-3">
                                                            <input class="form-check-input" type="checkbox" id="scheduleEnabled"
                                                                <%= (typeof ad !== 'undefined' && ad.scheduleEnabled) ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="scheduleEnabled">Enable schedule (auto active/inactive)</label>
                                                        </div>
                                                        <div id="scheduleFields" style="<%= (typeof ad !== 'undefined' && ad.scheduleEnabled) ? '' : 'display:none;' %>">
                                                            <div class="row">
                                                                <div class="col-md-6 mb-3">
                                                                    <label for="scheduleStart" class="form-label">Start date &amp; time</label>
                                                                    <input type="datetime-local" class="form-control" id="scheduleStart"
                                                                        value="<%= typeof ad !== 'undefined' && ad.scheduleStart ? toDatetimeLocalValue(ad.scheduleStart) : '' %>">
                                                                    <div class="form-text">Ad becomes active at this time.</div>
                                                                </div>
                                                                <div class="col-md-6 mb-3">
                                                                    <label for="scheduleEnd" class="form-label">End date &amp; time</label>
                                                                    <input type="datetime-local" class="form-control" id="scheduleEnd"
                                                                        value="<%= typeof ad !== 'undefined' && ad.scheduleEnd ? toDatetimeLocalValue(ad.scheduleEnd) : '' %>">
                                                                    <div class="form-text">Ad becomes inactive after this time.</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Intelligent Ad Settings -->
                                                    <div class="settings-section">
                                                        <h5 class="mb-1"><i class="fas fa-brain me-2"></i>Intelligent Ad
                                                            Settings</h5>
                                                        <div class="text-muted small mb-3">ఒక user కి ఈ ad ఎన్నిసార్లు / ఎంత gap తో చూపించాలి — irritation రాకుండా.</div>

                                                        <div class="row">
                                                            <div class="col-md-6 mb-3">
                                                                <label for="maxViewsPerDay" class="form-label">Max Views
                                                                    Per Day</label>
                                                                <input type="number" class="form-control"
                                                                    id="maxViewsPerDay" min="1" max="10"
                                                                    value="<%= typeof ad !== 'undefined' ? ad.maxViewsPerDay : 3 %>">
                                                                <div class="form-text">Maximum number of times this ad
                                                                    can be shown to a user per day</div>
                                                            </div>
                                                            <div class="col-md-6 mb-3">
                                                                <label for="cooldownPeriodHours"
                                                                    class="form-label">Cooldown Period (Hours)</label>
                                                                <input type="number" class="form-control"
                                                                    id="cooldownPeriodHours" min="1" max="168"
                                                                    value="<%= typeof ad !== 'undefined' ? ad.cooldownPeriodHours : 24 %>">
                                                                <div class="form-text">Minimum hours between showing
                                                                    this ad to the same user</div>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-md-6 mb-3">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox"
                                                                        id="frequencyControlEnabled" <%=(typeof ad
                                                                        !=='undefined' && ad.frequencyControlEnabled
                                                                        !==false) ? 'checked' : '' %>>
                                                                    <label class="form-check-label"
                                                                        for="frequencyControlEnabled">Enable Frequency
                                                                        Control</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6 mb-3">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox"
                                                                        id="userBehaviorTrackingEnabled" <%=(typeof ad
                                                                        !=='undefined' && ad.userBehaviorTrackingEnabled
                                                                        !==false) ? 'checked' : '' %>>
                                                                    <label class="form-check-label"
                                                                        for="userBehaviorTrackingEnabled">Enable User
                                                                        Behavior Tracking</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- AdMob Integration Settings -->
                                                    <div class="settings-section">
                                                        <h5 class="mb-1"><i class="fas fa-ad me-2"></i>AdMob Integration
                                                        </h5>
                                                        <div class="text-muted small mb-3">మన image కాకుండా Google ads చూపించాలంటే మాత్రమే ON చేయండి.</div>

                                                        <div class="form-check form-switch mb-3">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="useAdMob" <%=(typeof ad !=='undefined' &&
                                                                ad.useAdMob===true) ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="useAdMob">Use AdMob for
                                                                this ad</label>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-md-6 mb-3">
                                                                <label for="adMobAppId" class="form-label">AdMob App
                                                                    ID</label>
                                                                <input type="text" class="form-control" id="adMobAppId"
                                                                    placeholder="ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy"
                                                                    value="<%= typeof ad !== 'undefined' ? ad.adMobAppId : '' %>">
                                                                <div class="form-text">AdMob App ID for this ad
                                                                    (overrides default)</div>
                                                            </div>
                                                            <div class="col-md-6 mb-3">
                                                                <label for="adMobUnitId" class="form-label">AdMob Unit
                                                                    ID</label>
                                                                <input type="text" class="form-control" id="adMobUnitId"
                                                                    placeholder="ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy"
                                                                    value="<%= typeof ad !== 'undefined' ? ad.adMobUnitId : '' %>">
                                                                <div class="form-text">AdMob Unit ID for this ad
                                                                    (overrides default)</div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="d-grid gap-2 d-md-none">
                                                        <button type="button" class="btn btn-primary ripple"
                                                            id="saveAdButtonMobile">
                                                            <i class="fas fa-save me-1"></i>
                                                            <%= typeof ad !=='undefined' ? 'Update Ad' : 'Save Ad' %>
                                                        </button>
                                                        <button type="button" class="btn btn-secondary ripple"
                                                            onclick="window.location.href='/ads'">
                                                            <i class="fas fa-times me-1"></i> Cancel
                                                        </button>
                                                    </div>
                                                    <div class="d-none d-md-flex justify-content-end gap-2 mt-4">
                                                        <button type="button" class="btn btn-secondary ripple"
                                                            onclick="window.location.href='/ads'">
                                                            <i class="fas fa-times me-1"></i> Cancel
                                                        </button>
                                                        <button type="button" class="btn btn-primary ripple"
                                                            id="saveAdButton">
                                                            <i class="fas fa-save me-1"></i>
                                                            <%= typeof ad !=='undefined' ? 'Update Ad' : 'Save Ad' %>
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Crop Modal -->
            <div class="crop-modal" id="cropModal">
                <div class="crop-container">
                    <div class="aspect-ratio-info">
                        <h5><i class="fas fa-crop me-2"></i>Image Crop - 9:20 Ratio</h5>
                    </div>
                    <div class="crop-image-container">
                        <img id="cropImage" src="" alt="Crop preview">
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted">Important content should stay inside the "Safe Area" dashed
                            lines.</small>
                    </div>
                    <div class="crop-controls">
                        <button type="button" class="btn btn-secondary" id="cancelCrop">
                            <i class="fas fa-times me-1"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-primary" id="applyCrop">
                            <i class="fas fa-check me-1"></i> Crop & Upload
                        </button>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
                <script>
                    // Current image index for carousel
                    let currentImageIndex = 0;
                    // Array to store all image URLs
                    let imageUrls = [];

                    // Initialize image URLs from hidden input
                    document.addEventListener('DOMContentLoaded', function () {
                        const imageUrlsInput = document.getElementById('imageUrls');
                        if (imageUrlsInput && imageUrlsInput.value) {
                            imageUrls = imageUrlsInput.value.split(',').filter(url => url.trim() !== '');
                        }

                        const scheduleEnabled = document.getElementById('scheduleEnabled');
                        const scheduleFields = document.getElementById('scheduleFields');
                        if (scheduleEnabled && scheduleFields) {
                            scheduleEnabled.addEventListener('change', function () {
                                scheduleFields.style.display = this.checked ? '' : 'none';
                            });
                        }

                        const adFormatSelect = document.getElementById('adFormat');
                        const buttonTextContainer = document.getElementById('buttonTextContainer');
                        if (adFormatSelect && buttonTextContainer) {
                            adFormatSelect.addEventListener('change', function() {
                                if (this.value === 'news_format') {
                                    buttonTextContainer.style.display = 'block';
                                } else {
                                    buttonTextContainer.style.display = 'none';
                                }
                            });
                        }

                        updateCarousel();
                        setupMobileMenu();
                    });

                    // Add Ad Function
                    async function saveAd() {
                        const adId = document.getElementById('adId').value;
                        const title = document.getElementById('title').value;
                        const content = document.getElementById('content').value;
                        const adFormat = document.getElementById('adFormat').value;
                        const buttonText = document.getElementById('buttonText').value;
                        const linkUrl = document.getElementById('linkUrl').value;
                        const positionInterval = document.getElementById('positionInterval').value;
                        const maxViewsPerDay = document.getElementById('maxViewsPerDay').value;
                        const cooldownPeriodHours = document.getElementById('cooldownPeriodHours').value;
                        const frequencyControlEnabled = document.getElementById('frequencyControlEnabled').checked;
                        const userBehaviorTrackingEnabled = document.getElementById('userBehaviorTrackingEnabled').checked;
                        const priority = document.getElementById('priority').value;
                        const bidAmount = parseFloat(document.getElementById('bidAmount').value) || 0;
                        const maxImpressions = parseInt(document.getElementById('maxImpressions').value, 10) || 0;
                        const language = document.getElementById('language').value;
                        const category = document.getElementById('category').value;

                        // AdMob fields
                        const useAdMob = document.getElementById('useAdMob').checked;
                        const adMobAppId = document.getElementById('adMobAppId').value;
                        const adMobUnitId = document.getElementById('adMobUnitId').value;
                        const scheduleEnabled = document.getElementById('scheduleEnabled').checked;
                        const scheduleStart = document.getElementById('scheduleStart').value;
                        const scheduleEnd = document.getElementById('scheduleEnd').value;
                        const showBottomBar = document.getElementById('showBottomBar').checked;

                        // Validate required fields
                        if (!language) {
                            showFeedback('Please select a language', 'error');
                            return;
                        }
                        if (!title) {
                            showFeedback('Please enter a title', 'error');
                            return;
                        }
                        if (scheduleEnabled && (!scheduleStart || !scheduleEnd)) {
                            showFeedback('Please select both schedule start and end time', 'error');
                            return;
                        }
                        if (scheduleEnabled && new Date(scheduleEnd) <= new Date(scheduleStart)) {
                            showFeedback('Schedule end must be after schedule start', 'error');
                            return;
                        }

                        // Get image URLs from the array
                        const imageUrl = imageUrls.length > 0 ? imageUrls[0] : '';

                        const adData = {
                            title,
                            content,
                            imageUrl, // Keep for backward compatibility
                            imageUrls, // New field for multiple images
                            linkUrl,
                            positionInterval: parseInt(positionInterval),
                            maxViewsPerDay: parseInt(maxViewsPerDay),
                            cooldownPeriodHours: parseInt(cooldownPeriodHours),
                            frequencyControlEnabled,
                            userBehaviorTrackingEnabled,
                            priority,
                            bidAmount,
                            maxImpressions,
                            language,
                            category,
                            showBottomBar,
                            // AdMob fields
                            useAdMob,
                            adMobAppId,
                            adMobUnitId,
                            scheduleEnabled,
                            scheduleStart: scheduleEnabled ? scheduleStart : null,
                            scheduleEnd: scheduleEnabled ? scheduleEnd : null
                        };

                        try {
                            let response;
                            if (adId) {
                                response = await fetch(`/ads/ads/${adId}`, {
                                    method: 'PUT',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(adData)
                                });
                            } else {
                                response = await fetch('/ads/ads', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(adData)
                                });
                            }

                            if (response.ok) {
                                showFeedback(adId ? 'Ad updated successfully!' : 'Ad created successfully!', 'success');
                                setTimeout(() => {
                                    window.location.href = '/ads';
                                }, 1500);
                            } else {
                                const errorData = await response.json();
                                showFeedback('Error: ' + (errorData.error || 'Failed to save ad'), 'error');
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            showFeedback('Network error occurred while saving the ad', 'error');
                        }
                    }

                    // Cropper instance
                    let cropper = null;
                    let currentFile = null;
                    let currentFileIndex = 0;
                    let filesToProcess = [];

                    // Upload Images Function
                    const uploadImageButton = document.getElementById('uploadImageButton');
                    if (uploadImageButton) {
                        uploadImageButton.addEventListener('click', function () {
                            document.getElementById('imageUpload').click();
                        });
                    }

                    const imageUpload = document.getElementById('imageUpload');
                    if (imageUpload) {
                        imageUpload.addEventListener('change', async function (event) {
                            const files = event.target.files;
                            if (!files || files.length === 0) return;

                            // Store files to process
                            filesToProcess = Array.from(files);
                            currentFileIndex = 0;

                            // Start processing first file
                            processNextFile();
                        });
                    }

                    // Check if WebP is animated (safely read binary)
                    async function isAnimatedWebP(file) {
                        try {
                            const buffer = await file.arrayBuffer(); // Read full file just in case
                            const bytes = new Uint8Array(buffer);
                            for (let i = 0; i < bytes.length - 3; i++) {
                                if (bytes[i] === 0x41 && bytes[i+1] === 0x4E && bytes[i+2] === 0x49 && bytes[i+3] === 0x4D) {
                                    return true;
                                }
                            }
                            return false;
                        } catch (e) {
                            console.error('Error checking WebP:', e);
                            return false;
                        }
                    }

                    // Process next file in queue
                    async function processNextFile() {
                        if (currentFileIndex >= filesToProcess.length) {
                            filesToProcess = [];
                            currentFileIndex = 0;
                            const upload = document.getElementById('imageUpload');
                            if (upload) upload.value = '';
                            return;
                        }

                        currentFile = filesToProcess[currentFileIndex];
                        if (!currentFile.type.startsWith('image/') && !currentFile.type.startsWith('video/')) {
                            showFeedback('Please select image or video files only', 'error');
                            currentFileIndex++;
                            processNextFile();
                            return;
                        }

                        // 🚀 BYPASS CROPPER FOR GIFs, ANIMATED WEBP, and VIDEOS
                        if (currentFile.type === 'image/gif' || currentFile.type.startsWith('video/')) {
                            uploadMediaDirectly(currentFile);
                            return;
                        }
                        
                        const isWebpExt = currentFile.name.toLowerCase().endsWith('.webp');
                        if (currentFile.type === 'image/webp' || isWebpExt) {
                            const isAnimated = await isAnimatedWebP(currentFile);
                            if (isAnimated) {
                                uploadMediaDirectly(currentFile);
                                return;
                            }
                        }

                        openCropModal(currentFile);
                    }

                    // Directly upload media (GIF/WebP/Video) to preserve animation/quality
                    async function uploadMediaDirectly(file) {
                        const formData = new FormData();
                        formData.append('media', file, file.name);
                        
                        try {
                            const response = await fetch('/news/upload-ad-media', {
                                method: 'POST',
                                body: formData
                            });
                            if (response.ok) {
                                const data = await response.json();
                                imageUrls.push(data.mediaUrl);
                                document.getElementById('imageUrls').value = imageUrls.join(',');
                                updateCarousel();
                                currentFileIndex++;
                                processNextFile();
                            } else {
                                const errorData = await response.json();
                                showFeedback('Error: ' + (errorData.error || 'Failed to upload GIF'), 'error');
                                currentFileIndex++;
                                processNextFile();
                            }
                        } catch (error) {
                            console.error('Upload error:', error);
                            showFeedback('Network error occurred while uploading GIF', 'error');
                            currentFileIndex++;
                            processNextFile();
                        }
                    }

                    // Open crop modal
                    function openCropModal(file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const cropImage = document.getElementById('cropImage');
                            cropImage.src = e.target.result;
                            document.getElementById('cropModal').classList.add('active');
                            if (cropper) cropper.destroy();
                            
                            const adFormatValue = document.getElementById('adFormat') ? document.getElementById('adFormat').value : 'image_only';
                            const targetAspectRatio = adFormatValue === 'news_format' ? 16 / 9 : 9 / 20;
                            
                            cropper = new Cropper(cropImage, {
                                aspectRatio: targetAspectRatio,
                                viewMode: 1,
                                dragMode: 'move',
                                autoCropArea: 1,
                                ready() {
                                    // Add safe area box to cropper only for image_only
                                    if (adFormatValue === 'image_only') {
                                        const cropperBox = document.querySelector('.cropper-crop-box');
                                        if (cropperBox && !document.querySelector('.safe-area-box')) {
                                            const safeArea = document.createElement('div');
                                            safeArea.className = 'safe-area-box';
                                            cropperBox.appendChild(safeArea);
                                        }
                                    }
                                }
                            });
                        };
                        reader.readAsDataURL(file);
                    }

                    // Cancel crop
                    const cancelCrop = document.getElementById('cancelCrop');
                    if (cancelCrop) {
                        cancelCrop.addEventListener('click', function () {
                            closeCropModal();
                            currentFileIndex++;
                            processNextFile();
                        });
                    }

                    // Apply crop and upload
                    const applyCrop = document.getElementById('applyCrop');
                    if (applyCrop) {
                        applyCrop.addEventListener('click', async function () {
                            if (!cropper) return;
                            
                            const adFormatValue = document.getElementById('adFormat') ? document.getElementById('adFormat').value : 'image_only';
                            const cropWidth = adFormatValue === 'news_format' ? 1920 : 1080;
                            const cropHeight = adFormatValue === 'news_format' ? 1080 : 2400;

                            const canvas = cropper.getCroppedCanvas({
                                width: cropWidth,
                                height: cropHeight,
                                imageSmoothingEnabled: true,
                                imageSmoothingQuality: 'high',
                            });
                            canvas.toBlob(async function (blob) {
                                const formData = new FormData();
                                formData.append('media', blob, currentFile.name);
                                try {
                                    const response = await fetch('/news/upload-ad-media', {
                                        method: 'POST',
                                        body: formData
                                    });
                                    if (response.ok) {
                                        const data = await response.json();
                                        imageUrls.push(data.mediaUrl);
                                        document.getElementById('imageUrls').value = imageUrls.join(',');
                                        updateCarousel();
                                        closeCropModal();
                                        currentFileIndex++;
                                        processNextFile();
                                    } else {
                                        const errorData = await response.json();
                                        showFeedback('Error: ' + (errorData.error || 'Failed to upload image'), 'error');
                                        closeCropModal();
                                    }
                                } catch (error) {
                                    console.error('Upload error:', error);
                                    showFeedback('Network error occurred while uploading the image', 'error');
                                    closeCropModal();
                                }
                            }, 'image/jpeg', 0.95);
                        });
                    }

                    // Close crop modal
                    function closeCropModal() {
                        document.getElementById('cropModal').classList.remove('active');
                        if (cropper) {
                            cropper.destroy();
                            cropper = null;
                        }
                    }

                    // Update carousel display
                    function updateCarousel() {
                        const carousel = document.getElementById('imagePreviewCarousel');
                        const indicatorsContainer = document.getElementById('imageIndicators');
                        if (!carousel) return;
                        carousel.innerHTML = '';
                        if (indicatorsContainer) indicatorsContainer.innerHTML = '';

                        if (imageUrls.length === 0) {
                            carousel.innerHTML = `
                    <div class="image-preview-item active" data-index="0">
                        <img src="/images/placeholder.png" class="img-fluid rounded" alt="Image Preview">
                    </div>
                `;
                            return;
                        }

                        imageUrls.forEach(function (url, index) {
                            const isActive = index === 0 ? 'active' : '';
                            const item = document.createElement('div');
                            item.className = `image-preview-item ${isActive}`;
                            item.dataset.index = index;
                            
                            const isVideo = url.match(/\.(mp4|webm|mov|avi)$/i) || url.includes('/short_news_videos/');
                            const mediaElement = isVideo 
                                ? `<video src="${url}" class="img-fluid rounded" controls autoplay muted loop style="max-height: 400px; width: auto;"></video>`
                                : `<img src="${url}" class="img-fluid rounded" alt="Image Preview">`;
                                
                            item.innerHTML = `
                    <button type="button" class="remove-image-btn" onclick="removeImage(${index})">
                        <i class="fas fa-times"></i>
                    </button>
                    ${mediaElement}
                `;
                            carousel.appendChild(item);
                            if (indicatorsContainer) {
                                const indicator = document.createElement('div');
                                indicator.className = `indicator ${isActive}`;
                                indicator.dataset.index = index;
                                indicator.onclick = function () { showImage(index); };
                                indicatorsContainer.appendChild(indicator);
                            }
                        });

                        if (imageUrls.length > 1) {
                            const prevBtn = document.createElement('button');
                            prevBtn.type = 'button';
                            prevBtn.className = 'carousel-controls carousel-prev';
                            prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
                            prevBtn.onclick = function () { changeImage(-1); };
                            carousel.appendChild(prevBtn);
                            const nextBtn = document.createElement('button');
                            nextBtn.type = 'button';
                            nextBtn.className = 'carousel-controls carousel-next';
                            nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
                            nextBtn.onclick = function () { changeImage(1); };
                            carousel.appendChild(nextBtn);
                        }
                        currentImageIndex = 0;
                    }

                    // Change image in carousel
                    function changeImage(direction) {
                        if (imageUrls.length <= 1) return;
                        currentImageIndex += direction;
                        if (currentImageIndex >= imageUrls.length) currentImageIndex = 0;
                        else if (currentImageIndex < 0) currentImageIndex = imageUrls.length - 1;
                        showImage(currentImageIndex);
                    }

                    // Show specific image
                    function showImage(index) {
                        const items = document.querySelectorAll('.image-preview-item');
                        const indicators = document.querySelectorAll('.indicator');
                        items.forEach(item => item.classList.remove('active'));
                        indicators.forEach(indicator => indicator.classList.remove('active'));
                        if (items[index]) items[index].classList.add('active');
                        if (indicators[index]) indicators[index].classList.add('active');
                        currentImageIndex = index;
                    }

                    // Remove image
                    window.removeImage = function (index) {
                        if (imageUrls.length <= 1) imageUrls = [];
                        else {
                            imageUrls.splice(index, 1);
                            if (currentImageIndex >= imageUrls.length) currentImageIndex = imageUrls.length - 1;
                        }
                        document.getElementById('imageUrls').value = imageUrls.join(',');
                        updateCarousel();
                    }

                    // Save button event listeners
                    const saveBtnIds = ['saveAdButton', 'saveAdButtonDesktop', 'saveAdButtonMobile', 'saveAdBtn'];
                    saveBtnIds.forEach(id => {
                        const btn = document.getElementById(id);
                        if (btn) btn.addEventListener('click', saveAd);
                    });

                    // Mobile menu setup
                    function setupMobileMenu() {
                        const menuToggle = document.getElementById('menuToggle');
                        const sidebar = document.getElementById('sidebar');
                        const mainContent = document.getElementById('mainContent');

                        if (menuToggle && sidebar) {
                            menuToggle.addEventListener('click', function (e) {
                                e.stopPropagation();
                                sidebar.classList.toggle('active');
                                mainContent.classList.toggle('sidebar-active');
                            });
                        }

                        document.addEventListener('click', function (event) {
                            if (window.innerWidth < 768 &&
                                sidebar && sidebar.classList.contains('active') &&
                                !sidebar.contains(event.target) &&
                                event.target !== menuToggle &&
                                !menuToggle.contains(event.target)) {
                                sidebar.classList.remove('active');
                                if (mainContent) mainContent.classList.remove('sidebar-active');
                            }
                        });
                    }

                    // Show feedback (Android-like snackbar)
                    function showFeedback(message, type) {
                        const existing = document.getElementById('feedback-toast');
                        if (existing) existing.remove();

                        const toast = document.createElement('div');
                        toast.id = 'feedback-toast';
                        toast.textContent = message;
                        Object.assign(toast.style, {
                            position: 'fixed', bottom: '20px', left: '50%', transform: 'translateX(-50%)',
                            padding: '12px 24px', borderRadius: '4px', color: 'white', zIndex: '9999',
                            backgroundColor: type === 'success' ? '#4CAF50' : (type === 'error' ? '#F44336' : '#2196F3'),
                            transition: 'all 0.3s'
                        });

                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }
                </script>
                <script>
                (function(){
                  var langSel=document.getElementById('language');
                  var ivInput=document.getElementById('positionInterval');
                  var hint=document.getElementById('intervalHint');
                  var recBtn=document.getElementById('recBtn');
                  var recVal=document.getElementById('recVal');
                  var adId=(document.getElementById('adId')||{}).value||'';
                  if(!langSel||!ivInput||!hint||!recBtn) return;
                  var stats={count:0,sumInv:0};
                  function render(){
                    var t=Math.max(1,parseInt(ivInput.value,10)||3);
                    var totalInv=stats.sumInv + 1/t;
                    var gapExact=totalInv>0?1/totalInv:999;
                    var gap=Math.round(gapExact);
                    var level=gapExact>=6?'good':(gapExact>=3?'warn':'bad');
                    var col=level==='good'?'#1b8a4b':(level==='warn'?'#9a6b00':'#c62828');
                    var bg =level==='good'?'#e7f6ec':(level==='warn'?'#fdf4e3':'#fdecec');
                    var dot=level==='good'?'🟢':(level==='warn'?'🟡':'🔴');
                    var tag=level==='good'?'Comfortable':(level==='warn'?'Frequent':'Too frequent — users will be irritated');
                    var freq;
                    if(gapExact>=1.5) freq='~1 ad every <b>'+gap+'</b> news cards';
                    else if(gapExact>=0.9) freq='<b>~1 ad on almost every card</b>';
                    else freq='<b>more than 1 ad per card</b> — some ads won’t even show';
                    var msg='<b>'+dot+' '+tag+'</b><br>ఈ భాషలో ఇప్పటికే <b>'+stats.count+'</b> active ad(s) ఉన్నాయి. వీటితో కలిపి: '+freq+'.';
                    if(level!=='good') msg+='<br><span style="color:'+col+'">సలహా: news app కి ప్రతి 6+ cards కి ఒక ad మంచిది — ads తగ్గించండి లేదా interval పెంచండి.</span>';
                    hint.style.display='block';hint.style.background=bg;hint.style.color='#333';hint.innerHTML=msg;
                    var denom=(1/6)-stats.sumInv;
                    var rec=denom>0?Math.max(3,Math.ceil(1/denom)):Math.max(8,t);
                    recVal.textContent=rec;recBtn.style.display='inline-block';recBtn.setAttribute('data-rec',rec);
                    recBtn.title=denom<=0?'ఈ భాష already crowded — కొన్ని ads off చేయండి':'';
                  }
                  function fetchStats(){
                    var lang=langSel.value;
                    if(!lang){stats={count:0,sumInv:0};render();return;}
                    fetch('/ads/api/lang-stats?lang='+encodeURIComponent(lang)+(adId?('&exclude='+encodeURIComponent(adId)):''))
                      .then(function(r){return r.json();}).then(function(d){stats={count:d.count||0,sumInv:d.sumInv||0};render();})
                      .catch(function(){render();});
                  }
                  langSel.addEventListener('change',fetchStats);
                  ivInput.addEventListener('input',render);
                  recBtn.addEventListener('click',function(){ivInput.value=recBtn.getAttribute('data-rec')||6;render();});
                  if(langSel.value) fetchStats(); else render();
                })();
                </script>
    </body>

</html>
