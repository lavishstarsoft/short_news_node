                    // ── Editor modal helpers (tabs, chips, scopes) ──
                    let _editorHierarchy = null;

                    function validateAddEditorTab(tabId) {
                        let isValid = true;
                        let firstErrorInput = null;

                        function showError(inputId, message) {
                            const input = document.getElementById(inputId);
                            if (input) {
                                input.classList.add('is-invalid');
                                let err = input.nextElementSibling;
                                if (!err || !err.classList.contains('invalid-feedback')) {
                                    err = document.createElement('div');
                                    err.className = 'invalid-feedback';
                                    input.parentNode.appendChild(err);
                                }
                                err.textContent = message;
                                err.style.display = 'block';
                                if (!firstErrorInput) firstErrorInput = input;
                                isValid = false;
                                
                                input.addEventListener('input', function() {
                                    input.classList.remove('is-invalid');
                                    if(err) err.style.display = 'none';
                                }, {once: true});
                            }
                        }

                        if (tabId === 'add-tab-account') {
                            if (!document.getElementById('addUsername').value.trim()) showError('addUsername', 'Username is required');
                            if (!document.getElementById('addEmail').value.trim()) showError('addEmail', 'Email is required');
                            if (!document.getElementById('addPassword').value.trim()) showError('addPassword', 'Password is required');
                        } else if (tabId === 'add-tab-profile') {
                            if (!document.getElementById('addName').value.trim()) showError('addName', 'Full Name is required');
                            // Custom Designation is optional now — backend defaults it from Member Type (Reporter / Sub-Editor).
                            if (!document.getElementById('addMobile').value.trim()) showError('addMobile', 'Mobile Number is required');
                            if (!document.getElementById('addWorkingLanguage').value) showError('addWorkingLanguage', 'Language is required');
                        } else if (tabId === 'add-tab-location') {
                            if (!document.getElementById('addConstituency').value.trim()) showError('addConstituency', 'Primary Constituency is required');

                            const roleType = document.getElementById('addRole').value;
                            if (roleType === 'editor') {
                                const scopes = document.getElementById('addAllowedScopes').options;
                                let hasScope = false;
                                for(let i=0; i<scopes.length; i++) if(scopes[i].selected) hasScope = true;
                                if (!hasScope) {
                                    if (typeof showFeedback === 'function') showFeedback('Please select at least one type of news they can write.', 'error');
                                    isValid = false;
                                }

                                const states = document.getElementById('addAssignedStates').options;
                                let hasState = false;
                                for(let i=0; i<states.length; i++) if(states[i].selected) hasState = true;
                                if (!hasState) {
                                    if (typeof showFeedback === 'function') showFeedback('Please select at least one state.', 'error');
                                    isValid = false;
                                }
                            }
                        }

                        if (firstErrorInput) firstErrorInput.focus();
                        return isValid;
                    }

                    function switchEditorTab(tabsRootId, panelId) {
                        const root = document.getElementById(tabsRootId);
                        if (!root) return;
                        
                        // Validation only for Add Admin flow
                        if (tabsRootId === 'addEditorTabs') {
                            const modalContent = root.closest('.modal-content');
                            if (modalContent) {
                                const activePanel = modalContent.querySelector('.editor-tab-panel.active');
                                // Only validate if moving FORWARD or trying to switch away from a tab
                                // Note: A simple approach is just validating the current tab before allowing any switch
                                if (activePanel && activePanel.id !== panelId) {
                                    // If we are moving to an earlier tab (e.g. from 3 back to 1), maybe we shouldn't block?
                                    // But user asked: "next కొట్టేటప్పుడు ఆ ఫీల్డ్ లేకపోతే ఎర్రర్ చూపించి ఆ ఫీల్డ్ వరకు డిస్ప్లే చేయాలి"
                                    // Let's check tab index to see if it's forward.
                                    const tabs = Array.from(root.querySelectorAll('.editor-tab-btn'));
                                    const currentIdx = tabs.findIndex(btn => btn.classList.contains('active'));
                                    const targetIdx = tabs.findIndex(btn => btn.dataset.tab === panelId);
                                    
                                    if (targetIdx > currentIdx) {
                                        if (!validateAddEditorTab(activePanel.id)) {
                                            return; // Stop tab switch if validation fails
                                        }
                                    }
                                }
                            }
                        }
                        
                        root.querySelectorAll('.editor-tab-btn').forEach(btn => {
                            btn.classList.toggle('active', btn.dataset.tab === panelId);
                        });
                        const modalContent = root.closest('.modal-content');
                        if (modalContent) {
                            modalContent.querySelectorAll('.editor-tab-panel').forEach(p => {
                                p.classList.toggle('active', p.id === panelId);
                            });
                            const tabBody = modalContent.querySelector('.editor-tab-body');
                            if (tabBody) tabBody.scrollTop = 0;
                        }

                        if (tabsRootId === 'addEditorTabs') {
                            const addNextBtn = document.getElementById('addNextBtn');
                            const addSubmitBtn = document.getElementById('addSubmitBtn');
                            if (addNextBtn && addSubmitBtn) {
                                if (panelId === 'add-tab-perms') {
                                    addNextBtn.style.display = 'none';
                                    addSubmitBtn.style.display = 'inline-block';
                                } else {
                                    addNextBtn.style.display = 'inline-block';
                                    addSubmitBtn.style.display = 'none';
                                }
                            }
                        }
                    }

                    function initEditorTabButtons(tabsRootId) {
                        const root = document.getElementById(tabsRootId);
                        if (!root || root.dataset.bound) return;
                        root.dataset.bound = '1';
                        root.querySelectorAll('.editor-tab-btn').forEach(btn => {
                            btn.addEventListener('click', () => switchEditorTab(tabsRootId, btn.dataset.tab));
                        });
                    }

                    function initRoleCards(cardsId, hiddenSelectId, onChange, tierSelectId) {
                        const cards = document.getElementById(cardsId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!cards || !sel || cards.dataset.bound) return;
                        cards.dataset.bound = '1';
                        cards.querySelectorAll('.editor-role-card').forEach(card => {
                            card.addEventListener('click', () => {
                                cards.querySelectorAll('.editor-role-card').forEach(c => c.classList.remove('selected'));
                                card.classList.add('selected');
                                sel.value = card.dataset.role;
                                // Member Type card also carries reporterTier (Super Admin only element).
                                if (tierSelectId) {
                                    const ts = document.getElementById(tierSelectId);
                                    if (ts) ts.value = card.dataset.tier || '';
                                }
                                sel.dispatchEvent(new Event('change'));
                                if (onChange) onChange(sel.value);
                            });
                        });
                    }

                    // Select the Member Type card matching role + tier (exact), falling back to
                    // role-only when the tier card is absent (e.g. non-super-admin view).
                    function setRoleCards(cardsId, role, tier) {
                        const cards = document.getElementById(cardsId);
                        if (!cards) return;
                        const t = tier || '';
                        const list = Array.from(cards.querySelectorAll('.editor-role-card'));
                        let match = list.find(c => c.dataset.role === role && (c.dataset.tier || '') === t)
                                 || list.find(c => c.dataset.role === role);
                        list.forEach(c => c.classList.toggle('selected', c === match));
                    }

                    function initScopeCards(cardsId, hiddenSelectId) {
                        const row = document.getElementById(cardsId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!row || !sel || row.dataset.bound) return;
                        row.dataset.bound = '1';
                        row.querySelectorAll('.editor-scope-card').forEach(card => {
                            card.addEventListener('click', () => {
                                card.classList.toggle('selected');
                                const scope = card.dataset.scope;
                                const opt = Array.from(sel.options).find(o => o.value === scope);
                                if (opt) opt.selected = card.classList.contains('selected');
                            });
                        });
                    }

                    function syncScopeCardsFromSelect(cardsId, hiddenSelectId) {
                        const row = document.getElementById(cardsId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!row || !sel) return;
                        const selected = new Set(Array.from(sel.selectedOptions).map(o => o.value));
                        row.querySelectorAll('.editor-scope-card').forEach(card => {
                            card.classList.toggle('selected', selected.has(card.dataset.scope));
                        });
                    }

                    function buildLanguagePermissionUI(prefix) {
                        const sel = document.getElementById(prefix + 'AllowedLanguages');
                        const row = document.getElementById(prefix + 'LangCards');
                        if (!sel || !row) return;

                        sel.innerHTML = '<option value="all">all</option>' +
                            _activeLanguages.map(l => `<option value="${l.code}">${l.name || l.code}</option>`).join('');

                        row.innerHTML =
                            '<div class="editor-scope-card" data-lang="all"><strong>All Languages</strong><div class="te">Post in any active language</div></div>' +
                            _activeLanguages.map(l =>
                                `<div class="editor-scope-card" data-lang="${l.code}"><strong>${l.name || l.code}</strong></div>`
                            ).join('');

                        initLangCards(prefix + 'LangCards', prefix + 'AllowedLanguages');
                    }

                    function initLangCards(cardsId, hiddenSelectId) {
                        const row = document.getElementById(cardsId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!row || !sel || row.dataset.langBound) return;
                        row.dataset.langBound = '1';

                        row.querySelectorAll('.editor-scope-card').forEach(card => {
                            card.addEventListener('click', () => {
                                const lang = card.dataset.lang;
                                if (lang === 'all') {
                                    Array.from(sel.options).forEach(opt => { opt.selected = opt.value === 'all'; });
                                } else {
                                    const allOpt = Array.from(sel.options).find(o => o.value === 'all');
                                    if (allOpt) allOpt.selected = false;
                                    const opt = Array.from(sel.options).find(o => o.value === lang);
                                    if (opt) opt.selected = !opt.selected;
                                }
                                syncLangCardsFromSelect(cardsId, hiddenSelectId);
                            });
                        });
                    }

                    function syncLangCardsFromSelect(cardsId, hiddenSelectId) {
                        const row = document.getElementById(cardsId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!row || !sel) return;
                        const selected = new Set(Array.from(sel.selectedOptions).map(o => o.value));
                        row.querySelectorAll('.editor-scope-card').forEach(card => {
                            card.classList.toggle('selected', selected.has(card.dataset.lang));
                        });
                    }

                    function loadAllowedLanguages(prefix, editor) {
                        const sel = document.getElementById(prefix + 'AllowedLanguages');
                        if (!sel) return;
                        Array.from(sel.options).forEach(opt => { opt.selected = false; });

                        const allowed = editor?.allowedLanguages || [];
                        if (allowed.includes('all')) {
                            const allOpt = sel.querySelector('option[value="all"]');
                            if (allOpt) allOpt.selected = true;
                        } else if (allowed.length) {
                            allowed.forEach(code => {
                                const opt = sel.querySelector(`option[value="${code}"]`);
                                if (opt) opt.selected = true;
                            });
                        } else if (editor?.workingLanguage) {
                            const opt = sel.querySelector(`option[value="${editor.workingLanguage}"]`);
                            if (opt) opt.selected = true;
                        }

                        syncLangCardsFromSelect(prefix + 'LangCards', prefix + 'AllowedLanguages');
                    }

                    function getSelectedFromHidden(selectId) {
                        const sel = document.getElementById(selectId);
                        if (!sel) return [];
                        return Array.from(sel.selectedOptions).map(o => o.value).filter(Boolean);
                    }

                    function renderChipGrid(gridId, hiddenSelectId, items, selectedNames, emptyMsg, onChange) {
                        const grid = document.getElementById(gridId);
                        const sel = document.getElementById(hiddenSelectId);
                        if (!grid || !sel) return;
                        const selected = new Set(selectedNames || []);
                        sel.innerHTML = '';

                        const wrap = grid.closest('.editor-chip-wrap');
                        if (wrap) {
                            const oldToolbar = wrap.querySelector('.editor-chip-toolbar');
                            if (oldToolbar) oldToolbar.remove();
                        }
                        grid.innerHTML = '';

                        if (!items || !items.length) {
                            grid.innerHTML = `<span class="text-muted small">${emptyMsg}</span>`;
                            return;
                        }

                        const itemNames = [];
                        items.forEach(item => {
                            const name = typeof item === 'string' ? item : item.name;
                            itemNames.push(name);
                            const label = typeof item === 'string' ? item : (item.localName ? `${item.name} (${item.localName})` : item.name);
                            const opt = document.createElement('option');
                            opt.value = name;
                            opt.textContent = label;
                            opt.selected = selected.has(name);
                            sel.appendChild(opt);

                            const chip = document.createElement('label');
                            chip.className = 'editor-chip' + (selected.has(name) ? ' selected' : '');
                            chip.dataset.name = name;
                            chip.innerHTML = `<input type="checkbox" value="${name}" ${selected.has(name) ? 'checked' : ''}>${label}`;
                            chip.addEventListener('click', (e) => {
                                e.preventDefault();
                                chip.classList.toggle('selected');
                                const cb = chip.querySelector('input');
                                cb.checked = chip.classList.contains('selected');
                                const o = Array.from(sel.options).find(x => x.value === name);
                                if (o) o.selected = cb.checked;
                                updateChipCount(grid, sel);
                                if (onChange) onChange();
                            });
                            grid.appendChild(chip);
                        });

                        if (wrap && items.length > 1) {
                            const toolbar = document.createElement('div');
                            toolbar.className = 'editor-chip-toolbar';
                            const selCount = Array.from(sel.selectedOptions).length;
                            toolbar.innerHTML = `
                                <span><span class="chip-count">${selCount}</span> of ${items.length} selected</span>
                                <span class="chip-actions">
                                    <button type="button" class="chip-action-btn chip-select-all">Select All</button>
                                    <button type="button" class="chip-action-btn chip-deselect-all">Clear All</button>
                                </span>`;
                            toolbar.querySelector('.chip-select-all').addEventListener('click', () => {
                                grid.querySelectorAll('.editor-chip').forEach(c => {
                                    c.classList.add('selected');
                                    c.querySelector('input').checked = true;
                                });
                                Array.from(sel.options).forEach(o => { o.selected = true; });
                                updateChipCount(grid, sel);
                                if (onChange) onChange();
                            });
                            toolbar.querySelector('.chip-deselect-all').addEventListener('click', () => {
                                grid.querySelectorAll('.editor-chip').forEach(c => {
                                    c.classList.remove('selected');
                                    c.querySelector('input').checked = false;
                                });
                                Array.from(sel.options).forEach(o => { o.selected = false; });
                                updateChipCount(grid, sel);
                                if (onChange) onChange();
                            });
                            wrap.insertBefore(toolbar, grid);
                        }
                    }

                    function updateChipCount(grid, sel) {
                        const wrap = grid.closest('.editor-chip-wrap');
                        if (!wrap) return;
                        const toolbar = wrap.querySelector('.editor-chip-toolbar');
                        if (!toolbar) return;
                        const countEl = toolbar.querySelector('.chip-count');
                        if (countEl) countEl.textContent = Array.from(sel.selectedOptions).length;
                    }

                    function getDistrictsForStates(stateNames) {
                        if (!_editorHierarchy || !stateNames?.length) return [];
                        const districts = [];
                        stateNames.forEach(sn => {
                            const st = _editorHierarchy.find(s => s.name === sn);
                            if (st?.districts) districts.push(...st.districts);
                        });
                        return districts.sort((a, b) => a.name.localeCompare(b.name));
                    }

                    function getConstituenciesForDistricts(districtNames) {
                        if (!_editorHierarchy || !districtNames?.length) return [];
                        const list = [];
                        _editorHierarchy.forEach(st => {
                            (st.districts || []).forEach(d => {
                                if (districtNames.includes(d.name) && d.constituencies?.length) {
                                    list.push(...d.constituencies);
                                }
                            });
                        });
                        return list.sort((a, b) => a.name.localeCompare(b.name));
                    }

                    function refreshReporterLocation(prefix) {
                        const states = getSelectedFromHidden(prefix + 'AssignedStates');
                        const districts = getSelectedFromHidden(prefix + 'AssignedDistricts');
                        renderChipGrid(prefix + 'StateChips', prefix + 'AssignedStates',
                            (_editorHierarchy || []).map(s => s), states, 'No states found', () => refreshReporterLocation(prefix));
                        
                        const distEmptyMsg = states.length ? 'No districts found' : 'Select at least one state';
                        renderChipGrid(prefix + 'DistrictChips', prefix + 'AssignedDistricts',
                            getDistrictsForStates(states),
                            districts, distEmptyMsg, () => refreshReporterLocation(prefix));
                        
                        const validDistricts = getSelectedFromHidden(prefix + 'AssignedDistricts');
                        const constEmptyMsg = validDistricts.length ? 'No constituencies found (optional)' : 'Select districts first (optional)';
                        renderChipGrid(prefix + 'ConstituencyChips', prefix + 'AssignedConstituencies',
                            getConstituenciesForDistricts(validDistricts),
                            getSelectedFromHidden(prefix + 'AssignedConstituencies'),
                            constEmptyMsg);
                    }

                    function refreshManagedGeography(prefix) {
                        const states = getSelectedFromHidden(prefix + 'ManagedStates');
                        renderChipGrid(prefix + 'ManagedStateChips', prefix + 'ManagedStates',
                            (_editorHierarchy || []).map(s => s), states, 'No states', () => refreshManagedGeography(prefix));
                            
                        const distEmptyMsg = states.length ? 'No districts found' : 'Select managed states';
                        renderChipGrid(prefix + 'ManagedDistrictChips', prefix + 'ManagedDistricts',
                            getDistrictsForStates(states),
                            getSelectedFromHidden(prefix + 'ManagedDistricts'), distEmptyMsg, () => refreshManagedGeography(prefix));
                            
                        const validDistricts = getSelectedFromHidden(prefix + 'ManagedDistricts');
                        const constEmptyMsg = validDistricts.length ? 'No constituencies found (optional)' : 'Select managed districts (optional)';
                        renderChipGrid(prefix + 'ManagedConstituencyChips', prefix + 'ManagedConstituencies',
                            getConstituenciesForDistricts(validDistricts),
                            getSelectedFromHidden(prefix + 'ManagedConstituencies'), constEmptyMsg);
                    }

                    function getReporterList() {
                        return (editors || []).filter(e => e.role === 'editor');
                    }

                    function renderReporterPicker(listId, hiddenSelectId, searchId, selectedIds) {
                        const listEl = document.getElementById(listId);
                        const sel = document.getElementById(hiddenSelectId);
                        const searchEl = searchId ? document.getElementById(searchId) : null;
                        if (!listEl || !sel) return;
                        // Preserve selections across search re-renders: union incoming ids with
                        // whatever is currently selected in the hidden <select>. (Fixes multi-select loss.)
                        const selected = new Set((selectedIds || []).map(String));
                        Array.from(sel.selectedOptions).forEach(o => selected.add(o.value));
                        const q = (searchEl?.value || '').trim().toLowerCase();
                        const all = getReporterList();
                        const byId = new Map(all.map(r => [String(r._id), r]));

                        const matchIds = new Set(all.filter(r => {
                            if (!q) return true;
                            const hay = [r.name, r.username, r.location, ...(r.assignedDistricts || []), ...(r.assignedStates || []), r.constituency].join(' ').toLowerCase();
                            return hay.includes(q);
                        }).map(r => String(r._id)));
                        selected.forEach(id => matchIds.add(id)); // always show already-selected reporters

                        // Rebuild hidden <select> so it keeps an option for EVERY selected id (even if
                        // filtered out or not in the loaded list) → nothing is lost on save.
                        sel.innerHTML = '';
                        const ensureOption = (id) => {
                            let o = Array.from(sel.options).find(x => x.value === String(id));
                            if (!o) { o = document.createElement('option'); o.value = String(id); sel.appendChild(o); }
                            return o;
                        };
                        selected.forEach(id => { ensureOption(id).selected = true; });

                        listEl.innerHTML = '';
                        // Live summary of who is added (visible even after search / on reopen).
                        const sumEl = document.createElement('div');
                        sumEl.className = 'mb-2 pb-2 small';
                        sumEl.style.borderBottom = '1px solid #eee';
                        listEl.appendChild(sumEl);
                        const renderSummary = () => {
                            const names = [...selected].map(x => { const rr = byId.get(x); return (rr && (rr.name || rr.username)) || x; });
                            sumEl.innerHTML = names.length
                                ? '<strong>Added reporters (' + names.length + '):</strong> ' + names.map(n => '<span class="badge bg-primary" style="margin:2px 3px 2px 0;font-weight:500">' + String(n).replace(/</g,'&lt;') + '</span>').join('')
                                : '<span class="text-muted">No reporters added yet.</span>';
                        };
                        renderSummary();
                        const rows = [...matchIds].map(id => byId.get(id)).filter(Boolean)
                            .sort((a, b) => (selected.has(String(b._id)) ? 1 : 0) - (selected.has(String(a._id)) ? 1 : 0));
                        if (!rows.length) return;
                        rows.forEach(r => {
                            const id = String(r._id);
                            ensureOption(id).selected = selected.has(id);
                            const districts = (r.assignedDistricts || []).slice(0, 2).join(', ') || r.location || '—';
                            const row = document.createElement('label');
                            row.className = 'd-flex align-items-start gap-2 mb-2';
                            row.style.cursor = 'pointer';
                            row.innerHTML = `<input type="checkbox" class="form-check-input mt-1" value="${id}" ${selected.has(id) ? 'checked' : ''}>
                                <span><strong>${(r.name || r.username || '').replace(/</g,'&lt;')}</strong><br><small class="text-muted">${String(districts).replace(/</g,'&lt;')}</small></span>`;
                            row.querySelector('input').addEventListener('change', (e) => {
                                if (e.target.checked) { selected.add(id); ensureOption(id).selected = true; }
                                else { selected.delete(id); const o = Array.from(sel.options).find(x => x.value === id); if (o) o.selected = false; }
                                renderSummary();
                            });
                            listEl.appendChild(row);
                        });
                    }

                    function syncApprovalScopeUI(prefix) {
                        const scopeEl = document.getElementById(prefix + 'ApprovalScope');
                        if (!scopeEl) return;
                        let scope = scopeEl.value;
                        if (scope === 'locations') scope = 'geography';
                        const showGeo = (scope === 'geography' || scope === 'geography_and_reporters');
                        const showReps = (scope === 'reporters' || scope === 'geography_and_reporters');
                        const geo = document.getElementById(prefix + 'ManagedGeographyWrapper');
                        const reps = document.getElementById(prefix + 'ManagedReportersWrapper');
                        if (geo) geo.style.display = showGeo ? 'block' : 'none';
                        if (reps) reps.style.display = showReps ? 'block' : 'none';
                        if (showGeo) refreshManagedGeography(prefix);
                        if (showReps) renderReporterPicker(prefix + 'ManagedReporterList', prefix + 'ManagedReporterIds', prefix + 'ReporterSearch', getSelectedFromHidden(prefix + 'ManagedReporterIds'));
                        // Edit modal: refresh the read-only "reporters in scope" list when geography is involved.
                        if (prefix === 'edit' && showGeo) {
                            const idEl = document.getElementById('editEditorId');
                            if (idEl && idEl.value) loadScopeReporters(idEl.value);
                        }
                    }

                    function syncApprovalScopeSectionVisibility(prefix) {
                        const isEdit = prefix === 'edit';
                        const approveCb = document.getElementById(isEdit ? 'editCanApproveNews' : 'addCanApproveNews');
                        const checked = !!(approveCb && approveCb.checked);

                        if (isEdit) {
                            const wrap = document.getElementById('editManagedLocationsWrapper');
                            if (wrap) wrap.style.display = checked ? 'block' : 'none';
                        } else {
                            const scopeWrap = document.getElementById('addApprovalScopeWrapper');
                            const geo = document.getElementById('addManagedGeographyWrapper');
                            const reps = document.getElementById('addManagedReportersWrapper');
                            if (!checked) {
                                if (scopeWrap) scopeWrap.style.display = 'none';
                                if (geo) geo.style.display = 'none';
                                if (reps) reps.style.display = 'none';
                            } else {
                                if (scopeWrap) scopeWrap.style.display = 'block';
                            }
                        }

                        if (checked) syncApprovalScopeUI(prefix);
                    }

                    function initApprovalScopeHandlers(prefix) {
                        const scopeEl = document.getElementById(prefix + 'ApprovalScope');
                        if (scopeEl && !scopeEl.dataset.bound) {
                            scopeEl.dataset.bound = '1';
                            scopeEl.addEventListener('change', () => syncApprovalScopeUI(prefix));
                        }
                        const searchEl = document.getElementById(prefix + 'ReporterSearch');
                        if (searchEl && !searchEl.dataset.bound) {
                            searchEl.dataset.bound = '1';
                            searchEl.addEventListener('input', () => renderReporterPicker(prefix + 'ManagedReporterList', prefix + 'ManagedReporterIds', prefix + 'ReporterSearch', getSelectedFromHidden(prefix + 'ManagedReporterIds')));
                        }
                        const approveCb = document.getElementById(prefix === 'edit' ? 'editCanApproveNews' : 'addCanApproveNews');
                        if (approveCb && !approveCb.dataset.coverageBound) {
                            approveCb.dataset.coverageBound = '1';
                            approveCb.addEventListener('change', () => syncApprovalScopeSectionVisibility(prefix));
                        }
                    }

                    function renderDistrictChips(gridId, hiddenSelectId, districts, selectedNames) {
                        renderChipGrid(gridId, hiddenSelectId, districts, selectedNames, 'No districts found for this state');
                    }

                    function loadReporterCoverage(prefix, editor) {
                        const states = editor?.assignedStates?.length ? editor.assignedStates : (editor?.assignedState ? [editor.assignedState] : []);
                        renderChipGrid(prefix + 'StateChips', prefix + 'AssignedStates', (_editorHierarchy || []).map(s => s), states, 'No states', () => refreshReporterLocation(prefix));
                        
                        const districts = editor?.assignedDistricts || [];
                        const consts = editor?.assignedConstituencies || [];
                        
                        const distEmptyMsg = states.length ? 'No districts found' : 'Select states';
                        renderChipGrid(prefix + 'DistrictChips', prefix + 'AssignedDistricts', getDistrictsForStates(states), districts, distEmptyMsg, () => refreshReporterLocation(prefix));
                        
                        const constEmptyMsg = districts.length ? 'No constituencies found (optional)' : 'Optional';
                        renderChipGrid(prefix + 'ConstituencyChips', prefix + 'AssignedConstituencies', getConstituenciesForDistricts(districts), consts, constEmptyMsg);
                    }

                    function loadManagedCoverage(prefix, permissions) {
                        const perms = permissions || {};
                        let scope = perms.approvalScope || 'reporters';
                        if (scope === 'locations') scope = 'geography';
                        const scopeEl = document.getElementById(prefix + 'ApprovalScope');
                        if (scopeEl) scopeEl.value = scope;
                        
                        const geo = document.getElementById(prefix + 'ManagedGeographyWrapper');
                        const reps = document.getElementById(prefix + 'ManagedReportersWrapper');
                        if (geo) geo.style.display = scope === 'geography' ? 'block' : 'none';
                        if (reps) reps.style.display = scope === 'reporters' ? 'block' : 'none';

                        const mStates = perms.managedStates || [];
                        const mDistricts = perms.managedDistricts || [];
                        const mConst = perms.managedConstituencies || [];
                        
                        renderChipGrid(prefix + 'ManagedStateChips', prefix + 'ManagedStates', (_editorHierarchy || []).map(s => s), mStates, 'No states', () => refreshManagedGeography(prefix));
                        
                        const distEmptyMsg = mStates.length ? 'No districts found' : 'Select states';
                        renderChipGrid(prefix + 'ManagedDistrictChips', prefix + 'ManagedDistricts', getDistrictsForStates(mStates), mDistricts, distEmptyMsg, () => refreshManagedGeography(prefix));
                        
                        const constEmptyMsg = mDistricts.length ? 'No constituencies found (optional)' : 'Optional';
                        renderChipGrid(prefix + 'ManagedConstituencyChips', prefix + 'ManagedConstituencies', getConstituenciesForDistricts(mDistricts), mConst, constEmptyMsg);
                        
                        renderReporterPicker(prefix + 'ManagedReporterList', prefix + 'ManagedReporterIds', prefix + 'ReporterSearch', perms.managedReporterIds || []);
                        syncApprovalScopeUI(prefix); // triggers loadScopeReporters for edit+geography (backend source of truth)
                    }

                    // Fetch + render the reporters the backend resolves for this sub-editor's
                    // current saved approval scope (State → District → Reporter). Read-only.
                    async function loadScopeReporters(editorId) {
                        const listEl = document.getElementById('editScopeReporterList');
                        const countEl = document.getElementById('editScopeReporterCount');
                        if (!listEl || !editorId) return;
                        listEl.innerHTML = '<span class="text-muted small">Loading current reporters…</span>';
                        try {
                            const res = await fetch('/admin/editors/' + editorId + '/managed-reporters');
                            const data = await res.json();
                            if (!res.ok) throw new Error(data.error || 'Failed to load');

                            if (data.unrestricted) {
                                countEl.textContent = 'ALL';
                                listEl.innerHTML = '<div class="text-muted small">This sub-editor can view/approve <strong>all reporters</strong> (Can View All News is on).</div>';
                                return;
                            }
                            countEl.textContent = data.total;
                            if (!data.total) {
                                listEl.innerHTML = '<div class="text-warning small">No reporters currently fall in this scope. Adjust the managed areas above, or reporters may not be tagged to these districts yet.</div>';
                                return;
                            }
                            const esc = (s) => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                            let html = '';
                            Object.keys(data.grouped).sort().forEach((state) => {
                                html += `<div style="margin-bottom:6px;"><div style="font-weight:700;color:#E31E24;">${esc(state)}</div>`;
                                const districts = data.grouped[state];
                                Object.keys(districts).sort().forEach((district) => {
                                    html += `<div style="margin:2px 0 2px 10px;"><span style="font-weight:600;">${esc(district)}</span> <span class="text-muted">(${districts[district].length})</span>`;
                                    districts[district].forEach((r) => {
                                        const cons = r.constituency && r.constituency !== district ? ` · ${esc(r.constituency)}` : '';
                                        html += `<div style="margin-left:16px;">• ${esc(r.name)}${r.email ? ` <span class="text-muted">&lt;${esc(r.email)}&gt;</span>` : ''}${cons}</div>`;
                                    });
                                    html += '</div>';
                                });
                                html += '</div>';
                            });
                            listEl.innerHTML = html;
                        } catch (err) {
                            listEl.innerHTML = '<span class="text-danger small">Could not load reporters: ' + (err.message || 'error') + '</span>';
                        }
                    }

                    async function loadEditorLocationHierarchy(editor) {
                        await ensureEditorHierarchy();
                        loadReporterCoverage('edit', editor);
                        const scopesEl = document.getElementById('editAllowedScopes');
                        Array.from(scopesEl.options).forEach(opt => { opt.selected = false; });
                        if (editor?.allowedScopes?.length) {
                            Array.from(scopesEl.options).forEach(opt => {
                                opt.selected = editor.allowedScopes.includes(opt.value);
                            });
                        }
                        syncScopeCardsFromSelect('editScopeCards', 'editAllowedScopes');
                    }

                    async function loadAddEditorLocationHierarchy() {
                        await ensureEditorHierarchy();
                        loadReporterCoverage('add', null);
                        const scopesEl = document.getElementById('addAllowedScopes');
                        Array.from(scopesEl.options).forEach(opt => { opt.selected = false; });
                        syncScopeCardsFromSelect('addScopeCards', 'addAllowedScopes');
                        refreshManagedGeography('add');
                    }

                    function collectCoveragePayload(prefix) {
                        return {
                            assignedStates: getSelectedFromHidden(prefix + 'AssignedStates'),
                            assignedDistricts: getSelectedFromHidden(prefix + 'AssignedDistricts'),
                            assignedConstituencies: getSelectedFromHidden(prefix + 'AssignedConstituencies'),
                            managedStates: getSelectedFromHidden(prefix + 'ManagedStates'),
                            managedDistricts: getSelectedFromHidden(prefix + 'ManagedDistricts'),
                            managedConstituencies: getSelectedFromHidden(prefix + 'ManagedConstituencies'),
                            managedReporterIds: getSelectedFromHidden(prefix + 'ManagedReporterIds')
                        };
                    }

                    function populateLegacyLocationOptions() {
                        const selectEl = document.getElementById('editAssignedLocations');
                        if (!selectEl || selectEl.dataset.populated) return;
                        selectEl.dataset.populated = '1';
                        selectEl.innerHTML = '';
                        <% if (typeof locations !== 'undefined' && locations.length) { %>
                        <% locations.forEach(function(loc) { %>
                        (function () {
                            const opt = document.createElement('option');
                            opt.value = <%- JSON.stringify(loc.name) %>;
                            opt.textContent = <%- JSON.stringify(loc.name) %>;
                            selectEl.appendChild(opt);
                        })();
                        <% }); %>
                        <% } %>
                    }

                    function applyRoleSections(modalRoot, isSub) {
                        if (!modalRoot) return;
                        modalRoot.querySelectorAll('.reporter-only-section').forEach(el => {
                            el.classList.toggle('role-hidden', isSub);
                        });
                        modalRoot.querySelectorAll('.subeditor-only-section').forEach(el => {
                            el.classList.toggle('role-hidden', !isSub);
                        });
                    }

                    function applyEditSubEditorVisibility(role) {
                        const isSub = role === 'subeditor';
                        const modal = document.getElementById('editEditorModal');

                        applyRoleSections(modal, isSub);

                        const permsTab = document.getElementById('editTabPermsBtn');
                        if (permsTab) {
                            permsTab.textContent = isSub ? '🔐 4. Permissions' : '✅ 4. Permissions';
                        }

                        const permsNote = document.getElementById('editPermsReporterNote');
                        const subBlock = document.getElementById('editSubEditorPermsBlock');
                        if (permsNote) permsNote.classList.toggle('role-hidden', isSub);
                        if (subBlock) subBlock.classList.toggle('role-hidden', !isSub);

                        const managedLocWrapper = document.getElementById('editManagedLocationsWrapper');
                        const approveChecked = document.getElementById('editCanApproveNews')?.checked;
                        if (managedLocWrapper) {
                            managedLocWrapper.style.display = (isSub && approveChecked) ? 'block' : 'none';
                        }
                        if (!isSub) {
                            ['editCanAccessAdminDashboard', 'editCanViewReporterDetails', 'editCanApproveNews', 'editCanViewAllNews',
                             'editCanSendNotifications', 'editCanEditNews', 'editRequiresSourceLink'].forEach(id => {
                                const el = document.getElementById(id);
                                if (el) el.checked = false;
                            });
                        }
                    }

                    function applyAddSubEditorVisibility(role) {
                        const isSub = role === 'subeditor';
                        const modal = document.getElementById('addEditorModal');

                        applyRoleSections(modal, isSub);

                        const permsTab = document.getElementById('addTabPermsBtn');
                        if (permsTab) {
                            permsTab.textContent = isSub ? '🔐 4. Permissions' : '✅ 4. Permissions';
                        }

                        const subPerms = document.getElementById('addSubEditorPerms');
                        const repNote = document.getElementById('addReporterNote');
                        if (subPerms) subPerms.style.display = isSub ? 'block' : 'none';
                        if (repNote) repNote.style.display = isSub ? 'none' : 'block';
                        const approveWrap = document.getElementById('addApprovalScopeWrapper');
                        const approveChecked = document.getElementById('addCanApproveNews')?.checked;
                        if (isSub && approveChecked) {
                            syncApprovalScopeSectionVisibility('add');
                        } else {
                            if (approveWrap) approveWrap.style.display = 'none';
                            ['addManagedGeographyWrapper', 'addManagedReportersWrapper'].forEach(id => {
                                const el = document.getElementById(id);
                                if (el) el.style.display = 'none';
                            });
                        }
                    }

                    async function ensureEditorHierarchy() {
                        if (!_editorHierarchy) {
                            try {
                                const resp = await fetch('/api/public/location-hierarchy');
                                _editorHierarchy = await resp.json();
                            } catch (e) {
                                console.error('Failed to load hierarchy:', e);
                                _editorHierarchy = [];
                            }
                        }
                        return _editorHierarchy;
                    }

                    function openAddEditorModal() {
                        document.getElementById('addEditorForm').reset();
                        document.getElementById('addRole').value = 'editor';
                        setRoleCards('addRoleCards', 'editor', '');
                        const addTierReset = document.getElementById('addReporterTier');
                        if (addTierReset) addTierReset.value = '';
                        applyAddSubEditorVisibility('editor');
                        switchEditorTab('addEditorTabs', 'add-tab-account');
                        loadAddEditorLocationHierarchy();
                        refreshManagedGeography('add');
                        new bootstrap.Modal(document.getElementById('addEditorModal')).show();
                    }

                    // Open Edit Modal
                    function openEditEditorModal(editorId) {
                        populateLegacyLocationOptions();
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        document.getElementById('editEditorId').value = editor._id;
                        document.getElementById('editProfileImageUrl').value = editor.profileImage || '';
                        document.getElementById('editModalSubtitle').textContent = (editor.username || '') + ' — ' + (editor.email || '');

                        if (editor.profileImage) {
                            document.getElementById('editProfilePreview').src = editor.profileImage;
                        } else {
                            document.getElementById('editProfilePreview').src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%2394a3b8"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>';
                        }

                        document.getElementById('editName').value = editor.name || '';
                        const editUsernameEl = document.getElementById('editUsername');
                        const editUsernameWrap = document.getElementById('editUsernameFieldWrap');
                        const currentAdminRole = '<%= admin.role %>';
                        const isSuperAdmin = currentAdminRole === 'superadmin';
                        if (editUsernameWrap) {
                            editUsernameWrap.style.display = isSuperAdmin ? '' : 'none';
                        }
                        if (editUsernameEl) {
                            editUsernameEl.value = editor.username || '';
                            editUsernameEl.disabled = !isSuperAdmin;
                        }
                        const role = editor.role || 'editor';
                        document.getElementById('editRole').value = role;
                        // Infer Member Type card from role + reporterTier (preserves existing tier).
                        setRoleCards('editRoleCards', role, editor.reporterTier || '');
                        applyEditSubEditorVisibility(role);

                        // Display Role dropdown — backward-compat: if this staff member's
                        // saved displayRole is not in the managed category list (legacy/disabled),
                        // inject it as a temporary option so nothing is lost on save.
                        const displayRoleSel = document.getElementById('editDisplayRole');
                        const currentRole = editor.displayRole || '';
                        if (currentRole && !Array.from(displayRoleSel.options).some(o => o.value === currentRole)) {
                            const opt = document.createElement('option');
                            opt.value = currentRole;
                            opt.textContent = currentRole + ' (legacy)';
                            displayRoleSel.appendChild(opt);
                        }
                        displayRoleSel.value = currentRole;
                        // Reporter Tier (Super Admin only; element absent for other roles).
                        const editTierSel = document.getElementById('editReporterTier');
                        if (editTierSel) editTierSel.value = editor.reporterTier || '';
                        document.getElementById('editSalary').value = (editor.salary === null || editor.salary === undefined) ? '' : editor.salary;
                        const assignedLocations = editor.assignedLocations || (editor.location ? [editor.location] : []);
                        const selectEl = document.getElementById('editAssignedLocations');
                        Array.from(selectEl.options).forEach(opt => {
                            opt.selected = assignedLocations.includes(opt.value);
                        });

                        loadEditorLocationHierarchy(editor);

                        document.getElementById('editWorkingLanguage').value = editor.workingLanguage || 'te';
                        document.getElementById('editConstituency').value = editor.constituency || '';
                        document.getElementById('editMobile').value = editor.mobileNumber || '';

                        const displaySettings = editor.displaySettings || { showProfileImage: true, showName: true, showConstituency: true };
                        document.getElementById('editShowProfileImage').checked = displaySettings.showProfileImage !== false;
                        document.getElementById('editShowName').checked = displaySettings.showName !== false;
                        document.getElementById('editShowConstituency').checked = displaySettings.showConstituency !== false;

                        const permissions = editor.permissions || {};
                        document.getElementById('editCanViewReporterDetails').checked = permissions.canViewReporterDetails === true;
                        document.getElementById('editCanAccessAdminDashboard').checked = permissions.canAccessAdminDashboard === true;
                        document.getElementById('editCanApproveNews').checked = permissions.canApproveNews === true;
                        document.getElementById('editCanViewAllNews').checked = permissions.canViewAllNews === true;
                        document.getElementById('editCanSendNotifications').checked = permissions.canSendNotifications === true;
                        document.getElementById('editCanEditNews').checked = permissions.canEditNews === true;
                        document.getElementById('editRequiresSourceLink').checked = permissions.requiresSourceLink === true;
                        // Default ON: only unchecked when super admin explicitly disabled it.
                        document.getElementById('editAiCheckEnabled').checked = permissions.aiCheckEnabled !== false;

                        const sidebarPerms = permissions.sidebar || {};
                        document.querySelectorAll('#editEditorModal .sidebar-menu-cb').forEach(cb => {
                            const menu = cb.getAttribute('data-menu');
                            const optIn = cb.getAttribute('data-opt-in') === 'true';
                            cb.checked = optIn ? sidebarPerms[menu] === true : sidebarPerms[menu] !== false;
                        });

                        const walletConfig = editor.walletConfig || {};
                        document.getElementById('editWalletEnabled').checked = walletConfig.enabled === true;
                        document.getElementById('editWalletDailyTarget').value = walletConfig.dailyTargetNews || '';
                        document.getElementById('editWalletDailyReward').value = walletConfig.dailyRewardAmount || '';

                        document.getElementById('editApprovalScope').value = (permissions.approvalScope === 'locations') ? 'geography' : (permissions.approvalScope || 'reporters');
                        loadManagedCoverage('edit', permissions);
                        loadAllowedLanguages('edit', editor);
                        syncApprovalScopeSectionVisibility('edit');

                        const adminSection = document.getElementById('adminSettingsSection');
                        if (adminSection) adminSection.style.display = (currentAdminRole === 'superadmin' || currentAdminRole === 'admin') ? 'block' : 'none';

                        switchEditorTab('editEditorTabs', 'edit-tab-profile');
                        new bootstrap.Modal(document.getElementById('editEditorModal')).show();
                    }

                    document.getElementById('editRole').addEventListener('change', function () {
                        applyEditSubEditorVisibility(this.value);
                    });

                    document.getElementById('editCanApproveNews').addEventListener('change', function () {
                        syncApprovalScopeSectionVisibility('edit');
                    });

                    document.getElementById('editEditorForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        const id = document.getElementById('editEditorId').value;
                        const coverage = collectCoveragePayload('edit');
                        const allowedScopes = Array.from(document.getElementById('editAllowedScopes').selectedOptions).map(o => o.value).filter(v => v);
                        const allowedLanguages = getSelectedFromHidden('editAllowedLanguages');

                        const sidebarData = {};
                        document.querySelectorAll('#editEditorModal .sidebar-menu-cb').forEach(cb => {
                            sidebarData[cb.getAttribute('data-menu')] = cb.checked;
                        });

                        const data = {
                            name: document.getElementById('editName').value,
                            role: document.getElementById('editRole').value,
                            // Sub-Editor → send chosen designation (default "Sub Editor"). Reporter types →
                            // omit displayRole so an existing member's value is never auto-overwritten.
                            ...(document.getElementById('editRole').value === 'subeditor'
                                ? { displayRole: (document.getElementById('editDisplayRole').value || 'Sub Editor') }
                                : {}),
                            ...(document.getElementById('editReporterTier') ? { reporterTier: document.getElementById('editReporterTier').value || null } : {}),
                            ...coverage,
