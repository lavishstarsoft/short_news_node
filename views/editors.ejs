            <%- include('partials/footer') %>
                <script>
                    let editors = [];
                    let selectedInsightsEditorId = null;
                    const _activeLanguages = <%- JSON.stringify(typeof languageOptions !== 'undefined' ? languageOptions : []) %>;

                    document.addEventListener('DOMContentLoaded', function () {
                        const dataScript = document.getElementById('editorsData');
                        if (dataScript) {
                            try {
                                editors = JSON.parse(dataScript.textContent);
                            } catch (e) {
                                console.error('Error parsing editors data:', e);
                            }
                        }
                        initStaffFilters();
                        populateLegacyLocationOptions();
                        initEditorTabButtons('editEditorTabs');
                        initEditorTabButtons('addEditorTabs');
                        initRoleCards('editRoleCards', 'editRole', applyEditSubEditorVisibility, 'editReporterTier');
                        initRoleCards('addRoleCards', 'addRole', applyAddSubEditorVisibility, 'addReporterTier');
                        initScopeCards('editScopeCards', 'editAllowedScopes');
                        initScopeCards('addScopeCards', 'addAllowedScopes');
                        buildLanguagePermissionUI('edit');
                        buildLanguagePermissionUI('add');
                        initApprovalScopeHandlers('edit');
                        initApprovalScopeHandlers('add');
                        
                        const addNextBtn = document.getElementById('addNextBtn');
                        if (addNextBtn) {
                            addNextBtn.addEventListener('click', () => {
                                const root = document.getElementById('addEditorTabs');
                                if (!root) return;
                                const tabs = Array.from(root.querySelectorAll('.editor-tab-btn'));
                                const currentIdx = tabs.findIndex(btn => btn.classList.contains('active'));
                                if (currentIdx !== -1 && currentIdx < tabs.length - 1) {
                                    const nextTabId = tabs[currentIdx + 1].dataset.tab;
                                    switchEditorTab('addEditorTabs', nextTabId);
                                }
                            });
                        }
                    });

                    function initStaffFilters() {
                        const searchInput = document.getElementById('staffSearchInput');
                        const languageFilter = document.getElementById('staffLanguageFilter');
                        const segments = document.querySelectorAll('.team-segment');
                        const visibleCountEl = document.getElementById('teamVisibleCount');
                        let activeRole = 'all';

                        function applyStaffFilters() {
                            const query = (searchInput?.value || '').trim().toLowerCase();
                            const lang = languageFilter?.value || '';
                            let visible = 0;

                            document.querySelectorAll('.staff-row').forEach(row => {
                                const role = row.dataset.role;
                                const rowLang = row.dataset.language || '';
                                const haystack = row.dataset.search || '';

                                const roleMatch = activeRole === 'all' || role === activeRole;
                                const searchMatch = !query || haystack.includes(query);
                                const langMatch = !lang || (lang === '__unset__' ? !rowLang : rowLang === lang);
                                const show = roleMatch && searchMatch && langMatch;

                                row.style.display = show ? '' : 'none';
                                if (show) visible += 1;
                            });

                            if (visibleCountEl) visibleCountEl.textContent = visible;
                        }

                        segments.forEach(segment => {
                            segment.addEventListener('click', function () {
                                segments.forEach(item => item.classList.remove('active'));
                                segment.classList.add('active');
                                activeRole = segment.dataset.staffFilter || 'all';
                                applyStaffFilters();
                            });
                        });

                        if (searchInput) searchInput.addEventListener('input', applyStaffFilters);
                        if (languageFilter) languageFilter.addEventListener('change', applyStaffFilters);

                        applyStaffFilters();
                    }

                    function showEditorInsightsById(id) {
                        const editor = editors.find(e => e._id === id);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }
                        showEditorInsights(
                            id,
                            editor.name || editor.username,
                            JSON.stringify(editor.newsStats?.monthlyTrend || [])
                        );
                    }

                    let currentReportEditorId = null;

                    function showAdvancedReport(id) {
                        currentReportEditorId = id;
                        const modal = new bootstrap.Modal(document.getElementById('reporterReportModal'));
                        
                        // Reset modal UI
                        document.getElementById('reportModalTitle').textContent = 'Loading...';
                        document.getElementById('reportAccountCreated').textContent = '—';
                        document.getElementById('reportFirstArticle').textContent = '—';
                        document.getElementById('reportTotalArticles').textContent = '—';
                        document.getElementById('reportTodayCount').textContent = '—';
                        document.getElementById('reportYesterdayCount').textContent = '—';
                        document.getElementById('reportTotalViews').textContent = '—';
                        document.getElementById('reportApprovedCount').textContent = '—';
                        document.getElementById('reportRejectedCount').textContent = '—';
                        document.getElementById('reportTopCategories').innerHTML = '';
                        document.getElementById('reportDateWiseBody').innerHTML = '<tr><td colspan="2" class="text-muted py-3">Select a date range or month to view data</td></tr>';
                        document.getElementById('reportRangeTotal').textContent = 'Total: 0';
                        document.getElementById('reportMonthFilter').value = '';
                        document.getElementById('reportStartDate').value = '';
                        document.getElementById('reportEndDate').value = '';

                        modal.show();
                        fetchEditorReportData(id);
                    }

                    function formatDateDDMMYYYY(dateStr) {
                        if (!dateStr) return '—';
                        const d = new Date(dateStr);
                        const day = String(d.getDate()).padStart(2, '0');
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const year = d.getFullYear();
                        return `${day}-${month}-${year}`;
                    }

                    async function fetchEditorReportData(id, params = '') {
                        try {
                            const response = await fetch(`/admin/editors/${id}/report?${params}`);
                            if (!response.ok) throw new Error('Failed to fetch report');
                            
                            const data = await response.json();
                            
                            document.getElementById('reportModalTitle').textContent = `${data.editor.name || data.editor.username} (${data.editor.role})`;
                            document.getElementById('reportAccountCreated').textContent = data.editor.createdAt ? formatDateDDMMYYYY(data.editor.createdAt) : 'N/A';
                            document.getElementById('reportFirstArticle').textContent = data.firstArticleDate ? formatDateDDMMYYYY(data.firstArticleDate) : 'No Articles Yet';
                            
                            document.getElementById('reportTotalArticles').textContent = data.totalArticles;
                            document.getElementById('reportTodayCount').textContent = data.todayCount;
                            document.getElementById('reportYesterdayCount').textContent = data.yesterdayCount;
                            document.getElementById('reportTotalViews').textContent = data.totalViews || 0;
                            document.getElementById('reportApprovedCount').textContent = data.approvedCount;
                            document.getElementById('reportRejectedCount').textContent = data.rejectedCount;

                            // Populate PDF template as well
                            document.getElementById('pdfGeneratedDate').textContent = formatDateDDMMYYYY(new Date());
                            document.getElementById('pdfEmpName').textContent = data.editor.name || data.editor.username;
                            document.getElementById('pdfEmpRole').textContent = (data.editor.role).toUpperCase();
                            document.getElementById('pdfEmpJoined').textContent = data.editor.createdAt ? formatDateDDMMYYYY(data.editor.createdAt) : 'N/A';
                            document.getElementById('pdfEmpFirstArticle').textContent = data.firstArticleDate ? formatDateDDMMYYYY(data.firstArticleDate) : 'No Articles Yet';
                            
                            document.getElementById('pdfTotalArticles').textContent = data.totalArticles;
                            document.getElementById('pdfTodayArticles').textContent = data.todayCount;
                            document.getElementById('pdfYesterdayArticles').textContent = data.yesterdayCount;
                            document.getElementById('pdfTotalViews').textContent = data.totalViews || 0;
                            document.getElementById('pdfApproved').textContent = data.approvedCount;
                            document.getElementById('pdfRejected').textContent = data.rejectedCount;

                            const categoriesList = document.getElementById('reportTopCategories');
                            const pdfCategoriesList = document.getElementById('pdfTopCategories');
                            categoriesList.innerHTML = '';
                            pdfCategoriesList.innerHTML = '';
                            if (data.topCategories && data.topCategories.length > 0) {
                                data.topCategories.forEach(cat => {
                                    categoriesList.innerHTML += `<li class="list-group-item d-flex justify-content-between align-items-center">
                                        ${cat.category || 'Uncategorized'}
                                        <span class="badge bg-primary rounded-pill">${cat.count}</span>
                                    </li>`;
                                    pdfCategoriesList.innerHTML += `<tr>
                                        <td style="padding: 10px; border-bottom: 1px solid #eee;">${cat.category || 'Uncategorized'}</td>
                                        <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;">${cat.count}</td>
                                    </tr>`;
                                });
                            } else {
                                categoriesList.innerHTML = '<li class="list-group-item text-muted border-0 text-center py-3">No categories data</li>';
                                pdfCategoriesList.innerHTML = '<tr><td style="padding: 10px; text-align: center; color: #666;" colspan="2">No categories data</td></tr>';
                            }

                            document.getElementById('pdfReportPeriod').textContent = params !== '' ? 'Custom Range' : 'All Time';
                            const tbody = document.getElementById('reportDateWiseBody');
                            const pdfTbody = document.getElementById('pdfBreakdownBody');
                            
                            if (params !== '') {
                                // Render datewise data
                                document.getElementById('reportRangeTotal').textContent = `Total: ${data.customRangeCount}`;
                                tbody.innerHTML = '';
                                pdfTbody.innerHTML = '';
                                if (data.dateWiseData && data.dateWiseData.length > 0) {
                                    data.dateWiseData.forEach(item => {
                                        tbody.innerHTML += `<tr>
                                            <td>${new Date(item.date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})}</td>
                                            <td class="fw-bold text-primary">${item.count}</td>
                                        </tr>`;
                                        pdfTbody.innerHTML += `<tr>
                                            <td style="padding: 10px 15px; border: 1px solid #dee2e6;">${formatDateDDMMYYYY(item.date)}</td>
                                            <td style="padding: 10px 15px; border: 1px solid #dee2e6; text-align: right; font-weight: bold;">${item.count}</td>
                                        </tr>`;
                                    });
                                } else {
                                    tbody.innerHTML = '<tr><td colspan="2" class="text-muted py-3">No articles found in this period</td></tr>';
                                    pdfTbody.innerHTML = '<tr><td colspan="2" style="padding: 20px; text-align: center; color: #666; border: 1px solid #dee2e6;">No articles found in this period</td></tr>';
                                }
                                document.getElementById('pdfBreakdownSection').style.display = 'block';
                            } else {
                                document.getElementById('pdfBreakdownSection').style.display = 'none';
                            }
                        } catch (error) {
                            console.error(error);
                            showFeedback('Error fetching report data', 'error');
                        }
                    }

                    document.addEventListener('DOMContentLoaded', () => {
                        const filterForm = document.getElementById('reportFilterForm');
                        if (filterForm) {
                            filterForm.addEventListener('submit', (e) => {
                                e.preventDefault();
                                const month = document.getElementById('reportMonthFilter').value;
                                const startDate = document.getElementById('reportStartDate').value;
                                const endDate = document.getElementById('reportEndDate').value;

                                let params = new URLSearchParams();
                                if (month) params.append('month', month);
                                else {
                                    if (startDate) params.append('startDate', startDate);
                                    if (endDate) params.append('endDate', endDate);
