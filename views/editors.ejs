            <%- include('partials/footer') %>
                <script>
                    let editors = [];
                    let selectedInsightsEditorId = null;
                    const _activeLanguages = <%- JSON.stringify(typeof languageOptions !== 'undefined' ? languageOptions : []) %>;

                    document.addEventListener('DOMContentLoaded', function () {
                        const dataScript = document.getElementById('editorsData');
                        if (dataScript) {
                            try {
                                editors = JSON.parse(dataScript.textContent);
                            } catch (e) {
                                console.error('Error parsing editors data:', e);
                            }
                        }
                        initStaffFilters();
                        populateLegacyLocationOptions();
                        initEditorTabButtons('editEditorTabs');
                        initEditorTabButtons('addEditorTabs');
                        initRoleCards('editRoleCards', 'editRole', applyEditSubEditorVisibility);
                        initRoleCards('addRoleCards', 'addRole', applyAddSubEditorVisibility);
                        initScopeCards('editScopeCards', 'editAllowedScopes');
                        initScopeCards('addScopeCards', 'addAllowedScopes');
                        buildLanguagePermissionUI('edit');
                        buildLanguagePermissionUI('add');
                        initApprovalScopeHandlers('edit');
                        initApprovalScopeHandlers('add');
                        
                        const addNextBtn = document.getElementById('addNextBtn');
                        if (addNextBtn) {
                            addNextBtn.addEventListener('click', () => {
                                const root = document.getElementById('addEditorTabs');
                                if (!root) return;
                                const tabs = Array.from(root.querySelectorAll('.editor-tab-btn'));
                                const currentIdx = tabs.findIndex(btn => btn.classList.contains('active'));
                                if (currentIdx !== -1 && currentIdx < tabs.length - 1) {
                                    const nextTabId = tabs[currentIdx + 1].dataset.tab;
                                    switchEditorTab('addEditorTabs', nextTabId);
                                }
                            });
                        }
                    });

                    function initStaffFilters() {
                        const searchInput = document.getElementById('staffSearchInput');
                        const languageFilter = document.getElementById('staffLanguageFilter');
                        const segments = document.querySelectorAll('.team-segment');
                        const visibleCountEl = document.getElementById('teamVisibleCount');
                        let activeRole = 'all';

                        function applyStaffFilters() {
                            const query = (searchInput?.value || '').trim().toLowerCase();
                            const lang = languageFilter?.value || '';
                            let visible = 0;

                            document.querySelectorAll('.staff-row').forEach(row => {
                                const role = row.dataset.role;
                                const rowLang = row.dataset.language || '';
                                const haystack = row.dataset.search || '';

                                const roleMatch = activeRole === 'all' || role === activeRole;
                                const searchMatch = !query || haystack.includes(query);
                                const langMatch = !lang || (lang === '__unset__' ? !rowLang : rowLang === lang);
                                const show = roleMatch && searchMatch && langMatch;

                                row.style.display = show ? '' : 'none';
                                if (show) visible += 1;
                            });

                            if (visibleCountEl) visibleCountEl.textContent = visible;
                        }

                        segments.forEach(segment => {
                            segment.addEventListener('click', function () {
                                segments.forEach(item => item.classList.remove('active'));
                                segment.classList.add('active');
                                activeRole = segment.dataset.staffFilter || 'all';
                                applyStaffFilters();
                            });
                        });

                        if (searchInput) searchInput.addEventListener('input', applyStaffFilters);
                        if (languageFilter) languageFilter.addEventListener('change', applyStaffFilters);

                        applyStaffFilters();
                    }

