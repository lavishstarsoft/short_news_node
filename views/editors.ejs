    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select All logic
            const selectAll = document.getElementById('selectAllEditors');
            const checkboxes = document.querySelectorAll('.editor-select-checkbox');
            const selectedCount = document.getElementById('multiReportSelectedCount');
            
            function updateSelectedCount() {
                const count = document.querySelectorAll('.editor-select-checkbox:checked').length;
                selectedCount.innerText = `${count} selected`;
                checkButtons();
            }

            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    checkboxes.forEach(cb => {
                        // Only check if row is visible
                        const row = cb.closest('tr');
                        if (row.style.display !== 'none') {
                            cb.checked = this.checked;
                        }
                    });
                    updateSelectedCount();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateSelectedCount);
            });

            // Date Range Picker
            let reportFrom = null;
            let reportTo = null;
            if (document.getElementById('multiReportDateRange')) {
                flatpickr("#multiReportDateRange", {
                    mode: "range",
                    dateFormat: "Y-m-d",
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length > 0) {
                            reportFrom = instance.formatDate(selectedDates[0], "Y-m-d");
                            reportTo = instance.formatDate(selectedDates[selectedDates.length === 1 ? 0 : 1], "Y-m-d");
                            checkButtons();
                        } else {
                            reportFrom = null;
                            reportTo = null;
                            checkButtons();
                        }
                    }
                });
            }

            function checkButtons() {
                const count = document.querySelectorAll('.editor-select-checkbox:checked').length;
                const btnPdf = document.getElementById('btnMultiReportPdf');
                const btnImg = document.getElementById('btnMultiReportImage');
                if (count > 0 && reportFrom && reportTo) {
                    btnPdf.disabled = false;
                    btnImg.disabled = false;
                } else {
                    btnPdf.disabled = true;
                    btnImg.disabled = true;
                }
                // Staff Report needs a selection only (no date range) — it is not time-scoped.
                const btnStaff = document.getElementById('btnStaffReportPdf');
                if (btnStaff) btnStaff.disabled = count === 0;
            }

            async function generateMultiReport(format) {
                const selectedIds = Array.from(document.querySelectorAll('.editor-select-checkbox:checked')).map(cb => cb.value);
                if (selectedIds.length === 0 || !reportFrom || !reportTo) return;

                const btnPdf = document.getElementById('btnMultiReportPdf');
                const btnImg = document.getElementById('btnMultiReportImage');
                btnPdf.disabled = true;
                btnImg.disabled = true;
                
                const originalPdfText = btnPdf.innerHTML;
                const originalImgText = btnImg.innerHTML;
                
                if (format === 'pdf') btnPdf.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
                else btnImg.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

                try {
                    const response = await fetch('/admin/editors/multi-report', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ adminIds: selectedIds, from: reportFrom, to: reportTo })
                    });
                    const result = await response.json();
                    
                    if (!result.success) throw new Error(result.error || 'Failed to generate report');

                    // Populate Template
                    document.getElementById('multiReportDateRangeStr').innerText = `${reportFrom} to ${reportTo}`;
                    const tbody = document.getElementById('multiReportTableBody');
                    const tfoot = document.getElementById('multiReportTableFoot');
                    const summaryDiv = document.getElementById('multiReportSummary');
                    
                    tbody.innerHTML = '';
                    tfoot.innerHTML = '';
                    summaryDiv.innerHTML = '';
                    
                    // Gather all unique languages with count > 0 across all selected editors
                    const allLanguages = new Set();
                    result.data.forEach(r => {
                        if (r.languageData) {
                            for (const lang in r.languageData) {
                                if (r.languageData[lang] > 0) {
                                    allLanguages.add(lang);
                                }
                            }
                        }
                    });
                    const languagesArray = Array.from(allLanguages).sort();

                    // Generate Dynamic Header
                    const thead = document.getElementById('multiReportTableHead');
                    let headerHtml = `
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; font-size: 12px; color: #495057;">Name & Role</th>
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057;">Total</th>
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057;">Normal</th>
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057;">Video</th>
                    `;
                    languagesArray.forEach(lang => {
                        const capitalizedLang = lang.charAt(0).toUpperCase() + lang.slice(1);
                        headerHtml += `<th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #084298; background-color: #e0f2fe;">${capitalizedLang}</th>`;
                    });
                    headerHtml += `
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057;">Pending</th>
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057;">Rejected</th>
                        <th style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; font-size: 12px; color: #495057; width: 140px;">24h Activity Timeline</th>
                    </tr>`;
                    thead.innerHTML = headerHtml;

                    let totalNews = 0;
                    let totalNormal = 0;
                    let totalVideo = 0;
                    let totalPending = 0;
                    let totalRejected = 0;
                    const languageTotals = {};
                    languagesArray.forEach(lang => languageTotals[lang] = 0);
                    
                    const aggregateHourly = new Array(24).fill(0);
                    
                    result.data.forEach((r, idx) => {
                        const tr = document.createElement('tr');
                        tr.style.backgroundColor = idx % 2 === 0 ? '#ffffff' : '#fafafa';
                        
                        let heatmapHtml = '<div style="display: flex; gap: 2px; align-items: center; justify-content: center;">';
                        const maxCount = Math.max(...r.hourlyData, 1);
                        r.hourlyData.forEach(count => {
                            let color = '#ebedf0'; // gray (0)
                            if (count > 0) {
                                const intensity = count / maxCount;
                                if (intensity < 0.3) color = '#9be9a8';
                                else if (intensity < 0.6) color = '#40c463';
                                else if (intensity < 0.9) color = '#30a14e';
                                else color = '#216e39';
                            }
                            heatmapHtml += `<div style="width: 4px; height: 12px; background-color: ${color}; border-radius: 1px;"></div>`;
                        });
                        heatmapHtml += '</div>';

                        let langCellsHtml = '';
                        languagesArray.forEach(lang => {
                            const count = (r.languageData && r.languageData[lang]) || 0;
                            languageTotals[lang] += count;
                            langCellsHtml += `<td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 13px; font-weight: bold; color: #084298; background-color: #f0f9ff;">${count}</td>`;
                        });

                        tr.innerHTML = `
                            <td style="padding: 10px; border: 1px solid #dee2e6; font-size: 13px;">
                                <strong>${r.name}</strong><br>
                                <span style="font-size: 10px; color: #888; text-transform: capitalize;">${r.role}</span>
                            </td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #0d6efd;">${r.count}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 13px; color: #198754;">${r.normalCount}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 13px; color: #6f42c1;">${r.videoCount}</td>
                            ${langCellsHtml}
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 13px; color: #ffc107;">${r.pendingCount}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 13px; color: #dc3545;">${r.rejectedCount}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; vertical-align: middle;">${heatmapHtml}</td>
                        `;
                        tbody.appendChild(tr);
                        
                        totalNews += r.count;
                        totalNormal += r.normalCount;
                        totalVideo += r.videoCount;
                        totalPending += r.pendingCount;
                        totalRejected += r.rejectedCount;
                        r.hourlyData.forEach((val, h) => { aggregateHourly[h] += val; });
                    });

                    // Add Totals Row
                    let totalsLangCellsHtml = '';
                    languagesArray.forEach(lang => {
                        totalsLangCellsHtml += `<td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #084298; background-color: #e0f2fe;">${languageTotals[lang]}</td>`;
                    });

                    tfoot.innerHTML = `
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dee2e6; font-size: 14px; font-weight: bold; text-align: right;">GRAND TOTAL</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 15px; font-weight: bold; color: #0d6efd;">${totalNews}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #198754;">${totalNormal}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #6f42c1;">${totalVideo}</td>
                            ${totalsLangCellsHtml}
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #ffc107;">${totalPending}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; font-size: 14px; font-weight: bold; color: #dc3545;">${totalRejected}</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center;">-</td>
                        </tr>
                    `;

                    // Add Summary Section
                    if (totalNews > 0) {
                        let peakHour = 0;
                        let peakCount = aggregateHourly[0];
                        for(let i=1; i<24; i++) {
                            if(aggregateHourly[i] > peakCount) {
                                peakCount = aggregateHourly[i];
                                peakHour = i;
                            }
                        }
                        
                        const formatHour = (h) => {
                            const ampm = h >= 12 ? 'PM' : 'AM';
                            const formatted = h % 12 || 12;
                            return `${formatted}:00 ${ampm}`;
                        };
                        const nextHour = (peakHour + 1) % 24;
                        
                        summaryDiv.innerHTML = `
                            <h4 style="margin: 0 0 5px 0; color: #0056b3; font-size: 16px;">Overall Insights</h4>
                            <p style="margin: 0; font-size: 14px; color: #444;">
                                <strong>Peak Activity Time:</strong> The most active period was between <strong>${formatHour(peakHour)} and ${formatHour(nextHour)}</strong>, 
                                during which the team collectively posted <strong>${peakCount}</strong> articles.
                            </p>
                        `;
                    } else {
                        summaryDiv.innerHTML = `<p style="margin: 0; font-style: italic; color: #666;">No activity recorded in the selected period.</p>`;
                    }

                    const element = document.getElementById('multiReportTemplateContainer').cloneNode(true);
                    element.style.display = 'block';
                    
                    const tempContainer = document.createElement('div');
                    tempContainer.style.position = 'absolute';
                    tempContainer.style.left = '-9999px';
                    tempContainer.appendChild(element);
                    document.body.appendChild(tempContainer);

                    if (format === 'pdf') {
                        const opt = {
                            margin:       0.5,
                            filename:     `Team_Performance_${reportFrom}_to_${reportTo}.pdf`,
                            image:        { type: 'jpeg', quality: 0.98 },
                            html2canvas:  { scale: 2, useCORS: true },
                            jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
                        };
                        await html2pdf().set(opt).from(element).save();
                    } else if (format === 'image') {
                        const canvas = await html2canvas(element.firstElementChild, { scale: 2, useCORS: true });
                        const link = document.createElement('a');
                        link.download = `Team_Performance_${reportFrom}_to_${reportTo}.png`;
                        link.href = canvas.toDataURL('image/png');
                        link.click();
                    }
                    
                    document.body.removeChild(tempContainer);
                } catch (err) {
                    alert('Error generating report: ' + err.message);
                } finally {
                    btnPdf.disabled = false;
                    btnImg.disabled = false;
                    btnPdf.innerHTML = originalPdfText;
                    btnImg.innerHTML = originalImgText;
                }
            }

            if (document.getElementById('btnMultiReportPdf')) {
                document.getElementById('btnMultiReportPdf').addEventListener('click', () => generateMultiReport('pdf'));
            }
            if (document.getElementById('btnMultiReportImage')) {
                document.getElementById('btnMultiReportImage').addEventListener('click', () => generateMultiReport('image'));
            }

            // ---- Staff Report PDF: selected Sub Editor + Bureau staff (A4 table) ----
            // Eligibility is based on the ACTUAL role, not the free-text displayRole
            // (which defaults to "Reporter"): every Sub Editor is role==='subeditor',
            // and Bureau members are marked via displayRole==='bureau'.
            function isStaffReportEligible(e) {
                if (!e) return false;
                if (e.role === 'subeditor') return true;
                return String(e.displayRole || '').trim().toLowerCase() === 'bureau';
            }

            // Truthful label for the "Display Role" column.
            function staffRoleLabel(e) {
                const dr = String(e.displayRole || '').trim();
                if (dr.toLowerCase() === 'bureau') return 'Bureau';
                if (dr.toLowerCase() === 'sub editor') return 'Sub Editor';
                if (e.role === 'subeditor') return 'Sub Editor'; // subeditor with default/other displayRole
                return dr || '—';
            }

            // Returns { records: eligible[], selectedTotal, skipped } — never drops silently.
            function getSelectedStaffRecords() {
                // Source data from the admin-only serialized JSON (already on the page).
                let all = [];
                try { all = JSON.parse(document.getElementById('editorsData').textContent) || []; }
                catch (e) { all = []; }
                const byId = {};
                all.forEach(e => { byId[String(e._id)] = e; });

                const selected = Array.from(document.querySelectorAll('.editor-select-checkbox:checked'))
                    .map(cb => byId[String(cb.value)])
                    .filter(Boolean);
                const records = selected.filter(isStaffReportEligible);
                return { records, selectedTotal: selected.length, skipped: selected.length - records.length };
            }

            async function generateStaffReport() {
                const { records, skipped } = getSelectedStaffRecords();
                if (records.length === 0) {
                    alert('None of the selected members are Sub Editor or Bureau staff. This report includes only Sub Editors and Bureau members.');
                    return;
                }
                // Never drop silently: tell the admin how many selected rows were skipped.
                if (skipped > 0 && !confirm(`${skipped} selected member(s) are neither Sub Editor nor Bureau and will be skipped.\n\nGenerate the report for the ${records.length} eligible member(s)?`)) {
                    return;
                }

                const btn = document.getElementById('btnStaffReportPdf');
                const original = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

                const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
                const areaOf = (e) => e.assignedState
                    || (Array.isArray(e.assignedStates) && e.assignedStates[0])
                    || (Array.isArray(e.assignedLocations) && e.assignedLocations[0])
                    || e.location
                    || e.constituency
                    || 'Pan India';
                // Blank cell when salary is not set — never the text "Not set".
                const salaryOf = (e) => (e.salary === null || e.salary === undefined || e.salary === '')
                    ? ''
                    : '₹ ' + Number(e.salary).toLocaleString('en-IN');
                const approvedOf = (e) => Number(e.approvedPosts != null ? e.approvedPosts : (e.newsStats && e.newsStats.published) || 0);

                const esc = (s) => String(s == null ? '' : s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

                // Column widths (sum 100%): narrower Approved Posts, wider Salary.
                const colgroup = `<colgroup>
                    <col style="width:24%"><col style="width:14%"><col style="width:13%">
                    <col style="width:19%"><col style="width:20%"><col style="width:10%">
                </colgroup>`;
                const theadHtml = `<thead style="display: table-header-group;">
                    <tr style="background-color: #f1f3f5;">
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; color: #343a40;">Name</th>
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; color: #343a40;">Display Role</th>
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; color: #343a40;">Joining Date</th>
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; color: #343a40;">State/Bureau</th>
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: right; font-weight: bold; color: #343a40;">Salary</th>
                        <th style="padding: 8px 9px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; color: #343a40;">Approved</th>
                    </tr>
                </thead>`;
                const rowHtml = (e, idx) => `
                    <tr style="background-color: ${idx % 2 === 0 ? '#ffffff' : '#f9fafb'};">
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6; font-weight: 600;">${esc(e.name || e.username || '—')}</td>
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6;">${esc(staffRoleLabel(e))}</td>
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6; white-space: nowrap;">${fmtDate(e.createdAt)}</td>
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6;">${esc(areaOf(e))}</td>
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6; text-align: right; white-space: nowrap;">${esc(salaryOf(e))}</td>
                        <td style="padding: 7px 9px; border: 1px solid #dee2e6; text-align: center; font-weight: bold; color: #0d6efd;">${approvedOf(e).toLocaleString('en-IN')}</td>
                    </tr>`;
                const brandHeader = `
                    <div style="display: flex; align-items: center; border-bottom: 3px solid #E31E24; padding-bottom: 12px; margin-bottom: 16px;">
                        <img src="/images/logo.png" alt="Tehelka News" style="max-height: 56px; width: auto; margin-right: 16px;">
                        <div>
                            <h1 style="margin: 0; color: #E31E24; font-size: 22px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Official Staff Report</h1>
                            <p style="margin: 3px 0 0 0; font-size: 13px; color: #555; font-weight: 600;">Tehelka News</p>
                        </div>
                    </div>`;
                const genLine = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });

                try {
                    // Paginate: repeat the brand + table header on each A4 page. First page
                    // carries the header block so it holds a few less rows than the rest.
                    const ROWS_FIRST = 16, ROWS_REST = 22;
                    const pages = [];
                    let i = 0;
                    while (i < records.length) {
                        const size = pages.length === 0 ? ROWS_FIRST : ROWS_REST;
                        pages.push(records.slice(i, i + size));
                        i += size;
                    }

                    // Join page blocks with html2pdf's NATIVE break element so every page
                    // is emitted (inline `page-break-before` is NOT reliably honored and
                    // caused later pages/records to be clipped).
                    const pagesHtml = pages.map((chunk, pIdx) => {
                        const startIdx = pIdx === 0 ? 0 : ROWS_FIRST + (pIdx - 1) * ROWS_REST;
                        const rows = chunk.map((e, k) => rowHtml(e, startIdx + k)).join('');
                        return `
                            <div style="padding: 24px 28px;">
                                ${brandHeader}
                                <table style="width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed;">
                                    ${colgroup}
                                    ${theadHtml}
                                    <tbody>${rows}</tbody>
                                </table>
                                <div style="margin-top: 14px; text-align: right; color: #999; font-size: 11px;">
                                    Generated on ${genLine} · Page ${pIdx + 1} of ${pages.length} · Tehelka News (confidential)
                                </div>
                            </div>`;
                    }).join('<div class="html2pdf__page-break"></div>');

                    document.getElementById('staffReportPages').innerHTML = pagesHtml;

                    const element = document.getElementById('staffReportTemplateContainer').cloneNode(true);
                    element.style.display = 'block';
                    const holder = document.createElement('div');
                    holder.style.position = 'absolute';
                    holder.style.left = '-9999px';
                    holder.appendChild(element);
                    document.body.appendChild(holder);

                    try {
                        await html2pdf().set({
                            margin: [0.35, 0.25, 0.35, 0.25], // top,left,bottom,right (in) — tighter sides
                            filename: `Staff_Report_${new Date().toISOString().slice(0, 10)}.pdf`,
                            image: { type: 'jpeg', quality: 0.98 },
                            html2canvas: { scale: 2, useCORS: true },
                            jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' },
                            // 'legacy' detects .html2pdf__page-break; 'avoid-all' keeps rows/tables intact.
                            pagebreak: { mode: ['avoid-all', 'legacy'], before: '.html2pdf__page-break' }
                        }).from(element).save();
                    } finally {
                        document.body.removeChild(holder);
                    }
                } catch (err) {
                    alert('Error generating staff report: ' + err.message);
                } finally {
                    btn.innerHTML = original;
                    checkButtons();
                }
            }

            if (document.getElementById('btnStaffReportPdf')) {
                document.getElementById('btnStaffReportPdf').addEventListener('click', generateStaffReport);
            }
        });
    </script>
    </body>
</html>