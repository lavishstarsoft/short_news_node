<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Editors List' }) %>

    <style>
        .editors-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .editors-card {
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border: none;
            margin-bottom: 20px;
            background: white;
        }

        .editors-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 30px;
        }

        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        .table tr:hover {
            background-color: #f8f9fa;
        }

        .badge-active {
            background-color: #28a745;
        }

        .badge-inactive {
            background-color: #dc3545;
        }

        .btn-logout {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            border: none;
        }

        .btn-logout:hover {
            background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
        }

        .stats-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            margin: 2px 4px 2px 0;
        }

        .stats-submitted {
            background: #e9ecef;
            color: #495057;
        }

        .stats-published {
            background: #d1fae5;
            color: #065f46;
        }

        .stats-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .stats-rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        /* Modal styles */
        .modal-content {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px 24px;
        }

        /* Feedback message */
        .feedback-message {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 20px;
            border-radius: 5px;
            color: white;
            font-weight: 500;
            z-index: 9999;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
            transform: translateX(200%);
            transition: transform 0.3s ease;
        }

        .feedback-message.show {
            transform: translateX(0);
        }

        .feedback-message.success {
            background-color: #28a745;
        }

        .feedback-message.error {
            background-color: #dc3545;
        }

        @media (max-width: 767.98px) {
            .editors-header {
                padding: 20px 15px;
            }

            .table-responsive {
                font-size: 0.85rem;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Editors Management' , backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'editors' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4">
                                <div class="card editors-card">
                                    <div class="card-header editors-header">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <h2 class="mb-0"><i class="fas fa-users-cog me-2"></i>Editors Management
                                                </h2>
                                                <p class="mb-0 opacity-75">Manage reporter accounts and permissions</p>
                                            </div>
                                            <button class="btn btn-light ripple"
                                                onclick="window.location.href='/register-editor'">
                                                <i class="fas fa-user-plus me-1"></i>Register Editor
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <% if (editors && editors.length> 0) { %>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle">
                                                    <thead>
                                                        <tr>
                                                            <th>Reporter</th>
                                                            <th>Role</th>
                                                            <th>Contact</th>
                                                            <th>Location</th>
                                                            <th>News Insights</th>
                                                            <th>Status</th>
                                                            <th>Last Login</th>
                                                            <th>Joined</th>
                                                            <th class="text-end">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% editors.forEach(function(editor) { %>
                                                            <tr id="editor-row-<%= editor._id %>">
                                                                <td>
                                                                    <div class="fw-bold">
                                                                        <%= editor.name || editor.username %>
                                                                    </div>
                                                                    <div class="text-muted small">@<%= editor.username
                                                                            %>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <span class="badge <%= editor.role === 'subeditor' ? 'bg-info' : 'bg-secondary' %>">
                                                                        <%= editor.role === 'subeditor' ? 'Sub-Editor' : 'Reporter' %>
                                                                    </span>
                                                                    <div class="text-muted small"><%= editor.displayRole || '' %></div>
                                                                </td>
                                                                <td>
                                                                    <div>
                                                                        <%= editor.email %>
                                                                    </div>
                                                                    <div class="small">
                                                                        <%= editor.mobileNumber || '-' %>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div>
                                                                        <%= editor.location || '-' %>
                                                                    </div>
                                                                    <div class="text-muted small">
                                                                        <%= editor.constituency || '-' %>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div>
                                                                        <span class="stats-pill stats-submitted">Submitted: <%= editor.newsStats?.submitted || 0 %></span>
                                                                        <span class="stats-pill stats-published">Published: <%= editor.newsStats?.published || 0 %></span>
                                                                        <span class="stats-pill stats-pending">Pending: <%= editor.newsStats?.pending || 0 %></span>
                                                                        <span class="stats-pill stats-rejected">Rejected: <%= editor.newsStats?.rejected || 0 %></span>
                                                                    </div>
                                                                    <% if (editor.latestRejection) { %>
                                                                        <div class="small text-danger mt-1" title="<%= editor.latestRejection.feedback || '' %>">
                                                                            Last reject: <%= editor.latestRejection.reason || 'Not specified' %>
                                                                        </div>
                                                                        <div class="small text-muted">
                                                                            <%= editor.latestRejection.rejectedAt ? new Date(editor.latestRejection.rejectedAt).toLocaleDateString() : '' %>
                                                                        </div>
                                                                    <% } else { %>
                                                                        <div class="small text-muted mt-1">No rejection history</div>
                                                                    <% } %>
                                                                    <button class="btn btn-sm btn-outline-primary mt-2"
                                                                        onclick="openInsightsModal('<%= editor._id %>')">
                                                                        <i class="fas fa-chart-pie me-1"></i>View Insights
                                                                    </button>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge <%= editor.isActive ? 'badge-active' : 'badge-inactive' %>">
                                                                        <%= editor.isActive ? 'Active' : 'Inactive' %>
                                                                    </span>
                                                                    <div class="mt-2">
                                                                        <button
                                                                            class="btn btn-sm <%= editor.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>"
                                                                            onclick="toggleEditorStatus('<%= editor._id %>', <%= editor.isActive ? 'true' : 'false' %>)"
                                                                            title="Toggle Status">
                                                                            <i class="fas <%= editor.isActive ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                                                                            <%= editor.isActive ? 'Deactivate' : 'Activate' %>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                                <td class="small">
                                                                    <%= editor.lastLogin ? new Date(editor.lastLogin).toLocaleString() : '-' %>
                                                                </td>
                                                                <td class="small">
                                                                    <%= new Date(editor.createdAt).toLocaleDateString()
                                                                        %>
                                                                </td>
                                                                <td class="text-end">
                                                                    <div class="d-flex justify-content-end gap-1">
                                                                        <button class="btn btn-sm btn-outline-primary"
                                                                            onclick="openEditEditorModal('<%= editor._id %>')">
                                                                            <i class="fas fa-edit"></i>
                                                                        </button>
                                                                        <button class="btn btn-sm btn-outline-warning"
                                                                            onclick="openPasswordModal('<%= editor._id %>')"
                                                                            title="Change Password">
                                                                            <i class="fas fa-key"></i>
                                                                        </button>
                                                                        <button class="btn btn-sm btn-outline-danger"
                                                                            onclick="deleteEditor('<%= editor._id %>')">
                                                                            <i class="fas fa-trash"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <script id="editorsData"
                                                type="application/json"><%- JSON.stringify(editors) %></script>
                                            <% } else { %>
                                                <div class="text-center py-5">
                                                    <i class="fas fa-users text-muted fa-3x mb-3"></i>
                                                    <p class="text-muted">No editors registered yet.</p>
                                                    <a href="/register-editor" class="btn btn-primary">Add First
                                                        Editor</a>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Edit Editor Modal -->
            <div class="modal fade" id="editEditorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Edit Editor Details</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editEditorForm">
                                <input type="hidden" id="editEditorId">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Full Name</label>
                                        <input type="text" class="form-control" id="editName">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Role</label>
                                        <select class="form-select" id="editRole">
                                            <option value="editor">Reporter</option>
                                            <option value="subeditor">Sub-Editor</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Display Role</label>
                                        <input type="text" class="form-control" id="editDisplayRole"
                                            placeholder="e.g. Senior Reporter">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Location</label>
                                        <select class="form-select" id="editLocation">
                                            <option value="">Select Location</option>
                                            <% locations.forEach(function(loc) { %>
                                                <option value="<%= loc.name %>">
                                                    <%= loc.name %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Constituency</label>
                                        <input type="text" class="form-control" id="editConstituency">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Mobile Number</label>
                                        <input type="text" class="form-control" id="editMobile">
                                    </div>
                                </div>
                                <div class="d-grid mt-3">
                                    <button type="submit" class="btn btn-primary text-white">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feedback Message -->
            <div id="feedbackMessage" class="feedback-message"></div>

            <!-- Change Password Modal -->
            <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-key me-2"></i>Change Editor Password</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="changePasswordForm">
                                <input type="hidden" id="passwordEditorId">
                                <div class="mb-3">
                                    <label class="form-label">New Password</label>
                                    <input type="password" class="form-control" id="newPassword" minlength="6" required>
                                    <small class="text-muted">Minimum 6 characters</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm Password</label>
                                    <input type="password" class="form-control" id="confirmPassword" minlength="6" required>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-warning text-dark fw-bold">Update Password</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- News Insights Modal -->
            <div class="modal fade" id="insightsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-chart-line me-2"></i>News Insights</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <h6 class="mb-1" id="insightsEditorName">Reporter</h6>
                                <div class="small text-muted" id="insightsEditorRole">Role</div>
                            </div>

                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <button class="btn w-100 btn-outline-secondary" onclick="openEditorNews('submitted')">
                                        <div class="fw-bold fs-4" id="insightsSubmitted">0</div>
                                        <div class="small">Submitted</div>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3">
                                    <button class="btn w-100 btn-outline-success" onclick="openEditorNews('published')">
                                        <div class="fw-bold fs-4" id="insightsPublished">0</div>
                                        <div class="small">Published</div>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3">
                                    <button class="btn w-100 btn-outline-warning" onclick="openEditorNews('pending')">
                                        <div class="fw-bold fs-4" id="insightsPending">0</div>
                                        <div class="small">Pending</div>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3">
                                    <button class="btn w-100 btn-outline-danger" onclick="openEditorNews('rejected')">
                                        <div class="fw-bold fs-4" id="insightsRejected">0</div>
                                        <div class="small">Rejected</div>
                                    </button>
                                </div>
                            </div>

                            <div class="mt-4 p-3 bg-light rounded">
                                <div class="fw-semibold mb-1">Latest Rejection Reason</div>
                                <div id="insightsRejectionReason" class="text-danger small">No rejection history</div>
                                <div id="insightsRejectionDate" class="text-muted small"></div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <script>
                    let editors = [];
                    let selectedInsightsEditorId = null;

                    document.addEventListener('DOMContentLoaded', function () {
                        const dataScript = document.getElementById('editorsData');
                        if (dataScript) {
                            try {
                                editors = JSON.parse(dataScript.textContent);
                            } catch (e) {
                                console.error('Error parsing editors data:', e);
                            }
                        }
                    });

                    // Open Edit Modal
                    function openEditEditorModal(editorId) {
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        document.getElementById('editEditorId').value = editor._id;
                        document.getElementById('editName').value = editor.name || '';
                        document.getElementById('editRole').value = editor.role || 'editor';
                        document.getElementById('editDisplayRole').value = editor.displayRole || '';
                        document.getElementById('editLocation').value = editor.location || '';
                        document.getElementById('editConstituency').value = editor.constituency || '';
                        document.getElementById('editMobile').value = editor.mobileNumber || '';

                        const modal = new bootstrap.Modal(document.getElementById('editEditorModal'));
                        modal.show();
                    }

                    // Handle Edit Form Submit
                    document.getElementById('editEditorForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        const id = document.getElementById('editEditorId').value;
                        const data = {
                            name: document.getElementById('editName').value,
                            role: document.getElementById('editRole').value,
                            displayRole: document.getElementById('editDisplayRole').value,
                            location: document.getElementById('editLocation').value,
                            constituency: document.getElementById('editConstituency').value,
                            mobileNumber: document.getElementById('editMobile').value
                        };

                        fetch(`/admin/editors/${id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('editEditorModal')).hide();
                                    setTimeout(() => location.reload(), 1000);
                                }
                            })
                            .catch(err => showFeedback('Update failed', 'error'));
                    });

                    // Delete Editor
                    function deleteEditor(id) {
                        if (confirm('Are you sure you want to delete this editor?')) {
                            fetch(`/admin/editors/${id}`, { method: 'DELETE' })
                                .then(res => res.json())
                                .then(result => {
                                    if (result.error) {
                                        showFeedback(result.error, 'error');
                                    } else {
                                        showFeedback('Editor deleted', 'success');
                                        document.getElementById(`editor-row-${id}`).remove();
                                    }
                                })
                                .catch(err => showFeedback('Delete failed', 'error'));
                        }
                    }

                    // Toggle editor active status
                    function toggleEditorStatus(id, currentStatus) {
                        const nextStatus = !currentStatus;
                        const actionText = nextStatus ? 'activate' : 'deactivate';

                        if (!confirm(`Are you sure you want to ${actionText} this user?`)) return;

                        fetch(`/admin/editors/${id}/status`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ isActive: nextStatus })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    setTimeout(() => location.reload(), 800);
                                }
                            })
                            .catch(() => showFeedback('Failed to update user status', 'error'));
                    }

                    // Open password modal
                    function openPasswordModal(editorId) {
                        document.getElementById('passwordEditorId').value = editorId;
                        document.getElementById('newPassword').value = '';
                        document.getElementById('confirmPassword').value = '';
                        const modal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
                        modal.show();
                    }

                    // Handle password change form
                    document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
                        e.preventDefault();

                        const editorId = document.getElementById('passwordEditorId').value;
                        const newPassword = document.getElementById('newPassword').value;
                        const confirmPassword = document.getElementById('confirmPassword').value;

                        if (newPassword.length < 6) {
                            showFeedback('Password must be at least 6 characters', 'error');
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            showFeedback('Passwords do not match', 'error');
                            return;
                        }

                        fetch(`/admin/editors/${editorId}/password`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ newPassword })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                                }
                            })
                            .catch(() => showFeedback('Failed to update password', 'error'));
                    });

                    function showFeedback(message, type) {
                        const feedback = document.getElementById('feedbackMessage');
                        feedback.textContent = message;
                        feedback.className = 'feedback-message ' + type + ' show';
                        setTimeout(() => feedback.classList.remove('show'), 3000);
                    }

                    function openInsightsModal(editorId) {
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        selectedInsightsEditorId = editorId;
                        document.getElementById('insightsEditorName').textContent = editor.name || editor.username;
                        document.getElementById('insightsEditorRole').textContent = editor.displayRole || (editor.role === 'subeditor' ? 'Sub-Editor' : 'Reporter');

                        document.getElementById('insightsSubmitted').textContent = editor.newsStats?.submitted || 0;
                        document.getElementById('insightsPublished').textContent = editor.newsStats?.published || 0;
                        document.getElementById('insightsPending').textContent = editor.newsStats?.pending || 0;
                        document.getElementById('insightsRejected').textContent = editor.newsStats?.rejected || 0;

                        if (editor.latestRejection) {
                            document.getElementById('insightsRejectionReason').textContent = editor.latestRejection.reason || 'Not specified';
                            document.getElementById('insightsRejectionDate').textContent = editor.latestRejection.rejectedAt
                                ? new Date(editor.latestRejection.rejectedAt).toLocaleString()
                                : '';
                        } else {
                            document.getElementById('insightsRejectionReason').textContent = 'No rejection history';
                            document.getElementById('insightsRejectionDate').textContent = '';
                        }

                        const modal = new bootstrap.Modal(document.getElementById('insightsModal'));
                        modal.show();
                    }

                    function openEditorNews(type) {
                        if (!selectedInsightsEditorId) return;

                        const statusMap = {
                            submitted: '',
                            published: 'active',
                            pending: 'pending',
                            rejected: 'rejected'
                        };

                        const params = new URLSearchParams();
                        params.set('authorId', selectedInsightsEditorId);
                        if (statusMap[type]) {
                            params.set('status', statusMap[type]);
                        }

                        window.location.href = `/news-list?${params.toString()}`;
                    }
                </script>
    </body>

</html>