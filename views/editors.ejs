                    function formatDateDDMMYYYY(dateStr) {
                        if (!dateStr) return '—';
                        const d = new Date(dateStr);
                        const day = String(d.getDate()).padStart(2, '0');
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const year = d.getFullYear();
                        return `${day}-${month}-${year}`;
                    }

                    async function fetchEditorReportData(id, params = '') {
                        try {
                            const response = await fetch(`/admin/editors/${id}/report?${params}`);
                            if (!response.ok) throw new Error('Failed to fetch report');
                            
                            const data = await response.json();
                            
                            document.getElementById('reportModalTitle').textContent = `${data.editor.name || data.editor.username} (${data.editor.role})`;
                            document.getElementById('reportAccountCreated').textContent = data.editor.createdAt ? formatDateDDMMYYYY(data.editor.createdAt) : 'N/A';
                            document.getElementById('reportFirstArticle').textContent = data.firstArticleDate ? formatDateDDMMYYYY(data.firstArticleDate) : 'No Articles Yet';
                            
                            document.getElementById('reportTotalArticles').textContent = data.totalArticles;
                            document.getElementById('reportTodayCount').textContent = data.todayCount;
                            document.getElementById('reportYesterdayCount').textContent = data.yesterdayCount;
                            document.getElementById('reportTotalViews').textContent = data.totalViews || 0;
                            document.getElementById('reportApprovedCount').textContent = data.approvedCount;
                            document.getElementById('reportRejectedCount').textContent = data.rejectedCount;

                            // Populate PDF template as well
                            document.getElementById('pdfGeneratedDate').textContent = formatDateDDMMYYYY(new Date());
                            document.getElementById('pdfEmpName').textContent = data.editor.name || data.editor.username;
                            document.getElementById('pdfEmpRole').textContent = (data.editor.role).toUpperCase();
                            document.getElementById('pdfEmpJoined').textContent = data.editor.createdAt ? formatDateDDMMYYYY(data.editor.createdAt) : 'N/A';
                            document.getElementById('pdfEmpFirstArticle').textContent = data.firstArticleDate ? formatDateDDMMYYYY(data.firstArticleDate) : 'No Articles Yet';
                            
                            document.getElementById('pdfTotalArticles').textContent = data.totalArticles;
                            document.getElementById('pdfTodayArticles').textContent = data.todayCount;
                            document.getElementById('pdfYesterdayArticles').textContent = data.yesterdayCount;
                            document.getElementById('pdfTotalViews').textContent = data.totalViews || 0;
                            document.getElementById('pdfApproved').textContent = data.approvedCount;
                            document.getElementById('pdfRejected').textContent = data.rejectedCount;

                            const categoriesList = document.getElementById('reportTopCategories');
                            const pdfCategoriesList = document.getElementById('pdfTopCategories');
                            categoriesList.innerHTML = '';
                            pdfCategoriesList.innerHTML = '';
                            if (data.topCategories && data.topCategories.length > 0) {
                                data.topCategories.forEach(cat => {
                                    categoriesList.innerHTML += `<li class="list-group-item d-flex justify-content-between align-items-center">
                                        ${cat.category || 'Uncategorized'}
