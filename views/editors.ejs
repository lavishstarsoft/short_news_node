<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Editors List' }) %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <link rel="stylesheet" href="/css/editors-directory.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    <link rel="stylesheet" href="/css/team-register.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    <style>
        .feedback-message {
            position: fixed;
            top: 25px;
            right: 25px;
            padding: 16px 24px;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            z-index: 9999;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            transform: translateX(200%);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .feedback-message.show { transform: translateX(0); }
        .feedback-message.success { background-color: #10b981; }
        .feedback-message.error { background-color: #ef4444; }
        .cropper-view-box, .cropper-face { border-radius: 50%; }

        /* ── Editor modal (add / edit) ── */
        .editor-modal .modal-dialog {
            max-height: calc(100vh - 3.5rem);
            margin: 1.75rem auto;
        }
        .editor-modal .modal-content {
            border: none; border-radius: 16px; overflow: hidden;
            display: flex; flex-direction: column;
            max-height: calc(100vh - 3.5rem);
        }
        .editor-modal .modal-header,
        .editor-modal .editor-tabs {
            flex-shrink: 0;
        }
        .editor-modal form {
            display: flex; flex-direction: column;
            flex: 1 1 auto; min-height: 0; overflow: hidden;
        }
        .editor-modal .editor-tab-body {
            flex: 1 1 auto; min-height: 0;
            overflow-y: auto; -webkit-overflow-scrolling: touch;
        }
        .editor-modal-header {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff; padding: 20px 24px;
        }
        .editor-modal-header .modal-title { font-weight: 700; margin: 0; }
        .editor-modal-sub { opacity: .85; font-size: 13px; margin: 4px 0 0; }
        .editor-tabs {
            display: flex; gap: 4px; padding: 12px 16px 0;
            background: #f8fafc; border-bottom: 1px solid #e2e8f0;
            overflow-x: auto;
        }
        .editor-tab-btn {
            border: none; background: transparent; padding: 10px 16px;
            border-radius: 10px 10px 0 0; font-weight: 600; font-size: 13px;
            color: #64748b; white-space: nowrap; cursor: pointer; transition: .2s;
        }
        .editor-tab-btn.active {
            background: #fff; color: #4f46e5;
            box-shadow: 0 -2px 0 #4f46e5 inset;
        }
        .editor-tab-panel { display: none; padding: 20px 24px; }
        .editor-tab-panel.active { display: block; }
        .editor-help {
            background: linear-gradient(135deg, #eef2ff, #f0f9ff);
            border: 1px solid #c7d2fe; border-radius: 12px;
            padding: 14px 16px; margin-bottom: 18px; font-size: 13px; color: #475569;
        }
        .editor-help strong { color: #3730a3; }
        .editor-section-title {
            font-size: 14px; font-weight: 700; color: #1e293b;
            margin: 0 0 14px; display: flex; align-items: center; gap: 8px;
        }
        .editor-role-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
        .editor-role-card {
            border: 2px solid #e2e8f0; border-radius: 12px; padding: 14px;
            cursor: pointer; transition: .2s; background: #fff; text-align: left;
        }
        .editor-role-card.selected { border-color: #4f46e5; background: #eef2ff; }
        .editor-role-card strong { display: block; color: #1e293b; margin-bottom: 4px; }
        .editor-role-card small { color: #64748b; line-height: 1.4; }
        .editor-chip-wrap {
            border: 1px solid #e2e8f0; border-radius: 12px; background: #fafafa; overflow: hidden;
        }
        .editor-chip-toolbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 12px; background: #f1f5f9; border-bottom: 1px solid #e2e8f0;
            font-size: 12px; color: #64748b;
        }
        .editor-chip-toolbar .chip-count {
            font-weight: 700; color: #4f46e5;
        }
        .editor-chip-toolbar .chip-actions {
            display: flex; gap: 8px;
        }
        .editor-chip-toolbar .chip-action-btn {
            background: none; border: 1px solid #cbd5e1; border-radius: 6px;
            padding: 3px 10px; font-size: 11px; color: #475569; cursor: pointer;
            transition: .15s;
        }
        .editor-chip-toolbar .chip-action-btn:hover {
            background: #4f46e5; color: #fff; border-color: #4f46e5;
        }
        .editor-chip-grid {
            display: flex; flex-wrap: wrap; gap: 8px;
            max-height: 200px; overflow-y: auto; padding: 12px;
        }
        .editor-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 20px; font-size: 13px;
            border: 1px solid #cbd5e1; background: #fff; cursor: pointer;
            user-select: none; transition: .15s;
        }
        .editor-chip.selected { background: #4f46e5; color: #fff; border-color: #4f46e5; }
        .editor-chip input { display: none; }
        .editor-scope-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .editor-scope-card {
            border: 2px solid #e2e8f0; border-radius: 10px; padding: 12px;
            cursor: pointer; text-align: center; transition: .2s;
        }
        .editor-scope-card.selected { border-color: #059669; background: #ecfdf5; }
        .editor-scope-card .te { font-size: 12px; color: #64748b; }
        .editor-perm-card {
            border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;
            margin-bottom: 10px; background: #fff;
        }
        .editor-perm-card label { font-weight: 600; cursor: pointer; margin: 0; }
        .editor-perm-card .hint { font-size: 12px; color: #94a3b8; margin: 4px 0 0 28px; }
        .editor-modal-footer {
            flex-shrink: 0;
            padding: 16px 24px; border-top: 1px solid #e2e8f0;
            background: #f8fafc; display: flex; justify-content: space-between; gap: 12px;
        }
        .editor-field { margin-bottom: 14px; }
        .editor-field label { font-weight: 600; font-size: 13px; color: #334155; margin-bottom: 6px; display: block; }
        .editor-field input, .editor-field select {
            width: 100%; border: 1px solid #cbd5e1; border-radius: 10px;
            padding: 10px 12px; font-size: 14px;
        }
        .editor-field-hint { font-size: 12px; color: #94a3b8; margin-top: 4px; }
        .editor-profile-wrap { text-align: center; margin-bottom: 20px; }

        /* ── Info tooltip "?" icon ── */
        .info-tip {
            display: inline-flex; align-items: center; justify-content: center;
            width: 18px; height: 18px; border-radius: 50%;
            background: #e2e8f0; color: #475569; font-size: 11px; font-weight: 700;
            cursor: help; margin-left: 6px; position: relative; vertical-align: middle;
            transition: background .2s;
        }
        .info-tip:hover { background: #4f46e5; color: #fff; }
        .info-tip .info-tip-text {
            display: none; position: absolute; bottom: calc(100% + 8px); left: 50%;
            transform: translateX(-50%); width: 260px; padding: 10px 14px;
            background: #1e293b; color: #f1f5f9; font-size: 12px; font-weight: 400;
            line-height: 1.5; border-radius: 8px; box-shadow: 0 4px 12px rgb(0 0 0/.2);
            z-index: 100; text-align: left; white-space: normal;
        }
        .info-tip .info-tip-text::after {
            content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
            border: 6px solid transparent; border-top-color: #1e293b;
        }
        .info-tip:hover .info-tip-text { display: block; }

        /* ── Step info banner ── */
        .editor-step-banner {
            background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
            border: 1px solid #86efac; border-radius: 12px;
            padding: 14px 16px; margin-bottom: 18px; font-size: 13px; color: #166534;
            display: flex; align-items: flex-start; gap: 10px;
        }
        .editor-step-banner.blue {
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-color: #93c5fd; color: #1e40af;
        }
        .editor-step-banner.amber {
            background: linear-gradient(135deg, #fffbeb, #fef3c7);
            border-color: #fcd34d; color: #92400e;
        }
        .editor-step-banner.purple {
            background: linear-gradient(135deg, #faf5ff, #f3e8ff);
            border-color: #c4b5fd; color: #6b21a8;
        }
        .editor-step-banner .step-icon {
            font-size: 18px; flex-shrink: 0; margin-top: 1px;
        }
        .editor-step-banner strong { font-weight: 700; }

        /* ── Reporter-only / SubEditor-only markers ── */
        .reporter-only-section, .subeditor-only-section { transition: .3s; }
        .role-hidden { display: none !important; }

        @media (max-width: 768px) {
            .editor-role-cards, .editor-scope-row { grid-template-columns: 1fr; }
            .info-tip .info-tip-text { width: 200px; }
        }
    </style>

    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Editors Management' , backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'editors' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4">
                                <% 
                                    const allStaff = editors || [];
                                    const reporterList = allStaff.filter(e => e.role === 'editor');
                                    const subEditorList = allStaff.filter(e => e.role === 'subeditor');
                                    const activeCount = allStaff.filter(e => e.isActive !== false).length;
                                    const editorLangLabels = typeof newsLanguageLabels !== 'undefined' ? newsLanguageLabels : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' };
                                %>

                                <div class="team-page">
                                    <div class="team-page-header">
                                        <div>
                                            <h1 class="team-page-title">Team Directory</h1>
                                            <p class="team-page-subtitle">Manage reporters and sub-editors — search, filter, and track performance.</p>
                                        </div>
                                        <button type="button" class="team-btn-primary" onclick="openAddEditorModal()">
                                            <i class="fas fa-plus"></i> Add Member
                                        </button>
                                    </div>

                                    <div class="team-stats">
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= allStaff.length %></div>
                                            <div class="team-stat-label">Total members</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= reporterList.length %></div>
                                            <div class="team-stat-label">Reporters</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= subEditorList.length %></div>
                                            <div class="team-stat-label">Sub-editors</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= activeCount %></div>
                                            <div class="team-stat-label">Active</div>
                                        </div>
                                    </div>

                                    <% if (allStaff.length > 0) { %>
                                    <div class="team-panel">
                                        <div class="team-panel-toolbar">
                                            <div class="team-search-wrap">
                                                <i class="fas fa-search"></i>
                                                <input type="text" id="staffSearchInput" class="team-search" placeholder="Search name, email, location...">
                                            </div>
                                            <select id="staffLanguageFilter" class="team-filter-select">
                                                <option value="">All languages</option>
                                                <% Object.keys(editorLangLabels).forEach(function(code) { %>
                                                    <option value="<%= code %>"><%= editorLangLabels[code] %></option>
                                                <% }); %>
                                                <option value="__unset__">Not set</option>
                                            </select>
                                            <div class="team-segments" role="tablist">
                                                <button type="button" class="team-segment active" data-staff-filter="all">All<span class="team-segment-count"><%= allStaff.length %></span></button>
                                                <button type="button" class="team-segment" data-staff-filter="editor">Reporters<span class="team-segment-count"><%= reporterList.length %></span></button>
                                                <button type="button" class="team-segment" data-staff-filter="subeditor">Sub-editors<span class="team-segment-count"><%= subEditorList.length %></span></button>
                                            </div>
                                        </div>
                                        
                                        <div class="team-panel-toolbar d-flex align-items-center justify-content-between p-3 border-top" style="background-color: #fcfcfc;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="fw-bold text-secondary small text-uppercase">Multi-Editor Report:</div>
                                                <input type="text" id="multiReportDateRange" class="form-control form-control-sm" placeholder="Select Date Range..." style="width: 220px;">
                                                <span class="text-muted small" id="multiReportSelectedCount">0 selected</span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button id="btnMultiReportPdf" class="btn btn-sm btn-outline-primary" disabled><i class="fas fa-file-pdf"></i> Download PDF</button>
                                                <button id="btnMultiReportImage" class="btn btn-sm btn-outline-success" disabled><i class="fas fa-file-image"></i> Download Image</button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th style="width: 40px; text-align: center;">
                                                            <input type="checkbox" class="form-check-input" id="selectAllEditors">
                                                        </th>
                                                        <th>Member</th>
                                                        <th>Role</th>
                                                        <th>Location</th>
                                                        <th>Language</th>
                                                        <th>Today</th>
                                                        <th>7 Days</th>
                                                        <th>Published</th>
                                                        <th>Range</th>
                                                        <th>Status</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="teamDirectoryBody">
                                                    <% allStaff.forEach(function(editor) { %>
                                                        <%- include('partials/editor-directory-row', { editor: editor, newsLanguageLabels: editorLangLabels }) %>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="team-footer-note">
                                            Showing <strong id="teamVisibleCount"><%= allStaff.length %></strong> of <%= allStaff.length %> members · Click Range to pick custom dates
                                        </div>
                                    </div>

                                    <script id="editorsData" type="application/json"><%- JSON.stringify(allStaff) %></script>
                                    <% } else { %>
                                    <div class="team-panel">
                                        <div class="team-empty">
                                            <div class="team-empty-icon"><i class="fas fa-users"></i></div>
                                            <h5 class="fw-bold text-dark mb-2">No team members yet</h5>
                                            <p class="mb-4">Register your first reporter or sub-editor to get started.</p>
                                            <a href="/register-editor" class="team-btn-primary">Register first member</a>
                                        </div>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Crop Image Modal -->
            <div class="modal fade" id="cropImageModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-crop-alt me-2"></i>Adjust Profile Image</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center">
                            <div style="max-height: 400px; width: 100%; display: flex; justify-content: center;">
                                <img id="cropImageSource" style="max-width: 100%; display: block;">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary text-white" id="btnCropAndSave">
                                <i class="fas fa-check me-1"></i> Crop & Upload
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Editor Modal (tabbed — easy for super admin) -->
            <div class="modal fade editor-modal" id="editEditorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header editor-modal-header">
                            <div>
                                <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Edit Member</h5>
                                <p class="editor-modal-sub" id="editModalSubtitle">Reporter / Sub-Editor details</p>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="editor-tabs" id="editEditorTabs">
                            <button type="button" class="editor-tab-btn active" data-tab="edit-tab-profile"><i class="fas fa-user me-1"></i> 1. Details</button>
                            <button type="button" class="editor-tab-btn" data-tab="edit-tab-location"><i class="fas fa-map-marker-alt me-1"></i> 2. Location</button>
                            <button type="button" class="editor-tab-btn" data-tab="edit-tab-display"><i class="fas fa-mobile-alt me-1"></i> 3. App Display</button>
                            <button type="button" class="editor-tab-btn" data-tab="edit-tab-perms" id="editTabPermsBtn"><i class="fas fa-shield-alt me-1"></i> 4. Permissions</button>
                        </div>

                        <form id="editEditorForm">
                            <input type="hidden" id="editEditorId">
                            <input type="hidden" id="editProfileImageUrl">
                            <select id="editAssignedLocations" multiple class="d-none"><option value=""></option></select>
                            <select id="editAssignedStates" multiple class="d-none"></select>
                            <select id="editAssignedDistricts" multiple class="d-none"></select>
                            <select id="editAssignedConstituencies" multiple class="d-none"></select>
                            <select id="editManagedStates" multiple class="d-none"></select>
                            <select id="editManagedDistricts" multiple class="d-none"></select>
                            <select id="editManagedConstituencies" multiple class="d-none"></select>
                            <select id="editManagedReporterIds" multiple class="d-none"></select>
                            <select id="editAllowedScopes" multiple class="d-none">
                                <option value="district">district</option>
                                <option value="state">state</option>
                                <option value="national">national</option>
                                <option value="international">international</option>
                            </select>
                            <select id="editAllowedLanguages" multiple class="d-none"></select>
                            <select id="editRole" class="d-none">
                                <option value="editor">editor</option>
                                <option value="subeditor">subeditor</option>
                            </select>

                            <div class="editor-tab-body">
                            <!-- Tab 1: Profile -->
                            <div class="editor-tab-panel active" id="edit-tab-profile">
                                <div class="editor-step-banner blue">
                                    <span class="step-icon">👤</span>
                                    <div><strong>Step 1: Basic Details</strong><br>Choose the member type and fill in their basic info. This info is used across the dashboard and the mobile app.</div>
                                </div>

                                <div class="editor-profile-wrap">
                                    <div class="position-relative d-inline-block">
                                        <img id="editProfilePreview" src="" class="rounded-circle img-thumbnail shadow" style="width:96px;height:96px;object-fit:cover;background:#f1f5f9">
                                        <label for="editProfileImageUpload" class="position-absolute bottom-0 end-0 btn btn-sm btn-light rounded-circle shadow" style="cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:2px solid #fff">
                                            <i class="fas fa-camera" style="font-size:.75rem"></i>
                                        </label>
                                        <input type="file" id="editProfileImageUpload" class="d-none" accept="image/*">
                                    </div>
                                    <div class="editor-field-hint mt-2">Click the camera icon to change photo</div>
                                </div>

                                <p class="editor-section-title"><i class="fas fa-id-badge text-primary"></i> What type of member?
                                    <span class="info-tip">?<span class="info-tip-text"><b>Reporter</b> = Writes news articles and submits them for approval.<br><br><b>Sub-Editor</b> = Reviews, approves or rejects news. Can log in to the dashboard.</span></span>
                                </p>
                                <div class="editor-role-cards" id="editRoleCards">
                                    <div class="editor-role-card selected" data-role="editor">
                                        <strong><i class="fas fa-pen-nib me-1"></i> Reporter</strong>
                                        <small>Writes news from the field. Submits for approval.</small>
                                    </div>
                                    <div class="editor-role-card" data-role="subeditor">
                                        <strong><i class="fas fa-user-check me-1"></i> Sub-Editor</strong>
                                        <small>Reviews &amp; approves/rejects news. Has dashboard access.</small>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="editor-field">
                                            <label for="editName">Full Name</label>
                                            <input type="text" id="editName" placeholder="e.g. Ravi Kumar">
                                        </div>
                                    </div>
                                    <div class="col-md-6" id="editUsernameFieldWrap" style="display: none;">
                                        <div class="editor-field">
                                            <label for="editUsername">Login Username
                                                <span class="info-tip">?<span class="info-tip-text">Super Admin only. This is the username used to log in. Must be unique.</span></span>
                                            </label>
                                            <input type="text" id="editUsername" placeholder="e.g. ravi.reporter" autocomplete="off" spellcheck="false">
                                            <small class="text-muted">Must be unique. Used for login.</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="editor-field">
                                            <label for="editDisplayRole">Display Role
                                                <span class="info-tip">?<span class="info-tip-text">This title appears next to their articles in the app. Example: "Senior Reporter", "Khammam Correspondent"</span></span>
                                            </label>
                                            <input type="text" id="editDisplayRole" placeholder="e.g. Senior Reporter">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="editor-field">
                                            <label for="editMobile">Mobile Number</label>
                                            <input type="text" id="editMobile" placeholder="+91 98765 43210">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 2: Location / Coverage Area -->
                            <div class="editor-tab-panel" id="edit-tab-location">
                                <!-- Reporter info banner -->
                                <div class="editor-step-banner reporter-only-section" id="editLocationBannerReporter">
                                    <span class="step-icon">📍</span>
                                    <div><strong>Step 2: Where does this reporter work?</strong><br>Select the areas this reporter covers. They can only submit news from these regions. Follow the steps below in order.</div>
                                </div>
                                <!-- Sub-editor info banner -->
                                <div class="editor-step-banner purple subeditor-only-section" id="editLocationBannerSubeditor">
                                    <span class="step-icon">📍</span>
                                    <div><strong>Step 2: Sub-Editor's base location</strong><br>This is just for record-keeping. The actual areas they can manage are set in the <strong>Permissions</strong> tab.</div>
                                </div>

                                <div class="editor-field">
                                    <label><strong>① Select State(s)</strong>
                                        <span class="info-tip">?<span class="info-tip-text">Click to select one or more states. This filters the districts below. Example: Select "Telangana" to see Telangana districts.</span></span>
                                    </label>
                                    <div class="editor-chip-wrap">
                                        <div class="editor-chip-grid" id="editStateChips">
                                            <span class="text-muted small">Loading states...</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="editor-field">
                                    <label><strong>② Select District(s)</strong>
                                        <span class="info-tip">?<span class="info-tip-text">Districts appear based on states selected above. Click to select the districts this member covers. Example: "Khammam", "Nalgonda".</span></span>
                                    </label>
                                    <div class="editor-chip-wrap">
                                        <div class="editor-chip-grid" id="editDistrictChips">
                                            <span class="text-muted small">Select at least one state first...</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="editor-field">
                                    <label><strong>③ Select Constituency (optional)</strong>
                                        <span class="info-tip">?<span class="info-tip-text">Optional — if the reporter covers specific constituencies only. Skip this if they cover the entire district.</span></span>
                                    </label>
                                    <div class="editor-chip-wrap">
                                        <div class="editor-chip-grid" id="editConstituencyChips">
                                            <span class="text-muted small">Select districts to see constituencies...</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="editor-field" id="editAllowedScopesSection">
                                    <label><strong>④ What type of news can they write?</strong>
                                        <span class="info-tip">?<span class="info-tip-text"><b>Local</b> = District-level news (e.g. "Khammam road accident")<br><b>State</b> = State-level news (e.g. "Telangana budget 2026")<br><b>National</b> = Country-level (e.g. "PM Modi speech")<br><b>International</b> = World news<br><br>Select one or more. If none selected, reporter can write all types.</span></span>
                                    </label>
                                    <div class="editor-scope-row" id="editScopeCards">
                                        <div class="editor-scope-card" data-scope="district">
                                            <strong>🏘 Local</strong>
                                            <div class="te">District-level news</div>
                                        </div>
                                        <div class="editor-scope-card" data-scope="state">
                                            <strong>🏛 State</strong>
                                            <div class="te">State-wide news</div>
                                        </div>
                                        <div class="editor-scope-card" data-scope="national">
                                            <strong>🇮🇳 National</strong>
                                            <div class="te">Country-level news</div>
                                        </div>
                                        <div class="editor-scope-card" data-scope="international">
                                            <strong>🌍 International</strong>
                                            <div class="te">World news</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="editor-field">
                                            <label for="editConstituency">Primary Constituency
                                                <span class="info-tip">?<span class="info-tip-text">This is shown next to their name in the app. Example: "Malakpet Correspondent". Pick from selected constituencies or type manually.</span></span>
                                            </label>
                                            <input type="text" id="editConstituency" placeholder="e.g. Malakpet">
                                        </div>
                                    </div>
                                    <div class="col-md-6 reporter-only-section">
                                        <div class="editor-field">
                                            <label for="editWorkingLanguage">News Language
                                                <span class="info-tip">?<span class="info-tip-text">The language this reporter writes news in. Their articles appear under this language in the app.</span></span>
                                            </label>
                                            <select id="editWorkingLanguage">
                                                <%- include('partials/language-select-options', { selectedValue: 'te' }) %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: App Display -->
                            <div class="editor-tab-panel" id="edit-tab-display">
                                <div class="editor-step-banner amber">
                                    <span class="step-icon">📱</span>
                                    <div><strong>App Display Settings</strong><br>Control what information appears next to this member's articles in the mobile app. Toggle ON/OFF as needed.</div>
                                </div>
                                <div class="editor-perm-card">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="editShowProfileImage" checked>
                                        <label class="form-check-label" for="editShowProfileImage"><strong>Show Profile Photo</strong></label>
                                    </div>
                                    <div class="hint">Their photo will appear next to articles in the app</div>
                                </div>
                                <div class="editor-perm-card">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="editShowName" checked>
                                        <label class="form-check-label" for="editShowName"><strong>Show Name</strong></label>
                                    </div>
                                    <div class="hint">Their full name will be visible on articles</div>
                                </div>
                                <div class="editor-perm-card">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="editShowConstituency" checked>
                                        <label class="form-check-label" for="editShowConstituency"><strong>Show Constituency</strong></label>
                                    </div>
                                    <div class="hint">Constituency name (e.g. "Malakpet") shown below their name</div>
                                </div>
                            </div>

                            <!-- Tab 4: Permissions (sub-editor only) -->
                            <div class="editor-tab-panel" id="edit-tab-perms">
                                <section id="adminSettingsSection">
                                    <!-- Reporter message -->
                                    <div class="editor-step-banner reporter-only-section" id="editPermsReporterNote">
                                        <span class="step-icon">✅</span>
                                        <div><strong>No permissions needed for Reporters</strong><br>Reporters simply write and submit news. Permissions are only for Sub-Editors. Wallet settings below apply to this member.</div>
                                    </div>

                                    <!-- Wallet & Daily Earnings (per member) -->
                                    <div id="editWalletConfigBlock">
                                        <div class="editor-step-banner green" style="background:#ecfdf5;border-color:#a7f3d0">
                                            <span class="step-icon">💰</span>
                                            <div><strong>Wallet &amp; Daily Earnings</strong><br>Settings here apply <b>only to this member</b>. Other reporters are not affected. If wallet is OFF, the app hides wallet, daily target and earnings completely.</div>
                                        </div>

                                        <div class="editor-perm-card">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="editWalletEnabled">
                                                <label class="form-check-label" for="editWalletEnabled"><strong>Wallet Enabled</strong></label>
                                            </div>
                                            <div class="hint">ON = this member sees wallet, daily target and earns daily rewards. OFF = wallet section fully hidden, no reward credits.</div>
                                        </div>

                                        <div class="row g-3" id="editWalletNumbersRow">
                                            <div class="col-md-6">
                                                <div class="editor-field">
                                                    <label for="editWalletDailyTarget">Daily Target (news per day)
                                                        <span class="info-tip">?<span class="info-tip-text">How many approved news this member needs in one day to earn the daily reward. Leave empty to use the global default.</span></span>
                                                    </label>
                                                    <input type="number" id="editWalletDailyTarget" min="1" step="1" placeholder="Global default">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="editor-field">
                                                    <label for="editWalletDailyReward">Daily Reward (₹)
                                                        <span class="info-tip">?<span class="info-tip-text">Amount credited when the daily target is reached. Leave empty to use the global default.</span></span>
                                                    </label>
                                                    <input type="number" id="editWalletDailyReward" min="1" step="1" placeholder="Global default">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="hint mb-3">Empty boxes = global defaults from the Wallet Settings page apply (e.g. 5 news / ₹30).</div>
                                    </div>

                                    <!-- Sub-editor permissions -->
                                    <div class="subeditor-only-section" id="editSubEditorPermsBlock">
                                        <div class="editor-step-banner purple">
                                            <span class="step-icon">🔐</span>
                                            <div><strong>Sub-Editor Permissions</strong><br>Control what this sub-editor can do in the dashboard. Turn ON only the permissions they need.</div>
                                        </div>

                                        <p class="editor-section-title"><i class="fas fa-key text-primary"></i> Dashboard Access</p>

                                        <div id="editCanAccessAdminDashboardWrapper">
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanAccessAdminDashboard" class="form-check-input me-2">
                                                <label for="editCanAccessAdminDashboard"><strong>Can login to Dashboard</strong></label>
                                                <div class="hint">Allow this sub-editor to log in to the admin dashboard website</div>
                                            </div>
                                        </div>
                                        <div id="editCanViewReporterDetailsWrapper">
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanViewReporterDetails" class="form-check-input me-2">
                                                <label for="editCanViewReporterDetails"><strong>Can see reporter personal info</strong></label>
                                                <div class="hint">Shows email, phone number, and constituency of reporters</div>
                                            </div>
                                        </div>

                                        <p class="editor-section-title mt-3"><i class="fas fa-newspaper text-success"></i> News Management</p>

                                        <div id="editCanApproveNewsWrapper">
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanApproveNews" class="form-check-input me-2">
                                                <label for="editCanApproveNews"><strong>Can approve / reject news</strong></label>
                                                <div class="hint">This sub-editor can approve or reject news articles submitted by reporters</div>
                                            </div>
                                        </div>
                                        <div id="editCanViewAllNewsWrapper">
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanViewAllNews" class="form-check-input me-2">
                                                <label for="editCanViewAllNews"><strong>Can view ALL articles</strong></label>
                                                <div class="hint">If OFF, this sub-editor only sees news from reporters assigned to them (not all news)</div>
                                            </div>
                                        </div>

                                        <div class="editor-field" id="editAllowedLanguagesSection">
                                            <label><strong>Languages for Add News</strong>
                                                <span class="info-tip">?<span class="info-tip-text">Controls which languages appear in Add News for this sub-editor.<br><br><b>All Languages</b> = any active language<br><b>One or more</b> = only those in the dropdown<br><br>Reporters use <b>News Language</b> in the Location tab instead.</span></span>
                                            </label>
                                            <div class="editor-scope-row" id="editLangCards"></div>
                                            <div class="hint">Sub-editors: set upload languages here. If none selected, Telugu is used as default.</div>
                                        </div>

                                        <!-- Approval Scope — shown only when "Can approve / reject news" is checked -->
                                        <div id="editManagedLocationsWrapper" style="display:none;margin-left:12px;padding-left:12px;border-left:3px solid #4f46e5">
                                            <div class="editor-step-banner amber" style="margin-top:12px">
                                                <span class="step-icon">🎯</span>
                                                <div><strong>Whose news can they approve?</strong><br>Choose which reporters' news this sub-editor can approve/reject.</div>
                                            </div>
                                            <div class="editor-field">
                                                <label for="editApprovalScope"><strong>Approval Mode</strong>
                                                    <span class="info-tip">?<span class="info-tip-text"><b>All Reporters</b> = Can approve news from any reporter<br><br><b>By Geography</b> = Only reporters from selected states/districts<br><br><b>Specific Reporters</b> = Hand-pick individual reporters</span></span>
                                                </label>
                                                <select id="editApprovalScope">
                                                    <option value="all">All Reporters (can approve anyone's news)</option>
                                                    <option value="geography">By Geography (only reporters from selected areas)</option>
                                                    <option value="reporters">Specific Reporters (pick by name)</option>
                                                </select>
                                            </div>

                                            <div id="editManagedGeographyWrapper" style="display:none">
                                                <div class="editor-step-banner" style="font-size:12px;padding:10px 14px">
                                                    <span class="step-icon">📌</span>
                                                    <div>Select the areas this sub-editor manages. They will only see news from reporters assigned to these areas.</div>
                                                </div>
                                                <div class="editor-field">
                                                    <label>Managed States</label>
                                                    <div class="editor-chip-wrap"><div class="editor-chip-grid" id="editManagedStateChips"><span class="text-muted small">Loading...</span></div></div>
                                                </div>
                                                <div class="editor-field">
                                                    <label>Managed Districts</label>
                                                    <div class="editor-chip-wrap"><div class="editor-chip-grid" id="editManagedDistrictChips"><span class="text-muted small">Select states first...</span></div></div>
                                                </div>
                                                <div class="editor-field">
                                                    <label>Managed Constituencies</label>
                                                    <div class="editor-chip-wrap"><div class="editor-chip-grid" id="editManagedConstituencyChips"><span class="text-muted small">Select districts first...</span></div></div>
                                                </div>
                                            </div>

                                            <div id="editManagedReportersWrapper" style="display:none">
                                                <div class="editor-field">
                                                    <label for="editReporterSearch">Search Reporters</label>
                                                    <input type="text" id="editReporterSearch" placeholder="Search by name, district..." class="form-control">
                                                </div>
                                                <div class="editor-reporter-list" id="editManagedReporterList" style="max-height:220px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:10px;padding:10px;background:#fafafa"></div>
                                            </div>
                                        </div>

                                        <p class="editor-section-title mt-3"><i class="fas fa-cog text-warning"></i> Extra Abilities</p>

                                        <div id="editSubEditorPermissionsWrapper">
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanSendNotifications" class="form-check-input me-2">
                                                <label for="editCanSendNotifications"><strong>Can send push notifications</strong></label>
                                                <div class="hint">Send push notifications to app users about breaking news</div>
                                            </div>
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanEditNews" class="form-check-input me-2">
                                                <label for="editCanEditNews"><strong>Can edit any news article</strong></label>
                                                <div class="hint">Edit any published or pending article (not just their own)</div>
                                            </div>
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editRequiresSourceLink" class="form-check-input me-2">
                                                <label for="editRequiresSourceLink"><strong>Must add source link</strong></label>
                                                <div class="hint">Force this sub-editor to include a source URL when posting news</div>
                                            </div>
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editAiCheckEnabled" class="form-check-input me-2">
                                                <label for="editAiCheckEnabled"><strong>News AI check</strong></label>
                                                <div class="hint">When ON, this sub-editor's news is verified by the AI duplicate check before auto-publishing. Turn OFF to publish their news directly without the AI check.</div>
                                            </div>
                                        </div>

                                        <div id="editSidebarAccessWrapper" style="margin-top:16px">
                                            <p class="editor-section-title"><i class="fas fa-bars text-info"></i> Dashboard Menu Access
                                                <span class="info-tip">?<span class="info-tip-text">Control which pages this sub-editor can see in the dashboard sidebar. Unchecked pages will be hidden from them.</span></span>
                                            </p>
                                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                                                <% const sidebarMenus = [
                                                    { id: 'dashboard', label: 'Dashboard' }, { id: 'newsList', label: 'News List' },
                                                    { id: 'addNews', label: 'Add News' }, { id: 'pendingNews', label: 'Pending News' },
                                                    { id: 'rejectedNews', label: 'Rejected News' }, { id: 'plagiarismReport', label: 'Plagiarism' },
                                                    { id: 'viralVideos', label: 'Viral Videos' }, { id: 'polls', label: 'Polls' },
                                                    { id: 'longVideos', label: 'Long Videos' }, { id: 'categories', label: 'Categories' },
                                                    { id: 'programCategories', label: 'Program Categories' }, { id: 'locations', label: 'Locations' },
                                                    { id: 'reports', label: 'Reports' }, { id: 'zodiac', label: 'Zodiac Calendar' }
                                                ]; %>
                                                <% sidebarMenus.forEach(menu => { %>
                                                <div class="form-check">
                                                    <input type="checkbox" id="editSidebar_<%= menu.id %>" class="form-check-input sidebar-menu-cb" data-menu="<%= menu.id %>" data-opt-in="<%= menu.id === 'zodiac' ? 'true' : 'false' %>"<%= menu.id === 'zodiac' ? '' : ' checked' %>>
                                                    <label for="editSidebar_<%= menu.id %>" class="form-check-label"><%= menu.label %><% if (menu.id === 'zodiac') { %> <span class="text-muted small">(off by default)</span><% } %></label>
                                                </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    </div><!-- end subeditor block -->
                                </section>
                            </div>

                            </div><!-- /.editor-tab-body -->

                            <div class="editor-modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i> Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Add Editor Modal -->
            <div class="modal fade editor-modal" id="addEditorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header editor-modal-header" style="background:linear-gradient(135deg,#059669,#047857)">
                            <div>
                                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Add New Member</h5>
                                <p class="editor-modal-sub">Create a Reporter or Sub-Editor account</p>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="editor-tabs" id="addEditorTabs">
                            <button type="button" class="editor-tab-btn active" data-tab="add-tab-account"><i class="fas fa-key me-1"></i> 1. Login</button>
                            <button type="button" class="editor-tab-btn" data-tab="add-tab-profile"><i class="fas fa-user me-1"></i> 2. Details</button>
                            <button type="button" class="editor-tab-btn" data-tab="add-tab-location"><i class="fas fa-map-marker-alt me-1"></i> 3. Location</button>
                            <button type="button" class="editor-tab-btn" data-tab="add-tab-perms" id="addTabPermsBtn"><i class="fas fa-shield-alt me-1"></i> 4. Permissions</button>
                        </div>

                        <form id="addEditorForm">
                            <select id="addRole" class="d-none"><option value="editor">editor</option><option value="subeditor">subeditor</option></select>
                            <select id="addAssignedStates" multiple class="d-none"></select>
                            <select id="addAssignedDistricts" multiple class="d-none"></select>
                            <select id="addAssignedConstituencies" multiple class="d-none"></select>
                            <select id="addManagedStates" multiple class="d-none"></select>
                            <select id="addManagedDistricts" multiple class="d-none"></select>
                            <select id="addManagedConstituencies" multiple class="d-none"></select>
                            <select id="addManagedReporterIds" multiple class="d-none"></select>
                            <select id="addAllowedScopes" multiple class="d-none">
                                <option value="district">district</option><option value="state">state</option>
                                <option value="national">national</option><option value="international">international</option>
                            </select>

                            <div class="editor-tab-body">
                            <!-- Add Tab 1: Login -->
                            <div class="editor-tab-panel active" id="add-tab-account">
                                <div class="editor-step-banner blue">
                                    <span class="step-icon">🔑</span>
                                    <div><strong>Step 1: Login Credentials</strong><br>These are required to create the account. The member will use these to log in.</div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6"><div class="editor-field"><label for="addUsername">Username *
                                        <span class="info-tip">?<span class="info-tip-text">A unique login name. Example: ravi_reporter, kumar_subeditor</span></span>
                                    </label><input type="text" id="addUsername" required placeholder="e.g. ravi_reporter"></div></div>
                                    <div class="col-md-6"><div class="editor-field"><label for="addEmail">Email *</label><input type="email" id="addEmail" required placeholder="name@news.com"></div></div>
                                    <div class="col-md-6"><div class="editor-field"><label for="addPassword">Password *</label><input type="password" id="addPassword" required minlength="6" placeholder="Minimum 6 characters"></div></div>
                                </div>
                            </div>

                            <!-- Add Tab 2: Profile -->
                            <div class="editor-tab-panel" id="add-tab-profile">
                                <div class="editor-step-banner blue">
                                    <span class="step-icon">👤</span>
                                    <div><strong>Step 2: Member Details</strong><br>Choose the member type and fill in their info.</div>
                                </div>

                                <p class="editor-section-title"><i class="fas fa-id-badge text-primary"></i> What type of member?
                                    <span class="info-tip">?<span class="info-tip-text"><b>Reporter</b> = Writes news articles from the field and submits for approval.<br><br><b>Sub-Editor</b> = Reviews and approves/rejects news. Can access the dashboard.</span></span>
                                </p>
                                <div class="editor-role-cards" id="addRoleCards">
                                    <div class="editor-role-card selected" data-role="editor">
                                        <strong><i class="fas fa-pen-nib me-1"></i> Reporter</strong>
                                        <small>Writes news from the field. Submits for approval.</small>
                                    </div>
                                    <div class="editor-role-card" data-role="subeditor">
                                        <strong><i class="fas fa-user-check me-1"></i> Sub-Editor</strong>
                                        <small>Reviews &amp; approves/rejects news. Has dashboard access.</small>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6"><div class="editor-field"><label for="addName">Full Name *</label><input type="text" id="addName" required placeholder="e.g. Ravi Kumar"></div></div>
                                    <div class="col-md-6"><div class="editor-field"><label for="addDisplayRole">Display Role *
                                        <span class="info-tip">?<span class="info-tip-text">Title shown next to articles in the app. Example: "Senior Reporter", "Khammam Correspondent"</span></span>
                                    </label><input type="text" id="addDisplayRole" required placeholder="e.g. Senior Reporter"></div></div>
                                    <div class="col-md-6"><div class="editor-field"><label for="addMobile">Mobile *</label><input type="text" id="addMobile" required placeholder="+91 98765 43210"></div></div>
                                    <div class="col-md-6 reporter-only-section"><div class="editor-field"><label for="addWorkingLanguage">News Language *
                                        <span class="info-tip">?<span class="info-tip-text">The language this reporter writes news in. Their news will appear in this language section of the app.</span></span>
                                    </label>
                                        <select id="addWorkingLanguage" required><%- include('partials/language-select-options', { selectedValue: 'te' }) %></select>
                                    </div></div>
                                </div>
                            </div>

                            <!-- Add Tab 3: Location -->
                            <div class="editor-tab-panel" id="add-tab-location">
                                <div class="editor-step-banner reporter-only-section" id="addLocationBannerReporter">
                                    <span class="step-icon">📍</span>
                                    <div><strong>Step 3: Where does this reporter work?</strong><br>Select the areas they cover. Follow the steps below in order.</div>
                                </div>
                                <div class="editor-step-banner purple subeditor-only-section" id="addLocationBannerSubeditor">
                                    <span class="step-icon">📍</span>
                                    <div><strong>Step 3: Sub-Editor's base location</strong><br>This is for record-keeping. The areas they manage are set in the <strong>Permissions</strong> tab.</div>
                                </div>

                                <div class="editor-field"><label><strong>① Select State(s) *</strong>
                                    <span class="info-tip">?<span class="info-tip-text">Click to select one or more states. This filters the districts below.</span></span>
                                </label><div class="editor-chip-wrap"><div class="editor-chip-grid" id="addStateChips"><span class="text-muted small">Loading...</span></div></div></div>
                                <div class="editor-field"><label><strong>② Select District(s)</strong>
                                    <span class="info-tip">?<span class="info-tip-text">Districts appear based on states selected above. Click to select.</span></span>
                                </label><div class="editor-chip-wrap"><div class="editor-chip-grid" id="addDistrictChips"><span class="text-muted small">Select states first...</span></div></div></div>
                                <div class="editor-field"><label><strong>③ Select Constituency (optional)</strong></label><div class="editor-chip-wrap"><div class="editor-chip-grid" id="addConstituencyChips"><span class="text-muted small">Select districts first...</span></div></div></div>

                                <div class="editor-field" id="addAllowedScopesSection">
