                                            <option value="reporters" selected>Specific Reporters (pick by name)</option>
                                            <option value="geography_and_reporters">Geography + Specific Reporters (both together)</option>
                                        </select>
                                    </div>
                                    <div id="addManagedGeographyWrapper" style="display:none;margin-left:12px;padding-left:12px;border-left:3px solid #4f46e5">
                                        <div class="editor-field"><label>Managed States</label><div class="editor-chip-wrap"><div class="editor-chip-grid" id="addManagedStateChips"></div></div></div>
