                                ? (getSelectedFromHidden('editAllowedLanguages').filter(c => c !== 'all')[0] || document.getElementById('editWorkingLanguage').value)
                                : document.getElementById('editWorkingLanguage').value,
                            constituency: document.getElementById('editConstituency').value,
                            mobileNumber: document.getElementById('editMobile').value,
                            salary: document.getElementById('editSalary').value === '' ? null : Number(document.getElementById('editSalary').value),
                            profileImage: document.getElementById('editProfileImageUrl').value,
                            displaySettings: {
                                showProfileImage: document.getElementById('editShowProfileImage').checked,
                                showName: document.getElementById('editShowName').checked,
                                showConstituency: document.getElementById('editShowConstituency').checked
                            },
                            canViewReporterDetails: document.getElementById('editCanViewReporterDetails').checked,
                            canAccessAdminDashboard: document.getElementById('editCanAccessAdminDashboard').checked,
                            canApproveNews: document.getElementById('editCanApproveNews').checked,
                            canViewAllNews: document.getElementById('editCanViewAllNews').checked,
                            canSendNotifications: document.getElementById('editCanSendNotifications').checked,
                            canEditNews: document.getElementById('editCanEditNews').checked,
                            requiresSourceLink: document.getElementById('editRequiresSourceLink').checked,
                            aiCheckEnabled: document.getElementById('editAiCheckEnabled').checked,
                            approvalScope: document.getElementById('editApprovalScope').value,
                            sidebar: sidebarData,
                            walletConfig: {
                                enabled: document.getElementById('editWalletEnabled').checked,
                                dailyTargetNews: document.getElementById('editWalletDailyTarget').value || null,
                                dailyRewardAmount: document.getElementById('editWalletDailyReward').value || null
                            }
                        };

                        const editUsernameEl = document.getElementById('editUsername');
                        if (editUsernameEl && !editUsernameEl.disabled) {
                            data.username = editUsernameEl.value.trim();
                        }

                        fetch(`/admin/editors/${id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) showFeedback(result.error, 'error');
                                else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('editEditorModal')).hide();
                                    setTimeout(() => location.reload(), 1000);
                                }
                            })
                            .catch(() => showFeedback('Update failed', 'error'));
                    });

