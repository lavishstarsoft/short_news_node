                                        pdfTbody.innerHTML += `<tr>
                                            <td style="padding: 10px 15px; border: 1px solid #dee2e6;">${formatDateDDMMYYYY(item.date)}</td>
                                            <td style="padding: 10px 15px; border: 1px solid #dee2e6; text-align: right; font-weight: bold;">${item.count}</td>
                                        </tr>`;
