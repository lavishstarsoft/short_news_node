                                categoriesList.innerHTML = '<li class="list-group-item text-muted border-0 text-center py-3">No categories data</li>';
                                pdfCategoriesList.innerHTML = '<tr><td style="padding: 10px; text-align: center; color: #666;" colspan="2">No categories data</td></tr>';
                            }

                            document.getElementById('pdfReportPeriod').textContent = params !== '' ? 'Custom Range' : 'All Time';
                            const tbody = document.getElementById('reportDateWiseBody');
                            const pdfTbody = document.getElementById('pdfBreakdownBody');
                            
                            if (params !== '') {
                                // Render datewise data
                                document.getElementById('reportRangeTotal').textContent = `Total: ${data.customRangeCount}`;
                                tbody.innerHTML = '';
                                pdfTbody.innerHTML = '';
                                if (data.dateWiseData && data.dateWiseData.length > 0) {
                                    data.dateWiseData.forEach(item => {
