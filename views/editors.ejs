                                    bootstrap.Modal.getInstance(document.getElementById('addEditorModal')).hide();
                                    setTimeout(() => location.reload(), 1000);
                                }
                            })
                            .catch(() => showFeedback('Registration failed', 'error'));
                    });

                    // Initialize Cropper Variables
                    let cropper;
                    const cropImageModalElement = document.getElementById('cropImageModal');
                    const cropImageModal = new bootstrap.Modal(cropImageModalElement);
                    const cropImageSource = document.getElementById('cropImageSource');

                    // Handle Profile Image Selection for Cropping
                    document.getElementById('editProfileImageUpload').addEventListener('change', function(e) {
                        const file = e.target.files[0];
                        if (!file) return;

                        const reader = new FileReader();
                        reader.onload = function(event) {
                            cropImageSource.src = event.target.result;
                            cropImageModal.show();
                            
                            // Clear input so same file can be selected again
                            e.target.value = '';
                        };
                        reader.readAsDataURL(file);
                    });

                    cropImageModalElement.addEventListener('shown.bs.modal', function () {
                        if (cropper) {
                            cropper.destroy();
                        }
                        cropper = new Cropper(cropImageSource, {
                            aspectRatio: 1,
                            viewMode: 1,
                            dragMode: 'move',
                            autoCropArea: 1,
                            restore: false,
                            guides: false,
                            center: false,
                            highlight: false,
                            cropBoxMovable: false,
                            cropBoxResizable: false,
                            toggleDragModeOnDblclick: false,
                        });
                    });

                    cropImageModalElement.addEventListener('hidden.bs.modal', function () {
                        if (cropper) {
                            cropper.destroy();
                            cropper = null;
                        }
                    });

                    // Handle Crop and Upload
                    document.getElementById('btnCropAndSave').addEventListener('click', async function() {
                        if (!cropper) return;
                        
                        // Show loading state
                        const btn = this;
                        const originalText = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Uploading...';
                        btn.disabled = true;

                        const croppedCanvas = cropper.getCroppedCanvas({
                            width: 400,
                            height: 400
                        });
                        
                        // Create a new canvas to draw the circle
                        const roundedCanvas = document.createElement('canvas');
                        const context = roundedCanvas.getContext('2d');
                        roundedCanvas.width = 400;
                        roundedCanvas.height = 400;

                        // Draw a circular path
                        context.beginPath();
                        context.arc(200, 200, 200, 0, Math.PI * 2, true);
                        context.closePath();
                        context.clip();

                        // Draw the cropped image into the circle
                        context.drawImage(croppedCanvas, 0, 0);

                        // Export as PNG for transparency
                        roundedCanvas.toBlob(async function(blob) {
                            const formData = new FormData();
                            // Append the blob as a PNG file
                            formData.append('media', blob, 'profile.png');
                            
                            try {
                                const response = await fetch('/news/upload-media', {
                                    method: 'POST',
                                    body: formData
                                });
                                
                                if (response.ok) {
                                    const data = await response.json();
                                    if (data.mediaUrl) {
                                        document.getElementById('editProfileImageUrl').value = data.mediaUrl;
                                        document.getElementById('editProfilePreview').src = data.mediaUrl;
                                        showFeedback('Image uploaded successfully', 'success');
                                        cropImageModal.hide();
                                    } else {
                                        showFeedback('Image upload returned no URL', 'error');
                                    }
                                } else {
                                    showFeedback('Failed to upload image', 'error');
                                }
                            } catch (err) {
                                console.error('Image upload error:', err);
                                showFeedback('Image upload failed', 'error');
                            } finally {
                                btn.innerHTML = originalText;
                                btn.disabled = false;
                            }
                        }, 'image/png');
                    });

                    // Delete Editor
                    function deleteEditor(id) {
                        if (confirm('Are you sure you want to delete this editor?')) {
                            fetch(`/admin/editors/${id}`, { method: 'DELETE' })
                                .then(res => res.json())
                                .then(result => {
                                    if (result.error) {
                                        showFeedback(result.error, 'error');
                                    } else {
                                        showFeedback('Editor deleted', 'success');
                                        document.getElementById(`editor-row-${id}`).remove();
                                    }
                                })
                                .catch(err => showFeedback('Delete failed', 'error'));
                        }
                    }

                    // Toggle editor active status
                    function toggleEditorStatus(id, currentStatus) {
                        const nextStatus = !currentStatus;
                        const actionText = nextStatus ? 'activate' : 'deactivate';

                        if (!confirm(`Are you sure you want to ${actionText} this user?`)) return;

                        fetch(`/admin/editors/${id}/status`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ isActive: nextStatus })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    setTimeout(() => location.reload(), 800);
                                }
                            })
                            .catch(() => showFeedback('Failed to update user status', 'error'));
                    }

                    // Open password modal
                    function openPasswordModal(editorId) {
                        document.getElementById('passwordEditorId').value = editorId;
                        document.getElementById('newPassword').value = '';
                        document.getElementById('confirmPassword').value = '';
                        const modal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
                        modal.show();
                    }

                    // Handle password change form
                    document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
                        e.preventDefault();

                        const editorId = document.getElementById('passwordEditorId').value;
                        const newPassword = document.getElementById('newPassword').value;
                        const confirmPassword = document.getElementById('confirmPassword').value;

                        if (newPassword.length < 6) {
                            showFeedback('Password must be at least 6 characters', 'error');
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            showFeedback('Passwords do not match', 'error');
                            return;
                        }

                        fetch(`/admin/editors/${editorId}/password`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ newPassword })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                                }
                            })
                            .catch(() => showFeedback('Failed to update password', 'error'));
                    });

                    function showFeedback(message, type) {
                        const feedback = document.getElementById('feedbackMessage');
                        feedback.textContent = message;
                        feedback.className = 'feedback-message ' + type + ' show';
                        setTimeout(() => feedback.classList.remove('show'), 3000);
                    }

                    function openInsightsModal(editorId) {
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        selectedInsightsEditorId = editorId;
                        document.getElementById('insightsEditorName').textContent = editor.name || editor.username;
                        document.getElementById('insightsEditorRole').textContent = editor.displayRole || (editor.role === 'subeditor' ? 'Sub-Editor' : 'Reporter');

                        document.getElementById('insightsSubmitted').textContent = editor.newsStats?.submitted || 0;
                        document.getElementById('insightsPublished').textContent = editor.newsStats?.published || 0;
                        document.getElementById('insightsPending').textContent = editor.newsStats?.pending || 0;
                        document.getElementById('insightsRejected').textContent = editor.newsStats?.rejected || 0;

                        if (editor.latestRejection) {
                            document.getElementById('insightsRejectionReason').textContent = editor.latestRejection.reason || 'Not specified';
                            document.getElementById('insightsRejectionDate').textContent = editor.latestRejection.rejectedAt
                                ? new Date(editor.latestRejection.rejectedAt).toLocaleString()
                                : '';
                        } else {
                            document.getElementById('insightsRejectionReason').textContent = 'No rejection history';
                            document.getElementById('insightsRejectionDate').textContent = '';
                        }

                        const modal = new bootstrap.Modal(document.getElementById('insightsModal'));
                        modal.show();
                    }

                    function openEditorNews(type) {
                        if (!selectedInsightsEditorId) return;

                        const statusMap = {
                            submitted: '',
                            published: 'active',
                            pending: 'pending',
                            rejected: 'rejected'
                        };

                        const params = new URLSearchParams();
                        params.set('authorId', selectedInsightsEditorId);
                        if (statusMap[type]) {
                            params.set('status', statusMap[type]);
                        }

                        window.location.href = `/news-list?${params.toString()}`;
                    }
                </script>
