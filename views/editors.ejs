                                                <div class="hint">Send push notifications to app users about breaking news</div>
                                            </div>
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editCanEditNews" class="form-check-input me-2">
                                                <label for="editCanEditNews"><strong>Can edit any news article</strong></label>
                                                <div class="hint">Edit any published or pending article (not just their own)</div>
                                            </div>
                                            <div class="editor-perm-card">
                                                <input type="checkbox" id="editRequiresSourceLink" class="form-check-input me-2">
