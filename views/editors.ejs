<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Editors List' }) %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <link rel="stylesheet" href="/css/editors-directory.css">
    <link rel="stylesheet" href="/css/team-register.css">
    <style>
        .feedback-message {
            position: fixed;
            top: 25px;
            right: 25px;
            padding: 16px 24px;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            z-index: 9999;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            transform: translateX(200%);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .feedback-message.show { transform: translateX(0); }
        .feedback-message.success { background-color: #10b981; }
        .feedback-message.error { background-color: #ef4444; }
        .cropper-view-box, .cropper-face { border-radius: 50%; }
    </style>

    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Editors Management' , backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'editors' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4">
                                <% 
                                    const allStaff = editors || [];
                                    const reporterList = allStaff.filter(e => e.role === 'editor');
                                    const subEditorList = allStaff.filter(e => e.role === 'subeditor');
                                    const activeCount = allStaff.filter(e => e.isActive !== false).length;
                                    const editorLangLabels = typeof newsLanguageLabels !== 'undefined' ? newsLanguageLabels : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' };
                                %>

                                <div class="team-page">
                                    <div class="team-page-header">
                                        <div>
                                            <h1 class="team-page-title">Team Directory</h1>
                                            <p class="team-page-subtitle">Manage reporters and sub-editors — search, filter, and track performance.</p>
                                        </div>
                                        <a href="/register-editor" class="team-btn-primary">
                                            <i class="fas fa-plus"></i> Add member
                                        </a>
                                    </div>

                                    <div class="team-stats">
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= allStaff.length %></div>
                                            <div class="team-stat-label">Total members</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= reporterList.length %></div>
                                            <div class="team-stat-label">Reporters</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= subEditorList.length %></div>
                                            <div class="team-stat-label">Sub-editors</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= activeCount %></div>
                                            <div class="team-stat-label">Active</div>
                                        </div>
                                    </div>

                                    <% if (allStaff.length > 0) { %>
                                    <div class="team-panel">
                                        <div class="team-panel-toolbar">
                                            <div class="team-search-wrap">
                                                <i class="fas fa-search"></i>
                                                <input type="text" id="staffSearchInput" class="team-search" placeholder="Search name, email, location...">
                                            </div>
                                            <select id="staffLanguageFilter" class="team-filter-select">
                                                <option value="">All languages</option>
                                                <% Object.keys(editorLangLabels).forEach(function(code) { %>
                                                    <option value="<%= code %>"><%= editorLangLabels[code] %></option>
                                                <% }); %>
                                                <option value="__unset__">Not set</option>
                                            </select>
                                            <div class="team-segments" role="tablist">
                                                <button type="button" class="team-segment active" data-staff-filter="all">All<span class="team-segment-count"><%= allStaff.length %></span></button>
                                                <button type="button" class="team-segment" data-staff-filter="editor">Reporters<span class="team-segment-count"><%= reporterList.length %></span></button>
                                                <button type="button" class="team-segment" data-staff-filter="subeditor">Sub-editors<span class="team-segment-count"><%= subEditorList.length %></span></button>
                                            </div>
                                        </div>

                                        <div class="team-table-wrap">
                                            <table class="team-table">
                                                <thead>
                                                    <tr>
                                                        <th>Member</th>
                                                        <th>Role</th>
                                                        <th>Location</th>
                                                        <th>Language</th>
                                                        <th>Today</th>
                                                        <th>7 Days</th>
                                                        <th>Published</th>
                                                        <th>Range</th>
                                                        <th>Status</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="teamDirectoryBody">
                                                    <% allStaff.forEach(function(editor) { %>
                                                        <%- include('partials/editor-directory-row', { editor: editor, newsLanguageLabels: editorLangLabels }) %>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="team-footer-note">
                                            Showing <strong id="teamVisibleCount"><%= allStaff.length %></strong> of <%= allStaff.length %> members · Click Range to pick custom dates
                                        </div>
                                    </div>

                                    <script id="editorsData" type="application/json"><%- JSON.stringify(allStaff) %></script>
                                    <% } else { %>
                                    <div class="team-panel">
                                        <div class="team-empty">
                                            <div class="team-empty-icon"><i class="fas fa-users"></i></div>
                                            <h5 class="fw-bold text-dark mb-2">No team members yet</h5>
                                            <p class="mb-4">Register your first reporter or sub-editor to get started.</p>
                                            <a href="/register-editor" class="team-btn-primary">Register first member</a>
                                        </div>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Crop Image Modal -->
            <div class="modal fade" id="cropImageModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-crop-alt me-2"></i>Adjust Profile Image</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center">
                            <div style="max-height: 400px; width: 100%; display: flex; justify-content: center;">
                                <img id="cropImageSource" style="max-width: 100%; display: block;">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary text-white" id="btnCropAndSave">
                                <i class="fas fa-check me-1"></i> Crop & Upload
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Editor Modal -->
            <div class="modal fade" id="editEditorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Edit Editor Details</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editEditorForm" class="reg-layout" style="display: block; padding: 0;">
                                <input type="hidden" id="editEditorId">
                                
                                <div class="col-md-12 mb-4 text-center">
                                    <div class="position-relative d-inline-block">
                                        <img id="editProfilePreview" src="" class="rounded-circle img-thumbnail shadow-sm" style="width: 100px; height: 100px; object-fit: cover; border-width: 3px; background-color: #f8fafc;">
                                        <label for="editProfileImageUpload" class="position-absolute bottom-0 end-0 btn btn-sm btn-primary rounded-circle shadow" style="cursor: pointer; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: 2px solid white;">
                                            <i class="fas fa-camera" style="font-size: 0.8rem;"></i>
                                        </label>
                                        <input type="file" id="editProfileImageUpload" class="d-none" accept="image/*">
                                        <input type="hidden" id="editProfileImageUrl">
                                    </div>
                                </div>

                                <section class="reg-form-section" style="margin-bottom: 20px;">
                                    <div class="reg-section-head" style="margin-bottom: 15px;">
                                        <span class="reg-section-icon reg-section-icon--account"><i class="fas fa-user-edit"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Basic Details</h2>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editName">Full Name</label>
                                                <input type="text" id="editName" placeholder="e.g. John Doe">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editRole">Role</label>
                                                <select id="editRole">
                                                    <option value="editor">Reporter</option>
                                                    <option value="subeditor">Sub-Editor</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editDisplayRole">Display Role</label>
                                                <input type="text" id="editDisplayRole" placeholder="e.g. Senior Reporter">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editAssignedLocations">Location</label>
                                                <select id="editAssignedLocations" multiple size="4">
                                                    <option value="" disabled>Select Locations (hold Cmd/Ctrl)</option>
                                                    <% locations.forEach(function(loc) { %>
                                                        <option value="<%= loc.name %>"><%= loc.name %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editWorkingLanguage">News Language</label>
                                                <select id="editWorkingLanguage">
                                                    <%- include('partials/language-select-options', { selectedValue: 'te' }) %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editConstituency">Constituency</label>
                                                <input type="text" id="editConstituency">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="editMobile">Mobile Number</label>
                                                <input type="text" id="editMobile">
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="reg-form-section" style="margin-bottom: 20px;">
                                    <div class="reg-section-head" style="margin-bottom: 15px;">
                                        <span class="reg-section-icon reg-section-icon--role"><i class="fas fa-mobile-alt"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">App Display Settings</h2>
                                            <p class="reg-section-desc">What shows up on the mobile app</p>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-4 mt-2">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="editShowProfileImage" checked>
                                            <label class="form-check-label" for="editShowProfileImage">Show Profile Image</label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="editShowName" checked>
                                            <label class="form-check-label" for="editShowName">Show Name</label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="editShowConstituency" checked>
                                            <label class="form-check-label" for="editShowConstituency">Show Constituency</label>
                                        </div>
                                    </div>
                                </section>

                                <section class="reg-form-section" id="adminSettingsSection" style="display:none; margin-bottom: 20px;">
                                    <div class="reg-section-head" style="margin-bottom: 15px;">
                                        <span class="reg-section-icon reg-section-icon--account"><i class="fas fa-shield-alt"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Admin Dashboard Settings</h2>
                                            <p class="reg-section-desc">Dashboard access and permissions</p>
                                        </div>
                                    </div>
                                    
                                    <div id="editCanViewReporterDetailsWrapper" style="display: none; margin-bottom: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="editCanViewReporterDetails" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="editCanViewReporterDetails" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can view reporter details</label>
                                        </div>
                                    </div>
                                    <div id="editCanAccessAdminDashboardWrapper" style="display: none; margin-bottom: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="editCanAccessAdminDashboard" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="editCanAccessAdminDashboard" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can access admin dashboard (Sub-editors)</label>
                                        </div>
                                    </div>
                                    <div id="editCanApproveNewsWrapper" style="display: none; margin-bottom: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="editCanApproveNews" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="editCanApproveNews" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can approve/reject news</label>
                                        </div>
                                    </div>
                                    
                                    <div id="editManagedLocationsWrapper" style="display: none; margin-top: 15px; margin-bottom: 15px; margin-left: 30px; padding-left: 15px; border-left: 2px solid #e2e8f0;">
                                        <div class="reg-field" style="margin-bottom: 10px;">
                                            <label style="font-size: 0.9rem;">Whose news can they approve?</label>
                                            <select id="editApprovalScope" style="font-size: 0.9rem; padding: 6px 12px; height: auto;">
                                                <option value="all">All Reporters</option>
                                                <option value="locations">Reporters in Specific Locations</option>
                                            </select>
                                        </div>
                                        <div class="reg-field" id="editManagedLocationsSelectWrapper" style="display: none;">
                                            <label style="font-size: 0.9rem;">Select Parent Locations</label>
                                            <% if (typeof locations !== 'undefined' && locations.length) { %>
                                            <select id="editManagedLocations" multiple size="4" style="font-size: 0.9rem;">
                                                <% locations.forEach(function(loc) { %>
                                                <option value="<%= loc.name %>"><%= loc.name %></option>
                                                <% }); %>
                                            </select>
                                            <div class="reg-field-hint">Hold Cmd/Ctrl to select multiple locations.</div>
                                            <% } else { %>
                                            <div class="alert alert-warning" style="font-size: 0.85rem; padding: 8px;">No locations found.</div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div id="editCanSendNotificationsWrapper" style="display: none; margin-bottom: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="editCanSendNotifications" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="editCanSendNotifications" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can send notifications</label>
                                        </div>
                                    </div>

                                    <div id="editSidebarAccessWrapper" style="display: none; margin-top: 25px;">
                                        <h5 style="margin-bottom: 15px; font-size: 1rem; border-bottom: 1px solid #eaeaea; padding-bottom: 5px;">Sidebar Menu Access</h5>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                            <% const sidebarMenus = [
                                                { id: 'dashboard', label: 'Dashboard' },
                                                { id: 'newsList', label: 'News List' },
                                                { id: 'addNews', label: 'Add News' },
                                                { id: 'pendingNews', label: 'Pending News' },
                                                { id: 'rejectedNews', label: 'Rejected News' },
                                                { id: 'plagiarismReport', label: 'Plagiarism Report' },
                                                { id: 'viralVideos', label: 'Viral Videos' },
                                                { id: 'polls', label: 'Polls' },
                                                { id: 'longVideos', label: 'Long Videos' },
                                                { id: 'categories', label: 'Categories' },
                                                { id: 'programCategories', label: 'Program Categories' },
                                                { id: 'locations', label: 'Locations' },
                                                { id: 'reports', label: 'Reports' }
                                            ]; %>
                                            <% sidebarMenus.forEach(menu => { %>
                                                <div class="reg-field" style="display: flex; align-items: center; gap: 10px; margin-bottom: 0;">
                                                    <input type="checkbox" id="editSidebar_<%= menu.id %>" class="sidebar-menu-cb" data-menu="<%= menu.id %>" checked style="width: auto; height: 16px; cursor: pointer;">
                                                    <label for="editSidebar_<%= menu.id %>" style="margin-bottom: 0; font-weight: normal; cursor: pointer;"><%= menu.label %></label>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </section>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="reg-btn reg-btn--primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feedback Message -->
            <div id="feedbackMessage" class="feedback-message"></div>

            <!-- Change Password Modal -->
            <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-key me-2"></i>Change Editor Password</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="changePasswordForm">
                                <input type="hidden" id="passwordEditorId">
                                <div class="mb-3">
                                    <label class="form-label">New Password</label>
                                    <input type="password" class="form-control" id="newPassword" minlength="6" required>
                                    <small class="text-muted">Minimum 6 characters</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm Password</label>
                                    <input type="password" class="form-control" id="confirmPassword" minlength="6" required>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-warning text-dark fw-bold">Update Password</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>



            <%- include('partials/footer') %>
                <script>
                    let editors = [];
                    let selectedInsightsEditorId = null;

                    document.addEventListener('DOMContentLoaded', function () {
                        const dataScript = document.getElementById('editorsData');
                        if (dataScript) {
                            try {
                                editors = JSON.parse(dataScript.textContent);
                            } catch (e) {
                                console.error('Error parsing editors data:', e);
                            }
                        }
                        initStaffFilters();
                    });

                    function initStaffFilters() {
                        const searchInput = document.getElementById('staffSearchInput');
                        const languageFilter = document.getElementById('staffLanguageFilter');
                        const segments = document.querySelectorAll('.team-segment');
                        const visibleCountEl = document.getElementById('teamVisibleCount');
                        let activeRole = 'all';

                        function applyStaffFilters() {
                            const query = (searchInput?.value || '').trim().toLowerCase();
                            const lang = languageFilter?.value || '';
                            let visible = 0;

                            document.querySelectorAll('.staff-row').forEach(row => {
                                const role = row.dataset.role;
                                const rowLang = row.dataset.language || '';
                                const haystack = row.dataset.search || '';

                                const roleMatch = activeRole === 'all' || role === activeRole;
                                const searchMatch = !query || haystack.includes(query);
                                const langMatch = !lang || (lang === '__unset__' ? !rowLang : rowLang === lang);
                                const show = roleMatch && searchMatch && langMatch;

                                row.style.display = show ? '' : 'none';
                                if (show) visible += 1;
                            });

                            if (visibleCountEl) visibleCountEl.textContent = visible;
                        }

                        segments.forEach(segment => {
                            segment.addEventListener('click', function () {
                                segments.forEach(item => item.classList.remove('active'));
                                segment.classList.add('active');
                                activeRole = segment.dataset.staffFilter || 'all';
                                applyStaffFilters();
                            });
                        });

                        if (searchInput) searchInput.addEventListener('input', applyStaffFilters);
                        if (languageFilter) languageFilter.addEventListener('change', applyStaffFilters);

                        applyStaffFilters();
                    }

                    function showEditorInsightsById(id) {
                        const editor = editors.find(e => e._id === id);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }
                        showEditorInsights(
                            id,
                            editor.name || editor.username,
                            JSON.stringify(editor.newsStats?.monthlyTrend || [])
                        );
                    }

                    // Open Edit Modal
                    function openEditEditorModal(editorId) {
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        document.getElementById('editEditorId').value = editor._id;
                        document.getElementById('editProfileImageUrl').value = editor.profileImage || '';
                        
                        // Set image preview or a default avatar/initials graphic
                        if (editor.profileImage) {
                            document.getElementById('editProfilePreview').src = editor.profileImage;
                            document.getElementById('editProfilePreview').style.display = 'inline-block';
                        } else {
                            // Empty string so styling like background-color shows, or could use a placeholder image
                            document.getElementById('editProfilePreview').src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%2394a3b8"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>';
                        }

                        document.getElementById('editName').value = editor.name || '';
                        document.getElementById('editRole').value = editor.role || 'editor';
                        document.getElementById('editDisplayRole').value = editor.displayRole || '';
                        // Handle multiple assignedLocations selection
                        const assignedLocations = editor.assignedLocations || (editor.location ? [editor.location] : []);
                        const selectEl = document.getElementById('editAssignedLocations');
                        Array.from(selectEl.options).forEach(opt => {
                            opt.selected = assignedLocations.includes(opt.value);
                        });

                        document.getElementById('editWorkingLanguage').value = editor.workingLanguage || 'te';
                        document.getElementById('editConstituency').value = editor.constituency || '';
                        document.getElementById('editMobile').value = editor.mobileNumber || '';

                        const displaySettings = editor.displaySettings || { showProfileImage: true, showName: true, showConstituency: true };
                        document.getElementById('editShowProfileImage').checked = displaySettings.showProfileImage !== false;
                        document.getElementById('editShowName').checked = displaySettings.showName !== false;
                        document.getElementById('editShowConstituency').checked = displaySettings.showConstituency !== false;

                        const permissions = editor.permissions || {};
                        document.getElementById('editCanViewReporterDetails').checked = permissions.canViewReporterDetails === true;
                        document.getElementById('editCanAccessAdminDashboard').checked = permissions.canAccessAdminDashboard === true;
                        document.getElementById('editCanApproveNews').checked = permissions.canApproveNews === true;
                        document.getElementById('editCanSendNotifications').checked = permissions.canSendNotifications === true;
                        
                        // Populate sidebar permissions
                        const sidebarPerms = permissions.sidebar || {};
                        document.querySelectorAll('.sidebar-menu-cb').forEach(cb => {
                            const menu = cb.getAttribute('data-menu');
                            // Default to true if not explicitly false (backward compatibility)
                            cb.checked = sidebarPerms[menu] !== false;
                        });

                        document.getElementById('editApprovalScope').value = permissions.approvalScope || 'all';
                        
                        const managedLocations = permissions.managedLocations || [];
                        const managedSelectEl = document.getElementById('editManagedLocations');
                        if (managedSelectEl) {
                            Array.from(managedSelectEl.options).forEach(opt => {
                                opt.selected = managedLocations.includes(opt.value);
                            });
                        }
                        
                        // Show/hide managed locations wrapper based on canApproveNews
                        const managedLocWrapper = document.getElementById('editManagedLocationsWrapper');
                        if (managedLocWrapper) {
                            managedLocWrapper.style.display = permissions.canApproveNews === true ? 'block' : 'none';
                        }
                        
                        // Show/hide location select based on approval scope
                        const managedLocSelectWrapper = document.getElementById('editManagedLocationsSelectWrapper');
                        if (managedLocSelectWrapper) {
                            managedLocSelectWrapper.style.display = permissions.approvalScope === 'locations' ? 'block' : 'none';
                        }
                        
                        
                        // Show/hide the dashboard access option and reporter details view based on role
                        if (editor.role === 'subeditor') {
                            document.getElementById('editCanAccessAdminDashboardWrapper').style.display = 'block';
                            document.getElementById('editCanViewReporterDetailsWrapper').style.display = 'block';
                            document.getElementById('editCanApproveNewsWrapper').style.display = 'block';
                            document.getElementById('editCanSendNotificationsWrapper').style.display = 'block';
                            document.getElementById('editSidebarAccessWrapper').style.display = 'block';
                            if (document.getElementById('editCanApproveNews').checked) {
                                document.getElementById('editManagedLocationsWrapper').style.display = 'block';
                            }
                        } else {
                            document.getElementById('editCanAccessAdminDashboardWrapper').style.display = 'none';
                            document.getElementById('editCanViewReporterDetailsWrapper').style.display = 'none';
                            document.getElementById('editCanApproveNewsWrapper').style.display = 'none';
                            document.getElementById('editCanSendNotificationsWrapper').style.display = 'none';
                            document.getElementById('editSidebarAccessWrapper').style.display = 'none';
                            document.getElementById('editManagedLocationsWrapper').style.display = 'none';
                        }

                        // Only show admin settings for subeditors/editors if accessed by superadmin
                        const currentAdminRole = '<%= admin.role %>';
                        if (currentAdminRole === 'superadmin' || currentAdminRole === 'admin') {
                            document.getElementById('adminSettingsSection').style.display = 'block';
                        } else {
                            document.getElementById('adminSettingsSection').style.display = 'none';
                        }

                        const modal = new bootstrap.Modal(document.getElementById('editEditorModal'));
                        modal.show();
                    }

                    // Toggle dashboard access options when role changes
                    document.getElementById('editRole').addEventListener('change', function (e) {
                        if (this.value === 'subeditor') {
                            document.getElementById('editCanAccessAdminDashboardWrapper').style.display = 'block';
                            document.getElementById('editCanViewReporterDetailsWrapper').style.display = 'block';
                            document.getElementById('editCanApproveNewsWrapper').style.display = 'block';
                            document.getElementById('editCanSendNotificationsWrapper').style.display = 'block';
                            document.getElementById('editSidebarAccessWrapper').style.display = 'block';
                            if (document.getElementById('editCanApproveNews').checked) {
                                document.getElementById('editManagedLocationsWrapper').style.display = 'block';
                            }
                        } else {
                            document.getElementById('editCanAccessAdminDashboardWrapper').style.display = 'none';
                            document.getElementById('editCanViewReporterDetailsWrapper').style.display = 'none';
                            document.getElementById('editCanApproveNewsWrapper').style.display = 'none';
                            document.getElementById('editCanSendNotificationsWrapper').style.display = 'none';
                            document.getElementById('editSidebarAccessWrapper').style.display = 'none';
                            document.getElementById('editManagedLocationsWrapper').style.display = 'none';
                            document.getElementById('editCanAccessAdminDashboard').checked = false;
                            document.getElementById('editCanViewReporterDetails').checked = false;
                            document.getElementById('editCanApproveNews').checked = false;
                            document.getElementById('editCanSendNotifications').checked = false;
                        }
                    });

                    // Handle canApproveNews toggle
                    document.getElementById('editCanApproveNews').addEventListener('change', function (e) {
                        document.getElementById('editManagedLocationsWrapper').style.display = this.checked ? 'block' : 'none';
                    });

                    // Handle approvalScope toggle
                    document.getElementById('editApprovalScope').addEventListener('change', function (e) {
                        document.getElementById('editManagedLocationsSelectWrapper').style.display = this.value === 'locations' ? 'block' : 'none';
                    });

                    // Handle Edit Form Submit
                    document.getElementById('editEditorForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        const id = document.getElementById('editEditorId').value;
                        const selectEl = document.getElementById('editAssignedLocations');
                        const assignedLocations = Array.from(selectEl.selectedOptions).map(opt => opt.value).filter(val => val !== "");

                        const sidebarData = {};
                        document.querySelectorAll('.sidebar-menu-cb').forEach(cb => {
                            sidebarData[cb.getAttribute('data-menu')] = cb.checked;
                        });

                        const managedLocSelectEl = document.getElementById('editManagedLocations');
                        const managedLocations = managedLocSelectEl ? Array.from(managedLocSelectEl.selectedOptions).map(opt => opt.value).filter(val => val !== "") : [];

                        const data = {
                            name: document.getElementById('editName').value,
                            role: document.getElementById('editRole').value,
                            displayRole: document.getElementById('editDisplayRole').value,
                            assignedLocations: assignedLocations,
                            workingLanguage: document.getElementById('editWorkingLanguage').value,
                            constituency: document.getElementById('editConstituency').value,
                            mobileNumber: document.getElementById('editMobile').value,
                            profileImage: document.getElementById('editProfileImageUrl').value,
                            displaySettings: {
                                showProfileImage: document.getElementById('editShowProfileImage').checked,
                                showName: document.getElementById('editShowName').checked,
                                showConstituency: document.getElementById('editShowConstituency').checked
                            },
                            canViewReporterDetails: document.getElementById('editCanViewReporterDetails').checked,
                            canAccessAdminDashboard: document.getElementById('editCanAccessAdminDashboard').checked,
                            canApproveNews: document.getElementById('editCanApproveNews').checked,
                            canSendNotifications: document.getElementById('editCanSendNotifications').checked,
                            approvalScope: document.getElementById('editApprovalScope').value,
                            managedLocations: managedLocations,
                            sidebar: sidebarData
                        };

                        fetch(`/admin/editors/${id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('editEditorModal')).hide();
                                    setTimeout(() => location.reload(), 1000);
                                }
                            })
                            .catch(err => showFeedback('Update failed', 'error'));
                    });

                    // Initialize Cropper Variables
                    let cropper;
                    const cropImageModalElement = document.getElementById('cropImageModal');
                    const cropImageModal = new bootstrap.Modal(cropImageModalElement);
                    const cropImageSource = document.getElementById('cropImageSource');

                    // Handle Profile Image Selection for Cropping
                    document.getElementById('editProfileImageUpload').addEventListener('change', function(e) {
                        const file = e.target.files[0];
                        if (!file) return;

                        const reader = new FileReader();
                        reader.onload = function(event) {
                            cropImageSource.src = event.target.result;
                            cropImageModal.show();
                            
                            // Clear input so same file can be selected again
                            e.target.value = '';
                        };
                        reader.readAsDataURL(file);
                    });

                    cropImageModalElement.addEventListener('shown.bs.modal', function () {
                        if (cropper) {
                            cropper.destroy();
                        }
                        cropper = new Cropper(cropImageSource, {
                            aspectRatio: 1,
                            viewMode: 1,
                            dragMode: 'move',
                            autoCropArea: 1,
                            restore: false,
                            guides: false,
                            center: false,
                            highlight: false,
                            cropBoxMovable: false,
                            cropBoxResizable: false,
                            toggleDragModeOnDblclick: false,
                        });
                    });

                    cropImageModalElement.addEventListener('hidden.bs.modal', function () {
                        if (cropper) {
                            cropper.destroy();
                            cropper = null;
                        }
                    });

                    // Handle Crop and Upload
                    document.getElementById('btnCropAndSave').addEventListener('click', async function() {
                        if (!cropper) return;
                        
                        // Show loading state
                        const btn = this;
                        const originalText = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Uploading...';
                        btn.disabled = true;

                        const croppedCanvas = cropper.getCroppedCanvas({
                            width: 400,
                            height: 400
                        });
                        
                        // Create a new canvas to draw the circle
                        const roundedCanvas = document.createElement('canvas');
                        const context = roundedCanvas.getContext('2d');
                        roundedCanvas.width = 400;
                        roundedCanvas.height = 400;

                        // Draw a circular path
                        context.beginPath();
                        context.arc(200, 200, 200, 0, Math.PI * 2, true);
                        context.closePath();
                        context.clip();

                        // Draw the cropped image into the circle
                        context.drawImage(croppedCanvas, 0, 0);

                        // Export as PNG for transparency
                        roundedCanvas.toBlob(async function(blob) {
                            const formData = new FormData();
                            // Append the blob as a PNG file
                            formData.append('media', blob, 'profile.png');
                            
                            try {
                                const response = await fetch('/news/upload-media', {
                                    method: 'POST',
                                    body: formData
                                });
                                
                                if (response.ok) {
                                    const data = await response.json();
                                    if (data.mediaUrl) {
                                        document.getElementById('editProfileImageUrl').value = data.mediaUrl;
                                        document.getElementById('editProfilePreview').src = data.mediaUrl;
                                        showFeedback('Image uploaded successfully', 'success');
                                        cropImageModal.hide();
                                    } else {
                                        showFeedback('Image upload returned no URL', 'error');
                                    }
                                } else {
                                    showFeedback('Failed to upload image', 'error');
                                }
                            } catch (err) {
                                console.error('Image upload error:', err);
                                showFeedback('Image upload failed', 'error');
                            } finally {
                                btn.innerHTML = originalText;
                                btn.disabled = false;
                            }
                        }, 'image/png');
                    });

                    // Delete Editor
                    function deleteEditor(id) {
                        if (confirm('Are you sure you want to delete this editor?')) {
                            fetch(`/admin/editors/${id}`, { method: 'DELETE' })
                                .then(res => res.json())
                                .then(result => {
                                    if (result.error) {
                                        showFeedback(result.error, 'error');
                                    } else {
                                        showFeedback('Editor deleted', 'success');
                                        document.getElementById(`editor-row-${id}`).remove();
                                    }
                                })
                                .catch(err => showFeedback('Delete failed', 'error'));
                        }
                    }

                    // Toggle editor active status
                    function toggleEditorStatus(id, currentStatus) {
                        const nextStatus = !currentStatus;
                        const actionText = nextStatus ? 'activate' : 'deactivate';

                        if (!confirm(`Are you sure you want to ${actionText} this user?`)) return;

                        fetch(`/admin/editors/${id}/status`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ isActive: nextStatus })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    setTimeout(() => location.reload(), 800);
                                }
                            })
                            .catch(() => showFeedback('Failed to update user status', 'error'));
                    }

                    // Open password modal
                    function openPasswordModal(editorId) {
                        document.getElementById('passwordEditorId').value = editorId;
                        document.getElementById('newPassword').value = '';
                        document.getElementById('confirmPassword').value = '';
                        const modal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
                        modal.show();
                    }

                    // Handle password change form
                    document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
                        e.preventDefault();

                        const editorId = document.getElementById('passwordEditorId').value;
                        const newPassword = document.getElementById('newPassword').value;
                        const confirmPassword = document.getElementById('confirmPassword').value;

                        if (newPassword.length < 6) {
                            showFeedback('Password must be at least 6 characters', 'error');
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            showFeedback('Passwords do not match', 'error');
                            return;
                        }

                        fetch(`/admin/editors/${editorId}/password`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ newPassword })
                        })
                            .then(res => res.json())
                            .then(result => {
                                if (result.error) {
                                    showFeedback(result.error, 'error');
                                } else {
                                    showFeedback(result.message, 'success');
                                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                                }
                            })
                            .catch(() => showFeedback('Failed to update password', 'error'));
                    });

                    function showFeedback(message, type) {
                        const feedback = document.getElementById('feedbackMessage');
                        feedback.textContent = message;
                        feedback.className = 'feedback-message ' + type + ' show';
                        setTimeout(() => feedback.classList.remove('show'), 3000);
                    }

                    function openInsightsModal(editorId) {
                        const editor = editors.find(e => e._id === editorId);
                        if (!editor) {
                            showFeedback('Editor data not found', 'error');
                            return;
                        }

                        selectedInsightsEditorId = editorId;
                        document.getElementById('insightsEditorName').textContent = editor.name || editor.username;
                        document.getElementById('insightsEditorRole').textContent = editor.displayRole || (editor.role === 'subeditor' ? 'Sub-Editor' : 'Reporter');

                        document.getElementById('insightsSubmitted').textContent = editor.newsStats?.submitted || 0;
                        document.getElementById('insightsPublished').textContent = editor.newsStats?.published || 0;
                        document.getElementById('insightsPending').textContent = editor.newsStats?.pending || 0;
                        document.getElementById('insightsRejected').textContent = editor.newsStats?.rejected || 0;

                        if (editor.latestRejection) {
                            document.getElementById('insightsRejectionReason').textContent = editor.latestRejection.reason || 'Not specified';
                            document.getElementById('insightsRejectionDate').textContent = editor.latestRejection.rejectedAt
                                ? new Date(editor.latestRejection.rejectedAt).toLocaleString()
                                : '';
                        } else {
                            document.getElementById('insightsRejectionReason').textContent = 'No rejection history';
                            document.getElementById('insightsRejectionDate').textContent = '';
                        }

                        const modal = new bootstrap.Modal(document.getElementById('insightsModal'));
                        modal.show();
                    }

                    function openEditorNews(type) {
                        if (!selectedInsightsEditorId) return;

                        const statusMap = {
                            submitted: '',
                            published: 'active',
                            pending: 'pending',
                            rejected: 'rejected'
                        };

                        const params = new URLSearchParams();
                        params.set('authorId', selectedInsightsEditorId);
                        if (statusMap[type]) {
                            params.set('status', statusMap[type]);
                        }

                        window.location.href = `/news-list?${params.toString()}`;
                    }
                </script>
    <!-- Performance Insights Modal -->
    <div class="modal fade" id="insightsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header bg-dark text-white p-4" style="border-radius: 24px 24px 0 0;">
                    <div>
                        <h5 class="modal-title fw-bold" id="insightsTitle">Editor Performance Insights</h5>
                        <p class="mb-0 text-white-50 small" id="insightsSubtitle"></p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <h6 class="text-muted small fw-bold text-uppercase">Monthly View Trend (Last 6 Months)</h6>
                                <div id="monthlyTrendChart" class="mt-3" style="height: 200px; display: flex; align-items: flex-end; gap: 10px;">
                                    <!-- Dynamic bars will be inserted here -->
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="p-3 bg-primary bg-opacity-10 rounded-4 text-center">
                                        <div class="text-primary small fw-bold">Avg Views/Post</div>
                                        <div class="fs-4 fw-bold" id="avgViewsStat">0</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-success bg-opacity-10 rounded-4 text-center">
                                        <div class="text-success small fw-bold">Published Ratio</div>
                                        <div class="fs-4 fw-bold" id="publishRatioStat">0%</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 bg-warning bg-opacity-10 rounded-4">
                                        <div class="text-warning small fw-bold">Performance Tip</div>
                                        <p class="mb-0 small" id="performanceTip">Consistency is key to growth.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // Initialize range pickers
        document.addEventListener('DOMContentLoaded', function() {
            flatpickr(".range-picker-input", {
                mode: "range",
                dateFormat: "Y-m-d",
                onClose: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        const authorId = instance.element.dataset.id;
                        const startDate = instance.formatDate(selectedDates[0], "Y-m-d");
                        const endDate = instance.formatDate(selectedDates[1], "Y-m-d");
                        
                        // Show loading state
                        const displaySpan = document.getElementById(`count-${authorId}`);
                        displaySpan.innerText = '...';
                        
                        fetch(`/admin/api/editor-range-stats?authorId=${authorId}&startDate=${startDate}&endDate=${endDate}`)
                            .then(response => response.json())
                            .then(data => {
                                displaySpan.innerText = data.count || 0;
                                document.getElementById(`range-pill-${authorId}`).title = `Posts between ${startDate} and ${endDate}`;
                            })
                            .catch(err => {
                                console.error('Error fetching stats:', err);
                                displaySpan.innerText = 'Error';
                            });
                    }
                }
            });
        });

        function showEditorInsights(id, name, trendJson) {
            const trend = JSON.parse(trendJson);
            const modal = new bootstrap.Modal(document.getElementById('insightsModal'));
            document.getElementById('insightsTitle').innerText = `${name}'s Performance`;
            document.getElementById('insightsSubtitle').innerText = `Data driven insights and growth metrics`;
            
            const chartArea = document.getElementById('monthlyTrendChart');
            chartArea.innerHTML = '';
            
            if (trend.length === 0) {
                chartArea.innerHTML = '<div class="w-100 text-center text-muted">No trend data available</div>';
            } else {
                const maxViews = Math.max(...trend.map(t => t.views)) || 1;
                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                
                trend.forEach(t => {
                    const height = (t.views / maxViews) * 100;
                    const bar = document.createElement('div');
                    bar.className = 'flex-grow-1 position-relative';
                    bar.style.height = `${height}%`;
                    bar.style.background = 'linear-gradient(to top, #4f46e5, #818cf8)';
                    bar.style.borderRadius = '6px 6px 0 0';
                    bar.title = `${months[t.month-1]} ${t.year}: ${t.views} views`;
                    
                    const label = document.createElement('div');
                    label.innerText = months[t.month-1];
                    label.style.fontSize = '10px';
                    label.style.position = 'absolute';
                    label.style.bottom = '-20px';
                    label.style.left = '50%';
                    label.style.transform = 'translateX(-50%)';
                    bar.appendChild(label);
                    
                    chartArea.appendChild(bar);
                });
            }
            
            modal.show();
        }
    </script>
    </body>
</html>