<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: (typeof news !=='undefined' ? 'Edit News' : 'Add News' ) + ' - Short News Admin'
    }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
    <link rel="stylesheet" href="/css/add-news.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    <link rel="stylesheet" href="/css/duplicate-review-modals.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
    </head>

    <body class="theme-v2">
        <%- include('partials/top-nav', { pageTitle: typeof news !=='undefined' ? 'Edit News' : 'Add News' , backButton:
            true, backUrl: '/' , actions: [ { id: 'saveNewsButtonDesktop' , icon: 'fas fa-save' , text: (typeof news
            !=='undefined' ? 'Update News' : 'Save News' ), class: 'btn-primary' } ] }) %>

            <div class="container-fluid">
                <div class="row">
                    <!-- Sidebar -->
                    <%- include('partials/sidebar', { activePage: 'add-news' }) %>

                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                            <div class="content-area mt-4 an-page">
                                <div class="an-page-header">
                                    <div>
                                        <h1 class="an-page-title"><%= typeof news !== 'undefined' ? 'Edit Article' : 'Create Article' %></h1>
                                        <p class="an-page-subtitle">Select text and apply color or bold — formatting shows directly in the field.</p>
                                    </div>
                                </div>

                                <form id="addNewsForm">
                                    <input type="hidden" id="newsId" value="<%= typeof news !== 'undefined' ? news._id : '' %>">
                                    <textarea id="title" class="d-none" aria-hidden="true"><%= typeof news !== 'undefined' ? news.title : '' %></textarea>
                                    <textarea id="content" class="d-none" aria-hidden="true"><%= typeof news !== 'undefined' ? news.content : '' %></textarea>

                                    <div class="an-compose-grid">
                                        <!-- LEFT: Title + Content -->
                                        <div class="an-col-write">
                                            <div class="an-panel">
                                                <div class="an-panel-head"><i class="fas fa-pen me-2"></i>Write article</div>
                                                <div class="an-panel-body">
                                                    <div class="an-field">
                                                        <label class="an-label">Title</label>
                                                        <div class="an-editor-wrap">
                                                            <div class="an-toolbar">
                                                                <span class="an-toolbar-label">Color</span>
                                                                <button type="button" class="an-color-dot" style="background:#F44336" onclick="applyTextColor('title', '#F44336')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#2196F3" onclick="applyTextColor('title', '#2196F3')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#4CAF50" onclick="applyTextColor('title', '#4CAF50')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#FF9800" onclick="applyTextColor('title', '#FF9800')"></button>
                                                                <input type="color" class="an-color-picker" onchange="applyTextColor('title', this.value)">
                                                                <span class="an-toolbar-divider"></span>
                                                                <button type="button" class="an-tool-btn" onclick="applyBoldText('title')"><i class="fas fa-bold"></i></button>
                                                                <button type="button" class="an-tool-btn" onclick="removeStyling('title')"><i class="fas fa-eraser"></i></button>
                                                            </div>
                                                            <div id="titleEditor" class="an-rich-editor an-rich-editor-title" contenteditable="true" data-placeholder="Enter news title"></div>
                                                            <div class="an-char-count" id="titleCountWrap"><span id="titleCount">0</span>/<%= newsTitleMax %></div>
                                                        </div>
                                                    </div>

                                                    <div class="an-field">
                                                        <label class="an-label">Content</label>
                                                        <div class="an-editor-wrap">
                                                            <div class="an-toolbar">
                                                                <span class="an-toolbar-label">Color</span>
                                                                <button type="button" class="an-color-dot" style="background:#F44336" onclick="applyTextColor('content', '#F44336')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#2196F3" onclick="applyTextColor('content', '#2196F3')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#4CAF50" onclick="applyTextColor('content', '#4CAF50')"></button>
                                                                <button type="button" class="an-color-dot" style="background:#FF9800" onclick="applyTextColor('content', '#FF9800')"></button>
                                                                <input type="color" class="an-color-picker" onchange="applyTextColor('content', this.value)">
                                                                <span class="an-toolbar-divider"></span>
                                                                <button type="button" class="an-tool-btn" onclick="applyBoldText('content')"><i class="fas fa-bold"></i></button>
                                                                <button type="button" class="an-tool-btn" onclick="insertLink('content')" title="Insert Link"><i class="fas fa-link"></i></button>
                                                                <button type="button" class="an-tool-btn" onclick="removeStyling('content')"><i class="fas fa-eraser"></i></button>
                                                            </div>
                                                            <div id="contentEditor" class="an-rich-editor an-rich-editor-content" contenteditable="true" data-placeholder="Enter news content"></div>
                                                            <div class="an-char-count" id="contentCountWrap"><span id="contentCount">0</span>/<%= newsContentMax %></div>
                                                        </div>
                                                    </div>

                                                    <div class="an-meta-row">
                                                        <div class="an-field">
                                                            <label for="language" class="an-label">Language</label>
                                                            <select class="an-select" id="language" required>
                                                                <% const selectedNewsLang = typeof news !== 'undefined' ? (news.language || defaultLanguage || 'te') : (typeof defaultLanguage !== 'undefined' ? defaultLanguage : 'te'); %>
                                                                <%- include('partials/language-select-options', { selectedValue: selectedNewsLang }) %>
                                                            </select>
                                                        </div>
                                                        <div class="an-field">
                                                            <label for="category" class="an-label">Category</label>
                                                            <select class="an-select" id="category" required>
                                                                <option value="">Select Category</option>
                                                            </select>
                                                        </div>
                                                        <div class="an-field">
                                                            <label for="newsScope" class="an-label">Scope</label>
                                                            <select class="an-select" id="newsScope">
                                                                <option value="state">State</option>
                                                                <option value="district">District</option>
                                                                <option value="national">National</option>
                                                                <option value="international">International</option>
                                                            </select>
                                                        </div>
                                                        <div class="an-field" id="locationStateWrapper">
                                                            <label for="locationState" class="an-label">State</label>
                                                            <select class="an-select" id="locationState">
                                                                <option value="">Select State</option>
                                                            </select>
                                                        </div>
                                                        <div class="an-field" id="locationDistrictWrapper">
                                                            <label for="locationDistrict" class="an-label">District</label>
                                                            <select class="an-select" id="locationDistrict">
                                                                <option value="">Select District</option>
                                                            </select>
                                                        </div>
                                                        <div class="an-field" id="locationConstituencyWrapper">
                                                            <label for="locationConstituency" class="an-label">Constituency <span class="an-label-hint">optional</span></label>
                                                            <select class="an-select" id="locationConstituency">
                                                                <option value="">Select Constituency (Optional)</option>
                                                            </select>
                                                        </div>
                                                        <div class="an-field" style="display:none;">
                                                            <label for="location" class="an-label">Location <span class="an-label-hint">auto</span></label>
                                                            <select class="an-select" id="location">
                                                                <option value="">Select Location (Optional)</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="an-form-actions">
                                                <button type="button" class="an-btn-secondary" onclick="window.location.href='/'"><i class="fas fa-times"></i> Cancel</button>
                                                <button type="button" class="an-btn-primary" id="saveNewsButton"><i class="fas fa-save"></i> <%= typeof news !== 'undefined' ? 'Update' : 'Publish' %></button>
                                            </div>
                                            <div class="d-grid d-md-none mt-3">
                                                <button type="button" class="an-btn-primary" id="saveNewsButtonMobile"><i class="fas fa-save"></i> <%= typeof news !== 'undefined' ? 'Update' : 'Publish' %></button>
                                            </div>
                                        </div>

                                        <!-- RIGHT: Media + publishing -->
                                        <div class="an-col-meta">
                                            <div class="an-panel an-panel-compact">
                                                <div class="an-panel-head"><i class="fas fa-image me-2"></i>Media</div>
                                                <div class="an-panel-body">
                                                    <div class="an-media-compact">
                                                        <div class="an-media-preview-sm position-relative" id="mediaPreviewContainer">
                                                            <img id="imagePreview"
                                                                src="<%= typeof news !== 'undefined' ? (news.mediaUrl || news.imageUrl) : '/images/placeholder.png' %>"
                                                                onerror="this.src='data:image/svg+xml;base64,'"
                                                                alt="Preview">
                                                            <button type="button" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 m-2 p-1" style="font-size:12px; z-index:10; display: <%= typeof news !== 'undefined' && (news.mediaUrl || news.imageUrl) ? 'block' : 'none' %>;" id="mainModerateBtn" onclick="openModeratorForMainImage()"><i class="fas fa-magic"></i> Edit</button>
                                                            <video id="videoPreview" src="" controls style="display:none;width:100%;height:100%;object-fit:contain;"></video>
                                                        </div>
                                                        <button type="button" class="an-upload-btn-sm" id="uploadMediaButton"><i class="fas fa-upload"></i> Upload image / video</button>
                                                        <input type="file" id="mediaUpload" accept="image/*,video/*" class="d-none" multiple>
                                                        <input type="hidden" id="mediaUrl" value="<%= typeof news !== 'undefined' ? (news.mediaUrl || news.imageUrl) : '' %>">
                                                        <input type="hidden" id="mediaType" value="<%= typeof news !== 'undefined' ? (news.mediaType || 'image') : '' %>">
                                                        <input type="hidden" id="thumbnailUrl" value="<%= typeof news !== 'undefined' ? (news.thumbnailUrl || news.mediaUrl || news.imageUrl) : '' %>">
                                                        <input type="hidden" id="imageUrls" value='<%= typeof news !== "undefined" && news.imageUrls ? JSON.stringify(news.imageUrls) : "[]" %>'>
                                                        <div id="multipleImagesContainer" class="an-thumb-row"></div>
                                                        <div id="thumbnailSelection" style="display:none;">
                                                            <label class="an-label" style="margin-top:10px;">Thumbnail</label>
                                                            <div class="thumbnail-grid" id="thumbnailGrid"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="an-panel">
                                                <div class="an-panel-head"><i class="fas fa-link me-2"></i>Links</div>
                                                <div class="an-panel-body">
                                                    <% if ((admin.role === 'subeditor' && admin.permissions && admin.permissions.requiresSourceLink) || admin.role === 'superadmin' || admin.role === 'admin') { %>
                                                    <div class="an-field">
                                                        <label for="sourceLink" class="an-label">Source (Link or Text)
                                                            <% if (admin.role === 'subeditor') { %>
                                                                <span class="an-label-hint" style="color: #dc3545;">* mandatory</span>
                                                            <% } else { %>
                                                                <span class="an-label-hint">optional</span>
                                                            <% } %>
                                                        </label>
                                                        <input type="text" class="an-input" id="sourceLink" placeholder="e.g. TV9 link, WhatsApp, Telegram..." <%= admin.role === 'subeditor' ? 'required' : '' %>
                                                            value="<%= typeof news !== 'undefined' ? (news.sourceLink || '') : '' %>">
                                                    </div>
                                                    <% } %>
                                                    <div class="an-field">
                                                        <label for="readFullLink" class="an-label">Read full link <span class="an-label-hint">optional</span></label>
                                                        <input type="url" class="an-input" id="readFullLink" placeholder="https://..."
                                                            value="<%= typeof news !== 'undefined' ? (news.readFullLink || '') : '' %>">
                                                    </div>
                                                    <div class="an-field">
                                                        <label for="ePaperLink" class="an-label">ePaper link <span class="an-label-hint">optional</span></label>
                                                        <input type="url" class="an-input" id="ePaperLink" placeholder="https://..."
                                                            value="<%= typeof news !== 'undefined' ? (news.ePaperLink || '') : '' %>">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Image Cropping Modal -->
            <div class="modal fade" id="imageCropModal" tabindex="-1" aria-labelledby="imageCropModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="imageCropModalLabel">Crop Image to 1080x900</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="img-container">
                                <img id="imageToCrop" src="" alt="Image to crop">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="cropButton">Crop & Save</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Language Warning Modal -->
            <div class="modal fade" id="languageWarningModal" tabindex="-1" aria-labelledby="languageWarningModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius: 20px; border: 2px solid #ffc107; box-shadow: 0 10px 30px rgba(255, 193, 7, 0.2);">
                        <div class="modal-body text-center p-4">
                            <div class="mb-3">
                                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#ffc107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            </div>
                            <h4 class="mb-3" style="font-weight: 700; color: #333;">Language Mismatch</h4>
                            <p id="languageWarningText" class="text-muted mb-4">You selected English but content is in Telugu.</p>
                            <div class="d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-light px-4 py-2 rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-white" onclick="saveNews(true)">Proceed Anyway</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Duplicate review modals are created by /js/duplicate-review-modals.js -->

            <%- include('partials/footer') %>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
                <script src="/js/rich-text.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>"></script>
                <script src="/js/duplicate-review-modals.js?v=1"></script>
                <script>
                    const pageSource = '<%= typeof source !== "undefined" ? source : "" %>';
                    const DISPLAY_CONFIG_BY_LANGUAGE = <%- JSON.stringify(typeof displayConfigByLanguage !== 'undefined' ? displayConfigByLanguage : {}) %>;
                    let TITLE_MAX = <%= newsTitleMax %>;
                    let CONTENT_MAX = <%= newsContentMax %>;
                    let CONTENT_MIN = 0;
                    const CURRENT_USER_ROLE = '<%= admin.role %>';

                    // Create-only duplicate gate for roles that publish/create news
                    const DUPLICATE_GATE_ROLES = ['superadmin', 'admin'];
                    function roleNeedsDuplicateGate() {
                        return DUPLICATE_GATE_ROLES.includes(CURRENT_USER_ROLE);
                    }
                    let duplicateGatePassed = false;

                    function getSaveButtonIds() {
                        return ['saveNewsButton', 'saveNewsButtonMobile', 'saveNewsButtonDesktop', 'saveNewsBtn'];
                    }

                    function setSaveButtonsEnabled(enabled) {
                        getSaveButtonIds().forEach(id => {
                            const btn = document.getElementById(id);
                            if (btn) {
                                btn.disabled = !enabled;
                                btn.style.pointerEvents = enabled ? 'auto' : 'none';
                            }
                        });
                    }

                    function escapeHtmlDup(text) {
                        return String(text || '')
                            .replace(/&/g, '&amp;')
                            .replace(/</g, '&lt;')
                            .replace(/>/g, '&gt;')
                            .replace(/"/g, '&quot;')
                            .replace(/'/g, '&#39;');
                    }

                    function getOverallSimilarity(match) {
                        if (!match) return 0;
                        if (typeof match.similarity === 'number') return match.similarity;
                        if (match.similarity && typeof match.similarity.overall === 'number') {
                            return match.similarity.overall;
                        }
                        return 0;
                    }

                    function resetDuplicateGate() {
                        duplicateGatePassed = false;
                    }

                    function getDuplicateDraftSnapshot() {
                        const titleEl = document.getElementById('title');
                        const contentEl = document.getElementById('content');
                        const languageEl = document.getElementById('language');
                        const categoryEl = document.getElementById('category');
                        const locationEl = document.getElementById('location');
                        const mediaUrlEl = document.getElementById('mediaUrl');
                        const mediaTypeEl = document.getElementById('mediaType');
                        const thumbnailUrlEl = document.getElementById('thumbnailUrl');
                        const videoUrlEl = document.getElementById('videoUrl');
                        let imageUrls = [];
                        try {
                            const raw = document.getElementById('imageUrls');
                            if (raw && raw.value) imageUrls = JSON.parse(raw.value);
                        } catch (_) {}
                        return {
                            title: titleEl ? titleEl.value : '',
                            content: contentEl ? contentEl.value : '',
                            language: languageEl ? languageEl.value : '',
                            category: categoryEl ? categoryEl.value : '',
                            location: locationEl ? locationEl.value : '',
                            author: '<%= (admin && (admin.username || admin.name)) || "You" %>',
                            reporter: '<%= (admin && (admin.username || admin.name)) || "You" %>',
                            mediaUrl: mediaUrlEl ? mediaUrlEl.value : '',
                            mediaType: mediaTypeEl ? mediaTypeEl.value : 'image',
                            thumbnailUrl: thumbnailUrlEl ? thumbnailUrlEl.value : '',
                            videoUrl: videoUrlEl ? videoUrlEl.value : '',
                            imageUrls: Array.isArray(imageUrls) ? imageUrls : [],
                        };
                    }

                    function showDuplicatePublishWarning(checkData) {
                        if (!window.DuplicateReviewUI) {
                            alert('Duplicate warning UI failed to load. Please refresh and try again.');
                            setSaveButtonsEnabled(true);
                            return;
                        }
                        window.DuplicateReviewUI.showWarning(checkData, {
                            getDraftSnapshot: getDuplicateDraftSnapshot,
                            onIgnoreWarning: confirmDuplicatePublishAnyway,
                            onContinueEditing: cancelDuplicatePublish,
                            onCancelSubmission: cancelDuplicatePublish,
                        });
                    }

                    function closeDuplicatePublishWarning() {
                        if (window.DuplicateReviewUI) window.DuplicateReviewUI.closeAll();
                    }

                    function getDisplayConfigForLanguage(code) {
                        const normalized = String(code || 'te').trim().toLowerCase();
                        const cfg = DISPLAY_CONFIG_BY_LANGUAGE[normalized];
                        if (cfg) return cfg;
                        return DISPLAY_CONFIG_BY_LANGUAGE.te || { titleMax: TITLE_MAX, contentMax: CONTENT_MAX };
                    }

                    function applyDisplayLimitsForLanguage(code) {
                        const cfg = getDisplayConfigForLanguage(code);
                        TITLE_MAX = cfg.titleMax;
                        CONTENT_MAX = cfg.contentMax;
                        CONTENT_MIN = cfg.contentMin || 0;
                        const titleWrap = document.getElementById('titleCountWrap');
                        const contentWrap = document.getElementById('contentCountWrap');
                        if (titleWrap) {
                            titleWrap.innerHTML = `<span id="titleCount">0</span>/${TITLE_MAX}`;
                        }
                        if (contentWrap) {
                            contentWrap.innerHTML = `<span id="contentCount">0</span>/${CONTENT_MAX}`;
                        }
                    }

                    async function normalizeImageForCrop(file) {
                        if (!file || !file.type) return file;

                        const isHeic = file.type === 'image/heic' || file.type === 'image/heif';
                        if (!isHeic) return file;

                        const bitmap = await createImageBitmap(file);
                        const canvas = document.createElement('canvas');
                        canvas.width = bitmap.width;
                        canvas.height = bitmap.height;
                        const ctx = canvas.getContext('2d');
                        if (!ctx) {
                            throw new Error('Unable to process image for cropping');
                        }
                        ctx.drawImage(bitmap, 0, 0);

                        const jpegBlob = await new Promise((resolve) =>
                            canvas.toBlob(resolve, 'image/jpeg', 0.92)
                        );

                        if (!jpegBlob) {
                            throw new Error('Failed to convert HEIC image');
                        }

                        return new File([jpegBlob], file.name.replace(/\.(heic|heif)$/i, '.jpg'), {
                            type: 'image/jpeg'
                        });
                    }

                    // Add News Function
                    async function saveNews(ignoreLanguageWarning = false) {
                        syncAllEditors();

                        const isIgnoreWarning = typeof ignoreLanguageWarning === 'boolean' ? ignoreLanguageWarning : false;

                        const newsId = document.getElementById('newsId').value;
                        const title = document.getElementById('title').value.trim();
                        const content = document.getElementById('content').value.trim();
                        const mediaUrl = document.getElementById('mediaUrl').value;
                        const mediaType = document.getElementById('mediaType').value;
                        const thumbnailUrl = document.getElementById('thumbnailUrl').value;
                        const category = document.getElementById('category').value;
                        const location = document.getElementById('location').value;
                        const language = document.getElementById('language').value;

                        // Validation
                        if (!title || !content || !mediaUrl || !category) {
                            showFeedback('Please fill in all required fields', 'error');
                            return;
                        }

                        if (stripTags(title).length > TITLE_MAX) {
                            showFeedback(`Title cannot exceed ${TITLE_MAX} characters`, 'error');
                            return;
                        }

                        if (stripTags(content).length > CONTENT_MAX) {
                            showFeedback(`Content cannot exceed ${CONTENT_MAX} characters`, 'error');
                            return;
                        }

                        if (CURRENT_USER_ROLE === 'subeditor' && stripTags(content).length < CONTENT_MIN) {
                            showFeedback(`Content must be at least ${CONTENT_MIN} characters for Sub Editors`, 'error');
                            return;
                        }

                        const newsData = {
                            title,
                            content,
                            mediaUrl,
                            mediaType,
                            thumbnailUrl,
                            category,
                            language,
                            ignoreLanguageWarning: isIgnoreWarning
                        };

                        try {
                            const parsedArray = JSON.parse(document.getElementById('imageUrls').value);
                            if (parsedArray && parsedArray.length > 0) {
                                newsData.imageUrls = parsedArray;
                            } else if (mediaUrl && mediaType === 'image') {
                                newsData.imageUrls = [mediaUrl];
                            } else {
                                newsData.imageUrls = [];
                            }
                        } catch (e) {
                            newsData.imageUrls = mediaUrl && mediaType === 'image' ? [mediaUrl] : [];
                        }

                        const newsScope = document.getElementById('newsScope').value || 'state';
                        newsData.scope = newsScope;

                        if (newsScope === 'district') {
                            const constituencyVal = document.getElementById('locationConstituency').value;
                            const districtVal = document.getElementById('locationDistrict').value;
                            if (constituencyVal) newsData.location = constituencyVal;
                            else if (districtVal) newsData.location = districtVal;
                        } else if (newsScope === 'state') {
                            const stateVal = document.getElementById('locationState').value;
                            if (stateVal) newsData.location = stateVal;
                        }

                        if (location && !newsData.location) {
                            newsData.location = location;
                        }

                        const readFullLink = document.getElementById('readFullLink').value;
                        const ePaperLink = document.getElementById('ePaperLink').value;
                        const sourceLinkEl = document.getElementById('sourceLink');
                        if (readFullLink) {
                            newsData.readFullLink = readFullLink;
                        }
                        if (ePaperLink) {
                            newsData.ePaperLink = ePaperLink;
                        }
                        if (sourceLinkEl && sourceLinkEl.value) {
                            newsData.sourceLink = sourceLinkEl.value;
                        }

                        setSaveButtonsEnabled(false);

                        try {
                            showLoader(newsId ? 'Updating news...' : 'Publishing news...');
                            let response;
                            if (newsId) {
                                response = await fetch(`/news/api/news/${newsId}`, {
                                    method: 'PUT',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(newsData)
                                });
                            } else {
                                response = await fetch('/news/api/news', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(newsData)
                                });
                            }

                            hideLoader();
                            if (response.ok) {
                                const warnModalEl = document.getElementById('languageWarningModal');
                                if (warnModalEl) {
                                    const warnModal = bootstrap.Modal.getInstance(warnModalEl);
                                    if (warnModal) warnModal.hide();
                                }
                                closeDuplicatePublishWarning();
                                resetDuplicateGate();

                                const responseData = await response.json();

                                if (newsId) {
                                    if (typeof pageSource !== 'undefined' && pageSource === 'pending') {
                                        const wantsToApprove = confirm("News updated successfully! Do you also want to approve this news? Click OK to approve, Cancel to just save changes.");
                                        if (wantsToApprove) {
                                            try {
                                                showLoader('Approving news...');
                                                await fetch(`/admin/api/news/${newsId}/approve`, {
                                                    method: 'POST',
                                                    headers: { 'Content-Type': 'application/json' },
                                                    body: JSON.stringify({ ignoreLanguageWarning: true })
                                                });
                                                hideLoader();
                                                showFeedback('News updated and approved successfully!', 'success');
                                            } catch(e) {
                                                console.error(e);
                                                hideLoader();
                                                showFeedback('News updated but failed to approve.', 'warning');
                                            }
                                        } else {
                                            showFeedback('Changes saved successfully.', 'success');
                                        }
                                        setTimeout(() => {
                                            window.location.href = '/admin/pending-news';
                                        }, 1500);
                                    } else {
                                        showFeedback('News updated successfully!', 'success');
                                        setTimeout(() => {
                                            window.location.href = '/news-list';
                                        }, 1500);
                                    }
                                } else {
                                    if (CURRENT_USER_ROLE === 'subeditor') {
                                        showFeedback('✅ News submitted! AI verification in progress...', 'success');
                                    } else {
                                        showFeedback('✅ News published successfully!', 'success');
                                    }
                                    setTimeout(() => {
                                        window.location.href = '/news-list';
                                    }, 1500);
                                }
                            } else {
                                if (response.status === 409) {
                                    try {
                                        const errorData = await response.json();
                                        const detected = (errorData.detectedLanguage || '').toUpperCase();
                                        const expected = (errorData.expectedCategory || '').toUpperCase();
                                        
                                        if (detected && expected) {
                                            const styledDetected = `<span style="font-size: 1.15em; font-weight: 900; color: #dc3545; text-transform: uppercase; background: #fff5f5; padding: 3px 8px; border-radius: 6px; border: 1px solid #f5c2c7; display: inline-block; margin: 0 4px;">${detected}</span>`;
                                            const styledExpected = `<span style="font-size: 1.15em; font-weight: 900; color: #dc3545; text-transform: uppercase; background: #fff5f5; padding: 3px 8px; border-radius: 6px; border: 1px solid #f5c2c7; display: inline-block; margin: 0 4px;">${expected}</span>`;
                                            document.getElementById('languageWarningText').innerHTML = `This content appears to be in ${styledDetected} <br> but you selected ${styledExpected}.`;
                                        } else {
                                            document.getElementById('languageWarningText').textContent = errorData.message || 'Language mismatch detected.';
                                        }
                                    } catch (e) {
                                        document.getElementById('languageWarningText').textContent = 'Language mismatch detected.';
                                    }
                                    // Keep duplicateGatePassed so Proceed Anyway does not re-open duplicate modal
                                    const warnModal = new bootstrap.Modal(document.getElementById('languageWarningModal'));
                                    warnModal.show();
                                    setSaveButtonsEnabled(true);
                                    return;
                                }
                                const errorText = await response.text();
                                try {
                                    const error = JSON.parse(errorText);
                                    showFeedback('Error saving news: ' + (error.error || error.message || 'Failed to save'), 'error');
                                } catch (e) {
                                    const cleanMsg = errorText.includes('<html') || errorText.includes('504')
                                        ? 'Server timeout occurred (504). Please try updating again.'
                                        : 'Error saving news: ' + errorText;
                                    showFeedback(cleanMsg, 'error');
                                }
                                if (roleNeedsDuplicateGate() && !newsId) {
                                    duplicateGatePassed = false;
                                }
                                setSaveButtonsEnabled(true);
                            }
                        } catch (error) {
                            hideLoader();
                            console.error('Error:', error);
                            showFeedback('Error saving news: ' + error.message, 'error');
                            // Allow a fresh duplicate gate on retry after hard failure
                            if (roleNeedsDuplicateGate() && !document.getElementById('newsId').value) {
                                duplicateGatePassed = false;
                            }
                            setSaveButtonsEnabled(true);
                        }
                    }

                    function confirmDuplicatePublishAnyway() {
                        closeDuplicatePublishWarning();
                        duplicateGatePassed = true;
                        saveNews(false);
                    }

                    function cancelDuplicatePublish() {
                        closeDuplicatePublishWarning();
                        resetDuplicateGate();
                        setSaveButtonsEnabled(true);
                        hideLoader();
                    }

                    // 🔔 Send OneSignal push notification for newly created news
                    function sendPushNotificationForNews(newsId, title, content, imageUrl) {
                        const notificationData = {
                            title: `Latest News: ${title}`,
                            message: content ? content.substring(0, 100) + '...' : title,
                            newsId: newsId,
                            imageUrl: imageUrl || null,
                            launchUrl: `/news/${newsId}`,
                            priority: 'normal'
                        };

                        fetch('/admin/api/send-notification', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(notificationData)
                        })
                            .then(res => res.json())
                            .then(result => {
                                console.log('🔔 Push notification sent:', result);
                            })
                            .catch(err => {
                                console.error('❌ Push notification error:', err);
                            });
                    }

                    // Wait for DOM to be fully loaded
                    document.addEventListener('DOMContentLoaded', function () {
                        // Load categories and locations
                        loadCategories();
                        loadLocations();
                        loadLocationHierarchy();

                        // Set up event listeners for save buttons
                        const saveBtnIds = ['saveNewsButton', 'saveNewsButtonMobile', 'saveNewsButtonDesktop', 'saveNewsBtn'];
                        saveBtnIds.forEach(id => {
                            const btn = document.getElementById(id);
                            if (btn) btn.addEventListener('click', (e) => saveNews(false));
                        });

                        const languageSelect = document.getElementById('language');
                        if (languageSelect) {
                            applyDisplayLimitsForLanguage(languageSelect.value);
                            languageSelect.addEventListener('change', function (e) {
                                applyDisplayLimitsForLanguage(e.target.value);
                                initRichEditor('titleEditor', 'title', TITLE_MAX, true, false);
                                initRichEditor('contentEditor', 'content', CONTENT_MAX, false, true);
                                updateCount('title', TITLE_MAX);
                                updateCount('content', CONTENT_MAX);
                            });
                        }

                        // Rich text editors
                        initRichEditor('titleEditor', 'title', TITLE_MAX, true, false);
                        initRichEditor('contentEditor', 'content', CONTENT_MAX, false, true);

                        window.onRichEditorChange = function (hiddenId, max) {
                            updateCount(hiddenId, max);
                        };

                        updateCount('title', TITLE_MAX);
                        updateCount('content', CONTENT_MAX);

                        // Initial media preview
                        const mediaType = document.getElementById('mediaType').value;
                        const mediaUrl = document.getElementById('mediaUrl').value;
                        if (mediaType === 'video' && mediaUrl) {
                            document.getElementById('imagePreview').style.display = 'none';
                            document.getElementById('videoPreview').src = mediaUrl;
                            document.getElementById('videoPreview').style.display = 'block';
                        }

                        // Media upload selection
                        const mediaUpload = document.getElementById('mediaUpload');
                        const uploadMediaButton = document.getElementById('uploadMediaButton');

                        if (uploadMediaButton) {
                            uploadMediaButton.addEventListener('click', () => mediaUpload.click());
                        }

                        if (mediaUpload) {
                            mediaUpload.addEventListener('change', async function (e) {
                                const files = e.target.files;
                                if (files.length === 0) return;

                                // NEW QUEUE-BASED CROPPER FOR MULTIPLE IMAGES
                                window.pendingCropFiles = Array.from(files);
                                window.processNextCrop();
                            });
                        }

                        // Queue processing function
                        window.processNextCrop = async function () {
                            if (!window.pendingCropFiles || window.pendingCropFiles.length === 0) {
                                return; // Queue finished
                            }

                            const fileToProcess = window.pendingCropFiles.shift(); // Remove first from queue

                            if (fileToProcess.type.startsWith('video/')) {
                                await uploadMediaFile(fileToProcess);
                                setTimeout(window.processNextCrop, 300);
                            } else {
                                try {
                                    const file = await normalizeImageForCrop(fileToProcess);
                                    const reader = new FileReader();
                                    reader.onload = function (event) {
                                        const imageToCrop = document.getElementById('imageToCrop');
                                        const imageCropModalElement = document.getElementById('imageCropModal');
                                        const imageCropModal = new bootstrap.Modal(imageCropModalElement);
                                        imageToCrop.src = event.target.result;
                                        setTimeout(() => imageCropModal.show(), 100);
                                    };
                                    reader.readAsDataURL(file);
                                } catch (error) {
                                    console.error('Image normalization failed:', error);
                                    showFeedback('Image processing failed. Skipping.', 'error');
                                    // Skip to next automatically
                                    setTimeout(window.processNextCrop, 500);
                                }
                            }
                        };

                        // Cropper setup
                        const imageToCrop = document.getElementById('imageToCrop');
                        const imageCropModalElement = document.getElementById('imageCropModal');
                        let cropper;

                        if (imageCropModalElement) {
                            imageCropModalElement.addEventListener('shown.bs.modal', function () {
                                if (cropper) cropper.destroy();
                                cropper = new Cropper(imageToCrop, {
                                    aspectRatio: 1080 / 900,
                                    viewMode: 1,
                                    autoCropArea: 1
                                });
                            });

                            imageCropModalElement.addEventListener('hidden.bs.modal', function () {
                                if (cropper) {
                                    cropper.destroy();
                                    cropper = null;
                                }
                                imageToCrop.src = '';

                                // Automatically process next file in queue if any remain
                                if (window.pendingCropFiles && window.pendingCropFiles.length > 0) {
                                    setTimeout(window.processNextCrop, 300);
                                }
                            });

                            document.getElementById('cropButton').addEventListener('click', function () {
                                if (cropper) {
                                    const canvas = cropper.getCroppedCanvas({ width: 1080, height: 900 });
                                    canvas.toBlob(blob => uploadMediaFile(blob, 'image'), 'image/jpeg', 0.85);
                                }
                            });
                        }

                        setupMobileMenu();
                        refreshMultipleImagesUI();
                    });

                    function refreshMultipleImagesUI() {
                        const container = document.getElementById('multipleImagesContainer');
                        if (!container) return;
                        container.innerHTML = '';
                        let urls = [];
                        try { urls = JSON.parse(document.getElementById('imageUrls').value) || []; } catch (e) { }

                        urls.forEach((url, i) => {
                            const wrapper = document.createElement('div');
                            wrapper.style.position = 'relative';

                            const img = document.createElement('img');
                            img.src = url;
                            img.style.width = '60px';
                            img.style.height = '60px';
                            img.style.objectFit = 'cover';
                            img.className = 'border rounded';

                            const removeBtn = document.createElement('button');
                            removeBtn.innerHTML = '&times;';
                            removeBtn.style.position = 'absolute';
                            removeBtn.style.top = '-5px';
                            removeBtn.style.right = '-5px';
                            removeBtn.style.background = 'red';
                            removeBtn.style.color = 'white';
                            removeBtn.style.border = 'none';
                            removeBtn.style.borderRadius = '50%';
                            removeBtn.style.width = '20px';
                            removeBtn.style.height = '20px';
                            removeBtn.style.fontSize = '14px';
                            removeBtn.style.lineHeight = '0';
                            removeBtn.style.cursor = 'pointer';
                            removeBtn.style.zIndex = '10';

                            const moderateBtn = document.createElement('button');
                            moderateBtn.innerHTML = '<i class="fas fa-magic"></i>';
                            moderateBtn.title = 'Moderate Image';
                            moderateBtn.className = 'btn btn-sm btn-primary p-1';
                            moderateBtn.style.position = 'absolute';
                            moderateBtn.style.bottom = '5px';
                            moderateBtn.style.right = '5px';
                            moderateBtn.style.fontSize = '10px';
                            moderateBtn.style.borderRadius = '4px';
                            
                            moderateBtn.onclick = function (e) {
                                e.preventDefault();
                                openImageModerator(url, function(newUrl) {
                                    urls[i] = newUrl;
                                    document.getElementById('imageUrls').value = JSON.stringify(urls);
                                    
                                    // If this was the first image, update main mediaUrl too
                                    if (i === 0) {
                                        document.getElementById('mediaUrl').value = newUrl;
                                        document.getElementById('imagePreview').src = newUrl;
                                    }
                                    refreshMultipleImagesUI();
                                });
                            };

                            removeBtn.onclick = function (e) {
                                e.preventDefault();
                                urls.splice(i, 1);
                                document.getElementById('imageUrls').value = JSON.stringify(urls);
                                refreshMultipleImagesUI();
                            };

                            wrapper.appendChild(img);
                            wrapper.appendChild(removeBtn);
                            wrapper.appendChild(moderateBtn);
                            container.appendChild(wrapper);
                        });
                    }

                    window.openModeratorForMainImage = function() {
                        const currentUrl = document.getElementById('mediaUrl').value;
                        if (!currentUrl) return;
                        openImageModerator(currentUrl, function(newUrl) {
                            document.getElementById('mediaUrl').value = newUrl;
                            document.getElementById('imagePreview').src = newUrl;
                            
                            // update in multiple images if it's there
                            let urls = [];
                            try { urls = JSON.parse(document.getElementById('imageUrls').value) || []; } catch(e){}
                            if (urls.length > 0) {
                                urls[0] = newUrl;
                                document.getElementById('imageUrls').value = JSON.stringify(urls);
                                refreshMultipleImagesUI();
                            }
                        });
                    }

                    // Upload media file
                    async function uploadMediaFile(file, type = null) {
                        const formData = new FormData();
                        formData.append('media', file);

                        try {
                            showLoader('Uploading media...');
                            const response = await fetch('/news/upload-media', {
                                method: 'POST',
                                body: formData
                            });

                            if (!response.ok) throw new Error('Upload failed');

                            const data = await response.json();
                            hideLoader();
                            console.log('Upload response:', data);
                            const imagePreview = document.getElementById('imagePreview');
                            const videoPreview = document.getElementById('videoPreview');
                            const mediaUrlInput = document.getElementById('mediaUrl');
                            const mediaTypeInput = document.getElementById('mediaType');
                            const thumbnailUrlInput = document.getElementById('thumbnailUrl');
                            const thumbnailSelection = document.getElementById('thumbnailSelection');

                            if (data.fileType === 'video' || type === 'video') {
                                imagePreview.style.display = 'none';
                                videoPreview.src = data.mediaUrl;
                                videoPreview.style.display = 'block';
                                mediaTypeInput.value = 'video';
                                thumbnailSelection.style.display = 'block';
                                generateVideoThumbnails(data.mediaUrl, data.thumbnailUrl);
                                const editBtn = document.getElementById('mainModerateBtn');
                                if (editBtn) editBtn.style.display = 'none';
                            } else {
                                videoPreview.style.display = 'none';
                                imagePreview.src = data.mediaUrl;
                                imagePreview.style.display = 'block';
                                mediaTypeInput.value = 'image';
                                thumbnailSelection.style.display = 'none';
                                const editBtn = document.getElementById('mainModerateBtn');
                                if (editBtn) editBtn.style.display = 'block';
                            }

                            mediaUrlInput.value = data.mediaUrl;
                            thumbnailUrlInput.value = data.thumbnailUrl || data.mediaUrl;

                            // Include it in the imageUrls list if it's an image
                            if (data.fileType === 'image' || type === 'image') {
                                let urls = [];
                                try { urls = JSON.parse(document.getElementById('imageUrls').value); } catch (e) { }
                                if (!urls.includes(data.mediaUrl)) {
                                    urls.push(data.mediaUrl);
                                    document.getElementById('imageUrls').value = JSON.stringify(urls);
                                    refreshMultipleImagesUI();
                                }
                            }

                            showFeedback('Media uploaded successfully!', 'success');

                            const cropBtn = document.getElementById('cropButton');
                            if (cropBtn) cropBtn.blur();

                            const modal = bootstrap.Modal.getInstance(document.getElementById('imageCropModal'));
                            if (modal) modal.hide();
                        } catch (error) {
                            hideLoader();
                            console.error('Upload error:', error);
                            showFeedback('Error uploading media: ' + error.message, 'error');
                        }
                    }

                    // Generate video thumbnails
                    function generateVideoThumbnails(videoUrl, defaultThumbnail) {
                        const thumbnailGrid = document.getElementById('thumbnailGrid');
                        const thumbnailUrlInput = document.getElementById('thumbnailUrl');
                        thumbnailGrid.innerHTML = '';

                        const createThumb = (src, label, isSelected) => {
                            const div = document.createElement('div');
                            div.className = `thumbnail-option ${isSelected ? 'selected' : ''}`;
                            div.innerHTML = `<img src="${src}" class="thumbnail-img"><small class="text-center d-block mt-1">${label}</small>`;
                            div.addEventListener('click', () => {
                                document.querySelectorAll('.thumbnail-option').forEach(el => el.classList.remove('selected'));
                                div.classList.add('selected');
                                thumbnailUrlInput.value = src;
                            });
                            return div;
                        };

                        thumbnailGrid.appendChild(createThumb(defaultThumbnail, 'Default', true));
                        for (let i = 1; i <= 3; i++) {
                            thumbnailGrid.appendChild(createThumb(`https://via.placeholder.com/160x120/007bff/ffffff?text=Frame+${i}`, `Frame ${i}`, false));
                        }
                    }

                    // Load categories
