                    // Load locations (old flat dropdown — kept for backward compat)
                    async function loadLocations() {
                        try {
                            const response = await fetch('/locations/api/locations');
                            const locations = await response.json();
                            const select = document.getElementById('location');
                            select.innerHTML = '<option value="">Select Location (Optional)</option>';
                            locations.filter(l => l.isActive).forEach(l => {
                                const opt = document.createElement('option');
                                opt.value = l.name;
                                opt.textContent = l.name;
                                select.appendChild(opt);
                            });
                            const current = '<%= typeof news !== "undefined" ? news.location : "" %>';
                            if (current) select.value = current;
                        } catch (e) { console.error(e); }
                    }

                    // Scope-based cascading dropdowns
                    let _allHierarchy = [];
                    const _editorAssignedStates = <%- JSON.stringify(typeof editorAssignedStates !== 'undefined' ? editorAssignedStates : []) %>;
                    const _editorAssignedDistricts = <%- JSON.stringify(typeof editorAssignedDistricts !== 'undefined' ? editorAssignedDistricts : []) %>;
                    const _editorRole = '<%= typeof admin !== "undefined" ? admin.role : "editor" %>';
                    const _isAdminOrSuper = (_editorRole === 'admin' || _editorRole === 'superadmin');
                    const _isSubEditor = (_editorRole === 'subeditor');
                    let _lastScopeForStates = null;

                    // Scope batti state dropdown options build cheyadam.
                    // Sub editor rule: state scope = anni states; district scope = assigned districts unna states matrame.
                    function rebuildStateOptions() {
                        const scope = document.getElementById('newsScope').value;
                        const stateSelect = document.getElementById('locationState');
                        const prevValue = stateSelect.value;
                        stateSelect.innerHTML = '<option value="">Select State</option>';
                        _lastScopeForStates = scope;

                        let allowedStates = null; // null = anni states
                        if (!_isAdminOrSuper) {
                            if (_isSubEditor) {
                                if (scope === 'district' && _editorAssignedDistricts.length > 0) {
                                    allowedStates = _allHierarchy
                                        .filter(s => (s.districts || []).some(d => _editorAssignedDistricts.includes(d.name)))
                                        .map(s => s.name);
                                }
                                // state scope: sub editor ki anni states allowed
                            } else if (_editorAssignedStates.length > 0) {
                                allowedStates = _editorAssignedStates;
                            }
                        }

                        _allHierarchy.forEach(s => {
                            if (allowedStates && !allowedStates.includes(s.name)) return;
                            const opt = document.createElement('option');
                            opt.value = s.name;
                            opt.textContent = s.localName ? `${s.name} (${s.localName})` : s.name;
                            stateSelect.appendChild(opt);
                        });

                        // Previous selection inka valid aithe restore
                        if (prevValue && Array.from(stateSelect.options).some(o => o.value === prevValue)) {
                            stateSelect.value = prevValue;
                        } else if (stateSelect.options.length === 2) {
                            stateSelect.selectedIndex = 1;
                        }
                        onStateChange();
                    }

                    async function loadLocationHierarchy() {
                        try {
                            const resp = await fetch('/api/public/location-hierarchy');
                            _allHierarchy = await resp.json();

                            const isEditMode = <%= typeof news !== "undefined" ? "true" : "false" %>;
                            const newsScopeVal = '<%= typeof news !== "undefined" && news.scope ? news.scope : "" %>';
                            const currentLocation = '<%= typeof news !== "undefined" && news.location ? news.location : "" %>';
                            
                            if (isEditMode && newsScopeVal) {
                                document.getElementById('newsScope').value = newsScopeVal;
                            }
                            
                            rebuildStateOptions();
                            const stateSelect = document.getElementById('locationState');
                            const currentScope = document.getElementById('newsScope').value;

                            if (isEditMode && currentScope === 'state' && currentLocation) {
                                stateSelect.value = currentLocation;
                            } else if (isEditMode && currentScope === 'district' && currentLocation) {
                                // Location district aa, constituency aa — rendu check cheyali
                                let parentState = null, parentDistrict = null, isConstituency = false;
                                _allHierarchy.forEach(s => {
                                    (s.districts || []).forEach(d => {
                                        if (d.name === currentLocation) { parentState = s.name; }
                                        (d.constituencies || []).forEach(c => {
                                            if (c.name === currentLocation) {
                                                parentState = s.name;
                                                parentDistrict = d.name;
                                                isConstituency = true;
                                            }
                                        });
                                    });
                                });
                                if (parentState) {
                                    stateSelect.value = parentState;
                                    onStateChange();
                                    setTimeout(() => {
                                        if (isConstituency) {
                                            document.getElementById('locationDistrict').value = parentDistrict;
                                            onDistrictChange();
                                            setTimeout(() => {
                                                document.getElementById('locationConstituency').value = currentLocation;
                                            }, 50);
                                        } else {
                                            document.getElementById('locationDistrict').value = currentLocation;
                                            onDistrictChange();
                                        }
                                    }, 100);
                                }
                            }

                            updateScopeVisibility();
                        } catch (e) { console.error('Error loading hierarchy:', e); }
                    }

                    function onStateChange() {
                        const stateName = document.getElementById('locationState').value;
                        const districtSelect = document.getElementById('locationDistrict');
                        districtSelect.innerHTML = '<option value="">Select District</option>';

                        const hasDistrictFilter = !_isAdminOrSuper && _editorAssignedDistricts.length > 0;

                        const stateData = _allHierarchy.find(s => s.name === stateName);
                        if (stateData && stateData.districts) {
                            stateData.districts.forEach(d => {
                                if (hasDistrictFilter && !_editorAssignedDistricts.includes(d.name)) return;
                                const opt = document.createElement('option');
                                opt.value = d.name;
                                opt.textContent = d.localName ? `${d.name} (${d.localName})` : d.name;
                                districtSelect.appendChild(opt);
                            });
                        }

                        if (districtSelect.options.length === 2) {
                            districtSelect.selectedIndex = 1;
                        }
                        onDistrictChange();
                    }

                    function onDistrictChange() {
                        const stateName = document.getElementById('locationState').value;
                        const districtName = document.getElementById('locationDistrict').value;
                        const constSelect = document.getElementById('locationConstituency');
                        constSelect.innerHTML = '<option value="">Select Constituency (Optional)</option>';

                        const stateData = _allHierarchy.find(s => s.name === stateName);
                        const districtData = stateData && stateData.districts
                            ? stateData.districts.find(d => d.name === districtName)
                            : null;
                        if (districtData && districtData.constituencies) {
                            districtData.constituencies.forEach(c => {
                                const opt = document.createElement('option');
                                opt.value = c.name;
                                const telugu = c.teluguName || c.localName;
                                opt.textContent = telugu ? `${c.name} (${telugu})` : c.name;
                                constSelect.appendChild(opt);
                            });
                        }
                        // Constituencies leni district ki dropdown hide
                        document.getElementById('locationConstituencyWrapper').style.display =
                            (constSelect.options.length > 1 && document.getElementById('newsScope').value === 'district') ? '' : 'none';
                    }

                    function updateScopeVisibility() {
                        const scope = document.getElementById('newsScope').value;
                        const stateW = document.getElementById('locationStateWrapper');
                        const distW = document.getElementById('locationDistrictWrapper');
                        const constW = document.getElementById('locationConstituencyWrapper');

                        // Scope maarithe state options malli build cheyali (sub editor rules scope batti untayi)
                        if (_allHierarchy.length && scope !== _lastScopeForStates && (scope === 'state' || scope === 'district')) {
                            rebuildStateOptions();
                        }

                        if (scope === 'district') {
                            stateW.style.display = '';
                            distW.style.display = '';
                            onDistrictChange();
                        } else if (scope === 'state') {
                            stateW.style.display = '';
                            distW.style.display = 'none';
                            constW.style.display = 'none';
                        } else {
                            stateW.style.display = 'none';
                            distW.style.display = 'none';
                            constW.style.display = 'none';
                        }
                    }

                    document.getElementById('newsScope').addEventListener('change', updateScopeVisibility);
                    document.getElementById('locationState').addEventListener('change', onStateChange);
                    document.getElementById('locationDistrict').addEventListener('change', onDistrictChange);

                    // Filter allowed languages for sub-editors / reporters
                    (function filterAllowedLanguages() {
                        const allowedLanguages = <%- JSON.stringify(typeof editorAllowedLanguages !== 'undefined' ? editorAllowedLanguages : []) %>;
                        const langSelect = document.getElementById('language');
                        if (!langSelect || !allowedLanguages.length) return;

                        Array.from(langSelect.options).forEach(opt => {
                            if (!allowedLanguages.includes(opt.value)) {
                                opt.remove();
                            }
                        });

                        if (langSelect.options.length === 1) {
                            langSelect.selectedIndex = 0;
                        } else if (langSelect.options.length > 0) {
                            const defaultLang = '<%= typeof defaultLanguage !== "undefined" ? defaultLanguage : "te" %>';
                            const match = Array.from(langSelect.options).find(o => o.value === defaultLang);
                            if (match) langSelect.value = defaultLang;
                        }

                        if (typeof applyDisplayLimitsForLanguage === 'function') {
                            applyDisplayLimitsForLanguage(langSelect.value);
                        }
                    })();

                    // Filter allowed scopes based on editor's allowedScopes from database
                    (function filterAllowedScopes() {
                        const allowedScopes = <%- JSON.stringify(typeof editorAllowedScopes !== 'undefined' ? editorAllowedScopes : []) %>;
                        const scopeSelect = document.getElementById('newsScope');

                        if (_isAdminOrSuper) {
                            updateScopeVisibility();
                            return;
                        }

                        if (allowedScopes.length > 0) {
                            Array.from(scopeSelect.options).forEach(opt => {
                                if (!allowedScopes.includes(opt.value)) {
                                    opt.style.display = 'none';
                                }
                            });
                            const firstAllowed = allowedScopes.find(s => Array.from(scopeSelect.options).some(o => o.value === s));
                            if (firstAllowed) scopeSelect.value = firstAllowed;
                        } else {
                            Array.from(scopeSelect.options).forEach(opt => {
                                if (opt.value !== 'district' && opt.value !== 'state') {
                                    opt.style.display = 'none';
                                }
                            });
                            scopeSelect.value = 'state';
                        }
                        updateScopeVisibility();
                    })();

                    // Mobile menu setup
                    function setupMobileMenu() {
                        const menuToggle = document.getElementById('menuToggle');
                        const sidebar = document.getElementById('sidebar');
                        const mainContent = document.getElementById('mainContent');

                        if (menuToggle && sidebar) {
                            menuToggle.addEventListener('click', function (e) {
                                e.stopPropagation();
                                sidebar.classList.toggle('active');
                                mainContent.classList.toggle('sidebar-active');
                            });
                        }

                        document.addEventListener('click', function (event) {
                            if (window.innerWidth < 768 &&
                                sidebar && sidebar.classList.contains('active') &&
                                !sidebar.contains(event.target) &&
                                event.target !== menuToggle &&
                                !menuToggle.contains(event.target)) {
                                sidebar.classList.remove('active');
                                if (mainContent) mainContent.classList.remove('sidebar-active');
                            }
                        });
                    }

                    // Show feedback (Android-like snackbar)
                    function showFeedback(message, type) {
                        const existing = document.getElementById('feedback-toast');
                        if (existing) existing.remove();

                        const toast = document.createElement('div');
                        toast.id = 'feedback-toast';
                        toast.textContent = message;
                        Object.assign(toast.style, {
                            position: 'fixed', bottom: '20px', left: '50%', transform: 'translateX(-50%)',
                            padding: '12px 24px', borderRadius: '4px', color: 'white', zIndex: '9999',
                            backgroundColor: type === 'success' ? '#4CAF50' : (type === 'error' ? '#F44336' : '#2196F3'),
                            transition: 'all 0.3s'
                        });

                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }

                    const EDITOR_MAP = {
                        title: { editorId: 'titleEditor', hiddenId: 'title', max: TITLE_MAX, singleLine: true, singleParagraph: false },
                        content: { editorId: 'contentEditor', hiddenId: 'content', max: CONTENT_MAX, singleLine: false, singleParagraph: true }
                    };

                    function syncAllEditors() {
                        syncRichEditor('titleEditor', 'title', TITLE_MAX, true, false);
                        syncRichEditor('contentEditor', 'content', CONTENT_MAX, false, true);
                    }

                    function stripTags(text) {
                        return typeof stripRichTags === 'function' ? stripRichTags(text) : (text || '');
                    }

                    function updateCount(hiddenId, max) {
                        const hidden = document.getElementById(hiddenId);
                        const countSpan = document.getElementById(hiddenId + 'Count');
                        const countWrap = document.getElementById(hiddenId + 'CountWrap');
                        if (!hidden || !countSpan) return;

                        const current = stripTags(hidden.value).length;
                        countSpan.textContent = current;

                        if (countWrap) {
                            countWrap.classList.toggle('over', current >= max);
                        }
                    }

                    function applyTextColor(fieldKey, color) {
                        const cfg = EDITOR_MAP[fieldKey];
                        if (!cfg) return;
                        if (!applyRichColor(cfg.editorId, cfg.hiddenId, color, cfg.max, cfg.singleLine, cfg.singleParagraph)) {
                            showFeedback('Please select some text first', 'info');
                        }
                    }

                    function applyBoldText(fieldKey) {
                        const cfg = EDITOR_MAP[fieldKey];
                        if (!cfg) return;
                        if (!applyRichBold(cfg.editorId, cfg.hiddenId, cfg.max, cfg.singleLine, cfg.singleParagraph)) {
                            showFeedback('Please select some text first', 'info');
                        }
                    }

                    function removeStyling(fieldKey) {
                        const cfg = EDITOR_MAP[fieldKey];
                        if (!cfg) return;
                        if (!removeRichStyling(cfg.editorId, cfg.hiddenId, cfg.max, cfg.singleLine, cfg.singleParagraph)) {
                            showFeedback('Please select styled text first', 'info');
                        }
                    }

                    function insertLink(fieldKey) {
                        const cfg = EDITOR_MAP[fieldKey];
                        if (!cfg) return;
                        
                        const editor = document.getElementById(cfg.editorId);
                        editor.focus();
                        
                        const url = prompt("Enter the link URL (e.g., https://example.com):");
                        if (url) {
                            let finalUrl = url.trim();
                            if (!/^https?:\/\//i.test(finalUrl)) {
                                finalUrl = 'http://' + finalUrl;
                            }
                            
                            document.execCommand('createLink', false, finalUrl);
                            
                            // Force links to open in a new tab if possible
                            const links = editor.querySelectorAll('a');
                            links.forEach(link => {
                                link.setAttribute('target', '_blank');
                                link.setAttribute('rel', 'noopener noreferrer');
                            });
                            
                            if (typeof window.onRichEditorChange === 'function') {
                                window.onRichEditorChange(cfg.hiddenId, cfg.max);
                            }
                        }
                    }
                </script>
        <%- include('partials/image-moderator') %>
    </body>
</html>