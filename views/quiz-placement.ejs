<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: 'Quiz Feed Position' }) %>
<body>
  <%- include('partials/top-nav', { pageTitle: 'Quiz Feed Position', backButton: true, backUrl: '/' }) %>
  <div class="container-fluid"><div class="row">
    <%- include('partials/sidebar', { activePage: 'quiz-placement' }) %>
    <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
      <div class="content-area py-3">
        <h3 class="mb-1"><i class="fas fa-stream me-2 text-primary"></i>Quiz Feed Position</h3>
        <p class="text-muted mb-3">Control where the Daily Quiz card appears in the app's news feed. Just like ads, it repeats — the quiz card is shown after every Nth news card.</p>

        <div class="card" style="max-width:600px">
          <div class="card-body">
            <div class="mb-3">
              <label class="fw-bold small text-muted" for="qzFeedPosition">Unplayed — show after every N news</label>
              <div class="d-flex align-items-center gap-2 mt-1" style="max-width:180px">
                <input type="number" id="qzFeedPosition" class="form-control form-control-sm" min="1" max="50" step="1" value="1">
                <span class="text-muted small">news cards</span>
              </div>
              <small class="text-muted d-block mt-1">For users who have NOT played today (e.g. 3 → after the 3rd, 6th, 9th …).</small>
            </div>
            <div class="mb-2">
              <label class="fw-bold small text-muted" for="qzFeedPositionPlayed">Played — show after every N news</label>
              <div class="d-flex align-items-center gap-2 mt-1" style="max-width:180px">
                <input type="number" id="qzFeedPositionPlayed" class="form-control form-control-sm" min="1" max="50" step="1" value="7">
                <span class="text-muted small">news cards</span>
              </div>
              <small class="text-muted d-block mt-1">For users who ALREADY submitted today's answer — usually larger, so it appears less often (e.g. 7 or 10).</small>
            </div>
            <div class="mt-3">
              <button class="btn btn-primary btn-sm" onclick="qpSave()"><i class="fas fa-save me-1"></i>Save</button>
              <span id="qpMsg" class="ms-2 small fw-bold"></span>
            </div>
          </div>
        </div>

        <div class="alert alert-info mt-3 small" style="max-width:560px">
          <i class="fas fa-info-circle me-1"></i>
          Changes apply the next time the app fetches settings (or on app restart). The quiz card only shows for users whose language is enabled in <a href="/admin/quiz/questions">Question Bank → Daily Quiz Settings</a>.
        </div>
      </div>
    </div>
  </div></div>

  <script>
    function qpClamp(v, def) { var n = parseInt(v, 10) || def; if (n < 1) n = 1; if (n > 50) n = 50; return n; }
    async function qpLoad() {
      try {
        var s = await (await fetch('/admin/quiz/api/settings')).json();
        if (s && s.feedPosition) document.getElementById('qzFeedPosition').value = s.feedPosition;
        if (s && s.feedPositionPlayed) document.getElementById('qzFeedPositionPlayed').value = s.feedPositionPlayed;
      } catch (e) { /* keep default */ }
    }
    async function qpSave() {
      var msg = document.getElementById('qpMsg');
      msg.textContent = 'Saving...'; msg.className = 'ms-2 small text-muted';
      var feedPosition = qpClamp(document.getElementById('qzFeedPosition').value, 1);
      var feedPositionPlayed = qpClamp(document.getElementById('qzFeedPositionPlayed').value, 7);
      try {
        var r = await fetch('/admin/quiz/api/settings/feed-position', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ feedPosition: feedPosition, feedPositionPlayed: feedPositionPlayed })
        });
        if (!r.ok) throw new Error();
        document.getElementById('qzFeedPosition').value = feedPosition;
        document.getElementById('qzFeedPositionPlayed').value = feedPositionPlayed;
        msg.textContent = 'Saved!'; msg.className = 'ms-2 small text-success';
        setTimeout(function () { msg.textContent = ''; }, 2000);
      } catch (e) {
        msg.textContent = 'Failed to save'; msg.className = 'ms-2 small text-danger';
      }
    }
    qpLoad();
  </script>
</body>
</html>
