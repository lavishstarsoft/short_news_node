<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Performance Analytics' }) %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="/css/performance-hub.css">
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Performance Analytics', backButton: true, backUrl: '/editors' }) %>

            <div class="container-fluid">
                <div class="row">
                    <%- include('partials/sidebar', { activePage: 'performance-analytics' }) %>

                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4 pa-page">
                                <% 
                                    const pageSummary = typeof summary !== 'undefined' ? summary : {};
                                    const rows = analyticsRows || [];
                                    const counts = typeof filterCounts !== 'undefined' ? filterCounts : { all: rows.length, reporters: 0, subeditors: 0 };
                                    const totalRows = (typeof pagination !== 'undefined' && pagination.totalRows !== undefined) ? pagination.totalRows : rows.length;
                                    const currentPage = (typeof pagination !== 'undefined' && pagination.currentPage) ? pagination.currentPage : 1;
                                    const totalPages = (typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1;
                                    const pageLimit = (typeof pagination !== 'undefined' && pagination.limit) ? pagination.limit : rows.length;
                                    const currentSearch = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
                                    const currentRole = (typeof roleFilter !== 'undefined' && roleFilter) ? roleFilter : '';
                                    const currentBand = (typeof bandFilter !== 'undefined' && bandFilter) ? bandFilter : '';
                                    const currentAuthorId = (typeof selectedAuthorId !== 'undefined' && selectedAuthorId) ? selectedAuthorId : '';
                                    const memberFocus = typeof selectedMember !== 'undefined' ? selectedMember : null;
                                    const teamMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                    const maxTeamViews = Math.max(...(teamMonthlyTrend || []).map(function(t) { return t.views; }), 1);

                                    function buildFilterQuery(overrides) {
                                        const o = overrides || {};
                                        const parts = [];
                                        const p = o.period !== undefined ? o.period : period;
                                        const sd = o.startDate !== undefined ? o.startDate : startDate;
                                        const ed = o.endDate !== undefined ? o.endDate : endDate;
                                        const search = o.search !== undefined ? o.search : currentSearch;
                                        const role = o.role !== undefined ? o.role : currentRole;
                                        const band = o.band !== undefined ? o.band : currentBand;
                                        const authorId = o.authorId !== undefined ? o.authorId : currentAuthorId;

                                        if (p && p !== '30' && !sd) parts.push('period=' + p);
                                        if (sd) parts.push('startDate=' + encodeURIComponent(sd));
                                        if (ed) parts.push('endDate=' + encodeURIComponent(ed));
                                        if (search) parts.push('search=' + encodeURIComponent(search));
                                        if (role) parts.push('role=' + role);
                                        if (band) parts.push('band=' + band);
                                        if (authorId) parts.push('authorId=' + authorId);
                                        return parts.length ? '&' + parts.join('&') : '';
                                    }

                                    function buildSegmentHref(role) {
                                        return '/admin/performance-analytics?' + (buildFilterQuery({ role: role, authorId: '' }).replace(/^&/, '') || 'period=' + period);
                                    }

                                    function getGrade(score) {
                                        if (score >= 85) return { letter: 'A+', cls: 'excellent' };
                                        if (score >= 75) return { letter: 'A', cls: 'excellent' };
                                        if (score >= 60) return { letter: 'B', cls: 'good' };
                                        if (score >= 45) return { letter: 'C', cls: 'average' };
                                        return { letter: 'F', cls: 'poor' };
                                    }

                                    let paginationQuery = buildFilterQuery({});
                                %>

                                <div class="pa-hero">
                                    <div>
                                        <p class="pa-eyebrow"><i class="fas fa-chart-line"></i> Editorial Intelligence</p>
                                        <h1 class="pa-hero-title">Team Performance Analytics</h1>
                                        <p class="pa-hero-sub">Track output quality, audience engagement, moderation load, and rank movement across reporters and sub-editors.</p>
                                    </div>
                                    <form method="GET" action="/admin/performance-analytics" id="analyticsForm" class="pa-hero-filters">
                                        <% if (currentSearch) { %><input type="hidden" name="search" value="<%= currentSearch %>"><% } %>
                                        <% if (currentRole) { %><input type="hidden" name="role" value="<%= currentRole %>"><% } %>
                                        <% if (currentBand) { %><input type="hidden" name="band" value="<%= currentBand %>"><% } %>
                                        <% if (currentAuthorId) { %><input type="hidden" name="authorId" value="<%= currentAuthorId %>"><% } %>
                                        <div class="pa-date-wrap">
                                            <i class="fas fa-calendar-alt"></i>
                                            <input type="text" id="datePicker" name="dateRange" class="pa-date-input" placeholder="Custom date range..." value="<%= startDate && endDate ? startDate + ' to ' + endDate : '' %>">
                                            <input type="hidden" name="startDate" id="startDate" value="<%= startDate %>">
                                            <input type="hidden" name="endDate" id="endDate" value="<%= endDate %>">
                                        </div>
                                        <select name="period" class="pa-period-select" onchange="document.getElementById('datePicker').value=''; document.getElementById('startDate').value=''; document.getElementById('endDate').value=''; this.form.submit();">
                                            <option value="7" <%= period === '7' ? 'selected' : '' %>>Last 7 days</option>
                                            <option value="30" <%= period === '30' ? 'selected' : '' %>>Last 30 days</option>
                                            <option value="90" <%= period === '90' ? 'selected' : '' %>>Last 90 days</option>
                                            <option value="all" <%= period === 'all' ? 'selected' : '' %>>All time</option>
                                        </select>
                                    </form>
                                </div>

                                <div class="pa-stats">
                                    <div class="pa-stat">
                                        <div class="pa-stat-value"><%= pageSummary.totalMembers || 0 %></div>
                                        <div class="pa-stat-label">Team members</div>
                                    </div>
                                    <div class="pa-stat">
                                        <div class="pa-stat-value"><%= (pageSummary.totalTeamViews || 0).toLocaleString() %></div>
                                        <div class="pa-stat-label">Total views</div>
                                    </div>
                                    <div class="pa-stat">
                                        <div class="pa-stat-value"><%= pageSummary.avgScore || 0 %></div>
                                        <div class="pa-stat-label">Avg quality score</div>
                                    </div>
                                    <div class="pa-stat">
                                        <div class="pa-stat-value"><%= pageSummary.excellentCount || 0 %></div>
                                        <div class="pa-stat-label">Excellent performers</div>
                                        <span class="pa-stat-accent up"><i class="fas fa-arrow-up"></i> Top tier</span>
                                    </div>
                                    <div class="pa-stat">
                                        <div class="pa-stat-value"><%= pageSummary.poorCount || 0 %></div>
                                        <div class="pa-stat-label">Needs attention</div>
                                        <span class="pa-stat-accent down"><i class="fas fa-flag"></i> Review</span>
                                    </div>
                                </div>

                                <div class="pa-trend-panel">
                                    <div class="pa-trend-header">
                                        <div>
                                            <h2 class="pa-trend-title"><i class="fas fa-wave-square me-2"></i>View velocity (6 months)</h2>
                                            <p class="pa-trend-sub">Aggregate audience reach across all editorial team members</p>
                                        </div>
                                        <span class="pa-trend-badge"><i class="fas fa-eye"></i> <%= (pageSummary.totalTeamViews || 0).toLocaleString() %> total</span>
                                    </div>
                                    <div class="pa-trend-chart">
                                        <% if (teamMonthlyTrend && teamMonthlyTrend.length > 0) { %>
                                            <% teamMonthlyTrend.forEach(function(t) {
                                                const height = Math.max(8, (t.views / maxTeamViews) * 100);
                                                const label = t.views > 999 ? (t.views / 1000).toFixed(1) + 'k' : t.views;
                                            %>
                                            <div class="pa-trend-bar-wrap">
                                                <div class="pa-trend-bar" style="height: <%= height %>%;">
                                                    <span class="pa-trend-bar-value"><%= label %></span>
                                                    <span class="pa-trend-bar-label"><%= teamMonths[t._id.month - 1] %></span>
                                                </div>
                                            </div>
                                            <% }); %>
                                        <% } else { %>
                                            <div class="pa-empty" style="width:100%; padding: 24px;">No trend data for this period.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="pa-leaderboards">
                                    <div class="pa-leaderboard">
                                        <div class="pa-leaderboard-header top">
                                            <i class="fas fa-trophy"></i>
                                            <h3>Top performers</h3>
                                        </div>
                                        <div class="pa-leaderboard-body">
                                            <% if (topPerformers && topPerformers.length > 0) { %>
                                                <% topPerformers.forEach(function(item) { %>
                                                <div class="pa-rank-item">
                                                    <span class="pa-rank-pos">#<%= item.rank %></span>
                                                    <div class="pa-rank-info">
                                                        <div class="pa-rank-name"><%= item.name %></div>
                                                        <div class="pa-rank-meta">@<%= item.username %> · <%= item.role %></div>
                                                    </div>
                                                    <span class="pa-rank-score"><%= item.performanceScore %></span>
                                                </div>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="pa-empty">No data available.</div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="pa-leaderboard">
                                        <div class="pa-leaderboard-header attention">
                                            <i class="fas fa-triangle-exclamation"></i>
                                            <h3>Needs attention</h3>
                                        </div>
                                        <div class="pa-leaderboard-body">
                                            <% if (poorPerformers && poorPerformers.length > 0) { %>
                                                <% poorPerformers.forEach(function(item) { %>
                                                <div class="pa-rank-item">
                                                    <span class="pa-rank-pos">#<%= item.rank %></span>
                                                    <div class="pa-rank-info">
                                                        <div class="pa-rank-name"><%= item.name %></div>
                                                        <div class="pa-rank-meta">Publish <%= item.publishRate %>% · Reject <%= item.rejectionRate %>%</div>
                                                    </div>
                                                    <span class="pa-rank-score low"><%= item.performanceScore %></span>
                                                </div>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="pa-empty">No data available.</div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="pa-panel">
                                    <% if (memberFocus) { %>
                                    <div class="pa-author-banner">
                                        <span><i class="fas fa-user-check me-1"></i> Focused on <strong><%= memberFocus.name %></strong> (@<%= memberFocus.username %>)</span>
                                        <a href="/admin/performance-analytics?<%= buildFilterQuery({ authorId: '' }).replace(/^&/, '') || 'period=' + period %>">Show all members</a>
                                    </div>
                                    <% } %>

                                    <div class="pa-panel-toolbar">
                                        <form class="pa-search-form" method="GET" action="/admin/performance-analytics">
                                            <input type="hidden" name="period" value="<%= period %>">
                                            <% if (startDate) { %><input type="hidden" name="startDate" value="<%= startDate %>"><% } %>
                                            <% if (endDate) { %><input type="hidden" name="endDate" value="<%= endDate %>"><% } %>
                                            <% if (currentAuthorId) { %><input type="hidden" name="authorId" value="<%= currentAuthorId %>"><% } %>
                                            <div class="pa-search-wrap">
                                                <i class="fas fa-search"></i>
                                                <input type="text" name="search" class="pa-search" placeholder="Search name, username, email, location..." value="<%= currentSearch %>">
                                            </div>
                                            <button type="submit" class="pa-search-btn"><i class="fas fa-filter"></i> Search</button>
                                            <% if (currentSearch || currentRole || currentBand || currentAuthorId) { %>
                                                <a href="/admin/performance-analytics?period=<%= period %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>" class="pa-clear-btn">Clear filters</a>
                                            <% } %>
                                        </form>

                                        <div class="pa-segments">
                                            <a href="<%= buildSegmentHref('') %>" class="pa-segment <%= !currentRole ? 'active' : '' %>">
                                                All<span class="pa-segment-count"><%= counts.all %></span>
                                            </a>
                                            <a href="<%= buildSegmentHref('reporter') %>" class="pa-segment <%= currentRole === 'reporter' ? 'active' : '' %>">
                                                Reporters<span class="pa-segment-count"><%= counts.reporters %></span>
                                            </a>
                                            <a href="<%= buildSegmentHref('subeditor') %>" class="pa-segment <%= currentRole === 'subeditor' ? 'active' : '' %>">
                                                Sub-editors<span class="pa-segment-count"><%= counts.subeditors %></span>
                                            </a>
                                        </div>

                                        <form method="GET" action="/admin/performance-analytics">
                                            <input type="hidden" name="period" value="<%= period %>">
                                            <% if (startDate) { %><input type="hidden" name="startDate" value="<%= startDate %>"><% } %>
                                            <% if (endDate) { %><input type="hidden" name="endDate" value="<%= endDate %>"><% } %>
                                            <% if (currentSearch) { %><input type="hidden" name="search" value="<%= currentSearch %>"><% } %>
                                            <% if (currentRole) { %><input type="hidden" name="role" value="<%= currentRole %>"><% } %>
                                            <% if (currentAuthorId) { %><input type="hidden" name="authorId" value="<%= currentAuthorId %>"><% } %>
                                            <select name="band" class="pa-band-select" onchange="this.form.submit()">
                                                <option value="">All bands</option>
                                                <option value="excellent" <%= currentBand === 'excellent' ? 'selected' : '' %>>Excellent</option>
                                                <option value="good" <%= currentBand === 'good' ? 'selected' : '' %>>Good</option>
                                                <option value="average" <%= currentBand === 'average' ? 'selected' : '' %>>Average</option>
                                                <option value="poor" <%= currentBand === 'poor' ? 'selected' : '' %>>Poor</option>
                                            </select>
                                        </form>
                                    </div>

                                    <% if (rows.length > 0) { %>
                                    <div class="pa-table-wrap">
                                        <table class="pa-table">
                                            <thead>
                                                <tr>
                                                    <th>Rank</th>
                                                    <th>Member</th>
                                                    <th>Role</th>
                                                    <th>Score</th>
                                                    <th>Views</th>
                                                    <th>Avg views</th>
                                                    <th>Content</th>
                                                    <th>Publish rate</th>
                                                    <th>Moderation</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% rows.forEach(function(row) {
                                                    const grade = getGrade(row.performanceScore);
                                                    const roleClass = row.role === 'Sub Editor' ? 'subeditor' : 'reporter';
                                                    const effClass = row.publishRate > 70 ? 'high' : (row.publishRate > 45 ? 'mid' : 'low');
                                                %>
                                                <tr>
                                                    <td class="fw-bold">#<%= row.rank %></td>
                                                    <td>
                                                        <div class="pa-member-cell">
                                                            <div class="pa-grade <%= grade.cls %>"><%= grade.letter %></div>
                                                            <div>
                                                                <div class="pa-member-name"><%= row.name %></div>
                                                                <div class="pa-member-handle">@<%= row.username %></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td><span class="pa-role-pill <%= roleClass %>"><%= row.role %></span></td>
                                                    <td class="pa-score-cell"><%= row.performanceScore %></td>
                                                    <td class="fw-semibold"><%= (row.totalViews || 0).toLocaleString() %></td>
                                                    <td><%= row.avgViews %></td>
                                                    <td>
                                                        <div class="pa-status-group">
                                                            <span class="pa-status-chip pub"><i class="fas fa-check"></i> <%= row.published %></span>
                                                            <span class="pa-status-chip rej"><i class="fas fa-times"></i> <%= row.rejected %></span>
                                                            <span class="pa-status-chip pend"><i class="fas fa-clock"></i> <%= row.pending %></span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="pa-efficiency">
                                                            <div class="pa-efficiency-bar">
                                                                <div class="pa-efficiency-fill <%= effClass %>" style="width: <%= Math.min(row.publishRate, 100) %>%"></div>
                                                            </div>
                                                            <div class="pa-efficiency-label"><%= row.publishRate %>%</div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="pa-mod-badge"><%= row.moderationLabel %>: <%= row.moderationApproved %></span>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="pa-pagination">
                                        <div class="pa-pagination-info">
                                            Showing <%= totalRows === 0 ? 0 : ((currentPage - 1) * pageLimit) + 1 %>–<%= Math.min(currentPage * pageLimit, totalRows) %> of <%= totalRows %> members
                                            <% if (totalPages > 1) { %> · Page <%= currentPage %> of <%= totalPages %><% } %>
                                        </div>
                                        <% if (totalPages > 1) { %>
                                        <div class="pa-pagination-nav">
                                            <a class="pa-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=1<%= paginationQuery %>" aria-label="First page"><i class="fas fa-angles-left"></i></a>
                                            <a class="pa-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=<%= currentPage - 1 %><%= paginationQuery %>" aria-label="Previous page"><i class="fas fa-angle-left"></i></a>
                                            <% 
                                                let startPage = Math.max(1, currentPage - 2);
                                                let endPage = Math.min(totalPages, currentPage + 2);
                                                if (endPage - startPage < 4) {
                                                    if (startPage === 1) endPage = Math.min(totalPages, startPage + 4);
                                                    else startPage = Math.max(1, endPage - 4);
                                                }
                                                for (let i = startPage; i <= endPage; i++) { %>
                                            <a class="pa-page-btn <%= i === currentPage ? 'active' : '' %>" href="?page=<%= i %><%= paginationQuery %>"><%= i %></a>
                                            <% } %>
                                            <a class="pa-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= currentPage + 1 %><%= paginationQuery %>" aria-label="Next page"><i class="fas fa-angle-right"></i></a>
                                            <a class="pa-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= totalPages %><%= paginationQuery %>" aria-label="Last page"><i class="fas fa-angles-right"></i></a>
                                        </div>
                                        <% } %>
                                    </div>
                                    <% } else { %>
                                    <div class="pa-empty">
                                        <i class="fas fa-chart-bar fa-2x mb-3 d-block"></i>
                                        No performance data found for the selected filters.
                                    </div>
                                    <% } %>
                                </div>

                                <div class="pa-insights">
                                    <h2 class="pa-insights-title"><i class="fas fa-lightbulb me-2 text-warning"></i>Editorial insights (industry benchmarks)</h2>
                                    <div class="pa-insights-grid">
                                        <% (recommendations || []).forEach(function(rec) { %>
                                        <div class="pa-insight-card">
                                            <h3 class="pa-insight-title"><%= rec.title %></h3>
                                            <p class="pa-insight-text"><%= rec.detail %></p>
                                            <div class="pa-insight-source"><%= rec.source %></div>
                                        </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script>
                flatpickr('#datePicker', {
                    mode: 'range',
                    dateFormat: 'Y-m-d',
                    defaultDate: <%= startDate && endDate ? JSON.stringify([startDate, endDate]) : 'null' %>,
                    onClose: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length === 2) {
                            document.getElementById('startDate').value = instance.formatDate(selectedDates[0], 'Y-m-d');
                            document.getElementById('endDate').value = instance.formatDate(selectedDates[1], 'Y-m-d');
                            document.getElementById('analyticsForm').submit();
                        }
                    }
                });
            </script>

            <%- include('partials/footer') %>
    </body>

</html>
