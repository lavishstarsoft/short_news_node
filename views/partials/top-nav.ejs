<!-- Mobile Top Navigation -->
<div class="top-nav d-md-none">
    <% if (typeof backButton !=='undefined' && backButton) { %>
        <button class="menu-toggle ripple" style="color: var(--text-primary);"
            onclick="<%= typeof backUrl !== 'undefined' ? `window.location.href='${backUrl}'` : `window.location.href='/'` %>">
            <i class="fas fa-arrow-left"></i>
        </button>
    <% } else { %>
        <button class="menu-toggle ripple" id="menuToggle" style="color: var(--text-primary);">
            <i class="fas fa-bars"></i>
        </button>
    <% } %>
    <h1 class="page-title">
        <%= typeof pageTitle !=='undefined' ? pageTitle : 'Dashboard' %>
    </h1>
    <div class="mobile-header-icons">
        <% if (typeof actions !=='undefined' && actions && actions.length> 0) { %>
            <% actions.forEach(function(action) { %>
                <button class="menu-toggle ripple" style="color: var(--text-primary);" id="<%= action.id %>Mobile" <%- (action && action.onClick) ? `onclick="${action.onClick}" ` : (action && action.url ? `onclick="window.location.href='${action.url}'" ` : '' ) %>>
                    <i class="<%= action.icon %>"></i>
                </button>
            <% }); %>
        <% } else { %>
            <button class="menu-toggle ripple" style="color: var(--text-primary);" onclick="window.location.href='/admin/profile';">
                <i class="fas fa-user"></i>
            </button>
            <button class="menu-toggle ripple" style="color: var(--text-primary);" onclick="window.location.href='/add-news';">
                <i class="fas fa-plus"></i>
            </button>
        <% } %>
    </div>
</div>

<!-- Desktop Navigation -->
<div class="top-nav d-none d-md-flex">
    <div class="top-nav-left">
        <div class="ds-breadcrumb">
            <span class="ds-breadcrumb-separator"><i class="fas fa-home"></i></span>
            <span class="ds-breadcrumb-separator">/</span>
            <span class="ds-breadcrumb-active"><%= typeof pageTitle !=='undefined' ? pageTitle : 'Dashboard' %></span>
        </div>
    </div>
    
    <div class="top-nav-center">
        <div class="ds-search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" class="ds-search-input" placeholder="Search news, editors...">
        </div>
    </div>

    <div class="top-nav-right">
        <!-- AI Status -->
        <div class="ds-ai-badge">
            <i class="fas fa-sparkles"></i> AI Active
        </div>

        <!-- Dynamic Actions -->
        <% if (typeof actions !=='undefined' && actions && actions.length> 0) { %>
            <% actions.forEach(function(action) { %>
                <button class="btn <%= action.class || 'btn-primary' %> ripple btn-sm" id="<%= action.id %>" <%- (action && action.onClick) ? `onclick="${action.onClick}" ` : (action && action.url ? `onclick="window.location.href='${action.url}'" ` : '' ) %>>
                    <% if (action.icon) { %><i class="<%= action.icon %> me-1"></i><% } %><%= action.text %>
                </button>
            <% }); %>
        <% } else { %>
            <button class="btn btn-primary ripple btn-sm" onclick="window.location.href='/add-news';">
                <i class="fas fa-plus me-1"></i> Add News
            </button>
        <% } %>

        <!-- Notification Bell -->
        <button class="ds-icon-btn" onclick="window.location.href='/admin/notifications';">
            <i class="far fa-bell"></i>
            <span class="ds-badge"></span>
        </button>

        <!-- User Profile -->
        <div class="ds-user-profile" onclick="window.location.href='/admin/profile';">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: var(--bg-canvas); border: 1px solid var(--border-subtle);">
                <i class="fas fa-user" style="color: var(--text-secondary); font-size: 14px;"></i>
            </div>
            <i class="fas fa-chevron-down ms-1" style="color: var(--text-muted); font-size: 10px;"></i>
        </div>
    </div>
</div>