<div class="col-md-3 col-lg-2 d-md-block sidebar" id="sidebar">
    <div class="position-sticky pt-3">
        <div class="sidebar-header text-center py-3 mb-3">
            <h4 class="mb-0">Short News</h4>
            <p class="small mb-0">Admin Dashboard</p>
            <% if (typeof admin !=='undefined' && admin) { %>
                <div class="d-flex align-items-center justify-content-center mt-2">
                    <i class="fas fa-user-circle fa-2x text-white me-2"></i>
                    <div class="text-white text-start">
                        <div class="fw-bold">
                            <%= admin.username %>
                        </div>
                        <div class="small">
                            <%= admin.role %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
        <ul class="nav flex-column">
            <% 
                var canView = function(menu) {
                    if (typeof admin === 'undefined' || !admin) return false;
                    if (admin.role !== 'subeditor') return true;
                    if (!admin.permissions || !admin.permissions.sidebar) {
                        return menu === 'zodiac' ? false : true;
                    }
                    if (menu === 'zodiac') {
                        return admin.permissions.sidebar.zodiac === true;
                    }
                    return admin.permissions.sidebar[menu] !== false;
                };
                const dashboardLink = (typeof isImpersonating !== 'undefined' && isImpersonating && admin) ? `/admin/editors/${admin.id}/dashboard` : '/news';
                const newsListLink = (typeof isImpersonating !== 'undefined' && isImpersonating && admin) ? `/admin/editors/${admin.id}/news-list` : '/news-list';
            %>
            <% if (canView('dashboard') && (typeof isImpersonating === 'undefined' || !isImpersonating)) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'dashboard' ? 'active' : '' %>" href="<%= dashboardLink %>">
                    <i class="fas fa-home me-3"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>
            <% } %>
            <% if (canView('newsList')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'news-list' ? 'active' : '' %>" href="<%= newsListLink %>">
                    <i class="fas fa-newspaper me-3"></i>
                    <span class="nav-text">News List</span>
                </a>
            </li>
            <% } %>
            <% if (canView('addNews')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'add-news' ? 'active' : '' %>" href="/add-news">
                    <i class="fas fa-plus-circle me-3"></i>
                    <span class="nav-text">Add News</span>
                </a>
            </li>
            <% } %>
            <% if (canView('pendingNews')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'pending-news' ? 'active' : '' %>" href="/admin/pending-news">
                    <i class="fas fa-inbox me-3"></i>
                    <span class="nav-text">Pending News</span>
                    <span class="badge bg-warning ms-2">Review</span>
                </a>
            </li>
            <% } %>
            <% if (canView('rejectedNews')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'rejected-news' ? 'active' : '' %>" href="/admin/rejected-news">
                    <i class="fas fa-trash me-3"></i>
                    <span class="nav-text">Rejected News</span>
                </a>
            </li>
            <% } %>
            <% if (canView('plagiarismReport')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'plagiarism-report' ? 'active' : '' %>" href="/admin/plagiarism-report">
                    <i class="fas fa-fingerprint me-3"></i>
                    <span class="nav-text">Plagiarism Report</span>
                </a>
            </li>
            <% } %>
            <% if (canView('viralVideos')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'viral-videos' ? 'active' : '' %>" href="/viral-videos">
                    <i class="fas fa-video me-3"></i>
                    <span class="nav-text">Viral Videos</span>
                </a>
            </li>
            <% } %>
            <% if (canView('polls')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'polls' ? 'active' : '' %>" href="/admin/polls">
                    <i class="fas fa-poll me-3"></i>
                    <span class="nav-text">Polls</span>
                </a>
            </li>
            <% } %>
            <% if (canView('zodiac')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'zodiac' ? 'active' : '' %>" href="/admin/zodiac">
                    <i class="fas fa-calendar-alt me-3"></i>
                    <span class="nav-text">Zodiac Calendar</span>
                </a>
            </li>
            <% } %>
            <% if (canView('longVideos')) { %>
            <li class="nav-item">
                <a class="nav-link ripple <%= activePage === 'long-videos' ? 'active' : '' %>" href="/long-videos">
                    <i class="fas fa-tv me-3"></i>
                    <span class="nav-text">Long Videos / Programs</span>
                </a>
            </li>
            <% } %>
            <% if (typeof admin !=='undefined' && admin && admin.role && (admin.role==='admin' ||
                admin.role==='superadmin' )) { %>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'ads' ? 'active' : '' %>" href="/ads/ads">
                        <i class="fas fa-ad me-3"></i>
                        <span class="nav-text">Ads Management</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'intelligent-ads' ? 'active' : '' %>"
                        href="/intelligent-ads">
                        <i class="fas fa-brain me-3"></i>
                        <span class="nav-text">Intelligent Ads</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'register-editor' ? 'active' : '' %>"
                        href="/register-editor">
                        <i class="fas fa-user-plus me-3"></i>
                        <span class="nav-text">Register Editor</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'registration-fields' ? 'active' : '' %>"
                        href="/registration-fields">
                        <i class="fas fa-list-alt me-3"></i>
                        <span class="nav-text">Form Registration</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'reporter-applications' ? 'active' : '' %>"
                        href="/reporter-applications">
                        <i class="fas fa-clipboard-list me-3"></i>
                        <span class="nav-text">Reporter Applications</span>
                        <span class="badge bg-info ms-2">New</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'editors' ? 'active' : '' %>" href="/editors">
                        <i class="fas fa-users me-3"></i>
                        <span class="nav-text">Editors</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'command-center' ? 'active' : '' %>" href="/admin/command-center">
                        <i class="fas fa-satellite-dish me-3"></i>
                        <span class="nav-text">Command Center</span>
                        <span class="badge bg-danger ms-2">New</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'performance-analytics' ? 'active' : '' %>" href="/admin/performance-analytics">
                        <i class="fas fa-chart-line me-3"></i>
                        <span class="nav-text">Performance Analytics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ripple <%= activePage === 'users' ? 'active' : '' %>" href="/admin/users">
                        <i class="fas fa-users me-3"></i>
                        <span class="nav-text">Users</span>
                    </a>
                </li>
            <% } %>
            <% if (canView('categories')) { %>
                    <li class="nav-item">
                        <a class="nav-link ripple <%= activePage === 'categories' ? 'active' : '' %>"
                            href="/categories">
                            <i class="fas fa-list me-3"></i>
                            <span class="nav-text">Categories</span>
                        </a>
                    </li>
            <% } %>
            <% if (canView('programCategories')) { %>
                    <li class="nav-item">
                        <a class="nav-link ripple <%= activePage === 'program-categories' ? 'active' : '' %>"
                            href="/categories?type=program">
                            <i class="fas fa-list-alt me-3"></i>
                            <span class="nav-text">Program Categories</span>
                        </a>
                    </li>
            <% } %>
            <% if (canView('locations')) { %>
                    <li class="nav-item">
                        <a class="nav-link ripple <%= activePage === 'locations' ? 'active' : '' %>" href="/locations">
                            <i class="fas fa-map-marker-alt me-3"></i>
                            <span class="nav-text">Locations</span>
                        </a>
                    </li>
            <% } %>
                    <% if (typeof admin !=='undefined' && admin && admin.role && (admin.role==='admin' ||
                        admin.role==='superadmin' )) { %>
                        <li class="nav-item">
                            <a class="nav-link ripple <%= activePage === 'languages' ? 'active' : '' %>" href="/languages">
                                <i class="fas fa-language me-3"></i>
                                <span class="nav-text">Languages</span>
                            </a>
                        </li>
                    <% } %>
            <% if (canView('reports')) { %>
                    <li class="nav-item">
                        <a class="nav-link ripple <%= activePage === 'reports' ? 'active' : '' %>"
                            href="/admin/reports">
                            <i class="fas fa-flag me-3"></i>
                            <span class="nav-text">Reports</span>
                        </a>
                    </li>
            <% } %>

                    <% if (typeof admin !=='undefined' && admin && admin.role && (admin.role==='admin' ||
                        admin.role==='superadmin' || (admin.role==='subeditor' && admin.permissions && admin.permissions.canSendNotifications))) { %>
                        <li class="nav-item">
                            <a class="nav-link ripple <%= activePage === 'notifications' ? 'active' : '' %>"
                                href="/admin/notifications">
                                <i class="fas fa-bell me-3"></i>
                                <span class="nav-text">Send Notification</span>
                            </a>
                        </li>
                    <% } %>
                    
                    <% if (typeof admin !=='undefined' && admin && admin.role && (admin.role==='admin' ||
                        admin.role==='superadmin' )) { %>
                        <li class="nav-item">
                            <a class="nav-link ripple <%= activePage === 'onesignal-analytics' ? 'active' : '' %>"
                                href="/admin/onesignal-analytics">
                                <i class="fas fa-chart-bar me-3"></i>
                                <span class="nav-text">OneSignal Analytics</span>
                            </a>
                        </li>
                    <% } %>
                    <% if (typeof admin !=='undefined' && admin && admin.role && (admin.role==='admin' ||
                        admin.role==='superadmin' )) { %>
                        <li class="nav-item">
                            <a class="nav-link ripple <%= activePage === 'app-settings' ? 'active' : '' %>"
                                href="/admin/app-settings">
                                <i class="fas fa-mobile-alt me-3"></i>
                                <span class="nav-text">App Settings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ripple <%= activePage === 'r2-usage' ? 'active' : '' %>"
                                href="/admin/r2-usage">
                                <i class="fas fa-cloud me-3"></i>
                                <span class="nav-text">R2 Usage</span>
                            </a>
                        </li>
                    <% } %>
                            <li class="nav-item">
                                <a class="nav-link ripple <%= activePage === 'profile' ? 'active' : '' %>"
                                    href="/admin/profile">
                                    <i class="fas fa-user me-3"></i>
                                    <span class="nav-text">Profile</span>
                                </a>
                            </li>
                            <li class="nav-item mt-3">
                                <a class="nav-link ripple" href="/logout">
                                    <i class="fas fa-sign-out-alt me-3"></i>
                                    <span class="nav-text">Logout</span>
                                </a>
                            </li>
        </ul>
        <div class="sidebar-footer text-center py-3 mt-3">
            <small class="text-white">© 2025 Short News</small>
        </div>
    </div>

    <!-- Sidebar JS can go here if specific to sidebar -->
</div>