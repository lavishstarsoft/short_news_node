<link rel="stylesheet" href="/css/sidebar-standard.css?v=2">
<div class="col-md-3 col-lg-2 d-md-block sidebar" id="sidebar">
    <div class="position-sticky pt-0 pb-0 d-flex flex-column h-100">
        <div class="sidebar-header">
            <h4><i class="fas fa-layer-group logo-icon"></i> Tehelka News</h4>
        </div>
        
        <% if (typeof admin !=='undefined' && admin) { %>
            <div class="sidebar-profile-card">
                <i class="fas fa-plus"></i>
                <div class="text-start">
                    <div class="fw-bold"><%= admin.name || admin.username %></div>
                </div>
            </div>
        <% } %>

        <ul class="nav flex-column flex-nowrap flex-grow-1 overflow-auto" id="sidebarAccordion">
            <% 
                var canView = function(menu) {
                    if (typeof admin === 'undefined' || !admin) return false;
                    if (admin.role !== 'subeditor') return true;
                    if (!admin.permissions || !admin.permissions.sidebar) {
                        return menu === 'zodiac' ? false : true;
                    }
                    if (menu === 'zodiac') {
                        return admin.permissions.sidebar.zodiac === true;
                    }
                    return admin.permissions.sidebar[menu] !== false;
                };
                
                const isAdmin = typeof admin !=='undefined' && admin && (admin.role==='admin' || admin.role==='superadmin');
                const isReporter = typeof admin !=='undefined' && admin && admin.role==='reporter';

                const dashboardLink = (typeof isImpersonating !== 'undefined' && isImpersonating && admin) ? `/admin/editors/${admin.id}/dashboard` : '/news';
                const newsListLink = (typeof isImpersonating !== 'undefined' && isImpersonating && admin) ? `/admin/editors/${admin.id}/news-list` : '/news-list';
            %>

            <!-- ==============================
                 MAIN NAVIGATION
            =============================== -->
            <div class="nav-section-title">Main Navigation</div>

            <% if (canView('dashboard') && (typeof isImpersonating === 'undefined' || !isImpersonating)) { %>
            <li class="nav-item nav-item-standalone">
                <a class="nav-link ripple <%= activePage === 'dashboard' ? 'active' : '' %>" href="<%= dashboardLink %>">
                    <i class="fas fa-home me-3"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>
            <% } %>

            <%# State In-Charge (subeditor) link to the existing Reporter Access page.
                Admin/superadmin already reach it via the System group below — this only
                surfaces it for subeditors, who the controller already authorizes. %>
            <% if (typeof admin !== 'undefined' && admin && admin.role === 'subeditor') { %>
            <li class="nav-item nav-item-standalone">
                <a class="nav-link ripple <%= activePage === 'reporter-access' ? 'active' : '' %>" href="/admin/reporter-access">
                    <i class="fas fa-key me-3"></i>
                    <span class="nav-text">Reporter Access</span>
                </a>
            </li>
            <li class="nav-item nav-item-standalone">
                <a class="nav-link ripple <%= activePage === 'coverage-map' ? 'active' : '' %>" href="/admin/coverage-map">
                    <i class="fas fa-map-location-dot me-3"></i>
                    <span class="nav-text">Coverage Map</span>
                </a>
            </li>
            <% } %>

            <!-- News & Content Group -->
            <% 
                const showNewsGroup = canView('addNews') || canView('newsList') || canView('pendingNews') || canView('rejectedNews') || canView('plagiarismReport');
                const newsGroupActive = ['add-news', 'news-list', 'pending-news', 'my-ai-queue', 'rejected-news', 'plagiarism-report'].includes(activePage);
            %>
            <% if (showNewsGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= newsGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseNews" role="button" aria-expanded="<%= newsGroupActive ? 'true' : 'false' %>" aria-controls="collapseNews">
                    <i class="fas fa-newspaper me-3 w-20px text-center"></i>
                    <span class="nav-text">News & Content</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= newsGroupActive ? 'show' : '' %>" id="collapseNews" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (canView('addNews')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'add-news' ? 'active' : '' %>" href="/add-news">Add News</a>
                        </li>
                        <% } %>
                        <% if (canView('newsList')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'news-list' ? 'active' : '' %>" href="<%= newsListLink %>">News List</a>
                        </li>
                        <% } %>
                        <% if (canView('pendingNews')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'pending-news' ? 'active' : '' %>" href="/admin/pending-news">
                                Pending News
                                
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'my-ai-queue' ? 'active' : '' %>" href="/admin/my-ai-queue">
                                My AI Queue
                            </a>
                        </li>
                        <% } %>
                        <% if (canView('rejectedNews')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'rejected-news' ? 'active' : '' %>" href="/admin/rejected-news">Rejected News</a>
                        </li>
                        <% } %>
                        <% if (canView('plagiarismReport')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'plagiarism-report' ? 'active' : '' %>" href="/admin/plagiarism-report">Plagiarism Report</a>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- AI Insights (Super Admin only) -->
            <% 
                const isSuperAdminOnly = typeof admin !== 'undefined' && admin && admin.role === 'superadmin';
                const aiInsightsActive = ['ai-insights-duplicate'].includes(activePage);
            %>
            <% if (isSuperAdminOnly) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= aiInsightsActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseAiInsights" role="button" aria-expanded="<%= aiInsightsActive ? 'true' : 'false' %>" aria-controls="collapseAiInsights">
                    <i class="fas fa-brain me-3 w-20px text-center"></i>
                    <span class="nav-text">AI Insights</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= aiInsightsActive ? 'show' : '' %>" id="collapseAiInsights" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'ai-insights-duplicate' ? 'active' : '' %>" href="/admin/ai-insights/duplicate-news">
                                Duplicate News Insights
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- View Engine (Super Admin only) -->
            <% 
                const viewEngineActive = ['view-engine-dashboard', 'view-engine-campaigns', 'view-engine-status', 'view-engine-settings'].includes(activePage);
            %>
            <% if (isSuperAdminOnly) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= viewEngineActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseViewEngine" role="button" aria-expanded="<%= viewEngineActive ? 'true' : 'false' %>" aria-controls="collapseViewEngine">
                    <i class="fas fa-server me-3 w-20px text-center"></i>
                    <span class="nav-text">View Engine</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= viewEngineActive ? 'show' : '' %>" id="collapseViewEngine" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'view-engine-dashboard' ? 'active' : '' %>" href="/view-engine/dashboard">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'view-engine-campaigns' ? 'active' : '' %>" href="/view-engine/campaigns">
                                Campaigns
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'view-engine-status' ? 'active' : '' %>" href="/view-engine/status">
                                Status
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'view-engine-settings' ? 'active' : '' %>" href="/view-engine/settings">
                                Settings
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- Media & Entertainment Group -->
            <% 
                const showMediaGroup = canView('viralVideos') || canView('longVideos') || canView('polls') || canView('zodiac');
                const mediaGroupActive = ['viral-videos', 'long-videos', 'polls', 'zodiac'].includes(activePage);
            %>
            <% if (showMediaGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= mediaGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseMedia" role="button" aria-expanded="<%= mediaGroupActive ? 'true' : 'false' %>" aria-controls="collapseMedia">
                    <i class="fas fa-photo-video me-3 w-20px text-center"></i>
                    <span class="nav-text">Media & Media</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= mediaGroupActive ? 'show' : '' %>" id="collapseMedia" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (canView('viralVideos')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'viral-videos' ? 'active' : '' %>" href="/viral-videos">Viral Videos</a>
                        </li>
                        <% } %>
                        <% if (canView('longVideos')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'long-videos' ? 'active' : '' %>" href="/long-videos">Long Videos</a>
                        </li>
                        <% } %>
                        <% if (canView('polls')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'polls' ? 'active' : '' %>" href="/admin/polls">Polls</a>
                        </li>
                        <% } %>
                        <% if (canView('zodiac')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'zodiac' ? 'active' : '' %>" href="/admin/zodiac">Zodiac Calendar</a>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- Categories & Locations Group -->
            <% 
                const showCatsGroup = canView('categories') || canView('programCategories') || canView('locations') || isAdmin;
                const catsGroupActive = ['categories', 'program-categories', 'locations', 'languages'].includes(activePage);
            %>
            <% if (showCatsGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= catsGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseCats" role="button" aria-expanded="<%= catsGroupActive ? 'true' : 'false' %>" aria-controls="collapseCats">
                    <i class="fas fa-tags me-3 w-20px text-center"></i>
                    <span class="nav-text">Categories & Regions</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= catsGroupActive ? 'show' : '' %>" id="collapseCats" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (canView('categories')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'categories' ? 'active' : '' %>" href="/categories">News Categories</a>
                        </li>
                        <% } %>
                        <% if (canView('programCategories')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'program-categories' ? 'active' : '' %>" href="/categories?type=program">Program Categories</a>
                        </li>
                        <% } %>
                        <% if (canView('locations')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'locations' ? 'active' : '' %>" href="/locations">Locations</a>
                        </li>
                        <% } %>
                        <% if (isAdmin) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'languages' ? 'active' : '' %>" href="/languages">Languages</a>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </li>
            <% } %>


            <!-- ==============================
                 MANAGEMENT
            =============================== -->
            <% if (isAdmin) { %>
            <div class="nav-section-title">Management</div>
            <% } %>

            <!-- Team & Roles Group -->
            <% 
                const showTeamGroup = isAdmin; 
                const teamGroupActive = ['editors', 'register-editor', 'staff-categories'].includes(activePage);
            %>
            <% if (showTeamGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= teamGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseTeam" role="button" aria-expanded="<%= teamGroupActive ? 'true' : 'false' %>" aria-controls="collapseTeam">
                    <i class="fas fa-user-tie me-3 w-20px text-center"></i>
                    <span class="nav-text">Team & Staff</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= teamGroupActive ? 'show' : '' %>" id="collapseTeam" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (isAdmin) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'editors' ? 'active' : '' %>" href="/editors">All Staff (Editors)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'register-editor' ? 'active' : '' %>" href="/register-editor">Register New Staff</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'staff-categories' ? 'active' : '' %>" href="/staff-categories">Staff Categories</a>
                        </li>
                        <% } else if (canView('editors')) { %>
                            <li class="nav-item">
                                <a class="nav-link <%= activePage === 'editors' ? 'active' : '' %>" href="/editors">All Staff</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- Reporters Group -->
            <% 
                const showReportersGroup = isAdmin;
                const reportersGroupActive = ['reporter-analytics', 'news-map', 'fraud-alerts', 'reporter-applications', 'reporter-home-content', 'reporter-guidelines', 'reporter-earning', 'reporter-popups'].includes(activePage);
            %>
            <% if (showReportersGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= reportersGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseReporters" role="button" aria-expanded="<%= reportersGroupActive ? 'true' : 'false' %>" aria-controls="collapseReporters">
                    <i class="fas fa-id-badge me-3 w-20px text-center"></i>
                    <span class="nav-text">Reporters</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= reportersGroupActive ? 'show' : '' %>" id="collapseReporters" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center <%= activePage === 'reporter-analytics' ? 'active' : '' %>" href="/admin/reporter-analytics">
                                Analytics 
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center <%= activePage === 'news-map' ? 'active' : '' %>" href="/admin/news-map">
                                News Map 
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center <%= activePage === 'fraud-alerts' ? 'active' : '' %>" href="/admin/fraud-alerts">
                                Fraud Alerts 
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reporter-applications' ? 'active' : '' %>" href="/reporter-applications">Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reporter-home-content' ? 'active' : '' %>" href="/admin/reporter-home-content">Home Content</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reporter-guidelines' ? 'active' : '' %>" href="/admin/reporter-guidelines">Guidelines</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reporter-earning' ? 'active' : '' %>" href="/admin/reporter-earning">Earning Page</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center <%= activePage === 'reporter-popups' ? 'active' : '' %>" href="/admin/popups">
                                In-App Popups 
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- Users Group -->
            <% 
                const showUsersGroup = isAdmin;
                const usersGroupActive = ['users', 'registration-fields', 'referrals'].includes(activePage);
            %>
            <% if (showUsersGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= usersGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseUsers" role="button" aria-expanded="<%= usersGroupActive ? 'true' : 'false' %>" aria-controls="collapseUsers">
                    <i class="fas fa-users me-3 w-20px text-center"></i>
                    <span class="nav-text">App Users</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= usersGroupActive ? 'show' : '' %>" id="collapseUsers" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'users' ? 'active' : '' %>" href="/admin/users">Users List</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'registration-fields' ? 'active' : '' %>" href="/registration-fields">Form Registration</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'referrals' ? 'active' : '' %>" href="/admin/referrals">Refer & Earn Data</a>
                        </li>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- Advertisements Group -->
            <% 
                const showAdsGroup = isAdmin;
                const adsGroupActive = ['ads', 'intelligent-ads'].includes(activePage);
            %>
            <% if (showAdsGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= adsGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseAds" role="button" aria-expanded="<%= adsGroupActive ? 'true' : 'false' %>" aria-controls="collapseAds">
                    <i class="fas fa-ad me-3 w-20px text-center"></i>
                    <span class="nav-text">Advertisements</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= adsGroupActive ? 'show' : '' %>" id="collapseAds" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'ads' ? 'active' : '' %>" href="/ads/ads">Ads Management</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'intelligent-ads' ? 'active' : '' %>" href="/intelligent-ads">Intelligent Ads</a>
                        </li>
                    </ul>
                </div>
            </li>
            <% } %>


            <!-- ==============================
                 SYSTEM & FINANCIAL
            =============================== -->
            <% 
                const showAnalyticsGroup = canView('reports') || isAdmin;
                const analyticsGroupActive = ['reports', 'performance-analytics', 'onesignal-analytics'].includes(activePage);

                const canSendNotif = isAdmin || (typeof admin !=='undefined' && admin.role==='subeditor' && admin.permissions && admin.permissions.canSendNotifications);
                const showSystemGroup = isAdmin || canSendNotif;
                const systemGroupActive = ['command-center', 'security', 'security-center', 'notifications', 'app-settings', 'r2-usage', 'agreement-terms', 'agreement-status', 'reporter-district-assignment', 'late-earnings', 'reporter-access', 'coverage-map'].includes(activePage);

                const showFinanceGroup = isAdmin || isReporter;
                const financeActive = ['wallet-settings', 'my-wallet', 'withdrawals-queue', 'wallet-transactions', 'audit-logs', 'monthly-report'].includes(activePage); 
            %>
            <% if (showAnalyticsGroup || showSystemGroup || showFinanceGroup) { %>
            <div class="nav-section-title">System & Financial</div>
            <% } %>

            <!-- Analytics & Reports Group -->
            <% if (showAnalyticsGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= analyticsGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseAnalytics" role="button" aria-expanded="<%= analyticsGroupActive ? 'true' : 'false' %>" aria-controls="collapseAnalytics">
                    <i class="fas fa-chart-line me-3 w-20px text-center"></i>
                    <span class="nav-text">Analytics & Reports</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= analyticsGroupActive ? 'show' : '' %>" id="collapseAnalytics" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (canView('reports')) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reports' ? 'active' : '' %>" href="/admin/reports">General Reports</a>
                        </li>
                        <% } %>
                        <% if (isAdmin) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'performance-analytics' ? 'active' : '' %>" href="/admin/performance-analytics">Performance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'onesignal-analytics' ? 'active' : '' %>" href="/admin/onesignal-analytics">OneSignal</a>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </li>
            <% } %>

            <!-- System Configuration Group -->
            <% if (showSystemGroup) { %>
            <li class="nav-item">
                <a class="nav-link has-submenu <%= systemGroupActive ? '' : 'collapsed' %>" data-bs-toggle="collapse" href="#collapseSystem" role="button" aria-expanded="<%= systemGroupActive ? 'true' : 'false' %>" aria-controls="collapseSystem">
                    <i class="fas fa-cogs me-3 w-20px text-center"></i>
                    <span class="nav-text">System & Security</span>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </a>
                <div class="collapse submenu-collapse <%= systemGroupActive ? 'show' : '' %>" id="collapseSystem" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <% if (canSendNotif) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'notifications' ? 'active' : '' %>" href="/admin/notifications">Send Notification</a>
                        </li>
                        <% } %>
                        <% if (isAdmin) { %>
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center <%= activePage === 'command-center' ? 'active' : '' %>" href="/admin/command-center">
                                Command Center 
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'security' ? 'active' : '' %>" href="/admin/security">Security & Fraud</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'security-center' ? 'active' : '' %>" href="/admin/security-center">Security Center</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'app-settings' ? 'active' : '' %>" href="/admin/app-settings">App Settings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'r2-usage' ? 'active' : '' %>" href="/admin/r2-usage">R2 CDN Usage</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'agreement-status' ? 'active' : '' %>" href="/admin/agreement-status">Agreement Status</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'reporter-district-assignment' ? 'active' : '' %>" href="/admin/reporter-district-assignment">Reporter District Assign</a>
                        </li>
                        <% } %>
                        <% if (isSuperAdminOnly) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= activePage === 'agreement-terms' ? 'active' : '' %>" href="/admin/agreement-terms">Agreement T&amp;C</a>
                        </li>
                        <li class="nav-item">
