<script>
function toggleQuizHelp() {
  const modal = document.getElementById('quizHelpModal');
  if (modal.classList.contains('show')) {
    modal.classList.remove('show');
    document.body.style.overflow = '';
  } else {
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
  }
}

function switchQHelp(e, sectionId) {
  e.preventDefault();
  document.querySelectorAll('.q-help-sidebar a').forEach(a => a.classList.remove('active'));
  e.target.classList.add('active');
  
  document.querySelectorAll('.q-help-section').forEach(s => s.classList.remove('active'));
  document.getElementById(sectionId).classList.add('active');
  
  // Scroll content to top
  document.querySelector('.q-help-content').scrollTop = 0;
}

// Close on ESC
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    const modal = document.getElementById('quizHelpModal');
    if (modal && modal.classList.contains('show')) {
      toggleQuizHelp();
    }
  }
});
</script>
