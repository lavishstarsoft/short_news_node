<% 
  const editorLangLabels = typeof newsLanguageLabels !== 'undefined'
    ? newsLanguageLabels
    : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' };
  const hasLanguageSet = editor.workingLanguage && String(editor.workingLanguage).trim() !== '';
  const initials = (editor.name || editor.username).split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
  const isSubEditor = editor.role === 'subeditor';
  const displayTitle = (editor.displayRole || '').trim();
  const rowId = editor._id.toString();
%>
<tr id="editor-row-<%= rowId %>"
    class="staff-row"
    data-role="<%= editor.role %>"
    data-language="<%= editor.workingLanguage || '' %>"
    data-search="<%= ((editor.name || '') + ' ' + (editor.username || '') + ' ' + (editor.email || '') + ' ' + (editor.assignedLocations ? editor.assignedLocations.join(' ') : (editor.location || '')) + ' ' + (editor.displayRole || '')).toLowerCase() %>">
  <td style="width: 40px; text-align: center;">
    <input type="checkbox" class="form-check-input editor-select-checkbox" value="<%= rowId %>">
  </td>
  <td>
    <div class="team-member">
      <% if (editor.profileImage) { %>
        <img src="<%= editor.profileImage %>" class="team-avatar" alt="">
      <% } else { %>
        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(editor.name || editor.username || 'User') %>&background=E31E24&color=fff&size=200" class="team-avatar" alt="">
      <% } %>
      <div>
        <div class="team-member-name"><%= editor.name || editor.username %></div>
        <div class="team-member-meta"><%= displayTitle || (isSubEditor ? 'Sub-Editor' : 'Reporter') %> · @<%= editor.username %></div>
        <div class="team-member-email" title="<%= editor.email %>"><%= editor.email %></div>
      </div>
    </div>
  </td>
  <td>
    <span class="team-badge <%= isSubEditor ? 'team-badge-sub' : 'team-badge-reporter' %>">
      <%= isSubEditor ? 'Sub-Editor' : 'Reporter' %>
    </span>
  </td>
  <td><%= (editor.assignedLocations && editor.assignedLocations.length > 0) ? editor.assignedLocations.join(', ') : (editor.location || 'Pan India') %></td>
  <td>
    <% if (hasLanguageSet) { %>
      <span class="team-badge team-badge-lang"><%= editorLangLabels[editor.workingLanguage] || editor.workingLanguage %></span>
    <% } else { %>
      <span class="team-badge team-badge-warn">Not set</span>
    <% } %>
  </td>
  <td class="team-metric"><div class="team-metric-val"><%= editor.newsStats?.today || 0 %></div><div class="team-metric-lbl">Today</div></td>
  <td class="team-metric"><div class="team-metric-val"><%= editor.newsStats?.weekly || 0 %></div><div class="team-metric-lbl">7 Days</div></td>
  <td class="team-metric"><div class="team-metric-val"><%= editor.newsStats?.published || 0 %></div><div class="team-metric-lbl">Published</div></td>
  <td class="team-metric team-metric-range" id="range-pill-<%= rowId %>" onclick="document.getElementById('picker-<%= rowId %>')._flatpickr.open()">
    <div class="team-metric-val"><span id="count-<%= rowId %>">—</span></div>
    <div class="team-metric-lbl">Range</div>
    <input type="text" id="picker-<%= rowId %>" class="range-picker-input" style="visibility:hidden;position:absolute;width:0;height:0;" data-id="<%= rowId %>">
  </td>
  <td>
    <span class="team-badge <%= editor.isActive ? 'team-badge-active' : 'team-badge-locked' %>">
      <%= editor.isActive ? 'Active' : 'Locked' %>
    </span>
  </td>
  <td class="text-end">
    <div class="dropdown">
      <button class="team-actions-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-ellipsis-vertical"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end team-dropdown-menu">
        <li>
          <a class="dropdown-item" href="/admin/editors/<%= editor._id %>/news-list<%= editor.role === 'subeditor' ? '?tab=team-list' : '' %>" target="_blank">
            <i class="fas fa-eye me-2"></i>View News List
          </a>
        </li>

        <li><a class="dropdown-item" href="/admin/performance-analytics?authorId=<%= rowId %>"><i class="fas fa-chart-line me-2"></i>Analytics</a></li>
        <li><a class="dropdown-item" href="#" onclick="openEditEditorModal('<%= rowId %>'); return false;"><i class="fas fa-pen me-2"></i>Edit profile</a></li>
        <li><a class="dropdown-item" href="#" onclick="showEditorInsightsById('<%= rowId %>'); return false;"><i class="fas fa-chart-bar me-2"></i>Insights</a></li>
        <li><a class="dropdown-item" href="#" onclick="openPasswordModal('<%= rowId %>'); return false;"><i class="fas fa-key me-2"></i>Change password</a></li>
        <li><a class="dropdown-item" href="#" onclick="toggleEditorStatus('<%= rowId %>', <%= editor.isActive ? 'true' : 'false' %>); return false;"><i class="fas fa-lock me-2"></i><%= editor.isActive ? 'Lock account' : 'Unlock account' %></a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger" href="#" onclick="deleteEditor('<%= rowId %>'); return false;"><i class="fas fa-trash me-2"></i>Remove user</a></li>
      </ul>
    </div>
  </td>
</tr>
