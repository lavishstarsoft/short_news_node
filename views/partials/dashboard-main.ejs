                            <% 
                                const dashTotal = typeof totalNewsCount !== 'undefined' ? totalNewsCount : (typeof newsList !== 'undefined' ? newsList.length : 0);
                                const dashActive = typeof activeNewsCount !== 'undefined' ? activeNewsCount : 0;
                                const dashInactive = typeof inactiveNewsCount !== 'undefined' ? inactiveNewsCount : 0;
                                const dashPending = typeof pendingNewsCount !== 'undefined' ? pendingNewsCount : 0;
                                const dashToday = typeof todaysNewsCount !== 'undefined' ? todaysNewsCount : 0;
                                const dashViews = typeof totalViews !== 'undefined' ? totalViews : 0;
                                const dashActivePct = dashTotal > 0 ? Math.round((dashActive / dashTotal) * 100) : 0;
                                const dashPendingPct = dashTotal > 0 ? Math.round((dashPending / dashTotal) * 100) : 0;
                                const dashInactivePct = dashTotal > 0 ? Math.round((dashInactive / dashTotal) * 100) : 0;
                                let dashRecentLikes = 0, dashRecentComments = 0;
                                if (typeof newsList !== 'undefined' && newsList.length) {
                                    newsList.forEach(function(n) {
                                        dashRecentLikes += (n.likes || 0);
                                        dashRecentComments += (n.comments || 0);
                                    });
                                }
                                const dashIsEditor = typeof admin !== 'undefined' && admin && admin.role === 'editor';
                                const dashIsSubEditor = typeof admin !== 'undefined' && admin && admin.role === 'subeditor';
                                const dashAdminName = typeof admin !== 'undefined' && admin ? (admin.name || admin.username || 'User') : 'User';
                            %>
                            <div class="dash-page content-area mt-4">
                                <% if (!dashIsSubEditor) { %>
                                <header class="ds-page-header" style="padding: 0 0 24px 0; margin-bottom: 24px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                                    <div>
                                        <h1 style="color: var(--text-primary); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 4px 0;">News Intelligence Dashboard</h1>
                                        <p style="color: var(--text-secondary); font-size: 14px; margin: 0; max-width: 600px;">Welcome back, <%= dashAdminName %>. Monitor your content pipeline, live broadcast, and regional distribution in one place.</p>
                                    </div>
                                    <div class="ds-header-actions">
                                        <a href="/add-news" class="btn btn-primary"><i class="fas fa-plus"></i> New article</a>
                                        <a href="/news-list" class="btn btn-secondary"><i class="fas fa-newspaper"></i> News library</a>
                                        <% if (!dashIsEditor) { %>
                                        <a href="/admin/pending-news" class="btn btn-secondary"><i class="fas fa-clock"></i> Pending (<%= dashPending %>)</a>
                                        <% } %>
                                    </div>
                                </header>
                                <% } %>

                                <!-- ============ SCOPED PERFORMANCE ANALYTICS ============ -->
                                <style>
                                    .sd-page { --sd-blue:var(--color-primary); --sd-green:var(--emerald-500); --sd-red:var(--rose-500); --sd-orange:var(--amber-500); --sd-purple:var(--purple-600); --sd-ink:var(--text-primary); --sd-muted:var(--text-secondary); --sd-border:var(--border-subtle); margin-bottom:28px; }
                                    .sd-page * { box-sizing:border-box; }
                                    .sd-card { background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); box-shadow:var(--shadow-sm); }

                                    /* Header */
                                    .sd-header { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
                                    .sd-header h1 { font-size:18px; font-weight:600; color:var(--text-primary); margin:0; letter-spacing:-.01em; }
                                    .sd-header .sd-sub { font-size:13px; color:var(--text-secondary); margin:3px 0 0; }
                                    .sd-header-right { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
                                    .sd-range-pill { display:inline-flex; align-items:center; gap:8px; background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:6px 12px; font-size:13px; font-weight:500; color:var(--text-primary); }
                                    .sd-range-pill i { color:var(--color-primary); }
                                    .sd-refresh { display:inline-flex; align-items:center; gap:6px; background:var(--bg-surface); color:var(--text-primary); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:6px 12px; font-size:13px; font-weight:500; cursor:pointer; transition:.15s; box-shadow:var(--shadow-sm); }
                                    .sd-refresh:hover { background:var(--slate-50); border-color:var(--border-strong); }
                                    .sd-viewas select { border:1px solid var(--border-subtle); background:var(--bg-surface); border-radius:var(--radius-md); padding:6px 10px; font-size:13px; font-weight:500; color:var(--text-primary); max-width: 140px; text-overflow: ellipsis; }

                                    /* Filter tabs */
                                    .sd-tabs { display:inline-flex; gap:2px; background:var(--slate-100); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:4px; flex-wrap:wrap; margin-bottom:18px; }
                                    .sd-tab { border:none; background:transparent; color:var(--text-secondary); font-size:13px; font-weight:500; padding:6px 12px; border-radius:var(--radius-sm); cursor:pointer; transition:.15s; white-space:nowrap; }
                                    .sd-tab:hover { color:var(--text-primary); }
                                    .sd-tab.active { background:var(--bg-surface); color:var(--text-primary); box-shadow:var(--shadow-sm); font-weight:600; }
                                    .sd-custom { display:none; gap:8px; align-items:center; margin:-8px 0 18px; }
                                    .sd-custom.show { display:flex; flex-wrap:wrap; }
                                    .sd-custom input { border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:6px 10px; font-size:13px; color:var(--text-primary); background:var(--bg-surface); }
                                    .sd-custom .sd-apply { border:none; background:var(--color-primary); color:#fff; font-size:13px; font-weight:500; padding:7px 16px; border-radius:var(--radius-md); cursor:pointer; }
                                    
                                    /* Mobile Scrolling Action Bars */
                                    .ds-header-actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
                                    .btn { white-space: nowrap; flex-shrink: 0; }
                                    @media (max-width: 600px) {
                                        .ds-header-actions, .sd-header-right, .sd-tabs { 
                                            flex-wrap: nowrap !important; 
                                            overflow-x: auto; 
                                            -webkit-overflow-scrolling: touch; 
                                            scrollbar-width: none; 
                                            padding-bottom: 8px;
                                            margin-bottom: 4px;
                                        }
                                        .ds-header-actions::-webkit-scrollbar, 
                                        .sd-header-right::-webkit-scrollbar, 
                                        .sd-tabs::-webkit-scrollbar { display: none; }
                                        .ds-header-actions { margin-left: -16px; margin-right: -16px; padding-left: 16px; padding-right: 16px; }
                                        .sd-header-right { margin-left: -16px; margin-right: -16px; padding-left: 16px; padding-right: 16px; }
                                        .sd-tabs { margin-left: -16px; margin-right: -16px; padding-left: 16px; padding-right: 16px; display: flex; width: auto; }
                                    }

                                    /* Summary cards */
                                    .sd-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:16px; margin-bottom:24px; }
                                    .sd-stat { padding:20px; display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
                                    .sd-stat-num { font-size:24px; font-weight:600; color:var(--sd-ink); line-height:1.1; letter-spacing:-.01em; }
                                    .sd-stat-label { font-size:13px; font-weight:500; color:var(--sd-muted); margin-top:4px; }
                                    .sd-stat-meta { font-size:12px; font-weight:500; margin-top:8px; }
                                    .sd-stat-icon { width:40px; height:40px; border-radius:var(--radius-md); display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0; }
                                    .sd-ic-blue { background:var(--indigo-50); color:var(--color-primary); }   .sd-tx-blue { color:var(--color-primary); }
                                    .sd-ic-green { background:#ECFDF5; color:var(--emerald-500); } .sd-tx-green { color:var(--emerald-500); }
                                    .sd-ic-red { background:#FEF2F2; color:var(--rose-500); }     .sd-tx-red { color:var(--rose-500); }
                                    .sd-ic-orange { background:#FFFBEB; color:var(--amber-500); } .sd-tx-orange { color:var(--amber-500); }
                                    .sd-ic-purple { background:var(--purple-50); color:var(--purple-600); } .sd-tx-purple { color:var(--purple-600); }

                                    /* Panels grid */
                                    .sd-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:24px; max-width: 100%; }
                                    @media (max-width: 1100px) { .sd-grid { grid-template-columns:1fr; } }
                                    .sd-panel { padding:20px 24px; box-sizing: border-box; max-width: 100%; min-width: 0; overflow-x: hidden; }
                                    @media (max-width: 600px) {
                                        .sd-grid { gap: 16px; }
                                        .sd-panel { padding: 16px 12px; }
                                        .sd-bar-label { width: 90px !important; font-size: 11px !important; }
                                        .sd-table th, .sd-table td { padding: 8px 6px !important; font-size: 11px !important; }
                                    }
                                    .sd-panel.sd-scrollable-panel { display:flex; flex-direction:column; max-height:350px; }
                                    .sd-panel.sd-scrollable-panel .sd-panel-head { flex:0 0 auto; }
                                    .sd-panel.sd-scrollable-panel .sd-scroll-content { flex:1 1 auto; overflow-y:auto; overflow-x:auto; padding-right:4px; }
                                    .sd-panel-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; }
                                    .sd-panel-head h4 { font-size:14px; font-weight:600; color:var(--text-primary); margin:0; display:flex; align-items:center; gap:8px; }
                                    .sd-panel-head .sd-panel-hint { font-size:12px; color:var(--text-secondary); font-weight:500; }

                                    /* Assigned locations tree */
                                    .sd-loc-list { display:flex; flex-direction:column; gap:8px; max-height:290px; overflow-y:auto; padding-right:4px; }
                                    .sd-loc-state { border:1px solid var(--border-subtle); border-radius:var(--radius-md); overflow:hidden; }
                                    .sd-loc-state-head { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:10px 14px; cursor:pointer; background:var(--slate-50); }
                                    .sd-loc-state-head:hover { background:var(--slate-100); }
                                    .sd-loc-state-head strong { font-size:13px; font-weight:600; color:var(--text-primary); }
                                    .sd-loc-state-head .sd-loc-count { font-size:11px; font-weight:600; color:var(--color-primary); background:var(--indigo-50); padding:2px 8px; border-radius:var(--radius-full); }
                                    .sd-loc-state-body { display:none; padding:10px 14px; }
                                    .sd-loc-state.open .sd-loc-state-body { display:block; }
                                    .sd-loc-state.open .sd-loc-caret { transform:rotate(180deg); }
                                    .sd-loc-caret { transition:.15s; color:var(--text-muted); font-size:11px; }
                                    .sd-loc-grid { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px; }
                                    .sd-loc-dist-chip { font-size: 12px; font-weight: 500; color: var(--text-primary); background: var(--slate-50); border: 1px solid var(--border-subtle); padding: 6px 12px; border-radius: var(--radius-full); display: inline-flex; align-items: center; gap: 6px; transition: .15s; cursor: default; }
                                    .sd-loc-dist-chip:hover { background: var(--slate-100); border-color: var(--border-strong); }
                                    .sd-loc-dist-chip i { color: var(--emerald-500); font-size: 11px; }
                                    .sd-loc-acs-count { color: var(--text-muted); font-size: 11px; background: #e2e8f0; padding: 1px 6px; border-radius: 10px; margin-left: 2px; }

                                    /* Donut + legend */
                                    .sd-donut-wrap { display:flex; align-items:center; gap:24px; padding: 12px 0; }
                                    .sd-donut-box { position:relative; width:160px; height:160px; flex-shrink:0; }
                                    .sd-donut-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; }
                                    .sd-donut-center strong { font-size:24px; font-weight:600; color:var(--text-primary); letter-spacing:-.01em; }
                                    .sd-donut-center span { font-size:12px; color:var(--text-secondary); font-weight:500; }
                                    .sd-legend { flex:1; display:flex; flex-direction:column; gap:8px; max-height:220px; overflow-y:auto; }
                                    .sd-legend-row { display:flex; align-items:center; gap:8px; font-size:13px; }
                                    .sd-legend-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
                                    .sd-legend-name { flex:1; font-weight:500; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
                                    .sd-legend-count { font-weight:600; color:var(--text-primary); }
                                    .sd-legend-pct { width:48px; text-align:right; font-weight:500; color:var(--text-muted); font-size:12px; }
                                    @media (max-width: 520px) { .sd-donut-wrap { flex-direction:column; } }

                                    /* Status bars */
                                    .sd-status-row { margin-bottom:16px; }
                                    .sd-status-top { display:flex; justify-content:space-between; font-size:13px; margin-bottom:8px; }
                                    .sd-status-top .sd-status-name { font-weight:500; color:var(--text-primary); }
                                    .sd-status-top .sd-status-val { font-weight:500; color:var(--text-secondary); }
                                    .sd-status-track { height:6px; background:var(--slate-100); border-radius:var(--radius-full); overflow:hidden; }
                                    .sd-status-fill { height:100%; border-radius:var(--radius-full); transition:width .4s; }

                                    /* Bars (top locations) */
                                    .sd-bar-row { display:flex; align-items:center; gap:12px; margin-bottom:12px; }
                                    .sd-bar-label { width:120px; font-size:13px; font-weight:500; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
                                    .sd-bar-track { flex:1; height:6px; background:var(--slate-100); border-radius:var(--radius-full); overflow:hidden; }
                                    .sd-bar-fill { height:100%; background:var(--color-primary); border-radius:var(--radius-full); }
                                    .sd-bar-count { width:40px; text-align:right; font-size:13px; font-weight:600; color:var(--text-primary); }

                                    /* Table */
                                    .sd-table { width:100%; border-collapse:collapse; font-size:13px; }
                                    .sd-table th { text-align:left; color:var(--text-secondary); font-weight:500; padding:10px 12px; border-bottom:1px solid var(--border-subtle); font-size:12px; }
                                    .sd-table td { padding:10px 12px; border-bottom:1px solid var(--border-subtle); color:var(--text-primary); font-weight:500; }
                                    .sd-table tr:last-child td { border-bottom:none; }
                                    .sd-table tr:hover td { background:var(--slate-50); }

                                    /* Trend toggle */
                                    .sd-mini-toggle { display:inline-flex; background:var(--slate-100); border-radius:var(--radius-md); padding:2px; border: 1px solid var(--border-subtle); }
                                    .sd-mini-toggle button { border:none; background:transparent; font-size:12px; font-weight:500; color:var(--text-secondary); padding:4px 10px; border-radius:var(--radius-sm); cursor:pointer; }
                                    .sd-mini-toggle button.active { background:var(--bg-surface); color:var(--text-primary); box-shadow:var(--shadow-sm); font-weight: 600; }

                                    .sd-empty { text-align:center; color:var(--text-muted); font-size:13px; padding:32px 0; font-weight:500; }
                                    .sd-chart-box { position:relative; height:240px; }

                                    /* Loading shimmer */
                                    .sd-page.sd-loading .sd-dim { opacity:.5; pointer-events:none; transition:opacity .2s; }
                                    .sd-spin { display:none; text-align:center; padding:12px 0 20px; color:var(--text-secondary); font-size:13px; font-weight:500; }
                                    .sd-page.sd-loading .sd-spin { display:block; }
                                </style>

                                <div class="sd-page" id="scopedAnalytics">
                                    <div class="sd-header">
                                        <div>
                                            <h1><%= dashIsSubEditor ? 'Sub Editor Dashboard' : (dashIsEditor ? 'My Dashboard' : 'Performance Analytics') %></h1>
                                            <p class="sd-sub">Welcome back, <%= dashAdminName %><span id="sdScopeNote"></span></p>
                                        </div>
                                        <div class="sd-header-right">
                                            <span class="sd-viewas" id="sdViewAsWrap" style="display:none">
                                                <select id="sdViewAs">
                                                    <option value="">All Data (Super Admin)</option>
                                                </select>
                                            </span>
                                            <span class="sd-range-pill"><i class="far fa-calendar"></i> <span id="sdRangeLabel">Last 30 Days</span></span>
                                            <button class="sd-refresh" id="sdRefresh"><i class="fas fa-rotate"></i> Refresh</button>
                                        </div>
                                    </div>
                                    <div class="sd-tabs" role="tablist">
                                        <button class="sd-tab" data-range="today">Today</button>
                                        <button class="sd-tab" data-range="yesterday">Yesterday</button>
                                        <button class="sd-tab" data-range="7d">Last 7 Days</button>
                                        <button class="sd-tab active" data-range="30d">Last 30 Days</button>
                                        <button class="sd-tab" data-range="thisMonth">This Month</button>
                                        <button class="sd-tab" data-range="lastMonth">Last Month</button>
                                        <button class="sd-tab" data-range="custom">Custom Range</button>
                                    </div>
                                    <div class="sd-custom" id="sdCustom">
                                        <input type="date" id="sdFrom"> <span style="font-size:12px;color:#64748b;font-weight:600">to</span> <input type="date" id="sdTo">
                                        <button class="sd-apply" id="sdApply">Apply</button>
                                    </div>

                                    <div class="sd-spin"><span class="spinner-border spinner-border-sm" style="width:14px;height:14px;border-width:2px"></span> Updating dashboard...</div>

                                    <div class="sd-dim">
                                        <div class="sd-cards" id="sdCards"></div>

                                        <div class="sd-grid" id="sdRow2">
                                            <div class="sd-card sd-panel" id="sdLocPanel">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-map-marker-alt" style="color:var(--sd-green)"></i> Assigned Locations</h4>
                                                    <span class="sd-panel-hint" id="sdLocHint"></span>
                                                </div>
                                                <div class="sd-loc-list" id="sdLocTree"></div>
                                            </div>
                                            <div class="sd-card sd-panel">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-chart-pie" style="color:var(--sd-blue)"></i> Category Wise Posts</h4>
                                                </div>
                                                <div class="sd-donut-wrap">
                                                    <div class="sd-donut-box">
                                                        <canvas id="sdCatChart"></canvas>
                                                        <div class="sd-donut-center"><strong id="sdCatTotal">0</strong><span>Total</span></div>
                                                    </div>
                                                    <div class="sd-legend" id="sdCatLegend"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="sd-grid">
                                            <div class="sd-card sd-panel">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-list-check" style="color:var(--sd-purple)"></i> Post Status Overview</h4>
                                                </div>
                                                <div id="sdStatusBars"></div>
                                            </div>
                                            <div class="sd-card sd-panel">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-chart-line" style="color:var(--sd-blue)"></i> Posts Trend</h4>
                                                    <span class="sd-mini-toggle">
                                                        <button class="active" data-mode="day">Daily</button>
                                                        <button data-mode="week">Weekly</button>
                                                    </span>
                                                </div>
                                                <div class="sd-chart-box"><canvas id="sdTrendChart"></canvas></div>
                                            </div>
                                        </div>

                                        <div class="sd-grid" id="sdRow4">
                                            <div class="sd-card sd-panel sd-scrollable-panel">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-location-dot" style="color:var(--sd-red)"></i> Top Assigned Locations</h4>
                                                </div>
                                                <div id="sdTopLoc" class="sd-scroll-content"></div>
                                            </div>
                                            <div class="sd-card sd-panel sd-scrollable-panel" id="sdReporterPanel" style="display:none">
                                                <div class="sd-panel-head">
                                                    <h4><i class="fas fa-users" style="color:var(--sd-blue)"></i> All Reporters</h4>
                                                </div>
                                                <div class="sd-scroll-content" id="sdReporterWrap"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
                                <script>
                                (function () {
                                    let sdRange = '30d';
                                    let sdViewAsId = '';
                                    let sdTargetsLoaded = false;
                                    let sdTrendMode = 'day';
                                    let sdTrendData = [];
                                    let catChart = null;
                                    let trendChart = null;

                                    const page = document.getElementById('scopedAnalytics');
                                    const PALETTE = ['#2563eb', '#16a34a', '#f59e0b', '#ef4444', '#7c3aed', '#06b6d4', '#ec4899', '#94a3b8'];

                                    function esc(s) {
                                        return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
                                    }
                                    function num(n) { return (n || 0).toLocaleString('en-IN'); }
                                    function compact(n) {
                                        if ((n || 0) < 10000) return num(n);
                                        return new Intl.NumberFormat('en-IN', { notation: 'compact', maximumFractionDigits: 1 }).format(n);
                                    }

                                    function statCard(value, label, meta, metaTone, icon, iconTone) {
                                        return `
                                        <div class="sd-card sd-stat">
                                            <div>
                                                <div class="sd-stat-num">${value}</div>
                                                <div class="sd-stat-label">${label}</div>
                                                ${meta ? `<div class="sd-stat-meta sd-tx-${metaTone}">${meta}</div>` : ''}
                                            </div>
                                            <span class="sd-stat-icon sd-ic-${iconTone}"><i class="fas ${icon}"></i></span>
                                        </div>`;
                                    }

                                    function renderCards(s, a) {
                                        const myPostsCount = typeof dashMyArticles !== 'undefined' ? dashMyArticles.length : 0;
                                        const dashInactiveCount = <%= typeof dashInactive !== 'undefined' ? dashInactive : 0 %>;
                                        const isEditor = <%= typeof dashIsSubEditor !== 'undefined' && dashIsSubEditor ? 'true' : (typeof dashIsEditor !== 'undefined' && dashIsEditor ? 'true' : 'false') %>;
                                        
                                        document.getElementById('sdCards').innerHTML =
                                            statCard(num(s.total), 'Total Posts', '', '', 'fa-file-lines', 'blue') +
                                            statCard(num(s.approved), 'Approved', s.total ? s.approvalRate + '%' : '', 'green', 'fa-circle-check', 'green') +
                                            statCard(num(s.rejected), 'Rejected', s.total ? s.rejectionRate + '%' : '', 'red', 'fa-circle-xmark', 'red') +
                                            statCard(num(s.pending), 'Pending', s.total ? Math.round((s.pending / s.total) * 100) + '%' : '', 'orange', 'fa-clock', 'orange') +
                                            statCard(compact(s.views), 'Total Views', '', '', 'fa-eye', 'purple') +
                                            statCard(num(dashInactiveCount), 'Inactive (All Time)', '', 'slate', 'fa-pause-circle', 'slate') +
                                            (isEditor ? statCard(num(myPostsCount), 'My Posts (All Time)', '', 'blue', 'fa-user-edit', 'blue') : '');
                                    }

                                    function renderLocTree(tree) {
                                        const panel = document.getElementById('sdLocPanel');
                                        const row2 = document.getElementById('sdRow2');
                                        if (tree === null) {
                                            // Superadmin full access — assigned locations panel hide
                                            panel.style.display = 'none';
                                            row2.style.gridTemplateColumns = '1fr';
                                            return;
                                        }
                                        panel.style.display = '';
                                        row2.style.gridTemplateColumns = '';
                                        const box = document.getElementById('sdLocTree');
                                        if (!tree.length) {
                                            box.innerHTML = '<div class="sd-empty">No locations assigned — contact admin</div>';
                                            document.getElementById('sdLocHint').textContent = '';
                                            return;
                                        }
                                        const distCount = tree.reduce((n, st) => n + st.districts.length, 0);
                                        document.getElementById('sdLocHint').textContent = `${tree.length} state${tree.length > 1 ? 's' : ''} · ${distCount} district${distCount > 1 ? 's' : ''}`;
                                        box.innerHTML = tree.map((st, i) => `
                                            <div class="sd-loc-state ${i === 0 ? 'open' : ''}">
                                                <div class="sd-loc-state-head" data-loc-toggle>
                                                    <strong><i class="fas fa-map" style="color:var(--sd-blue);font-size:11px"></i> ${esc(st.name)}</strong>
                                                    <span style="display:flex;align-items:center;gap:8px">
                                                        <span class="sd-loc-count">${st.districts.length}</span>
                                                        <i class="fas fa-chevron-down sd-loc-caret"></i>
                                                    </span>
                                                </div>
                                                <div class="sd-loc-state-body">
                                                    <div class="sd-loc-grid">
                                                    ${st.districts.map(d => `
                                                        <div class="sd-loc-dist-chip" title="${esc(d.name)}">
                                                            <i class="fas fa-location-dot"></i> ${esc(d.name)}
                                                            ${d.constituencies.length ? `<span class="sd-loc-acs-count" title="${d.constituencies.length} constituencies">${d.constituencies.length}</span>` : ''}
                                                        </div>
                                                    `).join('')}
                                                    </div>
                                                </div>
                                            </div>`).join('');
                                        box.querySelectorAll('[data-loc-toggle]').forEach(head => {
                                            head.addEventListener('click', () => head.parentElement.classList.toggle('open'));
                                        });
                                    }

                                    function renderCategoryDonut(categories, total) {
                                        const withData = categories.filter(c => c.count > 0);
                                        const top = withData.slice(0, 7);
                                        const restCount = withData.slice(7).reduce((n, c) => n + c.count, 0);
                                        const items = [...top];
                                        if (restCount > 0) items.push({ name: 'Others', count: restCount });

                                        document.getElementById('sdCatTotal').textContent = compact(total);
                                        const legend = document.getElementById('sdCatLegend');
                                        if (!items.length) {
                                            legend.innerHTML = '<div class="sd-empty">No posts in this range</div>';
                                        } else {
                                            legend.innerHTML = items.map((it, i) => `
                                                <div class="sd-legend-row">
                                                    <span class="sd-legend-dot" style="background:${PALETTE[i % PALETTE.length]}"></span>
                                                    <span class="sd-legend-name" title="${esc(it.name)}">${esc(it.name)}</span>
                                                    <span class="sd-legend-count">${num(it.count)}</span>
                                                    <span class="sd-legend-pct">${total ? ((it.count / total) * 100).toFixed(1) : 0}%</span>
                                                </div>`).join('');
                                        }

                                        if (typeof Chart === 'undefined') return;
                                        if (catChart) catChart.destroy();
                                        catChart = new Chart(document.getElementById('sdCatChart'), {
                                            type: 'doughnut',
                                            data: {
                                                labels: items.map(i => i.name),
                                                datasets: [{
                                                    data: items.length ? items.map(i => i.count) : [1],
                                                    backgroundColor: items.length ? items.map((_, i) => PALETTE[i % PALETTE.length]) : ['#f1f5f9'],
                                                    borderWidth: 2,
                                                    borderColor: '#fff'
                                                }]
                                            },
                                            options: {
                                                cutout: '72%',
                                                responsive: true,
                                                maintainAspectRatio: false,
                                                plugins: { legend: { display: false }, tooltip: { enabled: items.length > 0 } }
                                            }
                                        });
                                    }

                                    function renderStatusBars(s) {
                                        const rows = [
                                            { name: 'Approved', val: s.approved, color: '#16a34a' },
                                            { name: 'Rejected', val: s.rejected, color: '#ef4444' },
                                            { name: 'Pending', val: s.pending, color: '#f59e0b' },
                                            { name: 'Published', val: s.published, color: '#2563eb' },
                                            { name: 'Draft / Off', val: s.draft, color: '#94a3b8' }
                                        ];
                                        document.getElementById('sdStatusBars').innerHTML = rows.map(r => {
                                            const pct = s.total ? Math.round((r.val / s.total) * 100) : 0;
                                            return `
                                            <div class="sd-status-row">
                                                <div class="sd-status-top">
                                                    <span class="sd-status-name">${r.name}</span>
                                                    <span class="sd-status-val">${num(r.val)} (${pct}%)</span>
                                                </div>
                                                <div class="sd-status-track"><div class="sd-status-fill" style="width:${pct}%;background:${r.color}"></div></div>
                                            </div>`;
                                        }).join('');
                                    }

                                    function groupWeekly(trend) {
                                        const weeks = {};
                                        trend.forEach(t => {
                                            const d = new Date(t.date + 'T00:00:00');
                                            const day = (d.getDay() + 6) % 7; // Monday start
                                            d.setDate(d.getDate() - day);
                                            const key = d.toISOString().slice(0, 10);
                                            weeks[key] = (weeks[key] || 0) + t.count;
                                        });
                                        return Object.keys(weeks).sort().map(k => ({ date: k, count: weeks[k] }));
                                    }

                                    function renderTrend() {
                                        if (typeof Chart === 'undefined') return;
                                        const data = sdTrendMode === 'week' ? groupWeekly(sdTrendData) : sdTrendData;
                                        const labels = data.map(t => {
                                            const d = new Date(t.date + 'T00:00:00');
                                            return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
                                        });
                                        if (trendChart) trendChart.destroy();
                                        trendChart = new Chart(document.getElementById('sdTrendChart'), {
                                            type: 'line',
                                            data: {
                                                labels,
                                                datasets: [{
                                                    label: 'Posts',
                                                    data: data.map(t => t.count),
                                                    borderColor: '#2563eb',
                                                    backgroundColor: 'rgba(37,99,235,.08)',
                                                    fill: true,
                                                    tension: 0.35,
                                                    pointRadius: data.length > 40 ? 0 : 3,
                                                    pointBackgroundColor: '#fff',
                                                    pointBorderColor: '#2563eb',
                                                    pointBorderWidth: 2,
                                                    borderWidth: 2
                                                }]
                                            },
                                            options: {
                                                responsive: true,
                                                maintainAspectRatio: false,
                                                plugins: { legend: { display: false } },
                                                scales: {
                                                    x: { grid: { display: false }, ticks: { maxTicksLimit: 10, font: { size: 10 }, color: '#94a3b8' } },
                                                    y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { precision: 0, font: { size: 10 }, color: '#94a3b8' } }
                                                }
                                            }
                                        });
                                    }

                                    function renderTopLocations(locations) {
                                        const max = Math.max(0, ...locations.map(l => l.count));
                                        document.getElementById('sdTopLoc').innerHTML = !locations.length
                                            ? '<div class="sd-empty">No posts in this range</div>'
                                            : locations.slice(0, 10).map(l => `
                                                <div class="sd-bar-row">
                                                    <span class="sd-bar-label" title="${esc(l.name)}">${esc(l.name)}</span>
                                                    <span class="sd-bar-track"><span class="sd-bar-fill" style="width:${max ? Math.max(3, Math.round((l.count / max) * 100)) : 0}%"></span></span>
                                                    <span class="sd-bar-count">${num(l.count)}</span>
                                                </div>`).join('');
                                    }

                                    function renderReporters(reporters, scopeRole) {
                                        const panel = document.getElementById('sdReporterPanel');
                                        const row4 = document.getElementById('sdRow4');
                                        // Reporter (editor) sonta dashboard lo ee table avasaram ledu
                                        const show = reporters.length > 0 && scopeRole !== 'editor';
                                        panel.style.display = show ? '' : 'none';
                                        row4.style.gridTemplateColumns = show ? '' : '1fr';
                                        if (!show) return;
                                        document.getElementById('sdReporterWrap').innerHTML = `
                                            <table class="sd-table">
                                                <thead><tr><th>Reporter</th><th>Email</th><th>Mobile</th><th>State</th><th>District</th><th>Total</th><th>Approved</th><th>Rejected</th><th>Pending</th><th>Views</th></tr></thead>
                                                <tbody>
                                                ${reporters.map(r => `<tr>
                                                    <td>${esc(r.author)}</td>
                                                    <td>${esc(r.email || '-')}</td>
                                                    <td>${esc(r.mobile || '-')}</td>
                                                    <td>${esc(r.state || '-')}</td>
                                                    <td><div style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${esc(r.district || '-')}">${esc(r.district || '-')}</div></td>
                                                    <td>${num(r.total)}</td>
                                                    <td style="color:#16a34a">${num(r.approved)}</td>
                                                    <td style="color:#ef4444">${num(r.rejected)}</td>
                                                    <td style="color:#f59e0b">${num(r.pending)}</td>
                                                    <td>${compact(r.views)}</td>
                                                </tr>`).join('')}
                                                </tbody>
                                            </table>`;
                                    }

                                    function render(data) {
                                        document.getElementById('sdRangeLabel').textContent = data.range.label;
                                        document.getElementById('sdScopeNote').textContent = data.scope.fullAccess
                                            ? ' — All Data (Super Admin)'
                                            : (data.scope.viewingAs ? ` — Viewing: ${data.scope.name}` : '');

                                        renderCards(data.summary, data.allTime);
                                        renderLocTree(data.assignedLocations);
                                        renderCategoryDonut(data.categories, data.summary.total);
                                        renderStatusBars(data.summary);
                                        sdTrendData = data.dailyTrend;
                                        renderTrend();
                                        renderTopLocations(data.locations);
                                        renderReporters(data.reporters, data.scope.role);

                                        if (data.viewTargets && !sdTargetsLoaded) {
                                            sdTargetsLoaded = true;
                                            const sel = document.getElementById('sdViewAs');
                                            data.viewTargets.forEach(t => {
                                                const opt = document.createElement('option');
                                                opt.value = t.id;
                                                opt.textContent = `${t.name} (Sub Editor)`;
                                                sel.appendChild(opt);
                                            });
                                            document.getElementById('sdViewAsWrap').style.display = 'inline-block';
                                        }
                                    }

                                    async function load() {
                                        page.classList.add('sd-loading');
                                        let url = `/admin/api/scoped-analytics?range=${sdRange}`;
                                        if (sdRange === 'custom') {
                                            const from = document.getElementById('sdFrom').value;
                                            const to = document.getElementById('sdTo').value;
                                            if (!from || !to) { page.classList.remove('sd-loading'); return; }
                                            url += `&from=${from}&to=${to}`;
                                        }
                                        if (sdViewAsId) url += `&viewAs=${sdViewAsId}`;
                                        try {
                                            const res = await fetch(url);
                                            const data = await res.json();
                                            if (!res.ok) throw new Error(data.error || 'Failed');
                                            render(data);
                                        } catch (err) {
                                            document.getElementById('sdCards').innerHTML = `<div class="sd-empty" style="grid-column:1/-1">${esc(err.message || 'Failed to load analytics')}</div>`;
                                        } finally {
                                            page.classList.remove('sd-loading');
                                        }
                                    }

                                    document.querySelectorAll('#scopedAnalytics .sd-tab').forEach(tab => {
                                        tab.addEventListener('click', function () {
                                            document.querySelectorAll('#scopedAnalytics .sd-tab').forEach(t => t.classList.remove('active'));
                                            this.classList.add('active');
                                            sdRange = this.getAttribute('data-range');
                                            document.getElementById('sdCustom').classList.toggle('show', sdRange === 'custom');
                                            if (sdRange !== 'custom') load();
                                        });
                                    });
                                    document.getElementById('sdApply').addEventListener('click', load);
                                    document.getElementById('sdRefresh').addEventListener('click', load);
                                    document.getElementById('sdViewAs').addEventListener('change', function () {
                                        sdViewAsId = this.value;
                                        load();
                                    });
                                    document.querySelectorAll('#scopedAnalytics .sd-mini-toggle button').forEach(btn => {
                                        btn.addEventListener('click', function () {
                                            document.querySelectorAll('#scopedAnalytics .sd-mini-toggle button').forEach(b => b.classList.remove('active'));
                                            this.classList.add('active');
                                            sdTrendMode = this.getAttribute('data-mode');
                                            renderTrend();
                                        });
                                    });

                                    load();
                                })();
                                </script>
                                <!-- ============ /SCOPED PERFORMANCE ANALYTICS ============ -->

                                <% if (!dashIsSubEditor) { %>

                                <section class="dash-pipeline" aria-label="Content pipeline">
                                    <div class="dash-pipeline-head">
                                        <div>
                                            <h2><i class="fas fa-diagram-project"></i> Content pipeline</h2>
                                            <p>End-to-end flow from submission to publication</p>
                                        </div>
                                    </div>
                                    <div class="dash-pipeline-flow">
                                        <div class="dash-flow-node">
                                            <strong><%= dashTotal.toLocaleString('en-IN') %></strong>
                                            <span>Total</span>
                                        </div>
                                        <div class="dash-flow-arrow"><i class="fas fa-chevron-right"></i></div>
                                        <div class="dash-flow-node dash-flow-node--active">
                                            <strong><%= dashActive.toLocaleString('en-IN') %></strong>
                                            <span>Active</span>
                                        </div>
                                        <div class="dash-flow-arrow"><i class="fas fa-chevron-right"></i></div>
                                        <div class="dash-flow-node dash-flow-node--pending">
                                            <strong><%= dashPending.toLocaleString('en-IN') %></strong>
                                            <span>Pending</span>
                                        </div>
                                        <div class="dash-flow-arrow"><i class="fas fa-chevron-right"></i></div>
                                        <div class="dash-flow-node dash-flow-node--today">
                                            <strong><%= dashToday.toLocaleString('en-IN') %></strong>
                                            <span>Today</span>
                                        </div>
                                    </div>
                                </section>

                                <div class="dash-split">
                                    <section class="dash-panel dash-live-panel">
                                        <div class="dash-panel-head">
                                            <div>
                                                <h3><i class="fab fa-youtube" style="color:#dc2626"></i> Live broadcast control</h3>
                                                <p>YouTube live stream for the mobile app</p>
                                            </div>
                                        </div>
                                        <div class="dash-panel-body">
                                            <div class="dash-live-status">
                                                <span class="dash-live-badge" id="liveStreamBadge"><i class="fas fa-circle"></i> OFFLINE</span>
                                                <div class="dash-live-toggle form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="liveStreamToggle" role="switch">
                                                    <label class="form-check-label" for="liveStreamToggle" id="liveStreamStatusLabel">OFF</label>
                                                </div>
                                            </div>
                                            <div class="collapse show" id="liveStreamConfig">
                                                <label class="form-label small mb-2" style="color:rgba(255,255,255,0.7)">YouTube URL</label>
                                                <div class="input-group dash-live-input-wrap mb-2">
                                                    <span class="input-group-text"><i class="fab fa-youtube"></i></span>
                                                    <input type="text" class="form-control" id="liveStreamUrl" placeholder="https://www.youtube.com/watch?v=...">
                                                    <button class="btn" type="button" onclick="saveLiveStreamConfig()">Update</button>
                                                </div>
                                                <div class="dash-live-hints">
                                                    <span><i class="fas fa-check text-success"></i> Video <code>.../watch?v=ID</code></span>
                                                    <span><i class="fas fa-check text-success"></i> Live <code>.../live/ID</code></span>
                                                </div>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="dash-panel">
                                        <div class="dash-panel-head">
                                            <div>
                                                <h3><i class="fas fa-chart-pie"></i> Engagement snapshot</h3>
                                                <p>From latest <%= typeof newsList !== 'undefined' ? newsList.length : 0 %> articles on dashboard</p>
                                            </div>
                                        </div>
                                        <div class="dash-panel-body">
                                            <div class="dash-insight-grid">
                                                <div class="dash-insight-item">
                                                    <strong><%= dashRecentLikes.toLocaleString('en-IN') %></strong>
                                                    <span>Likes</span>
                                                </div>
                                                <div class="dash-insight-item">
                                                    <strong><%= dashRecentComments.toLocaleString('en-IN') %></strong>
                                                    <span>Comments</span>
                                                </div>
                                                <div class="dash-insight-item">
                                                    <strong><%= dashViews.toLocaleString('en-IN') %></strong>
                                                    <span>Total views</span>
                                                </div>
                                                <div class="dash-insight-item">
                                                    <strong><%= dashToday.toLocaleString('en-IN') %></strong>
                                                    <span>Today</span>
                                                </div>
                                            </div>
                                            <div class="dash-donut-wrap">
                                                <div class="dash-donut" style="--active-pct: <%= dashActivePct %>%; --pending-pct: <%= dashPendingPct %>%;">
                                                    <div class="dash-donut-inner"><%= dashActivePct %>%</div>
                                                </div>
                                                <div class="dash-legend">
                                                    <div class="dash-legend-item"><span class="dash-legend-dot" style="background:#10b981"></span> Active (<%= dashActive %>)</div>
                                                    <div class="dash-legend-item"><span class="dash-legend-dot" style="background:#f59e0b"></span> Pending (<%= dashPending %>)</div>
                                                    <div class="dash-legend-item"><span class="dash-legend-dot" style="background:#e5e7eb"></span> Other (<%= Math.max(0, dashTotal - dashActive - dashPending) %>)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                </div>


                                <section class="dash-section">
                                    <div class="dash-section-head">
                                        <div>
                                            <h2>Recent articles</h2>
                                            <p>Latest submissions — click to view full analytics</p>
                                        </div>
                                        <a href="<%= typeof isImpersonating !== 'undefined' && isImpersonating ? '/admin/editors/' + admin._id + '/news-list' : '/news-list' %>" class="dash-link-btn"><i class="fas fa-arrow-right"></i> View all</a>
                                    </div>
                                    
                                    <% if (typeof isRestrictedSubEditor !== 'undefined' && isRestrictedSubEditor) { %>
                                            <% 
                                                const dashAdminId = (admin && (admin.id || admin._id)) ? (admin.id || admin._id).toString() : '';
                                                const dashMyArticles = (typeof newsList !== 'undefined' ? newsList : []).filter(n => n.authorId && dashAdminId && n.authorId.toString() === dashAdminId);
                                                const dashTeamArticles = (typeof newsList !== 'undefined' ? newsList : []).filter(n => n.authorId && dashAdminId && n.authorId.toString() !== dashAdminId);
                                                const dashShowTeam = typeof hasTeamScope !== 'undefined' && hasTeamScope;
                                                const dashDefaultTeam = dashShowTeam && dashMyArticles.length === 0 && dashTeamArticles.length > 0;
                                            %>
                                            <% if (dashShowTeam) { %>
                                            <ul class="nav nav-tabs mb-4" id="subEditorDashboardTabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link <%= dashDefaultTeam ? '' : 'active' %> fw-bold" id="my-dash-tab" data-bs-toggle="tab" data-bs-target="#my-dash" type="button" role="tab" style="color: #475569;"><i class="fas fa-user-edit"></i> My Articles</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link <%= dashDefaultTeam ? 'active' : '' %> fw-bold" id="team-dash-tab" data-bs-toggle="tab" data-bs-target="#team-dash" type="button" role="tab" style="color: #475569;"><i class="fas fa-users"></i> Team Reporters</button>
                                                </li>
                                            </ul>
                                            <% } %>
                                        <% if (dashShowTeam) { %>
                                        <div class="tab-content" id="subEditorDashboardTabContent">
                                            <div class="tab-pane fade <%= dashDefaultTeam ? 'show active' : '' %>" id="team-dash" role="tabpanel">
                                                <div class="dash-news-panel">
                                                    <div class="dash-articles-grid">
                                                        <% dashTeamArticles.forEach(function(news) { %>

                                            <article class="dash-article news-card" onclick="openNewsDetail('<%= news._id %>')">
                                                <div class="dash-article-media">
                                                    <% if (news.mediaUrl) { %>
                                                        <% if (news.mediaType === 'video') { %>
                                                            <video src="<%= news.mediaUrl %>" onclick="event.stopPropagation()" controls></video>
                                                        <% } else { %>
                                                            <img src="<%= news.mediaUrl || news.imageUrl %>" alt="<%= news.title %>">
                                                        <% } %>
                                                    <% } else { %>
                                                        <div class="dash-article-media--empty"><i class="fas fa-image"></i></div>
                                                    <% } %>
                                                    <% if (news.location && news.locationCode) { %>
                                                        <span class="dash-article-chip"><i class="fas fa-map-marker-alt"></i> <%= news.locationCode %></span>
                                                    <% } %>
                                                    <span class="dash-article-status <%= news.isActive === false ? 'dash-article-status--off' : 'dash-article-status--on' %>">
                                                        <%= news.isActive === false ? 'Inactive' : 'Active' %>
                                                    </span>
                                                </div>
                                                <div class="dash-article-body">
                                                    <h3 class="dash-article-title rich-text"><%- renderRichText(news.title) %></h3>
                                                    <p class="dash-article-excerpt rich-text"><%- renderRichTextExcerpt(news.content, 90) %></p>
                                                    <div class="dash-article-meta">
                                                        <span><%= news.category %></span>
                                                        <span><%= new Date(news.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                                                        <% if (!dashIsEditor) { %><span><i class="fas fa-user"></i> <%= news.author %></span><% } %>
                                                    </div>
                                                    <div class="dash-article-engage">
                                                        <span class="dash-engage-pill"><i class="fas fa-thumbs-up"></i> <%= news.likes || 0 %></span>
                                                        <span class="dash-engage-pill"><i class="fas fa-comment"></i> <%= news.comments || 0 %></span>
                                                        <span class="dash-engage-pill"><i class="fas fa-eye"></i> <%= news.views || 0 %></span>
                                                    </div>
                                                    <div class="dash-article-actions">
                                                        <% if (news.isActive !== false && admin && (admin.role === 'superadmin' || admin.role === 'admin' || (admin.role === 'subeditor' && admin.permissions && admin.permissions.canSendNotifications))) { %>
                                                        <button type="button" class="btn btn-sm btn-warning ripple" title="Send notification" onclick="sendNotificationForNews('<%= news._id %>'); event.stopPropagation();">
                                                            <i class="fas fa-bell"></i>
                                                        </button>
                                                        <% } %>
                                                        <% 
                                                        const isSuperAdmin = admin && admin.role === 'superadmin';
                                                        const isAdmin = admin && admin.role === 'admin';
                                                        const hasEditPerm = admin && admin.role === 'subeditor' && admin.permissions && admin.permissions.canEditNews;
                                                        const canEditAny = isSuperAdmin || isAdmin || hasEditPerm;
                                                        const isOwnNews = admin && news.authorId && admin._id && news.authorId.toString() === admin._id.toString();
                                                        const isRejected = news.rejectionStatus && news.rejectionStatus.isRejected;
                                                        const canEdit = canEditAny || (isOwnNews && !isRejected);
                                                        %>
                                                        <% if (canEditAny || isOwnNews) { %>
                                                        <button type="button" class="btn btn-sm btn-<%= news.isActive === false ? 'success' : 'outline-secondary' %> ripple" onclick="toggleNewsStatus('<%= news._id %>'); event.stopPropagation();">
                                                            <i class="fas fa-<%= news.isActive === false ? 'check' : 'pause' %>"></i>
                                                        </button>
                                                        <% } %>
                                                        
                                                        <% if (canEdit) { %>
                                                        <button type="button" class="btn btn-sm btn-primary ripple" onclick="editNews('<%= news._id %>'); event.stopPropagation();">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <% } %>
                                                        <% if (canEditAny || isOwnNews) { %>
                                                        <button type="button" class="btn btn-sm btn-outline-danger ripple" onclick="deleteNews('<%= news._id %>'); event.stopPropagation();">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                        <% } %>
                                                    </div>
