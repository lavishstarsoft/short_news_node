                                                                    <div class="dash-article-meta">
                                                                        <span><%= news.category %></span>
                                                                        <span><%= new Date(news.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                                                                    </div>
                                                                </div>
                                                            </article>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
