<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: '3D Cube Ads - Short News Admin' }) %>
  <script type="module" src="https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>
  <script src="https://unpkg.com/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js"></script>
  <style>
    * { box-sizing: border-box; }
    /* body/header styles inherited from the dashboard shell */
    header h1 { font-size: 20px; margin: 0; }
    .wrap { max-width: 100%; margin: 12px 0; padding: 0; }
    .help { background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; font-size: 14px; line-height: 1.6; }
    .grid { display: grid; grid-template-columns: 1fr 300px; gap: 18px; }
    @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
    .card { background: #fff; border: 1px solid #e6e8eb; border-radius: 12px; padding: 16px; }
    label { display: block; font-weight: 600; font-size: 13px; margin: 12px 0 5px; }
    input[type=text], input[type=url], select, input[type=number] { width: 100%; padding: 9px 10px; border: 1px solid #ccd1d6; border-radius: 8px; font-size: 14px; }
    .row { display: flex; gap: 10px; }
    .row > div { flex: 1; }
    button { cursor: pointer; border: none; border-radius: 8px; padding: 9px 16px; font-weight: 700; font-size: 14px; }
    .btn-primary { background: #5E35B1; color: #fff; }
    .btn-light { background: #eef0f3; color: #333; }
    .btn-danger { background: #fdecec; color: #c62828; }
    .muted { color: #6b7280; font-size: 12px; }
    #uploadBox { border: 2px dashed #c7cdd4; border-radius: 10px; padding: 18px; text-align: center; cursor: pointer; }
    #uploadBox img { max-width: 120px; max-height: 120px; border-radius: 8px; }
    /* ── shared 3D template (same look the app renders) ── */
    .ad3d-scene { perspective: 900px; width: 200px; height: 200px; margin: 10px auto; }
    .ad3d-rotor { width: 100%; height: 100%; transform-style: preserve-3d; display: flex; align-items: center; justify-content: center; animation: ad3dSpin var(--spd, 6s) linear infinite; }
    .ad3d-rotor img { max-width: 100%; max-height: 100%; backface-visibility: visible; border-radius: 10px; box-shadow: 0 12px 28px rgba(0,0,0,.25); }
    .style-flip .ad3d-rotor { animation-name: ad3dFlip; }
    @keyframes ad3dSpin { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
    @keyframes ad3dFlip { from { transform: rotateX(0deg); } to { transform: rotateX(360deg); } }

    /* ── Dice / Cube: a real 3D box, 4 images on the 4 sides, logo on empties ── */
    .ad3d-cubescene { perspective: 1000px; width: 230px; height: 210px; margin: 10px auto; }
    .ad3d-cube { position: relative; width: 150px; height: 150px; margin: 30px auto; transform-style: preserve-3d; animation: ad3dCube var(--spd, 8s) linear infinite; }
    .ad3d-cube .face { position: absolute; width: 150px; height: 150px; border-radius: 6px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.08) inset; }
    .ad3d-cube .face img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ad3d-cube .face.logo { background: #0b1f3a; display: flex; align-items: center; justify-content: center; }
    .ad3d-cube .face.logo img { object-fit: contain; padding: 22px; }
    .ad3d-cube .front  { transform: rotateY(0deg)   translateZ(75px); }
    .ad3d-cube .right  { transform: rotateY(90deg)  translateZ(75px); }
    .ad3d-cube .back   { transform: rotateY(180deg) translateZ(75px); }
    .ad3d-cube .left   { transform: rotateY(-90deg) translateZ(75px); }
    .ad3d-cube .top    { transform: rotateX(90deg)  translateZ(75px); }
    .ad3d-cube .bottom { transform: rotateX(-90deg) translateZ(75px); }
    @keyframes ad3dCube { from { transform: rotateX(-14deg) rotateY(0deg); } to { transform: rotateX(-14deg) rotateY(360deg); } }

    /* 4 cube upload slots */
    .cube-slots { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 8px; }
    .cube-slot { border: 2px dashed #c7cdd4; border-radius: 10px; padding: 10px; text-align: center; cursor: pointer; min-height: 92px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .cube-slot img { max-width: 80px; max-height: 60px; border-radius: 6px; }
    .cube-slot .slot-label { font-size: 12px; color: #667; margin-top: 4px; }

    /* News picker (choose the one card an ad shows on) */
    #newsResults { border: 1px solid #e0e4ea; border-radius: 8px; margin-top: 4px; max-height: 190px; overflow-y: auto; display: none; }
    #newsResults.show { display: block; }
    .news-opt { padding: 8px 10px; cursor: pointer; border-bottom: 1px solid #f0f2f5; font-size: 14px; }
    .news-opt:hover { background: #f3f0ff; }
    #newsChips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .news-chip { background: #eef9f0; border: 1px solid #cdeccf; border-radius: 16px; padding: 5px 10px; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; max-width: 100%; }
    .news-chip .cx { color: #c62828; cursor: pointer; font-weight: 700; }
    .news-chip .ct { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #eee; font-size: 13px; vertical-align: middle; }
    .pill { padding: 2px 9px; border-radius: 20px; font-size: 12px; font-weight: 700; }
    .on { background: #e7f6ec; color: #1b8a4b; }
    .off { background: #f0f1f3; color: #6b7280; }
    .thumb { width: 42px; height: 42px; object-fit: cover; border-radius: 6px; }

    /* Language tabs + news dropdown (replaces free-text news search) */
    .lang-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0; }
    .lang-tab { padding: 6px 13px; border: 1px solid #ccd1d6; border-radius: 18px; background: #fff; cursor: pointer; font-size: 13px; font-weight: 600; }
    .lang-tab.active { background: #5E35B1; color: #fff; border-color: #5E35B1; }

    /* App preview + device coverage */
    .cov-wrap { display: grid; grid-template-columns: 270px 1fr; gap: 20px; margin-top: 14px; }
    @media (max-width: 820px) { .cov-wrap { grid-template-columns: 1fr; } }
    .phone-pick { margin-bottom: 8px; }
    .phone { margin: 0 auto; border: 7px solid #15181d; border-radius: 26px; overflow: hidden; position: relative; background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.18); }
    .phone .pmedia { width: 100%; display: block; object-fit: cover; background: #e3e6ea; }
    .phone .ptxt { padding: 6px 9px; }
    .phone .ptitle { color: #333; font-weight: 800; }
    .phone .pdesc { color: #555; margin-top: 4px; }
    .phone .pbar { position: absolute; left: 0; right: 0; bottom: 0; background: #fafbfc; border-top: 1px solid #eef0f3; }
    .phone .adbox { position: absolute; border-radius: 6px; background: rgba(94,53,177,.78); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; letter-spacing: .5px; box-shadow: 0 4px 12px rgba(0,0,0,.3); }
    .cov-table { width: 100%; border-collapse: collapse; }
    .cov-table th, .cov-table td { text-align: left; padding: 7px 9px; border-bottom: 1px solid #eef0f3; font-size: 13px; }
    .cov-table th { color: #6b7280; font-weight: 700; }
    .vd { padding: 2px 9px; border-radius: 14px; font-size: 12px; font-weight: 800; white-space: nowrap; }
    .vd-ok { background: #e7f6ec; color: #1b8a4b; }
    .vd-warn { background: #fff6e5; color: #b8791c; }
    .vd-bad { background: #fdecec; color: #c62828; }
    .cov-summary { padding: 10px 12px; border-radius: 10px; font-size: 13.5px; font-weight: 600; margin-bottom: 10px; }
    .mascot-bob { display: inline-block; animation: mbob 1.2s ease-in-out infinite; }
    @keyframes mbob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .mascot-bubble { display: inline-block; background: #fff; border: 1px solid #e0e4ea; border-radius: 14px; padding: 6px 12px; font-weight: 700; font-size: 13px; box-shadow: 0 2px 8px rgba(0,0,0,.1); margin-bottom: 8px; }
  </style>
<body>
<%- include('partials/top-nav', { pageTitle: '3D Cube Ads', backButton: false }) %>
<div class="container-fluid"><div class="row">
<%- include('partials/sidebar', { activePage: '3d-ads' }) %>
<div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
<div class="content-area">
  <div class="wrap">
    <!-- Telugu help card -->
    <div class="help">
      <b>3D Ads అంటే?</b> ఏ image అయినా upload చేస్తే, అది app లో news కింద <b>3D గా తిరుగుతూ</b> కనిపిస్తుంది.
      దాన్ని tap చేస్తే — Quiz / Train / Games / Viral Videos / ఒక URL / ఒక News కి తెరుచుకుంటుంది.
      ఇక్కడ మార్చిన వెంటనే app లో మారుతుంది (app update అవసరం లేదు). <b>Active చేస్తేనే</b> app లో కనిపిస్తుంది.
    </div>

    <div class="grid">
      <!-- Form -->
      <div class="card">
        <h3 id="formTitle" style="margin-top:0">కొత్త 3D Ad</h3>
        <input type="hidden" id="editId" value="" />

        <label>Title (మీ గుర్తు కోసం)</label>
        <input type="text" id="title" placeholder="ఉదా: Diwali offer banner" />

        <!-- Single image (spin / flip / coin styles) -->
        <div id="singleImageWrap">
          <label>Image / GIF (Plain కి as-is · Cube కి thumbnail)</label>
          <div id="uploadBox">
            <div id="uploadHint">📤 Image upload చేయడానికి ఇక్కడ click చేయండి</div>
            <img id="uploadPreview" style="display:none" />
            <input type="file" id="fileInput" accept="image/*" style="display:none" />
          </div>
        </div>
        <input type="hidden" id="imageUrl" value="" />
        <input type="hidden" id="glbUrl" value="" />

        <!-- 4 side images (cube / dice style). Empty slots → Tehelka logo. -->
        <div id="cubeWrap" style="display:none">
          <label>🎲 Cube sides — 4 images (ఖాళీ side లో Tehelka logo వస్తుంది)</label>
          <div class="cube-slots">
            <div class="cube-slot" data-cube="0"><div class="slot-ph">➕ Side 1 (front)</div><img class="slot-img" style="display:none"/><div class="slot-label">Side 1 · front</div><input type="hidden" class="cube-input" id="cubeImg0"/></div>
            <div class="cube-slot" data-cube="1"><div class="slot-ph">➕ Side 2 (right)</div><img class="slot-img" style="display:none"/><div class="slot-label">Side 2 · right</div><input type="hidden" class="cube-input" id="cubeImg1"/></div>
            <div class="cube-slot" data-cube="2"><div class="slot-ph">➕ Side 3 (back)</div><img class="slot-img" style="display:none"/><div class="slot-label">Side 3 · back</div><input type="hidden" class="cube-input" id="cubeImg2"/></div>
            <div class="cube-slot" data-cube="3"><div class="slot-ph">➕ Side 4 (left)</div><img class="slot-img" style="display:none"/><div class="slot-label">Side 4 · left</div><input type="hidden" class="cube-input" id="cubeImg3"/></div>
          </div>
          <input type="file" id="cubeFileInput" accept="image/*" style="display:none" />
          <div class="muted" style="margin-top:4px">1–4 images పెట్టండి. Top/bottom + ఖాళీ sides కి Tehelka logo ఆటోమేటిక్‌గా వస్తుంది.</div>
        </div>

        <!-- Floating mascot (an animated character that walks/bobs on the card) -->
        <div id="mascotWrap" style="display:none">
          <label>🚶 Mascot — image upload (ఊగుతుంది)</label>
          <div id="mascotBox" style="border:2px dashed #c7cdd4; border-radius:10px; padding:16px; text-align:center; cursor:pointer">
            <div id="mascotHint">📤 Mascot image upload (png/gif — click)</div>
            <img id="mascotPreviewImg" style="display:none; max-width:90px; max-height:90px" />
          </div>
          <input type="file" id="mascotFileInput" accept="image/*" style="display:none" />
          <label style="margin-top:10px">లేదా Lottie <b>.json</b> (lottiefiles నుంచి) — upload లేదా URL</label>
          <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px">
            <button type="button" class="btn-light" id="lottieUploadBtn" style="background:#e8f5e9; color:#1b8a4b">📤 Lottie .json upload</button>
            <span id="lottieUploadStatus" class="muted"></span>
          </div>
          <!-- No accept filter: some OS file pickers hide/grey-out .json. The
               server validates the upload is real JSON, so show all files. -->
          <input type="file" id="lottieFileInput" style="display:none" />
          <input type="text" id="mascotLottieUrl" placeholder="లేదా .json URL paste చేయండి" />
          <input type="hidden" id="mascotUrl" value="" />
          <label style="margin-top:10px">Banner text (optional — చిన్న speech bubble)</label>
          <input type="text" id="bannerText" maxlength="40" placeholder="ఉదా: 50% OFF! · ఇప్పుడే ఆడు!" />
          <div class="muted" style="margin-top:4px">Image లేదా Lottie URL — ఏదో ఒకటి. Mascot card కింద నడుస్తూ/ఊగుతూ కనిపిస్తుంది. Tap చేస్తే target కి వెళ్తుంది.</div>
        </div>

        <!-- Plain style extras: media kind, Lottie/video upload, on-card position -->
        <div id="plainWrap" style="display:none">
          <label>Media రకం</label>
          <select id="plainMedia">
            <option value="image">🖼️ Image / GIF</option>
            <option value="lottie">✨ Lottie (.json animation)</option>
            <option value="video">🎬 Video (auto-play · mute · loop)</option>
          </select>

          <div id="plainLottieWrap" style="display:none; margin-top:8px">
            <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px">
              <button type="button" class="btn-light" id="plainLottieBtn" style="background:#e8f5e9; color:#1b8a4b">📤 Lottie .json upload</button>
              <span id="plainLottieStatus" class="muted"></span>
            </div>
            <input type="file" id="plainLottieFile" style="display:none" />
            <input type="text" id="lottieUrl" placeholder="లేదా .json URL paste చేయండి" />
          </div>

          <div id="plainVideoWrap" style="display:none; margin-top:8px">
            <div id="videoBox" style="border:2px dashed #c7cdd4; border-radius:10px; padding:16px; text-align:center; cursor:pointer">
              <div id="videoHint">📤 Video upload (mp4 / webm — click)</div>
              <video id="videoPreview" style="display:none; max-width:180px; max-height:180px" muted loop autoplay playsinline></video>
            </div>
            <input type="file" id="videoFileInput" accept="video/*" style="display:none" />
            <span id="videoStatus" class="muted"></span>
            <input type="hidden" id="videoUrl" value="" />
          </div>

          <div class="row" style="margin-top:8px">
            <div>
              <label>Position (news card లో ఎక్కడ)</label>
              <select id="plainPosition">
                <option value="below_body">📄 News body కింద (text తర్వాత, inline)</option>
                <option value="top_left">↖ పైన ఎడమ</option>
                <option value="top_center">⬆ పైన మధ్య</option>
                <option value="top_right">↗ పైన కుడి</option>
                <option value="center_left">⬅ మధ్య ఎడమ</option>
                <option value="center">⦿ మధ్య</option>
                <option value="center_right">➡ మధ్య కుడి</option>
                <option value="bottom_left">↙ కింద ఎడమ</option>
                <option value="bottom_center">⬇ కింద మధ్య</option>
                <option value="bottom_right">↘ కింద కుడి (default)</option>
              </select>
            </div>
            <div>
              <label>Width (px · 0 = default)</label>
              <input type="number" id="plainWidth" value="0" min="0" max="1200" />
            </div>
          </div>
          <div class="row">
            <div><label>Nudge X (px · − ఎడమ / + కుడి)</label><input type="number" id="plainOffsetX" value="0" min="-300" max="300" /></div>
            <div><label>Nudge Y (px · − పైకి / + కిందకి)</label><input type="number" id="plainOffsetY" value="0" min="-300" max="300" /></div>
          </div>
          <div id="plainSizeInfo" class="muted" style="margin-top:8px; padding:8px 10px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#14532d"></div>
          <div class="muted" style="margin-top:6px"><b>Width 0 = full width</b> (అన్ని positions కి). px width పెడితే చిన్నదవుతుంది — అప్పుడే ఎడమ/మధ్య/కుడి వర్తిస్తుంది. "News body కింద" = వార్త text తర్వాత inline band. Nudge తో కొంచెం జరపొచ్చు. Video/GIF/Lottie వాటంతట అవే play అవుతాయి.</div>
        </div>

        <div id="embossWrap">
          <div style="margin-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button type="button" class="btn-light" id="embossBtn" onclick="embossGenerate()" style="background:#e8f5e9; color:#1b8a4b">🧊 Image ని నిజమైన 3D (emboss) గా మార్చు</button>
            <span id="embossStatus" class="muted"></span>
          </div>
          <div class="muted" style="margin-top:4px">Emboss అంటే image ని ఉబ్బెత్తుగా (depth తో) నిజమైన 3D model (.glb) గా మారుస్తుంది — ఉచితం, మన server లోనే. పెట్టకపోతే flat image నే 3D గా తిరుగుతుంది.</div>
        </div>

        <div class="row">
          <div>
            <label>Tap చేస్తే ఎక్కడికి?</label>
            <select id="targetType">
              <option value="quiz">Quiz</option>
              <option value="train">Train</option>
              <option value="games">Games</option>
              <option value="viral">Viral Videos</option>
              <option value="url">URL (external)</option>
              <option value="news">News (ఒక వార్త)</option>
            </select>
          </div>
          <div id="targetValueWrap" style="display:none">
            <label id="targetValueLabel">URL</label>
            <input type="text" id="targetValue" placeholder="https://... లేదా newsId" />
          </div>
        </div>

        <div class="row">
          <div>
            <label>Rotation style</label>
            <select id="rotateStyle">
              <option value="static">🖼️ Plain (Image / GIF / Lottie / Video · rotation లేదు)</option>
              <option value="cube">🎲 3D Cube / Dice (4 sides)</option>
            </select>
          </div>
          <div>
            <label>Speed (సెకన్లు / ఒక చుట్టు)</label>
            <input type="number" id="speedSeconds" value="6" min="2" max="30" />
          </div>
          <div>
            <label>Languages <span class="muted">(ఒకటి కంటే ఎక్కువ ఎంచుకోవచ్చు · ఏదీ ఎంచుకోకపోతే = అన్ని భాషలు)</span></label>
            <div id="langChecks" style="display:flex; flex-wrap:wrap; gap:14px; padding:6px 0">
              <label style="font-weight:400"><input type="checkbox" class="langCheck" value="te" /> Telugu</label>
              <label style="font-weight:400"><input type="checkbox" class="langCheck" value="hi" /> Hindi</label>
              <label style="font-weight:400"><input type="checkbox" class="langCheck" value="ta" /> Tamil</label>
              <label style="font-weight:400"><input type="checkbox" class="langCheck" value="en" /> English</label>
            </div>
          </div>
        </div>

        <label style="margin-top:14px">ఏ news cards లో చూపించాలి? <span class="muted">(ముందు భాష, తర్వాత news ఎంచుకోండి · ఎన్ని అయినా · ఖాళీ = ఎక్కడా pin కాదు)</span></label>
        <div id="newsLangTabs" class="lang-tabs"><span class="muted">భాషలు load అవుతున్నాయి…</span></div>
        <select id="newsDropdown"><option value="">— ముందు భాష ఎంచుకోండి —</option></select>
        <div id="newsChips"></div>

        <label style="margin-top:14px"><input type="checkbox" id="allPosts" onchange="onAllPostsToggle()" /> 📰 <b>Show on ALL posts</b> (ప్రతి news కి — pin చేయనవసరం లేదు, కొత్త posts కూడా automatic)</label>
        <label style="margin-top:6px"><input type="checkbox" id="autoSafeDevices" /> 🛡️ <b>Auto-safe devices only</b> (ad news text ని కప్పే devices skip — safe వాటిలోనే చూపిస్తుంది)</label>

        <label style="margin-top:14px"><input type="checkbox" id="isActive" /> Active (app లో చూపించు)</label>

        <div style="margin-top:16px; display:flex; gap:10px">
          <button class="btn-primary" id="saveBtn" onclick="save()">Save</button>
          <button class="btn-light" id="resetBtn" onclick="resetForm()">Clear</button>
          <span id="status" class="muted" style="align-self:center"></span>
        </div>
      </div>

      <!-- Live preview -->
      <div class="card" style="text-align:center">
        <h3 style="margin-top:0">Live Preview</h3>
        <div id="previewHost"><div class="muted" style="padding:40px 0">Image upload చేస్తే ఇక్కడ 3D గా కనిపిస్తుంది</div></div>
      </div>
    </div>

    <!-- App preview + device coverage -->
    <div class="card" style="margin-top:18px" id="coverageCard">
      <h3 style="margin-top:0">📱 App Preview + Device Coverage</h3>
      <div class="muted" style="margin-bottom:6px">News ఎంచుకుంటే — ఈ ad పెడితే ఏ device లో text కనిపిస్తుందో / cube ad కప్పుతుందో ఇక్కడ చూపిస్తుంది. app యొక్క అదే responsive లెక్క వాడుతోంది.</div>
      <div id="covEmpty" class="muted" style="padding:20px 0">👆 పైన ఒక news ఎంచుకోండి (preview + అన్ని devices analysis వస్తుంది).</div>
      <div id="covBody" style="display:none">
        <div class="cov-summary" id="covSummary"></div>
        <div class="cov-wrap">
          <div>
            <div class="phone-pick">
              <label style="margin-top:0">Preview device</label>
              <select id="previewDevice"></select>
            </div>
            <div id="phoneHost"></div>
          </div>
          <div>
            <table class="cov-table">
              <thead><tr><th>Device</th><th>Verdict</th><th>వివరం</th></tr></thead>
              <tbody id="covMatrix"></tbody>
            </table>
            <div class="muted" style="margin-top:8px">⚠️/❌ = ఆ device లో cube ad, description కుడివైపు కప్పుతుంది లేదా text చిన్నగా అవుతుంది. ✅ = బాగుంది.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- List -->
    <div class="card" style="margin-top:18px">
      <h3 style="margin-top:0">ఉన్న 3D Ads</h3>
      <table>
        <thead><tr><th></th><th>Title</th><th>Target</th><th>Style</th><th>Lang</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody id="listBody"><tr><td colspan="7" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const LOGO = '/images/logo.png';

    function cubeInputs() { return [$('cubeImg0'), $('cubeImg1'), $('cubeImg2'), $('cubeImg3')]; }
    function cubeValues() { return cubeInputs().map((el) => el.value.trim()); }

    function buildCubePreview(speed) {
      const v = cubeValues();
      const side = (i) => (v[i] ? v[i] : LOGO);
      const faceCls = (i) => (v[i] ? '' : ' logo');
      const face = (name, url, cls) => '<div class="face ' + name + cls + '"><img src="' + url + '"/></div>';
      return '<div class="ad3d-cubescene"><div class="ad3d-cube" style="--spd:' + speed + 's">' +
        face('front', side(0), faceCls(0)) +
        face('right', side(1), faceCls(1)) +
        face('back', side(2), faceCls(2)) +
        face('left', side(3), faceCls(3)) +
        face('top', LOGO, ' logo') +
        face('bottom', LOGO, ' logo') +
        '</div></div>';
    }

    function getMascotUrl() {
      const lot = $('mascotLottieUrl').value.trim();
      return lot || $('mascotUrl').value.trim();
    }

    function buildPreview(imageUrl, style, speed, glbUrl) {
      const host = $('previewHost');
      if (style === 'mascot') {
        const mu = getMascotUrl();
        const bt = $('bannerText').value.trim();
        if (!mu) { host.innerHTML = '<div class="muted" style="padding:40px 0">Mascot image లేదా Lottie URL పెట్టండి</div>'; return; }
        const bubble = bt ? '<div class="mascot-bubble">' + esc(bt) + '</div><br/>' : '';
        const art = /\.json(\?|$)/i.test(mu)
          ? '<lottie-player src="' + mu + '" background="transparent" speed="1" style="width:150px;height:150px;margin:6px auto" loop autoplay></lottie-player>'
          : '<div class="mascot-bob"><img src="' + mu + '" style="max-width:120px;max-height:120px"/></div>';
        host.innerHTML = '<div style="padding:16px 0">' + bubble + art + '</div>';
        return;
      }
      if (style === 'cube') { host.innerHTML = buildCubePreview(speed); return; }
      if (glbUrl) { // real emboss 3D model
        host.innerHTML = '<model-viewer src="' + glbUrl + '" camera-controls auto-rotate auto-rotate-delay="0" rotation-per-second="40deg" style="width:100%;height:240px;background:#111;border-radius:10px"></model-viewer>';
        return;
      }
      if (!imageUrl) { host.innerHTML = '<div class="muted" style="padding:40px 0">Image upload చేస్తే ఇక్కడ కనిపిస్తుంది</div>'; return; }
      // Plain image: no card, no shadow, no rotation — transparent GIF/PNG shows as-is.
      if (style === 'static') {
        host.innerHTML =
          '<div style="padding:10px 0;text-align:center">' +
          '<img src="' + imageUrl + '" alt="ad" style="max-width:100%;max-height:240px;display:inline-block"/></div>';
        return;
      }
      host.innerHTML =
        '<div class="ad3d-scene style-' + style + '" style="--spd:' + speed + 's">' +
        '<div class="ad3d-rotor"><img src="' + imageUrl + '" alt="ad"/></div></div>';
    }
    function refreshPreview() { buildPreview($('imageUrl').value, $('rotateStyle').value, $('speedSeconds').value || 6, $('glbUrl').value); }

    // Show the right inputs for the chosen style (single-image / cube / mascot).
    function toggleStyleUI() {
      const style = $('rotateStyle').value;
      const cube = style === 'cube';
      const mascot = style === 'mascot'; // no longer selectable; kept so old ads still open
      const isStatic = style === 'static';
      $('cubeWrap').style.display = cube ? 'block' : 'none';
      $('mascotWrap').style.display = mascot ? 'block' : 'none';
      $('plainWrap').style.display = isStatic ? 'block' : 'none';
      // Rotation speed only matters for the cube.
      $('speedSeconds').parentElement.style.display = cube ? 'block' : 'none';
      // Plain has no 3D emboss — hide that option for 'static'.
      $('embossWrap').style.display = (cube || mascot || isStatic) ? 'none' : 'block';
      togglePlainMedia();
      refreshPreview();
    }

    // Plain extras: which media input to show (image / Lottie / video).
    function togglePlainMedia() {
      const style = $('rotateStyle').value;
      const isStatic = style === 'static';
      const m = $('plainMedia').value;
      $('plainLottieWrap').style.display = (isStatic && m === 'lottie') ? 'block' : 'none';
      $('plainVideoWrap').style.display = (isStatic && m === 'video') ? 'block' : 'none';
      const showImage = isStatic ? (m === 'image') : !(style === 'cube' || style === 'mascot');
      $('singleImageWrap').style.display = showImage ? 'block' : 'none';
    }

    // Shared uploader → returns the uploaded media URL.
    async function uploadFile(file) {
      const fd = new FormData(); fd.append('media', file);
      const r = await fetch('/news/upload-media', { method: 'POST', body: fd });
      const data = await r.json();
      return data.mediaUrl || data.imageUrl || '';
    }

    // Cube slots: click → pick file → upload → fill that side.
    let _cubeSlot = -1;
    document.querySelectorAll('.cube-slot').forEach((el) => {
      el.addEventListener('click', () => { _cubeSlot = parseInt(el.getAttribute('data-cube'), 10); $('cubeFileInput').click(); });
    });
    $('cubeFileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file || _cubeSlot < 0) return;
      $('status').textContent = 'Uploading…';
      try {
        const url = await uploadFile(file); if (!url) throw new Error('no url');
        $('cubeImg' + _cubeSlot).value = url;
        const slot = document.querySelector('.cube-slot[data-cube="' + _cubeSlot + '"]');
        slot.querySelector('.slot-img').src = url;
        slot.querySelector('.slot-img').style.display = 'inline-block';
        slot.querySelector('.slot-ph').style.display = 'none';
        $('status').textContent = 'Uploaded ✓';
        refreshPreview();
      } catch (err) { $('status').textContent = 'Upload failed'; }
      finally { e.target.value = ''; }
    });

    async function embossGenerate() {
      const imageUrl = $('imageUrl').value.trim();
      if (!imageUrl) { $('embossStatus').textContent = 'ముందు image upload చేయండి'; return; }
      $('embossBtn').disabled = true; $('embossStatus').textContent = '3D తయారవుతోంది…';
      try {
        const r = await fetch('/3d-ads/api/emboss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageUrl }) });
        const data = await r.json();
        if (!data.ok) throw new Error(data.error || 'failed');
        $('glbUrl').value = data.glbUrl;
        $('embossStatus').textContent = '3D ready ✓ (' + Math.round((data.bytes || 0) / 1024) + ' KB)';
        refreshPreview();
      } catch (e) { $('embossStatus').textContent = 'విఫలం: ' + e.message; }
      finally { $('embossBtn').disabled = false; }
    }

    $('rotateStyle').addEventListener('change', toggleStyleUI);
    $('speedSeconds').addEventListener('input', refreshPreview);

    // Mascot: image upload (bobs) OR a pasted Lottie .json URL (real walk anim).
    $('mascotBox').addEventListener('click', () => $('mascotFileInput').click());
    $('mascotFileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file) return;
      $('status').textContent = 'Uploading…';
      try {
        const url = await uploadFile(file); if (!url) throw new Error('no url');
        $('mascotUrl').value = url;
        $('mascotLottieUrl').value = ''; // image chosen → clear lottie url
        $('mascotPreviewImg').src = url; $('mascotPreviewImg').style.display = 'inline-block';
        $('mascotHint').style.display = 'none';
        $('status').textContent = 'Uploaded ✓';
        refreshPreview();
      } catch (err) { $('status').textContent = 'Upload failed'; }
      finally { e.target.value = ''; }
    });
    $('mascotLottieUrl').addEventListener('input', refreshPreview);
    $('bannerText').addEventListener('input', refreshPreview);

    // Upload a Lottie .json (e.g. from lottiefiles) → stored on R2, used as mascot.
    $('lottieUploadBtn').addEventListener('click', () => $('lottieFileInput').click());
    $('lottieFileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file) return;
      $('lottieUploadStatus').textContent = 'Uploading…';
      try {
        const fd = new FormData(); fd.append('file', file);
        const r = await fetch('/3d-ads/api/upload-lottie', { method: 'POST', body: fd });
        const d = await r.json();
        if (!d.ok || !d.url) throw new Error(d.error || 'failed');
        $('mascotLottieUrl').value = d.url;       // treat as Lottie
        $('mascotUrl').value = '';                 // clear any image
        $('mascotPreviewImg').style.display = 'none'; $('mascotHint').style.display = 'block';
        $('lottieUploadStatus').textContent = 'Uploaded ✓';
        refreshPreview();
      } catch (err) { $('lottieUploadStatus').textContent = 'విఫలం: ' + err.message; }
      finally { e.target.value = ''; }
    });

    // ── Plain extras: media switch, Lottie upload, video upload ──
    $('plainMedia').addEventListener('change', togglePlainMedia);
    $('plainLottieBtn').addEventListener('click', () => $('plainLottieFile').click());
    $('plainLottieFile').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file) return;
      $('plainLottieStatus').textContent = 'Uploading…';
      try {
        const fd = new FormData(); fd.append('file', file);
        const r = await fetch('/3d-ads/api/upload-lottie', { method: 'POST', body: fd });
        const d = await r.json();
        if (!d.ok || !d.url) throw new Error(d.error || 'failed');
        $('lottieUrl').value = d.url;
        $('plainLottieStatus').textContent = 'Uploaded ✓';
        probeLottie(d.url);
      } catch (err) { $('plainLottieStatus').textContent = 'విఫలం: ' + err.message; }
      finally { e.target.value = ''; }
    });
    $('videoBox').addEventListener('click', () => $('videoFileInput').click());
    $('videoFileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file) return;
      $('videoStatus').textContent = 'Uploading… (video కి కొన్ని సెకన్లు పడుతుంది)';
      try {
        const url = await uploadFile(file);
        if (!url) throw new Error('no url');
        $('videoUrl').value = url;
        $('videoPreview').src = url; $('videoPreview').style.display = 'inline-block';
        $('videoHint').style.display = 'none';
        $('videoStatus').textContent = 'Uploaded ✓';
      } catch (err) { $('videoStatus').textContent = 'Upload failed'; }
      finally { e.target.value = ''; }
    });

    // ── Plain size info: media's real size → how big it renders on a phone ──
    let _plainNat = null; // { w, h } of the uploaded media
    function setPlainNat(w, h) { _plainNat = (w > 0 && h > 0) ? { w: w, h: h } : null; updatePlainSizeInfo(); }
    function updatePlainSizeInfo() {
      const el = $('plainSizeInfo'); if (!el) return;
      const pos = $('plainPosition').value;
      const pw = parseInt($('plainWidth').value, 10) || 0;
      const refW = 360 - 12; // typical 360-wide phone minus 6 px side insets
      let W = pw > 0 ? Math.min(pw, refW) : refW;
      if (!_plainNat) {
        el.innerHTML = '📐 App లో width ≈ <b>' + Math.round(W) + ' px</b> (360-wide phone · 0 = full width). Media upload చేస్తే height కూడా చూపిస్తా.<br>సిఫారసు: full-width banner కి <b>1080×360</b> (3:1) లేదా <b>1080×460</b> (2.35:1).';
        return;
      }
      const a = _plainNat.w / _plainNat.h;
      let H = W / a;
      const cap = pos === 'below_body' ? 240 : W * 4 / 3;
      let capped = false;
      if (H > cap) { H = cap; W = H * a; capped = true; }
      el.innerHTML = '📐 Media: <b>' + _plainNat.w + '×' + _plainNat.h + '</b> (' + a.toFixed(2) + ':1) → App లో (360-wide phone): <b>' + Math.round(W) + '×' + Math.round(H) + ' px</b>' +
        (capped ? '<br><span style="color:#b45309">⚠ Height cap (' + Math.round(cap) + 'px) వల్ల width తగ్గింది — full width కావాలంటే wider aspect (ఉదా 3:1) వాడండి.</span>' : '') +
        '<br>Width 0 = full width. సిఫారసు: <b>1080×360</b> (3:1) / <b>1080×460</b> (2.35:1). Body కింద max height 240px; overlay max height = width × 4/3.';
    }
    async function probeLottie(url) {
      if (!url) { setPlainNat(0, 0); return; }
      try { const r = await fetch(url); const j = await r.json(); setPlainNat(Number(j.w) || 0, Number(j.h) || 0); }
      catch (_) { setPlainNat(0, 0); }
    }
    $('uploadPreview').addEventListener('load', () => { if ($('plainMedia').value === 'image') setPlainNat($('uploadPreview').naturalWidth, $('uploadPreview').naturalHeight); });
    $('videoPreview').addEventListener('loadedmetadata', () => { if ($('plainMedia').value === 'video') setPlainNat($('videoPreview').videoWidth, $('videoPreview').videoHeight); });
    $('lottieUrl').addEventListener('change', () => probeLottie($('lottieUrl').value.trim()));
    $('plainWidth').addEventListener('input', updatePlainSizeInfo);
    $('plainPosition').addEventListener('change', updatePlainSizeInfo);
    $('plainMedia').addEventListener('change', () => {
      const m = $('plainMedia').value;
      if (m === 'image' && $('uploadPreview').naturalWidth) setPlainNat($('uploadPreview').naturalWidth, $('uploadPreview').naturalHeight);
      else if (m === 'video' && $('videoPreview').videoWidth) setPlainNat($('videoPreview').videoWidth, $('videoPreview').videoHeight);
      else if (m === 'lottie' && $('lottieUrl').value.trim()) probeLottie($('lottieUrl').value.trim());
      else setPlainNat(0, 0);
    });

    // ── News picker: language tabs → news dropdown → chips (+ live preview) ──
    let _newsByLang = {};   // langCode -> [newsObj]
    let _newsIndex = {};    // id -> newsObj
    let _currentLang = '';
    let _focusNews = null;  // the news shown in the preview
    let _displayCfg = {};   // langCode -> {titleFontSize, contentFontSize, titleLineHeight, contentLineHeight}

    async function loadLangsAndConfig() {
      try {
        const [lr, cr] = await Promise.all([
          fetch('/api/public/languages'),
          fetch('/api/public/news-display-config'),
        ]);
        const langs = await lr.json();
        (await cr.json()).forEach((c) => { _displayCfg[c.code] = c; });
        const tabs = $('newsLangTabs');
        tabs.innerHTML = (langs || []).map((l) =>
          '<button type="button" class="lang-tab" data-code="' + l.code + '">' + esc(l.nativeName || l.name) + '</button>'
        ).join('') || '<span class="muted">భాషలు లేవు</span>';
        tabs.querySelectorAll('.lang-tab').forEach((b) => b.addEventListener('click', () => selectLang(b.dataset.code)));
      } catch (e) { $('newsLangTabs').innerHTML = '<span class="muted">భాషలు load కాలేదు</span>'; }
    }

    async function selectLang(code) {
      _currentLang = code;
      document.querySelectorAll('#newsLangTabs .lang-tab').forEach((b) => b.classList.toggle('active', b.dataset.code === code));
      const dd = $('newsDropdown');
      dd.innerHTML = '<option value="">Loading…</option>';
      let list = _newsByLang[code];
      if (!list) {
        try {
          const r = await fetch('/admin/api/notification-studio/news?language=' + encodeURIComponent(code));
          list = (await r.json()).news || [];
          _newsByLang[code] = list;
          list.forEach((n) => { _newsIndex[n.id] = n; });
        } catch (e) { list = []; }
      }
      dd.innerHTML = '<option value="">— ' + list.length + ' news — ఎంచుకోండి —</option>' +
        list.map((n) => '<option value="' + n.id + '">' + esc((n.title || '').slice(0, 70)) + '</option>').join('');
    }
    $('newsDropdown').addEventListener('change', () => {
      const id = $('newsDropdown').value; if (!id) return;
      const n = _newsIndex[id];
      pickNews(id, n ? n.title : id);
      if (n) setFocusNews(n);
      $('newsDropdown').value = '';
    });

    // Multiple chosen news cards (the ad's cube shows on ALL of them).
    let _chosenNews = []; // [{id, title}]
    function renderChips() {
      $('newsChips').innerHTML = _chosenNews.map((n) =>
        '<span class="news-chip"><span class="ct" title="' + esc(n.title) + '" data-id="' + n.id + '">🎯 ' + esc(n.title) + '</span>' +
        '<span class="cx" data-id="' + n.id + '">✕</span></span>'
      ).join('');
    }
    $('newsChips').addEventListener('click', (e) => {
      const x = e.target.closest('.cx');
      if (x) { removeNews(x.dataset.id); return; }
      const t = e.target.closest('.ct'); // click a chip name → preview it
      if (t && _newsIndex[t.dataset.id]) setFocusNews(_newsIndex[t.dataset.id]);
    });
    function pickNews(id, title) {
      if (!_chosenNews.some((n) => n.id === id)) _chosenNews.push({ id: id, title: title || id });
      renderChips();
    }
    function removeNews(id) { _chosenNews = _chosenNews.filter((n) => n.id !== id); renderChips(); }
    function setChosenNews(list) { _chosenNews = (list || []).slice(); renderChips(); }
    function clearNews() { _chosenNews = []; renderChips(); _focusNews = null; renderCoverage(); }

    // ── App preview + device coverage (ports the app's responsive metrics) ──
    const CH_PAD = 9, IMG_TITLE_GAP = 8, BOTTOM_BAR = 92, TC_SPACING = 4;
    const AD_W = 96, AD_H = 128, AD_RIGHT = 6, AD_BOTTOM = 96; // 9:12 (3:4) ad box — taller
    const DEF_CFG = { titleFontSize: 18, contentFontSize: 16, titleLineHeight: 1.3, contentLineHeight: 1.6 };
    // 6 device-size CATEGORIES the app can actually detect (by width/height).
    // Each real phone/tablet falls into exactly one. Representative size used for
    // the preview + analysis. key is saved in the ad's deviceSizes.
    const CATS = [
      { key: 'small',    n: 'Small phone',      ex: '~320×480',       w: 320, h: 480 },
      { key: 'compact',  n: 'Compact phone',    ex: '~360×640',       w: 360, h: 640 },
      { key: 'standard', n: 'Standard phone',   ex: '~360×740',       w: 360, h: 740 },
      { key: 'large',    n: 'Large phone',      ex: 'iPhone / Pixel', w: 393, h: 851 },
      { key: 'xlarge',   n: 'Extra-large phone',ex: 'big Android/Max',w: 428, h: 926 },
      { key: 'tablet',   n: 'Tablet',           ex: '768×1024+',      w: 768, h: 1024 },
    ];
    let _devSel = new Set(CATS.map((c) => c.key)); // all categories ON by default
    // Empty array = all devices (so a "show everywhere" ad stays future-proof).
    function getDeviceSizes() { return _devSel.size >= CATS.length ? [] : [..._devSel]; }
    // Selected target languages ([] = all). Accepts a legacy single `language`.
    function getLanguages() {
      return [...document.querySelectorAll('.langCheck:checked')].map((c) => c.value);
    }
    function setLanguages(arr, legacy) {
      const set = new Set((arr && arr.length ? arr : (legacy ? [legacy] : [])).map((s) => String(s).toLowerCase()));
      document.querySelectorAll('.langCheck').forEach((c) => { c.checked = set.has(c.value); });
    }
    // When "all posts" is on, per-news pinning is handled by the server — grey it out.
    function onAllPostsToggle() {
      const on = $('allPosts') && $('allPosts').checked;
      if ($('newsDropdown')) $('newsDropdown').disabled = !!on;
    }
    function setDeviceSizes(arr) {
      _devSel = (arr && arr.length) ? new Set(arr) : new Set(CATS.map((c) => c.key));
      if (_focusNews) renderCoverage();
    }
    function cfgFor(lang) { return _displayCfg[lang] || _displayCfg[String(lang || '').toLowerCase()] || DEF_CFG; }

    function phoneMetrics(w, h) {
      let frac, ts = 1, cs = 1, bp = BOTTOM_BAR;
      if (h < 360) { frac = .24; ts = .89; cs = .89; bp = 68; }
      else if (h < 520) { frac = .28; ts = .94; cs = .94; bp = 76; }
      else if (h < 640) { frac = .32; bp = 84; }
      else if (h < 760) { frac = .36; bp = 88; }
      else { frac = .40; bp = 92; }
      let mh = Math.min(Math.max(h * frac, 72), h * 0.45);
      mh = Math.min(mh, w / 1.15);
      return { mediaHeight: mh, bottomPad: bp, titleScale: ts, contentScale: cs };
    }

    // Estimate the app's shrink-to-fit + how much the bottom-right cube ad covers.
    function analyze(dev, news, cfg) {
      const w = dev.w, h = dev.h;
      if (Math.min(w, h) >= 600) return { verdict: 'ok', note: 'టాబ్లెట్ — విశాలం, clip/overlap దాదాపు ఉండదు', shrink: 1 };
      const m = phoneMetrics(w, h);
      const titleSize = cfg.titleFontSize * m.titleScale;
      const contentSize = cfg.contentFontSize * m.contentScale;
      const cw = w - 2 * CH_PAD;
      const tCPL = Math.max(8, Math.floor(cw / (titleSize * 0.55)));
      const cCPL = Math.max(8, Math.floor(cw / (contentSize * 0.52)));
      const tLines = Math.max(1, Math.ceil(news.titleLen / tCPL));
      const cLines = Math.max(1, Math.ceil(news.contentLen / cCPL));
      const titleH = tLines * titleSize * cfg.titleLineHeight;
      const contentH = cLines * contentSize * cfg.contentLineHeight;
      const textTop = m.mediaHeight + IMG_TITLE_GAP;
      const availH = h - textTop - TC_SPACING - m.bottomPad;
      const neededH = titleH + TC_SPACING + contentH;
      let shrink = neededH > availH ? Math.max(availH / neededH, 0.6) : 1;
      const descTop = textTop + titleH * shrink + TC_SPACING;
      const descBottom = Math.min(descTop + contentH * shrink, h - m.bottomPad);
      const adTopY = h - AD_BOTTOM - AD_H, adBottomY = h - AD_BOTTOM;
      const ovH = Math.max(0, Math.min(adBottomY, descBottom) - Math.max(adTopY, descTop));
      const lineH = contentSize * cfg.contentLineHeight * shrink;
      const ovLines = lineH > 0 ? ovH / lineH : 0;
      let verdict, note;
      if (shrink < 0.8) { verdict = 'bad'; note = 'Text ' + Math.round(shrink * 100) + '% కి shrink + ad కప్పుతుంది'; }
      else if (ovLines >= 3) { verdict = 'bad'; note = 'Cube ad ~' + Math.round(ovLines) + ' lines కుడివైపు కప్పుతుంది'; }
      else if (ovLines >= 0.5) { verdict = 'warn'; note = 'చివరి ~' + Math.max(1, Math.round(ovLines)) + ' line(s) కుడివైపు కొంచెం కప్పుతుంది'; }
      else { verdict = 'ok'; note = 'Text clear — ad ఖాళీలో కూర్చుంటుంది'; }
      return { verdict, note, shrink, ovLines };
    }

    function setFocusNews(n) {
      _focusNews = {
        id: n.id, title: n.title || '', content: n.content || n.summary || '', image: n.image || '',
        language: n.language || _currentLang || 'te',
        titleLen: (n.title || '').length, contentLen: (n.content || n.summary || '').length,
      };
      if (!$('previewDevice').options.length) {
        $('previewDevice').innerHTML = CATS.map((d, i) =>
          '<option value="' + i + '"' + (i === 2 ? ' selected' : '') + '>' + d.n + ' (' + d.ex + ')</option>').join('');
        $('previewDevice').addEventListener('change', renderPhone);
      }
      renderCoverage();
    }

    function renderCoverage() {
      const has = !!_focusNews;
      $('covEmpty').style.display = has ? 'none' : 'block';
      $('covBody').style.display = has ? 'block' : 'none';
      if (!has) return;
      const cfg = cfgFor(_focusNews.language);
      let bad = 0, warn = 0; // counted among SELECTED (ticked) categories only
      $('covMatrix').innerHTML = CATS.map((d) => {
        const a = analyze(d, _focusNews, cfg);
        const on = _devSel.has(d.key);
        if (on) { if (a.verdict === 'bad') bad++; else if (a.verdict === 'warn') warn++; }
        const cls = a.verdict === 'ok' ? 'vd-ok' : (a.verdict === 'warn' ? 'vd-warn' : 'vd-bad');
        const lbl = a.verdict === 'ok' ? '✅ Safe' : (a.verdict === 'warn' ? '⚠️ Covers' : '❌ Covers');
        const cell = '<label style="display:flex;align-items:center;gap:7px;cursor:pointer">' +
          '<input type="checkbox" class="dev-tick" data-key="' + d.key + '"' + (on ? ' checked' : '') + ' style="width:auto"/> ' +
          '<span>' + d.n + ' <span class="muted">' + d.ex + '</span></span></label>';
        const note = on ? a.note : '<span class="muted">— ఈ device లో చూపించట్లేదు —</span>';
        const style = on ? '' : ' style="opacity:.45"';
        return '<tr' + style + '><td>' + cell + '</td><td><span class="vd ' + cls + '">' + lbl + '</span></td><td>' + note + '</td></tr>';
      }).join('');
      const s = $('covSummary');
      if (_devSel.size === 0) { s.className = 'cov-summary vd-bad'; s.textContent = '❌ ఏ device కూడా tick చెయ్యలేదు — ఈ ad ఎక్కడా కనిపించదు.'; }
      else if (bad > 0) { s.className = 'cov-summary vd-bad'; s.textContent = '❌ మీరు ఎంచుకున్న ' + bad + ' device size(s) లో cube ad text ని ఎక్కువ కప్పుతుంది' + (warn ? (' · ⚠️ ' + warn + ' లో కొంచెం') : '') + '. వాటిని untick చెయ్యండి లేదా description పొట్టిగా ఉంచండి.'; }
      else if (warn > 0) { s.className = 'cov-summary vd-warn'; s.textContent = '⚠️ ఎంచుకున్న ' + warn + ' device size(s) లో చివరి line(s) కుడివైపు కొంచెం కప్పుతుంది. మిగతావి బాగున్నాయి.'; }
      else { s.className = 'cov-summary vd-ok'; s.textContent = '✅ మీరు ఎంచుకున్న అన్ని device sizes లో బాగుంది — ad, text ని కప్పదు.'; }
      renderPhone();
    }

    function renderPhone() {
      if (!_focusNews) return;
      const di = parseInt($('previewDevice').value || '2', 10);
      const d = CATS[di] || CATS[2];
      const cfg = cfgFor(_focusNews.language);
      const tablet = Math.min(d.w, d.h) >= 600;
      const m = tablet ? { mediaHeight: d.h * 0.4, bottomPad: 92, titleScale: 1.5, contentScale: 1.4 } : phoneMetrics(d.w, d.h);
      const scale = 230 / d.w;
      const px = (v) => (v * scale).toFixed(1) + 'px';
      let titleSize = cfg.titleFontSize * m.titleScale;
      let contentSize = cfg.contentFontSize * m.contentScale;
      // mirror the app's shrink-to-fit so the preview matches reality
      if (!tablet) {
        const cw = d.w - 2 * CH_PAD;
        const tCPL = Math.max(8, Math.floor(cw / (titleSize * 0.55)));
        const cCPL = Math.max(8, Math.floor(cw / (contentSize * 0.52)));
        const tLines = Math.max(1, Math.ceil(_focusNews.titleLen / tCPL));
        const cLines = Math.max(1, Math.ceil(_focusNews.contentLen / cCPL));
        const needed = tLines * titleSize * cfg.titleLineHeight + TC_SPACING + cLines * contentSize * cfg.contentLineHeight;
        const avail = d.h - (m.mediaHeight + IMG_TITLE_GAP) - TC_SPACING - m.bottomPad;
        const shrink = needed > avail ? Math.max(avail / needed, 0.6) : 1;
        titleSize *= shrink; contentSize *= shrink;
      }
      const img = _focusNews.image
        ? '<img class="pmedia" src="' + esc(_focusNews.image) + '" style="height:' + px(m.mediaHeight) + '"/>'
        : '<div class="pmedia" style="height:' + px(m.mediaHeight) + '"></div>';
      $('phoneHost').innerHTML =
        '<div class="phone" style="width:' + px(d.w) + ';height:' + px(d.h) + '">' +
          img +
          '<div class="ptxt" style="padding:' + px(6) + ' ' + px(CH_PAD) + '">' +
            '<div class="ptitle" style="font-size:' + px(titleSize) + ';line-height:' + cfg.titleLineHeight + '">' + esc(_focusNews.title) + '</div>' +
            '<div class="pdesc" style="font-size:' + px(contentSize) + ';line-height:' + cfg.contentLineHeight + '">' + esc(_focusNews.content) + '</div>' +
          '</div>' +
          '<div class="pbar" style="height:' + px(m.bottomPad) + '"></div>' +
          '<div class="adbox" style="right:' + px(AD_RIGHT) + ';bottom:' + px(AD_BOTTOM) + ';width:' + px(AD_W) + ';height:' + px(AD_H) + ';font-size:' + px(20) + '">3D<br/>AD</div>' +
        '</div>';
    }
    $('targetType').addEventListener('change', () => {
      const t = $('targetType').value;
      const show = (t === 'url' || t === 'news');
      $('targetValueWrap').style.display = show ? 'block' : 'none';
      $('targetValueLabel').textContent = t === 'news' ? 'News ID' : 'URL';
    });

    // ── Image upload (reuses the shared /news/upload-media endpoint) ──
    $('uploadBox').addEventListener('click', () => $('fileInput').click());
    $('fileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      $('status').textContent = 'Uploading…';
      try {
        const fd = new FormData();
        fd.append('media', file);
        const r = await fetch('/news/upload-media', { method: 'POST', body: fd });
        const data = await r.json();
        const url = data.mediaUrl || data.imageUrl || '';
        if (!url) throw new Error('no url');
        $('imageUrl').value = url;
        $('glbUrl').value = ''; // new image → old emboss model no longer matches
        $('embossStatus').textContent = '';
        $('uploadPreview').src = url; $('uploadPreview').style.display = 'inline-block';
        $('uploadHint').style.display = 'none';
        $('status').textContent = 'Uploaded ✓';
        refreshPreview();
      } catch (err) { $('status').textContent = 'Upload failed'; }
    });

    async function save() {
      const style = $('rotateStyle').value;
      const cubeImages = cubeValues().filter(Boolean);
      const body = {
        title: $('title').value.trim(),
        imageUrl: $('imageUrl').value.trim(),
        glbUrl: $('glbUrl').value.trim(),
        cubeImages: cubeImages,
        displayNewsIds: _chosenNews.map((n) => n.id),
        targetType: $('targetType').value,
        targetValue: $('targetValue').value.trim(),
        rotateStyle: style,
        speedSeconds: parseInt($('speedSeconds').value, 10) || 6,
        language: '',
        languages: getLanguages(),
        deviceSizes: getDeviceSizes(),
        allPosts: $('allPosts').checked,
        autoSafeDevices: $('autoSafeDevices').checked,
        mascotUrl: getMascotUrl(),
        bannerText: $('bannerText').value.trim(),
        plainMedia: $('plainMedia').value,
        plainPosition: $('plainPosition').value,
        plainOffsetX: parseInt($('plainOffsetX').value, 10) || 0,
        plainOffsetY: parseInt($('plainOffsetY').value, 10) || 0,
        plainWidth: parseInt($('plainWidth').value, 10) || 0,
        lottieUrl: $('lottieUrl').value.trim(),
        videoUrl: $('videoUrl').value.trim(),
        isActive: $('isActive').checked,
      };
      // Cube: at least one side image; imageUrl (thumbnail) defaults to it.
      if (style === 'cube') {
        if (!cubeImages.length) { $('status').textContent = 'కనీసం 1 side image పెట్టండి'; return; }
        if (!body.imageUrl) body.imageUrl = cubeImages[0];
      }
      // Mascot: needs an image OR a Lottie URL; that becomes the thumbnail too.
      if (style === 'mascot') {
        if (!body.mascotUrl) { $('status').textContent = 'Mascot image లేదా Lottie URL పెట్టండి'; return; }
        if (!body.imageUrl) body.imageUrl = body.mascotUrl;
      }
      // Plain: the chosen media must be present; the thumbnail falls back to it.
      if (style === 'static') {
        if (body.plainMedia === 'lottie' && !body.lottieUrl) { $('status').textContent = 'Lottie .json upload లేదా URL పెట్టండి'; return; }
        if (body.plainMedia === 'video' && !body.videoUrl) { $('status').textContent = 'Video upload చేయండి'; return; }
        if (body.plainMedia === 'image' && !body.imageUrl) { $('status').textContent = 'Image / GIF upload చేయండి'; return; }
        if (!body.imageUrl) body.imageUrl = body.lottieUrl || body.videoUrl;
      }
      if (!body.title || !body.imageUrl) { $('status').textContent = 'Title + Image కావాలి'; return; }
      const id = $('editId').value;
      $('saveBtn').disabled = true; $('status').textContent = 'Saving…';
      try {
        const r = await fetch(id ? ('/3d-ads/api/' + id) : '/3d-ads/api', {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await r.json();
        if (!data.ok) throw new Error(data.error || 'failed');
        $('status').textContent = 'Saved ✓';
        resetForm(); loadList();
      } catch (err) { $('status').textContent = 'Save failed: ' + err.message; }
      finally { $('saveBtn').disabled = false; }
    }

    // Fill the 4 cube slots from an array (empty = placeholder).
    function setCubeSlots(images) {
      const arr = images || [];
      cubeInputs().forEach((input, i) => {
        const url = (arr[i] || '').trim();
        input.value = url;
        const slot = document.querySelector('.cube-slot[data-cube="' + i + '"]');
        const img = slot.querySelector('.slot-img'), ph = slot.querySelector('.slot-ph');
        if (url) { img.src = url; img.style.display = 'inline-block'; ph.style.display = 'none'; }
        else { img.style.display = 'none'; ph.style.display = 'block'; }
      });
    }

    function resetForm() {
      ['title', 'imageUrl', 'glbUrl', 'targetValue'].forEach((id) => $(id).value = '');
      setCubeSlots([]); clearNews(); setDeviceSizes([]);
      $('mascotUrl').value = ''; $('mascotLottieUrl').value = ''; $('bannerText').value = '';
      $('mascotPreviewImg').style.display = 'none'; $('mascotHint').style.display = 'block';
      $('editId').value = ''; $('targetType').value = 'quiz'; $('rotateStyle').value = 'static';
      $('speedSeconds').value = 6; setLanguages([], ''); $('isActive').checked = false;
      $('allPosts').checked = false; $('autoSafeDevices').checked = false; onAllPostsToggle();
      $('targetValueWrap').style.display = 'none';
      $('uploadPreview').style.display = 'none'; $('uploadHint').style.display = 'block';
      $('embossStatus').textContent = '';
      $('formTitle').textContent = 'కొత్త 3D Ad'; $('status').textContent = '';
      $('plainMedia').value = 'image'; $('plainPosition').value = 'bottom_right';
      $('plainOffsetX').value = 0; $('plainOffsetY').value = 0; $('plainWidth').value = 0;
      $('lottieUrl').value = ''; $('videoUrl').value = ''; $('plainLottieStatus').textContent = ''; $('videoStatus').textContent = '';
      $('videoPreview').style.display = 'none'; $('videoPreview').removeAttribute('src'); $('videoHint').style.display = 'block';
      setPlainNat(0, 0);
      toggleStyleUI();
    }

    function editAd(a) {
      $('editId').value = a._id; $('title').value = a.title || ''; $('imageUrl').value = a.imageUrl || '';
      $('glbUrl').value = a.glbUrl || ''; $('embossStatus').textContent = a.glbUrl ? '3D model ఉంది ✓' : '';
      $('targetType').value = a.targetType || 'quiz'; $('targetValue').value = a.targetValue || '';
      // spin / flip / coin / mascot are retired → open them as Plain.
      $('rotateStyle').value = (a.rotateStyle === 'cube') ? 'cube' : 'static'; $('speedSeconds').value = a.speedSeconds || 6;
      setLanguages(a.languages || [], a.language || ''); $('isActive').checked = !!a.isActive;
      $('allPosts').checked = !!a.allPosts; $('autoSafeDevices').checked = !!a.autoSafeDevices;
      onAllPostsToggle();
      setDeviceSizes(a.deviceSizes || []);
      setCubeSlots(a.cubeImages || []);
      // Mascot fields
      $('bannerText').value = a.bannerText || '';
      const mu = a.mascotUrl || '';
      if (/\.json(\?|$)/i.test(mu)) { $('mascotLottieUrl').value = mu; $('mascotUrl').value = ''; $('mascotPreviewImg').style.display = 'none'; $('mascotHint').style.display = 'block'; }
      else if (mu) { $('mascotUrl').value = mu; $('mascotLottieUrl').value = ''; $('mascotPreviewImg').src = mu; $('mascotPreviewImg').style.display = 'inline-block'; $('mascotHint').style.display = 'none'; }
      else { $('mascotUrl').value = ''; $('mascotLottieUrl').value = ''; $('mascotPreviewImg').style.display = 'none'; $('mascotHint').style.display = 'block'; }
      // Plain extras
      $('plainMedia').value = a.plainMedia || 'image';
      $('plainPosition').value = a.plainPosition || 'bottom_right';
      $('plainOffsetX').value = a.plainOffsetX || 0; $('plainOffsetY').value = a.plainOffsetY || 0;
      $('plainWidth').value = a.plainWidth || 0;
      $('lottieUrl').value = a.lottieUrl || ''; $('videoUrl').value = a.videoUrl || '';
      $('plainLottieStatus').textContent = ''; $('videoStatus').textContent = '';
      if (a.videoUrl) { $('videoPreview').src = a.videoUrl; $('videoPreview').style.display = 'inline-block'; $('videoHint').style.display = 'none'; }
      else { $('videoPreview').style.display = 'none'; $('videoPreview').removeAttribute('src'); $('videoHint').style.display = 'block'; }
      if ((a.plainMedia || 'image') === 'lottie' && a.lottieUrl) probeLottie(a.lottieUrl); else updatePlainSizeInfo();
      // Load pinned news (array + legacy single), as chips. Titles aren't stored,
      // so show a short id label.
      const ids = (a.displayNewsIds || []).slice();
      if (a.displayNewsId && !ids.includes(a.displayNewsId)) ids.push(a.displayNewsId);
      setChosenNews(ids.map((id) => ({ id: id, title: 'News (' + String(id).slice(-6) + ')' })));
      const show = (a.targetType === 'url' || a.targetType === 'news');
      $('targetValueWrap').style.display = show ? 'block' : 'none';
      $('targetValueLabel').textContent = a.targetType === 'news' ? 'News ID' : 'URL';
      $('uploadPreview').src = a.imageUrl; $('uploadPreview').style.display = 'inline-block'; $('uploadHint').style.display = 'none';
      $('formTitle').textContent = 'Edit: ' + (a.title || '');
      toggleStyleUI(); window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function toggleAd(id) { await fetch('/3d-ads/api/' + id + '/toggle', { method: 'POST' }); loadList(); }
    async function delAd(id) { if (!confirm('Delete this 3D ad?')) return; await fetch('/3d-ads/api/' + id, { method: 'DELETE' }); loadList(); }

    async function loadList() {
      try {
        const r = await fetch('/3d-ads/api/list');
        const data = await r.json();
        const rows = (data.ads || []).map((a) => {
          const target = a.targetType + (a.targetValue ? (': ' + a.targetValue.slice(0, 24)) : '');
          return '<tr>' +
            '<td><img class="thumb" src="' + a.imageUrl + '"/></td>' +
            '<td>' + esc(a.title) + '</td>' +
            '<td>' + esc(target) + '</td>' +
            '<td>' + a.rotateStyle + '</td>' +
            '<td>' + ((a.languages && a.languages.length) ? a.languages.join(', ') : (a.language || 'all')) + '</td>' +
            '<td><span class="pill ' + (a.isActive ? 'on">ON' : 'off">OFF') + '</span></td>' +
            '<td>' +
              '<button class="btn-light" onclick=\'editAd(' + JSON.stringify(a).replace(/'/g, "&#39;") + ')\'>Edit</button> ' +
              '<button class="btn-light" onclick="toggleAd(\'' + a._id + '\')">' + (a.isActive ? 'Turn off' : 'Turn on') + '</button> ' +
              '<button class="btn-danger" onclick="delAd(\'' + a._id + '\')">Delete</button>' +
            '</td></tr>';
        }).join('');
        $('listBody').innerHTML = rows || '<tr><td colspan="7" class="muted">ఇంకా ఏ 3D ad లేదు</td></tr>';
      } catch (e) { $('listBody').innerHTML = '<tr><td colspan="7" class="muted">Failed to load</td></tr>'; }
    }
    function esc(s) { return String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }

    // Tick / untick a device size → the cube ad shows ONLY on ticked sizes.
    $('covMatrix').addEventListener('change', (e) => {
      const cb = e.target.closest('.dev-tick'); if (!cb) return;
      if (cb.checked) _devSel.add(cb.dataset.key); else _devSel.delete(cb.dataset.key);
      renderCoverage();
    });

    loadList();
    toggleStyleUI();
    loadLangsAndConfig();
  </script>
  </div></div></div></div>
  <%- include('partials/footer') %>
  <script>(function(){var t=document.getElementById('menuToggle'),s=document.getElementById('sidebar'),m=document.getElementById('mainContent');if(t&&s)t.addEventListener('click',function(e){e.stopPropagation();s.classList.toggle('active');if(m)m.classList.toggle('sidebar-active');});})();</script>
</body>
</html>
