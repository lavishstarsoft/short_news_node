<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'News List' }) %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="/css/editors-directory.css">
    <link rel="stylesheet" href="/css/news-directory.css">
    <link rel="stylesheet" href="/css/news-detail-modal.css">
    <link rel="stylesheet" href="/css/notification-modal.css">
    <style>
        /* News detail modal — styles in news-detail-modal.css */

        /* Detail view styles (legacy helpers) */
        .detail-section {
            margin-bottom: 1.5rem;
        }

        .detail-section-header {
            border-bottom: 1px solid #eee;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        .interaction-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .interaction-item:last-child {
            border-bottom: none;
        }

        .comment-item {
            padding: 1rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .comment-item:last-child {
            border-bottom: none;
        }

        /* Scrollable sections */
        .scrollable-section {
            max-height: 300px;
            overflow-y: auto;
        }

        /* Styling tags visualization in editor */
        .rich-content-area b { font-weight: bold; }
        .rich-content-area font { }
        .rich-content-area big { font-size: 1.25em; font-weight: 500; }
    </style>
    </head>

    <body>
        <% if (typeof isImpersonating === 'undefined' || !isImpersonating) { %>
            <%- include('partials/top-nav', { pageTitle: 'News List' , backButton: true, backUrl: '/' }) %>
        <% } %>
            <% const selectedAuthorIdSafe = (typeof selectedAuthorId !== 'undefined' && selectedAuthorId) ? selectedAuthorId : ''; %>

            <div class="container-fluid">
                <div class="row">
                    <% if (typeof isImpersonating === 'undefined' || !isImpersonating) { %>
                        <!-- Sidebar -->
                        <%- include('partials/sidebar', { activePage: 'news-list' }) %>
                        
                        <!-- Main Content -->
                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                    <% } else { %>
                        <!-- Main Content (Full Width) -->
                        <div class="col-12 px-md-4 main-content" id="mainContent" style="margin-left: 0 !important;">
                    <% } %>
                            <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
                                <div class="alert alert-warning mb-4 mt-3 shadow-sm d-flex justify-content-between align-items-center" role="alert">
                                    <div>
                                        <i class="fas fa-user-secret me-2 fs-5"></i>
                                        <strong>Impersonation Mode:</strong> You are securely viewing the dashboard of <strong><%= admin.name || admin.username %></strong>.
                                    </div>
                                    <a href="/news" class="btn btn-sm btn-outline-dark fw-bold px-3">
                                        <i class="fas fa-sign-out-alt me-1"></i> Exit Impersonation
                                    </a>
                                </div>
                            <% } %>
                            <% if (typeof isImpersonating !== 'undefined' && isImpersonating && typeof impersonationMetrics !== 'undefined') { %>
                                <div class="row mb-4">
                                    <div class="col-md-3">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Total News</div>
                                                <h2 class="display-6 fw-bold mb-0 text-dark"><%= impersonationMetrics.totalNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Today</div>
                                                <h2 class="fw-bold mb-0 text-primary" style="font-size: 2rem;"><%= impersonationMetrics.todayNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Yesterday</div>
                                                <h2 class="fw-bold mb-0 text-info" style="font-size: 2rem;"><%= impersonationMetrics.yesterdayNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">7 Days</div>
                                                <h2 class="fw-bold mb-0 text-success" style="font-size: 2rem;"><%= impersonationMetrics.sevenDaysNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card shadow-sm border-0 rounded-4 h-100" style="background: linear-gradient(135deg, #e0c3fc, #8ec5fc);">
                                            <div class="card-body py-2 d-flex flex-column justify-content-center align-items-center">
                                                <div class="text-white fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Custom Range</div>
                                                <input type="text" id="customDateRangePicker" class="form-control form-control-sm border-0 shadow-none bg-white text-center rounded-3 mb-1" placeholder="Select dates..." style="max-width: 170px; font-weight: bold; color: #495057; font-size: 0.8rem; cursor: pointer;">
                                                <h2 class="fw-bold mb-0 text-white" id="customNewsCountDisplay" style="font-size: 2rem;">-</h2>
                                                <button id="downloadPdfBtn" class="btn btn-sm btn-light mt-1 fw-bold text-primary shadow-sm" style="display:none; font-size: 0.75rem;"><i class="fas fa-file-pdf text-danger"></i> Download PDF</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-4 justify-content-center">
                                    <div class="col-md-3">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Pending</div>
                                                <h2 class="fw-bold mb-0 text-warning" style="font-size: 2rem;" id="pendingCountDisplay"><%= impersonationMetrics.pendingNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card shadow-sm text-center border-0 rounded-4 h-100">
                                            <div class="card-body py-3 d-flex flex-column justify-content-center">
                                                <div class="text-muted fw-bold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Rejected</div>
                                                <h2 class="fw-bold mb-0 text-danger" style="font-size: 2rem;" id="rejectedCountDisplay"><%= impersonationMetrics.rejectedNews %></h2>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                            <div class="content-area mt-4">
                                <% 
                                    const langLabels = typeof newsLanguageLabels !== 'undefined'
                                        ? newsLanguageLabels
                                        : { te: 'Telugu', en: 'English', hi: 'Hindi', ta: 'Tamil' };
                                    const totalNews = (typeof pagination !== 'undefined' && pagination.totalNews) ? pagination.totalNews : newsList.length;
                                    const currentPage = (typeof pagination !== 'undefined' && pagination.currentPage) ? pagination.currentPage : 1;
                                    const totalPages = (typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1;
                                    const pageLimit = (typeof pagination !== 'undefined' && pagination.limit) ? pagination.limit : newsList.length;
                                    const showAuthorCol = typeof admin !== 'undefined' && admin && admin.role !== 'editor';

                                    let pageActive = 0, pagePending = 0, pageViews = 0;
                                    newsList.forEach(function(n) {
                                        pageViews += (n.views || 0);
                                        if (n.isActive !== false) {
                                            pageActive++;
                                        } else if (n.rejectionStatus && n.rejectionStatus.isRejected) {
                                            /* rejected */
                                        } else if (n.approvalStatus && n.approvalStatus.isApproved === false) {
                                            pagePending++;
                                        }
                                    });

                                    const paginationSearchQuery = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
                                    const paginationLocation = (typeof selectedLocation !== 'undefined' && selectedLocation) ? selectedLocation : '';
                                    const paginationStatus = (typeof selectedStatus !== 'undefined' && selectedStatus) ? selectedStatus : '';
                                    const paginationLanguage = (typeof selectedLanguage !== 'undefined' && selectedLanguage) ? selectedLanguage : '';
                                    const paginationFromDate = (typeof fromDate !== 'undefined' && fromDate) ? fromDate : '';
                                    const paginationToDate = (typeof toDate !== 'undefined' && toDate) ? toDate : '';
                                    let paginationQuery = '';
                                    if (selectedAuthorIdSafe) paginationQuery += '&authorId=' + selectedAuthorIdSafe;
                                    if (paginationSearchQuery) paginationQuery += '&search=' + encodeURIComponent(paginationSearchQuery);
                                    if (paginationLocation) paginationQuery += '&location=' + paginationLocation;
                                    if (paginationStatus) paginationQuery += '&status=' + paginationStatus;
                                    if (paginationLanguage) paginationQuery += '&language=' + paginationLanguage;
                                    if (paginationFromDate) paginationQuery += '&fromDate=' + paginationFromDate;
                                    if (paginationToDate) paginationQuery += '&toDate=' + paginationToDate;

                                    const currentSearch = paginationSearchQuery;
                                    const currentLocation = paginationLocation;
                                    const currentStatus = paginationStatus;
                                    const currentLanguage = paginationLanguage;
                                    const currentFromDate = paginationFromDate;
                                    const currentToDate = paginationToDate;
                                    const currentTabSafe = typeof currentTab !== 'undefined' ? currentTab : 'my-list';

                                    function newsFilterUrl(overrides) {
                                        const parts = [];
                                        const authorId = Object.prototype.hasOwnProperty.call(overrides, 'authorId') ? overrides.authorId : selectedAuthorIdSafe;
                                        const search = Object.prototype.hasOwnProperty.call(overrides, 'search') ? overrides.search : currentSearch;
                                        const location = Object.prototype.hasOwnProperty.call(overrides, 'location') ? overrides.location : currentLocation;
                                        const status = Object.prototype.hasOwnProperty.call(overrides, 'status') ? overrides.status : currentStatus;
                                        const language = Object.prototype.hasOwnProperty.call(overrides, 'language') ? overrides.language : currentLanguage;
                                        const from = Object.prototype.hasOwnProperty.call(overrides, 'fromDate') ? overrides.fromDate : currentFromDate;
                                        const to = Object.prototype.hasOwnProperty.call(overrides, 'toDate') ? overrides.toDate : currentToDate;
                                        const tab = Object.prototype.hasOwnProperty.call(overrides, 'tab') ? overrides.tab : currentTabSafe;

                                        if (authorId) parts.push('authorId=' + encodeURIComponent(authorId));
                                        if (tab) parts.push('tab=' + encodeURIComponent(tab));
                                        if (search) parts.push('search=' + encodeURIComponent(search));
                                        if (location) parts.push('location=' + encodeURIComponent(location));
                                        if (status) parts.push('status=' + encodeURIComponent(status));
                                        if (language) parts.push('language=' + encodeURIComponent(language));
                                        if (from) parts.push('fromDate=' + encodeURIComponent(from));
                                        if (to) parts.push('toDate=' + encodeURIComponent(to));
                                        return parts.length ? '/news-list?' + parts.join('&') : '/news-list';
                                    }

                                    const hasActiveFilters = !!(currentSearch || currentLocation || currentStatus || currentLanguage || currentFromDate || currentToDate);
                                    const statusLabels = { active: 'Active', inactive: 'Inactive', pending: 'Pending', rejected: 'Rejected' };
                                %>

                                <form id="filterForm" class="d-none" method="GET">
                                    <input type="hidden" id="tabFilterInput" name="tab" value="<%= currentTabSafe %>">
                                    <input type="hidden" id="authorFilterInput" name="authorId" value="<%= selectedAuthorIdSafe %>">
                                    <input type="hidden" id="searchFilterInput" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                                    <input type="hidden" id="locationFilterInput" name="location" value="<%= typeof selectedLocation !== 'undefined' ? selectedLocation : '' %>">
                                    <input type="hidden" id="statusFilterInput" name="status" value="<%= typeof selectedStatus !== 'undefined' ? selectedStatus : '' %>">
                                    <input type="hidden" id="languageFilterInput" name="language" value="<%= typeof selectedLanguage !== 'undefined' ? selectedLanguage : '' %>">
                                    <input type="hidden" id="fromDateFilterInput" name="fromDate" value="<%= typeof fromDate !== 'undefined' ? fromDate : '' %>">
                                    <input type="hidden" id="toDateFilterInput" name="toDate" value="<%= typeof toDate !== 'undefined' ? toDate : '' %>">
                                </form>

                                <div class="news-page">
                                    <% if (typeof isImpersonating === 'undefined' || !isImpersonating) { %>
                                    <div class="team-page-header">
                                        <div>
                                            <h1 class="team-page-title">News Library</h1>
                                            <p class="team-page-subtitle">Browse, filter, and manage all published articles in one place.</p>
                                        </div>
                                        <a href="/add-news" class="team-btn-primary">
                                            <i class="fas fa-plus"></i> New article
                                        </a>
                                    </div>
                                    <% } %>

                                    <% if (selectedAuthorIdSafe) { %>
                                    <div class="news-active-filters">
                                        <span class="news-active-filters-label">Active filters</span>
                                        <div class="news-filter-chips">
                                            <a href="<%= newsFilterUrl({ authorId: '' }) %>" class="news-filter-chip">
                                                <i class="fas fa-user-pen"></i>
                                                Reporter filter
                                                <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                            </a>
                                        </div>
                                        </div>
                                    <% } %>

                                    <% if (typeof isImpersonating === 'undefined' || !isImpersonating) { %>
                                    <div class="team-stats">
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= totalNews %></div>
                                            <div class="team-stat-label">Total articles</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= pageActive %></div>
                                            <div class="team-stat-label">Active on page</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= pagePending %></div>
                                            <div class="team-stat-label">Pending on page</div>
                                        </div>
                                        <div class="team-stat">
                                            <div class="team-stat-value"><%= pageViews.toLocaleString('en-IN') %></div>
                                            <div class="team-stat-label">Views on page</div>
                                        </div>
                                    </div>
                                    <% } %>
                                </div>

                                    <div class="news-filters-card">
                                        <div class="news-filters-top">
                                            <div class="news-filters-heading">
                                                <span class="news-filters-icon"><i class="fas fa-sliders"></i></span>
                                                <div>
                                                    <h2 class="news-filters-title">Filter articles</h2>
                                                    <p class="news-filters-subtitle"><%= totalNews.toLocaleString('en-IN') %> articles match your criteria</p>
                                </div>
                                    </div>
                                            <% if (hasActiveFilters) { %>
                                            <a href="<%= newsFilterUrl({ search: '', location: '', status: '', language: '', fromDate: '', toDate: '' }) %>" class="news-filters-reset">
                                                <i class="fas fa-rotate-left"></i> Reset filters
                                            </a>
                                                                                        <% } %>
                                                                            </div>

                                        <div class="news-filters-search-row">
                                            <div class="news-search-field">
                                                <i class="fas fa-search"></i>
                                                <input type="search" id="searchFilter" class="news-search-input" placeholder="Search by title, content, or author..." value="" autocomplete="new-password" name="news_search_nofill" data-lpignore="true" data-form-type="other">
                                                <script>
                                                (function(){
                                                    var sv = '<%= typeof searchQuery !== "undefined" && searchQuery ? searchQuery.replace(/\'/g, "\\\\'") : "" %>';
                                                    var el = document.getElementById('searchFilter');
                                                    if (el) el.value = sv;
                                                })();
                                                </script>
                                                <% if (currentSearch) { %>
                                                <button type="button" class="news-search-clear" id="clearSearchBtn" title="Clear search"><i class="fas fa-times"></i></button>
                                                                            <% } %>
                                                                                </div>
                                            <button type="submit" class="news-filters-apply" form="filterForm">
                                                <i class="fas fa-search"></i> Search
                                            </button>
                                        </div>

                                        <div class="news-filters-section">
                                            <span class="news-filters-section-label">Status</span>
                                            <div class="news-status-pills" role="tablist" aria-label="Filter by status">
                                                <button type="button" class="news-status-pill <%= !currentStatus ? 'active' : '' %>" data-status="">All</button>
                                                <button type="button" class="news-status-pill news-status-pill--active <%= currentStatus === 'active' ? 'active' : '' %>" data-status="active">Active</button>
                                                <button type="button" class="news-status-pill news-status-pill--pending <%= currentStatus === 'pending' ? 'active' : '' %>" data-status="pending">Pending</button>
                                                <button type="button" class="news-status-pill news-status-pill--inactive <%= currentStatus === 'inactive' ? 'active' : '' %>" data-status="inactive">Inactive</button>
                                                <button type="button" class="news-status-pill news-status-pill--rejected <%= currentStatus === 'rejected' ? 'active' : '' %>" data-status="rejected">Rejected</button>
                                                                                </div>
                                                        </div>

                                        <div class="news-filters-facets">
                                            <div class="news-facet">
                                                <label class="news-facet-label" for="locationFilter"><i class="fas fa-map-marker-alt"></i> Location</label>
                                                <div class="news-facet-select-wrap<%= currentLocation ? ' is-active' : '' %>">
                                                    <select id="locationFilter" class="news-facet-select">
                                                        <option value="">All locations</option>
                                                        <% locations.forEach(function(location) { %>
                                                            <option value="<%= location.name %>" <%= currentLocation === location.name ? 'selected' : '' %>><%= location.name %></option>
                                                        <% }); %>
                                                    </select>
                                                    <i class="fas fa-chevron-down news-facet-chevron"></i>
                                                            </div>
                                                                </div>

                                            <div class="news-facet">
                                                <label class="news-facet-label" for="languageFilter"><i class="fas fa-language"></i> Language</label>
                                                <div class="news-facet-select-wrap<%= currentLanguage ? ' is-active' : '' %>">
                                                    <select id="languageFilter" class="news-facet-select">
                                                        <option value="">All languages</option>
                                                        <% Object.keys(langLabels).forEach(function(code) { %>
                                                            <option value="<%= code %>" <%= currentLanguage === code ? 'selected' : '' %>><%= langLabels[code] %></option>
                                                        <% }); %>
                                                    </select>
                                                    <i class="fas fa-chevron-down news-facet-chevron"></i>
                                                                    </div>
                                                                    </div>

                                            <div class="news-facet news-facet--dates">
                                                <label class="news-facet-label"><i class="fas fa-calendar-alt"></i> Published date</label>
                                                <div class="news-date-range<%= (currentFromDate || currentToDate) ? ' is-active' : '' %>">
                                                    <input type="date" class="news-date-input" id="fromDateFilter" title="From date" value="<%= currentFromDate %>" aria-label="From date">
                                                    <span class="news-date-sep">→</span>
                                                    <input type="date" class="news-date-input" id="toDateFilter" title="To date" value="<%= currentToDate %>" aria-label="To date">
                                                        </div>
                                                    </div>
                                        </div>

                                        <% if (hasActiveFilters) { %>
                                        <div class="news-active-filters news-active-filters--inline">
                                            <span class="news-active-filters-label">Applied</span>
                                            <div class="news-filter-chips">
                                                <% if (currentSearch) { %>
                                                <a href="<%= newsFilterUrl({ search: '' }) %>" class="news-filter-chip">
                                                    Search: <%= currentSearch.length > 24 ? currentSearch.substring(0, 24) + '…' : currentSearch %>
                                                    <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                                </a>
                                                <% } %>
                                                <% if (currentStatus) { %>
                                                <a href="<%= newsFilterUrl({ status: '' }) %>" class="news-filter-chip">
                                                    Status: <%= statusLabels[currentStatus] || currentStatus %>
                                                    <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                                </a>
                                                <% } %>
                                                <% if (currentLocation) { %>
                                                <a href="<%= newsFilterUrl({ location: '' }) %>" class="news-filter-chip">
                                                    <%= currentLocation %>
                                                    <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                                </a>
                                                <% } %>
                                                <% if (currentLanguage) { %>
                                                <a href="<%= newsFilterUrl({ language: '' }) %>" class="news-filter-chip">
                                                    <%= langLabels[currentLanguage] || currentLanguage %>
                                                    <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                                </a>
                                                <% } %>
                                                <% if (currentFromDate || currentToDate) { %>
                                                <a href="<%= newsFilterUrl({ fromDate: '', toDate: '' }) %>" class="news-filter-chip">
                                                    <% if (currentFromDate && currentToDate) { %><%= currentFromDate %> → <%= currentToDate %><% } else if (currentFromDate) { %>From <%= currentFromDate %><% } else { %>Until <%= currentToDate %><% } %>
                                                    <span class="news-filter-chip-x"><i class="fas fa-times"></i></span>
                                                </a>
                                        <% } %>
                            </div>
                        </div>
                                        <% } %>
                </div>

                                    <select id="statusFilter" class="d-none" aria-hidden="true" tabindex="-1">
                                        <option value="" <%= !currentStatus ? 'selected' : '' %>>All</option>
                                        <option value="active" <%= currentStatus === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="inactive" <%= currentStatus === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                        <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="rejected" <%= currentStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                    </select>

                                    <div class="team-panel">
                                        <% if (typeof isRestrictedSubEditor !== 'undefined' && isRestrictedSubEditor) { %>
                                            <ul class="nav nav-tabs mb-4" id="subEditorNewsListTabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link <%= typeof currentTab !== 'undefined' && currentTab === 'my-list' ? 'active' : '' %> fw-bold" id="my-list-tab" onclick="document.getElementById('tabFilterInput').value='my-list'; document.getElementById('filterForm').submit();" type="button" role="tab" style="color: #475569;"><i class="fas fa-user-edit"></i> My Articles<% if (typeof subEditorTabCounts !== 'undefined' && subEditorTabCounts) { %> <span class="badge bg-light text-dark ms-1"><%= subEditorTabCounts.myList %></span><% } %></button>
                                                </li>
                                                <% if (typeof hasTeamScope !== 'undefined' && hasTeamScope) { %>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link <%= typeof currentTab !== 'undefined' && currentTab === 'team-list' ? 'active' : '' %> fw-bold" id="team-list-tab" onclick="document.getElementById('tabFilterInput').value='team-list'; document.getElementById('filterForm').submit();" type="button" role="tab" style="color: #475569;"><i class="fas fa-users"></i> Team Reporters<% if (typeof subEditorTabCounts !== 'undefined' && subEditorTabCounts) { %> <span class="badge bg-light text-dark ms-1"><%= subEditorTabCounts.teamList %></span><% } %></button>
                                                </li>
                                                <% } %>
                                            </ul>
                                            <% if (newsList.length === 0) { %>
                                            <div class="team-empty">
                                                <div class="team-empty-icon"><i class="fas fa-newspaper"></i></div>
                                                <h4 style="color:#374151;font-weight:600;margin-bottom:8px;">No articles in this view</h4>
                                                <p style="margin-bottom:20px;">
                                                    <% if (typeof currentTab !== 'undefined' && currentTab === 'team-list') { %>
                                                    No news from team reporters yet. Try the <strong>My Articles</strong> tab or adjust filters.
                                                    <% } else if (typeof hasTeamScope !== 'undefined' && hasTeamScope) { %>
                                                    You have not posted any articles yet. Check <strong>Team Reporters</strong> tab for team news.
                                                    <% } else { %>
                                                    You have not posted any articles yet.
                                                    <% } %>
                                                </p>
                                                <% if (typeof currentTab !== 'undefined' && currentTab === 'my-list' && typeof hasTeamScope !== 'undefined' && hasTeamScope) { %>
