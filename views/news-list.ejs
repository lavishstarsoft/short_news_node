                <!-- Latest News Option -->
                <div class="title-option" onclick="selectTitleOption(this)" data-value="latest" data-title="Latest News 📢:">
                    <input type="radio" name="titleType" value="latest">
                    <span class="option-icon">📢</span>
                    <div class="option-text">
                        <div class="option-label">Latest News</div>
                        <div class="option-preview">Latest News 📢</div>
                    </div>
                    <div class="check-icon">✓</div>
                </div>

                <!-- Custom Option -->
                <div class="title-option" onclick="selectTitleOption(this)" data-value="custom" data-title="">
                    <input type="radio" name="titleType" value="custom">
                    <span class="option-icon">✏️</span>
                    <div class="option-text">
                        <div class="option-label">Custom Title</div>
                        <div class="option-preview">Type your own title</div>
                    </div>
                    <div class="check-icon">✓</div>
                </div>

                <!-- Custom Title Input -->
                <input type="text" id="customTitleInput" class="custom-title-input" placeholder="Enter custom notification title..." maxlength="100">
            </div>
            <div class="notification-modal-footer">
                <button class="btn-cancel-notif" onclick="closeNotificationModal()">Cancel</button>
                <button class="btn-send-notif" id="sendNotifBtn" onclick="confirmSendNotification()">🚀 Send Notification</button>
            </div>
        </div>
    </div>

    </body>

</html>