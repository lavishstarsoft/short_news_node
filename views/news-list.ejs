            <%- include('partials/footer') %>
                <script src="/js/rich-text.js"></script>
                <script src="/js/main.js"></script>
                <script src="/js/notification-sender.js"></script>
                <script id="newsData" type="application/json"><%- JSON.stringify(newsList) %></script>
                <script>
                    window.newsListItems = JSON.parse(document.getElementById('newsData').textContent);
                    const newsListItems = window.newsListItems;
                    let currentViewNewsId = null;
                    let currentViewNewsItem = null;
                    const isSuperAdmin = <%= (typeof admin !== 'undefined' && admin && admin.role === 'superadmin') ? 'true' : 'false' %>;

                    function formatIndianDateTime(value) {
                        if (!value) return '-';
                        const date = new Date(value);
                        if (Number.isNaN(date.getTime())) return '-';
                        return date.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });
                    }

                    // Wait for DOM to be fully loaded
                    window.changeListCarousel = function(carouselId, totalSlides, direction) {
                        const stateKey = 'carouselState_' + carouselId.replace(/-/g, '_');
                        if (typeof window[stateKey] === 'undefined') window[stateKey] = 0;
                        
                        // Hide current
                        const currentSlide = document.getElementById(carouselId + '-slide-' + window[stateKey]);
                        if (currentSlide) currentSlide.style.display = 'none';
                        
                        // Update state
                        window[stateKey] = (window[stateKey] + direction + totalSlides) % totalSlides;
                        
                        // Show new
                        const newSlide = document.getElementById(carouselId + '-slide-' + window[stateKey]);
                        if (newSlide) newSlide.style.display = 'block';
                    };

                    document.addEventListener('DOMContentLoaded', function () {
                        // Prevent browser auto-restoring search field on refresh
                        const urlParams = new URLSearchParams(window.location.search);
                        const searchField = document.getElementById('searchFilter');
                        if (searchField && !urlParams.has('search')) {
                            searchField.value = '';
                        }

                        // Handle filter form submission
                        const searchFilter = document.getElementById('searchFilter');
                        const locationFilter = document.getElementById('locationFilter');
                        const languageFilter = document.getElementById('languageFilter');
                        const fromDateFilter = document.getElementById('fromDateFilter');
                        const toDateFilter = document.getElementById('toDateFilter');
                        
                        const searchFilterInput = document.getElementById('searchFilterInput');
                        const locationFilterInput = document.getElementById('locationFilterInput');
                        const statusFilterInput = document.getElementById('statusFilterInput');
                        const languageFilterInput = document.getElementById('languageFilterInput');
                        const fromDateFilterInput = document.getElementById('fromDateFilterInput');
                        const toDateFilterInput = document.getElementById('toDateFilterInput');
                        const filterForm = document.getElementById('filterForm');

                        if (searchFilter && locationFilter && languageFilter && fromDateFilter && toDateFilter && filterForm) {
                            function syncHiddenFilters() {
                                searchFilterInput.value = searchFilter.value;
                                locationFilterInput.value = locationFilter.value;
                                // statusFilterInput is updated by pill clicks directly
                                languageFilterInput.value = languageFilter.value;
                                fromDateFilterInput.value = fromDateFilter.value;
                                toDateFilterInput.value = toDateFilter.value;
                            }

                            // Search on Enter key
                            searchFilter.addEventListener('keypress', function (e) {
                                if (e.key === 'Enter') {
                                    e.preventDefault();
                                    syncHiddenFilters();
                                    filterForm.submit();
                                }
                            });

                            searchFilter.addEventListener('input', function () {
                                searchFilterInput.value = this.value;
                            });

                            const clearSearchBtn = document.getElementById('clearSearchBtn');
                            if (clearSearchBtn) {
                                clearSearchBtn.addEventListener('click', function () {
                                    searchFilter.value = '';
                                    searchFilterInput.value = '';
                                    filterForm.submit();
                                });
                            }

                            document.querySelectorAll('.news-status-pill').forEach(function (pill) {
                                pill.addEventListener('click', function () {
                                    const nextStatus = this.getAttribute('data-status') || '';
                                    // statusFilter does not exist
                                    statusFilterInput.value = nextStatus;
                                    statusFilterInput.value = nextStatus;
                                    document.querySelectorAll('.news-status-pill').forEach(function (node) {
                                        node.classList.toggle('active', node === pill);
                                    });
                                    filterForm.submit();
                                });
                            });

                            locationFilter.addEventListener('change', function () {
                                locationFilterInput.value = this.value;
                                filterForm.submit();
                            });

                            languageFilter.addEventListener('change', function () {
                                languageFilterInput.value = this.value;
                                filterForm.submit();
                            });

                            fromDateFilter.addEventListener('change', function () {
                                fromDateFilterInput.value = this.value;
                                filterForm.submit();
                            });

                            toDateFilter.addEventListener('change', function () {
                                toDateFilterInput.value = this.value;
                                filterForm.submit();
                            });
                        }

                        setupMobileMenu();
                    });

                    // View news function
                    function getNewsStatusInfo(newsItem) {
                        if (newsItem.isActive !== false) {
                            return { label: 'Active', className: 'nd-pill-active' };
                        }
                        if (newsItem.rejectionStatus && newsItem.rejectionStatus.isRejected) {
                            return { label: 'Rejected', className: 'nd-pill-rejected' };
                        }
                        if (newsItem.approvalStatus && newsItem.approvalStatus.isApproved === false) {
                            return { label: 'Pending', className: 'nd-pill-pending' };
                        }
                        return { label: 'Inactive', className: 'nd-pill-inactive' };
                    }

                    function renderNewsDetailMedia(newsItem) {
                        const container = document.getElementById('newsDetailMediaContainer');
                        const badge = document.getElementById('newsDetailMediaBadge');
                        const hero = document.getElementById('newsDetailHero');
                        const images = [];

                        if (Array.isArray(newsItem.imageUrls) && newsItem.imageUrls.length > 0) {
                            images.push(...newsItem.imageUrls.filter(Boolean));
                        }
                        const primary = newsItem.mediaUrl || newsItem.imageUrl;
                        if (primary && !images.includes(primary)) {
                            images.unshift(primary);
                        }

                        hero.classList.remove('is-hidden');

                        if (newsItem.mediaType === 'video' && primary) {
                            badge.style.display = 'inline-block';
                            badge.textContent = 'Video';
                            container.className = 'nd-hero-inner';
                            container.innerHTML = `<video controls playsinline preload="metadata"><source src="${escapeHtml(primary)}" type="video/mp4">Your browser does not support video.</video>`;
                            return;
                        }

                        if (images.length > 1) {
                            badge.style.display = 'inline-block';
                            badge.textContent = `${images.length} photos`;
                            
                            const carouselId = 'newsListCarousel-' + (newsItem._id || 'temp');
                            
                            let html = `<div style="position:relative; width:100%; height:100%; overflow:hidden; background:#000;">`;
                            html += images.map((url, idx) => `
                                <div id="${carouselId}-slide-${idx}" style="display: ${idx === 0 ? 'block' : 'none'}; width:100%; height:100%;">
                                    <img src="${escapeHtml(url)}" alt="Photo ${idx + 1}" style="width:100%; height:100%; object-fit:contain; display:block;" loading="lazy">
                                    <div style="position:absolute; bottom:10px; right:10px; background:rgba(0,0,0,0.6); color:#fff; padding:2px 8px; border-radius:12px; font-size:12px; z-index:5;">
                                        ${idx + 1} / ${images.length}
                                    </div>
                                </div>
                            `).join('');
                            
                            html += `
                                <button type="button" onclick="changeListCarousel('${carouselId}', ${images.length}, -1)" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:#fff; border:none; width:30px; height:30px; border-radius:50%; cursor:pointer; z-index:10;"><i class="fas fa-chevron-left"></i></button>
                                <button type="button" onclick="changeListCarousel('${carouselId}', ${images.length}, 1)" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:#fff; border:none; width:30px; height:30px; border-radius:50%; cursor:pointer; z-index:10;"><i class="fas fa-chevron-right"></i></button>
                            </div>`;
                            
                            window['carouselState_' + carouselId.replace(/-/g, '_')] = 0;
                            
                            container.className = 'nd-hero-inner';
                            container.innerHTML = html;
                            return;
                        }

                        if (images.length === 1) {
                            badge.style.display = 'none';
                            container.className = 'nd-hero-inner';
                            container.innerHTML = `<img src="${escapeHtml(images[0])}" alt="Article image" loading="lazy">`;
                            return;
                        }

                        badge.style.display = 'none';
                        hero.classList.add('is-hidden');
                        container.className = 'nd-hero-inner';
                        container.innerHTML = '';
                    }

                    function setAuthorDetails(newsItem) {
                        const authorRaw = (newsItem.author || '').trim();
                        const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(authorRaw);
                        const nameEl = document.getElementById('newsDetailAuthor');
                        const emailEl = document.getElementById('newsDetailAuthorEmail');
                        const phoneEl = document.getElementById('newsDetailAuthorPhone');
                        const constEl = document.getElementById('newsDetailAuthorConstituency');
                        
                        const canViewReporterDetails = <%= admin.role === 'superadmin' || (admin.permissions && admin.permissions.canViewReporterDetails) ? 'true' : 'false' %>;

                        if (newsItem.authorDetails && canViewReporterDetails) {
                            nameEl.textContent = newsItem.authorDetails.name || 'N/A';
                            emailEl.textContent = newsItem.authorDetails.email || authorRaw;
                            emailEl.style.display = '';
                            
                            if (phoneEl) {
                                if (newsItem.authorDetails.mobileNumber) {
                                    phoneEl.textContent = newsItem.authorDetails.mobileNumber;
                                    phoneEl.style.display = '';
                                } else {
                                    phoneEl.style.display = 'none';
                                }
                            }
                            
                            if (constEl) {
                                if (newsItem.authorDetails.constituency) {
                                    constEl.textContent = newsItem.authorDetails.constituency;
                                    constEl.style.display = '';
                                } else {
                                    constEl.style.display = 'none';
                                }
                            }
                        } else if (isEmail) {
                            nameEl.textContent = authorRaw.split('@')[0];
                            emailEl.textContent = authorRaw;
                            emailEl.style.display = '';
                            if(phoneEl) phoneEl.style.display = 'none';
                            if(constEl) constEl.style.display = 'none';
                        } else {
                            nameEl.textContent = authorRaw || '-';
                            emailEl.textContent = '';
                            emailEl.style.display = 'none';
                            if(phoneEl) phoneEl.style.display = 'none';
                            if(constEl) constEl.style.display = 'none';
                        }

                        document.getElementById('newsDetailAuthorRole').textContent = newsItem.authorRole || 'Reporter';
                        document.getElementById('newsDetailAuthorId').textContent = newsItem.authorId ? `ID ${newsItem.authorId}` : '';
                        const avatarSource = newsItem.authorDetails ? newsItem.authorDetails.name : (isEmail ? authorRaw.split('@')[0] : authorRaw);
                        const authorInitials = (avatarSource || '?').split(/[\s._-]+/).filter(Boolean).map(n => n[0]).join('').toUpperCase().substring(0, 2) || '?';
                        document.getElementById('newsDetailAuthorAvatar').textContent = authorInitials;
                    }

                    function getUserDisplayName(item) {
                        if (item.userName) return item.userName;
                        if (item.userEmail) return item.userEmail.split('@')[0];
                        return 'App user';
                    }

                    function getUserInitials(name) {
                        return (name || '?').split(/[\s._-]+/).filter(Boolean).map(n => n[0]).join('').toUpperCase().substring(0, 2) || '?';
                    }

                    function renderInteractionList(items, emptyText) {
                        if (!items || items.length === 0) {
                            return `<div class="nd-empty-note">${emptyText}</div>`;
                        }
                        return items.map(item => {
                            const displayName = getUserDisplayName(item);
                            const date = item.timestamp ? formatIndianDateTime(item.timestamp) : '-';
                            const userMeta = [item.userEmail, item.userId ? `ID: ${item.userId}` : ''].filter(Boolean).join(' · ');
                            return `
                                <div class="nd-list-item">
                                    <div class="nd-comment-top">
                                        <div class="nd-comment-user">
                                            <span class="nd-comment-avatar">${escapeHtml(getUserInitials(displayName))}</span>
                                            <div>
                                                <div class="nd-list-name">${escapeHtml(displayName)}</div>
                                                ${userMeta ? `<div class="nd-list-meta">${escapeHtml(userMeta)}</div>` : ''}
                                            </div>
                                        </div>
                                        <span class="nd-user-badge">Real user</span>
                                    </div>
                                    <div class="nd-list-meta" style="margin-top:6px;">${escapeHtml(date)}</div>
                                </div>`;
                        }).join('');
                    }

                    function renderCommentsList(comments) {
                        if (!comments || comments.length === 0) {
                            return '<div class="nd-empty-note">No comments yet</div>';
                        }
                        return comments.map(item => {
                            const commentId = item._id || item.id;
                            const displayName = getUserDisplayName(item);
                            const date = item.timestamp ? formatIndianDateTime(item.timestamp) : '-';
                            const userMeta = [item.userEmail, item.userId ? `ID: ${item.userId}` : ''].filter(Boolean).join(' · ');
                            const adminActions = (isSuperAdmin && commentId) ? `
                                <div class="nd-comment-admin-actions">
                                    <button type="button" class="nd-engagement-edit" onclick="editNewsComment('${commentId}')" title="Edit comment"><i class="fas fa-pen"></i></button>
                                    <button type="button" class="nd-engagement-delete" onclick="deleteNewsComment('${commentId}')" title="Delete comment"><i class="fas fa-trash"></i></button>
                                </div>` : '';

                            return `
                                <div class="nd-list-item nd-comment-item">
                                    <div class="nd-comment-top">
                                        <div class="nd-comment-user">
                                            <span class="nd-comment-avatar">${escapeHtml(getUserInitials(displayName))}</span>
                                            <div>
                                                <div class="nd-list-name">${escapeHtml(displayName)}</div>
                                                ${userMeta ? `<div class="nd-list-meta">${escapeHtml(userMeta)}</div>` : ''}
                                            </div>
                                        </div>
                                        <div class="nd-comment-meta">
                                            <span class="nd-user-badge">Real user</span>
                                            <span class="nd-list-meta">${escapeHtml(date)}</span>
                                            ${adminActions}
                                        </div>
                                    </div>
                                    <div class="nd-comment-text">${escapeHtml(item.comment)}</div>
                                </div>`;
                        }).join('');
                    }

                    function refreshEngagementPanel(newsItem) {
                        if (!newsItem) return;
                        currentViewNewsItem = newsItem;

                        document.getElementById('newsDetailViews').textContent = newsItem.views || 0;
                            document.getElementById('newsDetailLikes').textContent = newsItem.likes || 0;
                            document.getElementById('newsDetailDislikes').textContent = newsItem.dislikes || 0;
                            document.getElementById('newsDetailCommentsCount').textContent = newsItem.comments || 0;

                        const likes = newsItem.userInteractions?.likes || [];
                        const dislikes = newsItem.userInteractions?.dislikes || [];
                        const comments = newsItem.userInteractions?.comments || [];

                        document.getElementById('likesCount').textContent = likes.length;
                        document.getElementById('dislikesCount').textContent = dislikes.length;
                        document.getElementById('commentsCount').textContent = comments.length;
                        document.getElementById('likesList').innerHTML = renderInteractionList(likes, 'No likes yet');
                        document.getElementById('dislikesList').innerHTML = renderInteractionList(dislikes, 'No dislikes yet');
                        document.getElementById('commentsList').innerHTML = renderCommentsList(comments);
                    }

                    function syncNewsListCache(newsItem) {
                        const index = newsListItems.findIndex(n => n._id === newsItem._id);
                        if (index !== -1) {
                            newsListItems[index] = { ...newsListItems[index], ...newsItem };
                        }
                    }

                    async function viewNews(newsId) {
                        currentViewNewsId = newsId;
                        let newsItem = newsListItems.find(news => news._id === newsId);

                        if (!newsItem) {
                            alert('News item not found');
                            return;
                        }

                        try {
                            const response = await fetch(`/news/api/news/${newsId}`);
                            if (response.ok) {
                                const latestNews = await response.json();
                                newsItem = { ...newsItem, ...latestNews };
                            }
                        } catch (error) {
                            console.warn('Could not fetch latest news details, falling back to cached list item.', error);
                        }

                        if (!newsItem) return;

                        currentViewNewsItem = newsItem;
                        refreshEngagementPanel(newsItem);

                        renderNewsDetailMedia(newsItem);

                        const sourceLinkEl = document.getElementById('newsDetailSourceLink');
                        if (newsItem.sourceLink) {
                            let sourceDisplay = escapeHtml(newsItem.sourceLink);
                            if (newsItem.sourceLink.startsWith('http')) {
                                sourceDisplay = `<a href="${escapeHtml(newsItem.sourceLink)}" target="_blank" rel="noopener" style="color: #d32f2f; text-decoration: underline;">${escapeHtml(newsItem.sourceLink)}</a>`;
                            }
                            sourceLinkEl.innerHTML = `<i class="fas fa-link me-2"></i><strong>Source:</strong> ${sourceDisplay}`;
                            sourceLinkEl.style.display = 'block';
                        } else {
                            sourceLinkEl.style.display = 'none';
                        }

                        document.getElementById('newsDetailTitle').innerHTML = renderRichText(newsItem.title || '');
                        document.getElementById('newsDetailContent').innerHTML = renderRichText(newsItem.content || '');
                        document.getElementById('newsDetailCategory').innerHTML = `<i class="fas fa-tag"></i> ${escapeHtml(newsItem.category || 'General')}`;

                            const locationElement = document.getElementById('newsDetailLocation');
                            if (newsItem.location) {
                            const locationText = newsItem.locationCode
                                ? `${newsItem.location} (${newsItem.locationCode})`
                                : newsItem.location;
                            locationElement.innerHTML = `<i class="fas fa-map-marker-alt"></i> ${escapeHtml(locationText)}`;
                            locationElement.style.display = 'inline-flex';
                            } else {
                                locationElement.style.display = 'none';
                            }

                        document.getElementById('newsDetailDate').innerHTML = `<i class="far fa-clock"></i> ${formatIndianDateTime(newsItem.publishedAt)}`;

                        const statusInfo = getNewsStatusInfo(newsItem);
                        const statusEl = document.getElementById('newsDetailStatus');
                        statusEl.textContent = statusInfo.label;
                        statusEl.className = `nd-pill ${statusInfo.className}`;

                        const shortId = newsItem.shortId || (newsItem._id.toString().length > 6
                            ? newsItem._id.toString().substring(newsItem._id.toString().length - 6)
                            : newsItem._id.toString());
                        document.getElementById('newsDetailShortId').innerHTML = `<i class="fas fa-link"></i> cbnys.co/${escapeHtml(shortId)}`;

                        setAuthorDetails(newsItem);

                        const editBtn = document.getElementById('newsDetailEditBtn');
                        if (editBtn) {
                            const isSuperAdmin = <%= (typeof admin !== 'undefined' && admin && admin.role === 'superadmin') ? 'true' : 'false' %>;
                            const isAdmin = <%= (typeof admin !== 'undefined' && admin && admin.role === 'admin') ? 'true' : 'false' %>;
                            const hasEditPerm = <%= (typeof admin !== 'undefined' && admin && admin.role === 'subeditor' && admin.permissions && admin.permissions.canEditNews) ? 'true' : 'false' %>;
                            const currentAdminId = '<%= (typeof admin !== 'undefined' && admin) ? admin._id : "" %>';
                            const canEditAny = isSuperAdmin || isAdmin || hasEditPerm;
                            const isOwnNews = newsItem.authorId === currentAdminId;
                            const isRejected = newsItem.rejectionStatus && newsItem.rejectionStatus.isRejected;
                            
                            const canEdit = canEditAny || (isOwnNews && !isRejected);
                            
                            if (!canEdit) {
                                editBtn.style.display = 'none';
                            } else {
                                editBtn.style.display = '';
                                editBtn.onclick = () => editNews(newsId);
                            }
                        }

                        const linksWrap = document.getElementById('newsDetailExternalLinks');
                        const linksList = document.getElementById('newsDetailLinksList');
                        let linksHtml = '';
                        if (newsItem.readFullLink) {
                            linksHtml += `<a class="nd-external-link" href="${escapeHtml(newsItem.readFullLink)}" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> Read full article</a>`;
                        }
                        if (newsItem.ePaperLink) {
                            linksHtml += `<a class="nd-external-link" href="${escapeHtml(newsItem.ePaperLink)}" target="_blank" rel="noopener"><i class="fas fa-newspaper"></i> ePaper</a>`;
                        }
                        if (linksHtml) {
                            linksList.innerHTML = linksHtml;
                            linksWrap.style.display = '';
                            } else {
                            linksWrap.style.display = 'none';
                        }

                        const approval = newsItem.approvalStatus;
                        const approved = approval && approval.isApproved;
                        const isReporterNews = (newsItem.authorSystemRole === 'editor' || newsItem.authorSystemRole === 'reporter');
                        document.getElementById('newsDetailApprovalSection').style.display = (isReporterNews && approved) ? '' : 'none';
                        document.getElementById('newsDetailApprovalStatus').textContent = approved ? 'Approved' : 'Pending';
                        document.getElementById('newsDetailApprovalBy').textContent = approved ? (approval.approvedBy || '-') : '-';
                        document.getElementById('newsDetailApprovalRole').textContent = approved ? (approval.approvedByRole || '-') : '-';
                        document.getElementById('newsDetailApprovalAt').textContent = approved && approval.approvedAt
                            ? formatIndianDateTime(approval.approvedAt)
                            : '-';

                        const historyItems = Array.isArray(newsItem.actionHistory) ? [...newsItem.actionHistory] : [];
                        historyItems.sort((a, b) => new Date(b.performedAt || 0) - new Date(a.performedAt || 0));
                        document.getElementById('newsDetailHistoryCount').textContent = historyItems.length;
                        document.getElementById('newsDetailHistoryList').innerHTML = historyItems.length
                            ? historyItems.map(item => `
                                <div class="nd-timeline-item">
                                    <div class="nd-timeline-action">${escapeHtml((item.action || 'updated').replace(/_/g, ' '))}</div>
                                    <div class="nd-list-meta">${escapeHtml(item.details || '-')}</div>
                                    <div class="nd-list-meta">${escapeHtml(item.performedByName || 'System')} · ${escapeHtml(item.performedByRole || '-')}</div>
                                    <div class="nd-timeline-date">${item.performedAt ? formatIndianDateTime(item.performedAt) : '-'}</div>
                                </div>`).join('')
                            : '<div class="nd-empty-note">No activity yet</div>';

                            const modal = new bootstrap.Modal(document.getElementById('newsDetailModal'));
                            modal.show();
                    }

                    // Edit news function
                    function editNews(newsId) {
                        // Redirect to edit page
                        window.location.href = `/edit-news/${newsId}`;
                    }

                    // Delete news function
                    let deleteNewsModalInstance = null;

                    function deleteNews(newsId) {
                        const modalEl = document.getElementById('deleteNewsModal');
                        if (!deleteNewsModalInstance) {
                            deleteNewsModalInstance = new bootstrap.Modal(modalEl);
                        }
                        document.getElementById('deleteNewsPassword').value = '';
                        document.getElementById('deleteNewsId').value = newsId;
                        deleteNewsModalInstance.show();
                    }

                    function confirmDeleteNews() {
                        const password = document.getElementById('deleteNewsPassword').value;
                        const newsId = document.getElementById('deleteNewsId').value;
                        
                        if (!password) {
                            alert('Please enter the password');
                            return;
                        }

                        // Make API call to delete the news
                        fetch(`/news/api/news/${newsId}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ password })
                        })
                        .then(response => {
                            if (response.ok) {
                                // Reload the page to reflect the changes
                                location.reload();
                            } else {
                                // Try to get error message from response
                                return response.json().then(errorData => {
                                    throw new Error(errorData.error || 'Failed to delete news article');
                                }).catch(() => {
                                    throw new Error('Failed to delete news article');
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error: ' + error.message);
                        });
                    }

                    // Toggle news active status function
                    function toggleNewsStatus(newsId, ignoreLanguageWarning = false) {
                        // Find the news item in the newsListItems array
                        const newsItem = newsListItems.find(news => news._id === newsId);

                        if (newsItem) {
                            // Make API call to toggle the news status
                            fetch(`/news/api/news/${newsId}/toggle-status`, {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    isActive: !newsItem.isActive,
                                    ignoreLanguageWarning
                                })
                            })
                                .then(async response => {
                                    if (response.ok) {
                                        // Reload the page to reflect the changes
                                        location.reload();
                                    } else if (response.status === 409) {
                                        const errorData = await response.json();
                                        Swal.fire({
                                            title: 'Language Mismatch',
                                            html: errorData.message + '<br><br><b>Do you want to publish it anyway?</b>',
                                            icon: 'warning',
                                            showCancelButton: true,
                                            confirmButtonColor: '#3085d6',
                                            cancelButtonColor: '#d33',
                                            confirmButtonText: 'Publish Anyway',
                                            cancelButtonText: 'Cancel'
                                        }).then((result) => {
                                            if (result.isConfirmed) {
                                                toggleNewsStatus(newsId, true);
                                            }
                                        });
                                    } else {
                                        const errorData = await response.json().catch(() => ({}));
                                        const errorMessage = errorData.error || 'Failed to toggle news status';
                                        alert('Error: ' + errorMessage);
                                    }
                                })
                                .catch(error => {
                                    console.error('Network error:', error);
                                    alert('Network error occurred while toggling the news status: ' + error.message);
                                });
                        } else {
                            alert('News item not found');
                        }
                    }

                    // Mobile menu setup
                    function setupMobileMenu() {
                        const menuToggle = document.getElementById('menuToggle');
                        const sidebar = document.getElementById('sidebar');
                        const mainContent = document.getElementById('mainContent');

                        if (menuToggle && sidebar) {
                            menuToggle.addEventListener('click', function (e) {
                                e.stopPropagation();
                                sidebar.classList.toggle('active');
                                mainContent.classList.toggle('sidebar-active');
                            });
                        }

                        document.addEventListener('click', function (event) {
                            if (window.innerWidth < 768 &&
                                sidebar && sidebar.classList.contains('active') &&
                                !sidebar.contains(event.target) &&
                                event.target !== menuToggle &&
                                !menuToggle.contains(event.target)) {
                                sidebar.classList.remove('active');
                                if (mainContent) {
                                    mainContent.classList.remove('sidebar-active');
                                }
                            }
                        });

                        const sidebarLinks = document.querySelectorAll('.sidebar a');
                        sidebarLinks.forEach(link => {
                            link.addEventListener('click', function () {
                                if (window.innerWidth < 768 && sidebar) {
                                    sidebar.classList.remove('active');
                                    if (mainContent) {
                                        mainContent.classList.remove('sidebar-active');
                                    }
                                }
                            });
                        });
                    }

                    async function editEngagementCount(field, label, endpointKey) {
                        if (!currentViewNewsId || !isSuperAdmin) return;

                        const elementMap = {
                            views: 'newsDetailViews',
                            likes: 'newsDetailLikes',
                            dislikes: 'newsDetailDislikes'
                        };
                        const element = document.getElementById(elementMap[field]);
                        const currentValue = element.textContent;
                        const newValue = prompt(`Enter new ${label} count:`, currentValue);

                        if (newValue === null || newValue === '') return;

                        const parsed = parseInt(newValue, 10);
                        if (isNaN(parsed) || parsed < 0) {
                                alert('Please enter a valid positive number');
                                return;
                            }
                            
                            try {
                            const response = await fetch(`/news/api/news/${currentViewNewsId}/${endpointKey}`, {
                                    method: 'PUT',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ [field]: parsed })
                            });
                                const result = await response.json();
                                
                                if (response.ok) {
                                element.textContent = parsed;
                                if (result.news) {
                                    syncNewsListCache(result.news);
                                    if (currentViewNewsItem && currentViewNewsItem._id === currentViewNewsId) {
                                        currentViewNewsItem = { ...currentViewNewsItem, ...result.news };
                                    }
                                }
                                } else {
                                alert(result.error || `Failed to update ${label} count`);
                                }
                            } catch (error) {
                            console.error(`Error updating ${label}:`, error);
                            alert(`Error updating ${label} count`);
                        }
                    }

                    async function editNewsViews() {
                        await editEngagementCount('views', 'view', 'views');
                    }

                    async function editNewsLikes() {
                        await editEngagementCount('likes', 'like', 'likes');
                    }

                    async function editNewsDislikes() {
                        await editEngagementCount('dislikes', 'dislike', 'dislikes');
                    }

                    async function deleteNewsComment(commentId) {
                        if (!currentViewNewsId || !isSuperAdmin || !commentId) return;
                        if (!confirm('Delete this comment permanently?')) return;

                        try {
                            const response = await fetch(`/news/api/news/${currentViewNewsId}/comments/${commentId}`, {
                                method: 'DELETE'
                            });
                            const result = await response.json();

                            if (response.ok && result.news) {
                                syncNewsListCache(result.news);
                                refreshEngagementPanel(result.news);
                            } else {
                                alert(result.error || 'Failed to delete comment');
                            }
                        } catch (error) {
                            console.error('Error deleting comment:', error);
                            alert('Error deleting comment');
                        }
                    }

                    async function editNewsComment(commentId) {
                        if (!currentViewNewsId || !isSuperAdmin || !commentId) return;

                        const comments = currentViewNewsItem?.userInteractions?.comments || [];
                        const existing = comments.find(c => String(c._id) === String(commentId));
                        if (!existing) {
                            alert('Comment not found');
                            return;
                        }

                        const updatedText = prompt('Edit comment text:', existing.comment || '');
                        if (updatedText === null || updatedText.trim() === '') return;

                        try {
                            const response = await fetch(`/news/api/news/${currentViewNewsId}/comments/${commentId}`, {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ comment: updatedText.trim() })
                            });
                            const result = await response.json();

                            if (response.ok && result.news) {
                                syncNewsListCache(result.news);
                                refreshEngagementPanel(result.news);
                            } else {
                                alert(result.error || 'Failed to update comment');
                            }
                        } catch (error) {
                            console.error('Error updating comment:', error);
                            alert('Error updating comment');
                        }
                    }
                </script>

    <%- include('partials/notification-modal') %>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (document.getElementById('customDateRangePicker')) {
                const adminId = '<%= typeof admin !== "undefined" ? admin._id : "" %>';
                
                // Initialize PDF generation logic
                const downloadBtn = document.getElementById('downloadPdfBtn');
                if (downloadBtn) {
                    downloadBtn.addEventListener('click', function() {
                        const element = document.getElementById('pdfReportTemplateContainer').cloneNode(true);
                        element.style.display = 'block';
                        
                        const opt = {
                            margin:       0.5,
                            filename:     `SubEditor_Report_${document.getElementById('pdfDateRangeStr').innerText}.pdf`,
                            image:        { type: 'jpeg', quality: 0.98 },
                            html2canvas:  { scale: 2, useCORS: true },
                            jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
                        };
                        
                        // Temporarily append to body to render, then remove
                        const tempContainer = document.createElement('div');
                        tempContainer.style.position = 'absolute';
                        tempContainer.style.left = '-9999px';
                        tempContainer.appendChild(element);
                        document.body.appendChild(tempContainer);
                        
                        html2pdf().set(opt).from(element).save().then(() => {
                            document.body.removeChild(tempContainer);
                        });
                    });
                }

                flatpickr("#customDateRangePicker", {
                    mode: "range",
                    dateFormat: "Y-m-d",
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length > 0) {
                            const from = instance.formatDate(selectedDates[0], "Y-m-d");
                            const to = instance.formatDate(selectedDates[selectedDates.length === 1 ? 0 : 1], "Y-m-d");
                            const display = document.getElementById('customNewsCountDisplay');
                            
                            display.innerHTML = '<i class="fas fa-spinner fa-spin" style="font-size: 1.2rem;"></i>';
                            
                            fetch(`/admin/editors/${adminId}/custom-news-count?from=${from}&to=${to}`)
                                .then(res => res.json())
                                .then(data => {
                                    if (data.error) {
                                        display.innerText = 'Err';
                                        console.error(data.error);
                                    } else {
                                        display.innerText = data.count;
                                        
                                        // Update on-screen metrics
                                        const pendingDisplay = document.getElementById('pendingCountDisplay');
                                        if(pendingDisplay) pendingDisplay.innerText = data.pendingCount !== undefined ? data.pendingCount : '-';
                                        const rejectedDisplay = document.getElementById('rejectedCountDisplay');
                                        if(rejectedDisplay) rejectedDisplay.innerText = data.rejectedCount !== undefined ? data.rejectedCount : '-';
                                        
                                        // Update PDF template data
                                        document.getElementById('pdfDateRangeStr').innerText = `${from} to ${to}`;
                                        document.getElementById('pdfTotalNews').innerText = data.count;
                                        document.getElementById('pdfPendingNews').innerText = data.pendingCount || 0;
                                        document.getElementById('pdfRejectedNews').innerText = data.rejectedCount || 0;
                                        document.getElementById('pdfVideoNews').innerText = data.videoCount || 0;
                                        document.getElementById('pdfNormalNews').innerText = data.normalCount || 0;
                                        
                                        // Show Download Button
                                        if (downloadBtn) downloadBtn.style.display = 'inline-block';
                                    }
                                })
                                .catch(err => {
                                    display.innerText = 'Err';
                                    console.error('Fetch error:', err);
                                });
                        }
                    }
                });
            }
        });
    </script>

    <!-- Hidden PDF Template -->
    <div id="pdfReportTemplateContainer" style="display: none;">
        <div id="pdfReportTemplate" style="padding: 40px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; background: #fff;">
            <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #0056b3; padding-bottom: 20px;">
                <img src="/images/logo.png" alt="Tehelka Logo" style="max-height: 80px; margin-bottom: 15px;">
                <h1 style="color: #0056b3; margin: 0; font-size: 24px; text-transform: uppercase; letter-spacing: 1px;">Sub-Editor Performance Report</h1>
                <p style="color: #666; margin: 10px 0 0 0; font-size: 14px;"><strong>Editor:</strong> <%= typeof admin !== 'undefined' ? (admin.name || admin.username) : 'N/A' %></p>
                <p style="color: #666; margin: 5px 0 0 0; font-size: 14px;"><strong>Date Range:</strong> <span id="pdfDateRangeStr"></span></p>
            </div>
            
            <table style="width: 100%; border-collapse: collapse; margin-top: 20px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
                <thead>
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 12px 15px; border: 1px solid #dee2e6; text-align: left; font-weight: bold; color: #495057; width: 60%;">Metric</th>
                        <th style="padding: 12px 15px; border: 1px solid #dee2e6; text-align: right; font-weight: bold; color: #495057; width: 40%;">Count</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-size: 14px; font-weight: 500;">Total News Published</td>
                        <td style="padding: 12px 15px; border: 1px solid #dee2e6; text-align: right; font-size: 16px; font-weight: bold; color: #0d6efd;" id="pdfTotalNews">0</td>
                    </tr>
                    <tr style="background-color: #fafafa;">
                        <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-size: 14px;">&nbsp;&nbsp;├─ Normal News</td>
                        <td style="padding: 12px 15px; border: 1px solid #dee2e6; text-align: right; font-size: 15px; font-weight: bold; color: #198754;" id="pdfNormalNews">0</td>
