<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>State In-Charge Agreement — Tehelka News</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:#333;line-height:1.6;}
    .agr-wrap{max-width:960px;margin:40px auto;padding:0 20px;}
    .agr-card{background:#fff;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:40px;border:1px solid #e0e0e0;}
    .agr-brand{color:#b91c1c;font-weight:800;letter-spacing:1px;font-size:24px;text-transform:uppercase;}
    .agr-step{display:none;} .agr-step.active{display:block;}
    .tnc-header{text-align:center;margin-bottom:30px;border-bottom:2px solid #333;padding-bottom:15px;}
    .tnc-header h4{font-weight:700;margin:0;font-size:22px;letter-spacing:0.5px;}
    .tnc-header .tnc-version{color:#666;font-size:14px;margin-top:5px;}
    .tnc-box{font-size:15px;white-space:pre-wrap;background:#fff;}
    #sigPad{border:1px dashed #bbb;border-radius:4px;width:100%;height:150px;touch-action:none;background:#fafafa;}
    .muted{color:#6b7280;font-size:13px;}
    .err{color:#dc3545;font-size:14px;font-weight:500;}
    .tnc-text{display:block;margin-bottom:12px;color:#1f2937;}
    .tnc-point-row{display:flex;gap:12px;align-items:flex-start;margin:20px 0;padding:16px 20px;border:1px solid #d1d5db;border-radius:8px;background:#f9fafb;white-space:normal;cursor:pointer;transition:all 0.2s ease;}
    .tnc-point-row input{margin:4px 0 0;width:20px;height:20px;flex:0 0 auto;cursor:pointer;accent-color:#16a34a;}
    .tnc-point-row span{font-size:15px;color:#111827;line-height:1.5;font-weight:500;}
    .tnc-point-row:has(input:checked){background:#f0fdf4;border-color:#22c55e;box-shadow:0 2px 8px rgba(34,197,94,0.15);}
    .tnc-point-row:hover:not(:has(input:checked)){border-color:#9ca3af;background:#f3f4f6;}
    #tncProgress{font-size:14px;font-weight:600;margin-top:10px;}
    .identity-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:16px;margin-bottom:30px;}
    .identity-box .row > div {margin-bottom:8px;font-size:14px;}
    
    @media (max-width: 768px) {
      .agr-wrap{margin:16px auto;padding:0 12px;}
      .agr-card{padding:24px 16px;}
      .tnc-point-row{padding:12px 14px;}
    }
  </style>
</head>
<body>
  <div class="agr-wrap">
    <div class="text-center mb-3"><span class="agr-brand">TEHELKA NEWS</span><div class="muted">State In-Charge — Appointment Agreement</div></div>
    <div class="agr-card">

      <!-- Step 1: email -->
      <div class="agr-step active" id="s-email">
        <h5>Verify your identity</h5>
        <p class="muted">Enter the email address registered with your State In-Charge account. A one-time code will be sent to that email.</p>
        <input type="email" id="email" class="form-control mb-2" placeholder="registered email address" autocomplete="email">
        <div class="err mb-2" id="emailErr"></div>
        <button class="btn btn-danger w-100" id="btnSendOtp">Send Verification Code</button>
      </div>

      <!-- Step 2: otp -->
      <div class="agr-step" id="s-otp">
        <h5>Enter verification code</h5>
        <p class="muted" id="otpHint">We sent a 6-digit code to your registered email. Check inbox & spam.</p>
        <input type="text" id="otp" inputmode="numeric" maxlength="6" class="form-control mb-2" placeholder="6-digit code">
        <div class="err mb-2" id="otpErr"></div>
        <button class="btn btn-danger w-100 mb-2" id="btnVerify">Verify</button>
        <button class="btn btn-link w-100 p-0 muted" id="btnBackEmail">Change email</button>
      </div>

      <!-- Step 3: identity + terms -->
      <div class="agr-step" id="s-terms">
        <div class="alert alert-success py-2 fw-semibold" style="font-size:14px;">Identity Verified ✓</div>
        <div id="identityBox" class="identity-box"></div>
        
        <div class="tnc-header">
          <h4>TERMS &amp; CONDITIONS</h4>
          <div class="tnc-version" id="tncVer"></div>
        </div>
        
        <div class="tnc-box" id="tncBox">Loading…</div>
        
        <div class="p-4 mt-4" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
          <div id="tncProgress" class="text-primary mb-2"></div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="agree" disabled style="width:20px;height:20px;margin-top:2px;">
            <label class="form-check-label fw-bold ms-2" for="agree" style="font-size:15px;color:#111827;">I have read and agree to the Terms &amp; Conditions.</label>
          </div>
          <div class="muted fw-semibold" id="scrollHint">Select every required item and scroll to the end of the document to continue.</div>
          <button class="btn btn-primary btn-lg w-100 mt-3 fw-bold" id="btnToSign" disabled>Continue</button>
        </div>
      </div>

      <!-- Step 4: sign + accept -->
      <div class="agr-step" id="s-sign">
        <div class="text-center mb-4">
          <h4 style="font-weight:700;">Final Confirmation</h4>
          <p class="text-muted">Please complete the final steps to record your acceptance.</p>
        </div>
        
        <div class="mb-4">
          <label class="form-label fw-bold mb-1">Full Name</label>
          <input type="text" id="typedName" class="form-control form-control-lg mb-2" placeholder="Type your full name">
        </div>
        
        <div class="mb-4">
          <label class="form-label fw-bold mb-1">Digital Signature</label>
          <div class="text-muted mb-2" style="font-size:13px;">Draw your signature below to confirm your acceptance.</div>
          <canvas id="sigPad"></canvas>
          <div class="d-flex justify-content-between mt-1">
            <span class="text-muted" style="font-size:12px;">Use finger or mouse</span>
            <button class="btn btn-sm btn-outline-secondary py-0" id="clearSig">Clear Signature</button>
          </div>
        </div>
        
        <div class="mb-4 p-3" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
          <label class="form-label fw-bold mb-1">Location Permission</label>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="locConsent" style="width:18px;height:18px;margin-top:2px;">
            <label class="form-check-label ms-2" for="locConsent" style="font-size:14px;color:#374151;">
              Allow location access to complete the digital acceptance record.
            </label>
          </div>
        </div>
        
        <div class="err mb-3 text-center" id="signErr"></div>
        <button class="btn btn-primary btn-lg w-100 fw-bold" id="btnAccept" disabled>Submit Final Acceptance</button>
      </div>

      <!-- Done -->
      <div class="agr-step" id="s-done">
        <div class="text-center py-3">
          <div style="font-size:44px">✅</div>
          <h5>Agreement Completed</h5>
          <p class="muted" id="doneMsg">Thank you. Your acceptance has been recorded. Our team will review and confirm your appointment.</p>
        </div>
      </div>

      <!-- Already completed -->
      <div class="agr-step" id="s-already">
        <div class="text-center mb-2"><div style="font-size:40px">📄</div><h5 class="mb-0">Agreement Already Completed</h5>
          <p class="muted">This agreement has already been completed. No new acceptance is needed.</p></div>
        <div id="alreadyBox" style="font-size:14px"></div>
        <button class="btn btn-danger w-100 mt-3" id="btnViewCompleted">View / Print My Agreement</button>
      </div>

    </div>
    <p class="text-center muted mt-2">Secure · Your data is used only for this appointment agreement.</p>
  </div>

<script>
(function(){
  var email='', tnc=null;
  function show(id){document.querySelectorAll('.agr-step').forEach(function(e){e.classList.remove('active')});document.getElementById(id).classList.add('active');window.scrollTo(0,0);}
  function post(url,body){return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j}})});}

  document.getElementById('btnSendOtp').onclick=function(){
    email=document.getElementById('email').value.trim();
    document.getElementById('emailErr').textContent='';
    if(!email){document.getElementById('emailErr').textContent='Please enter your email.';return;}
    this.disabled=true;var b=this;
    post('/state-agreement/request-otp',{email:email}).then(function(res){
      b.disabled=false;
      if(res && res.ok===false){ document.getElementById('emailErr').textContent=(res.j&&res.j.error)||'Could not send the code right now. Please try again shortly.'; return; }
      document.getElementById('otpHint').textContent='If your email is registered, a 6-digit code was sent to it. Check inbox & spam.'; show('s-otp');
    }).catch(function(){b.disabled=false;document.getElementById('emailErr').textContent='Network error.';});
  };
  document.getElementById('btnBackEmail').onclick=function(){show('s-email');};

  document.getElementById('btnVerify').onclick=function(){
    var otp=document.getElementById('otp').value.trim();document.getElementById('otpErr').textContent='';
    if(otp.length!==6){document.getElementById('otpErr').textContent='Enter the 6-digit code.';return;}
    this.disabled=true;var b=this;
    post('/state-agreement/verify-otp',{email:email,otp:otp}).then(function(res){
      b.disabled=false;
      if(!res.ok||!res.j.ok){document.getElementById('otpErr').textContent=res.j.error||'Invalid code.';return;}
      var id=res.j.identity;
      // Already completed → show summary (only after successful OTP verification).
      if(res.j.alreadyCompleted){
        var s=res.j.summary||{};
        document.getElementById('alreadyBox').innerHTML=
          '<div><b>Name:</b> '+esc(id.name)+'</div>'+
          '<div><b>Email:</b> '+esc(id.emailMasked)+'</div>'+
          '<div><b>State:</b> '+esc(id.state||'—')+'</div>'+
          '<div><b>Status:</b> Completed / Accepted</div>'+
          '<div><b>T&C version accepted:</b> v'+esc(s.tncVersion||'—')+'</div>'+
          '<div><b>Accepted on:</b> '+(s.acceptedAt?new Date(s.acceptedAt).toLocaleString():'—')+'</div>'+
          '<div><b>Signature:</b> '+(s.hasSignature?'Captured':'Not captured')+'</div>'+
          '<div><b>Captured GPS:</b> '+(s.gpsCaptured?'Yes (with consent)':'Not captured')+'</div>'+
          '<div><b>IP evidence:</b> '+(s.ipCaptured?'Recorded':'—')+'</div>';
        show('s-already'); return;
      }
      document.getElementById('identityBox').innerHTML=
        '<div class="row">' +
        '<div class="col-sm-6"><strong>Name:</strong> '+esc(id.name)+'</div>' +
        '<div class="col-sm-6"><strong>Email:</strong> '+esc(id.emailMasked)+'</div>' +
        '<div class="col-sm-6"><strong>Designation:</strong> '+esc(id.designation)+'</div>' +
        '<div class="col-sm-6"><strong>State:</strong> '+esc(id.state||'—')+'</div>' +
        '</div>';
      document.getElementById('typedName').value=id.name||'';
      loadTerms();
    }).catch(function(){b.disabled=false;document.getElementById('otpErr').textContent='Network error.';});
  };

  // View / print the verified subeditor's OWN completed agreement (session-scoped).
  document.getElementById('btnViewCompleted').onclick=function(){
    fetch('/state-agreement/my-acceptance').then(function(r){return r.json();}).then(function(d){
      if(!d.ok||!d.evidence){alert('Could not load your agreement.');return;}
      var e=d.evidence;
      var w=window.open('','_blank');
      if(!w){alert('Please allow pop-ups to view/print.');return;}
      var points = (e.acceptancePoints && e.acceptancePoints.list) || [];
      var pointIndex = 0;
      var lines = (e.agreement.content||'').split('\n');
      var content = '';
      var MARKER_RE = /^[ \t]*\[\[ACCEPT(:optional)?\]\][ \t]*(.*?)[ \t]*$/i;
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        var mm = MARKER_RE.exec(line);
        if (mm) {
          var p = points[pointIndex++] || {};
          var label = p.label || mm[2] || '';
          content += '<div style="margin-bottom: 4px;">' + esc(label) + '</div>';
          if (p.accepted) {
            content += '<div style="margin: 4px 0 16px 0; color: #166534; font-weight: bold; font-size: 14px;">✓ Accepted</div>';
          } else if (p.required) {
            content += '<div style="margin: 4px 0 16px 0; color: #991b1b; font-weight: bold; font-size: 14px;">✗ NOT accepted (Required)</div>';
          } else {
            content += '<div style="margin: 4px 0 16px 0; color: #6b7280; font-weight: bold; font-size: 14px;">— Not accepted (Optional)</div>';
          }
        } else {
          var lm = /^\s*[☐☑☒]\s?(.*)$/.exec(line);
          if (lm && points.length === 0) {
            content += '<div style="margin-bottom: 4px;">' + esc(lm[1]) + '</div>';
            content += '<div style="margin: 4px 0 16px 0; color: #166534; font-weight: bold; font-size: 14px;">✓ Accepted</div>';
          } else {
            if (line.trim() === '') {
              content += '<br>';
            } else {
              content += '<div style="margin-bottom: 6px;">' + esc(line) + '</div>';
            }
          }
        }
      }
      
      var summaryHtml = '';
      if (e.acceptancePoints && e.acceptancePoints.hasPoints) {
        summaryHtml = '<div style="margin-top:20px;padding:12px;background:#f9fafb;border:1px solid #eee;border-radius:6px;"><strong>Acceptance Summary</strong><br>Required terms accepted: ' + e.acceptancePoints.acceptedRequiredCount + ' / ' + e.acceptancePoints.requiredCount + '<br>Final acceptance: Confirmed</div>';
      }

      w.document.write('<html><head><title>Agreement Evidence</title><style>body{font-family:Arial,sans-serif;max-width:800px;margin:20px auto;padding:0 16px}h2{color:#b91c1c}pre{white-space:pre-wrap;font-size:13px;border:1px solid #eee;padding:12px;background:#fafafa}.k{color:#666}@media print{@page{size:A4;margin:14mm}}</style></head><body>'+
        '<h2>TEHELKA NEWS — State In-Charge Agreement Evidence</h2>'+
        '<p><span class="k">Name:</span> '+esc(e.identity.name)+' &nbsp; <span class="k">Email:</span> '+esc(e.identity.emailMasked)+'<br>'+
        '<span class="k">State:</span> '+esc(e.identity.state||'—')+' &nbsp; <span class="k">Status:</span> Accepted<br>'+
        '<span class="k">T&C Version:</span> v'+esc(e.agreement.tncVersion)+' &nbsp; <span class="k">T&C Hash:</span> '+esc(e.agreement.tncHash)+'<br>'+
        '<span class="k">Accepted At:</span> '+(e.evidence.acceptedAt?new Date(e.evidence.acceptedAt).toLocaleString():'—')+'</p>'+
        '<h3>Terms &amp; Conditions Accepted (frozen v'+esc(e.agreement.tncVersion)+')</h3><div style="font-size:13px;border:1px solid #eee;padding:12px;background:#fafafa;font-family:Arial,sans-serif">'+content+'</div>'+summaryHtml+
        '<h3>Acceptance Evidence</h3><p><span class="k">OTP verified:</span> '+(e.evidence.otpVerified?'Yes':'No')+'<br>'+
        '<span class="k">IP:</span> '+esc(e.evidence.ip||'—')+'<br>'+
        '<span class="k">Captured GPS:</span> '+(e.location.hasGps?(e.location.latitude+', '+e.location.longitude):'Not captured')+'<br>'+
        '<span class="k">Acceptance Hash:</span> '+esc(e.evidence.acceptanceHash||'—')+'</p>'+
        '<p style="font-size:11px;color:#666">System-generated copy of the immutable acceptance record.</p>'+
        '</body></html>');
      w.document.close(); setTimeout(function(){w.print();},400);
    }).catch(function(){alert('Network error.');});
  };

  function loadTerms(){
    fetch('/state-agreement/terms').then(function(r){return r.json()}).then(function(j){
      if(j.error){document.getElementById('tncBox').textContent=j.error;show('s-terms');return;}
      tnc=j; document.getElementById('tncVer').textContent='Version '+j.version;
      renderTnc(); show('s-terms');
    });
  }
  var box=document.getElementById('tncBox');
  var scrolledEnd=false;
  var tncMismatch=false;
  var MARKER_RE = /^[ \t]*\[\[ACCEPT(:optional)?\]\][ \t]*(.*?)[ \t]*$/i;
  function renderTnc(){
    var text=tnc.bodyEnglish||tnc.bodyTelugu||'(No content)';
    var meta=(tnc.acceptancePoints||[]);
    var lines=text.split('\n'), html='', markerIdx=0;
    tncMismatch=false;
    for(var i=0;i<lines.length;i++){
      var line=lines[i];
      var mm=MARKER_RE.exec(line);
      if(mm){
        var pm=meta[markerIdx]; markerIdx++;
        if(meta.length>0 && !pm){ tncMismatch=true; }
        var key=pm?pm.key:'';
        var required=pm?!!pm.required:!mm[1];
        var label=pm?pm.label:(mm[2]||'');
        html+='<label class="tnc-point-row"><input type="checkbox" class="tnc-point" data-key="'+esc(key)+'" data-required="'+(required?'1':'0')+'"><span>'+esc(label)+(required?'':' <em style="color:#6b7280;font-weight:normal;font-size:13px;">(optional)</em>')+'</span></label>';
      } else {
        var lm=/^\s*[☐☑☒]\s?(.*)$/.exec(line);
        if(lm && meta.length===0){
          html+='<label class="tnc-point-row"><input type="checkbox" class="tnc-point" data-required="1"><span>'+esc(lm[1])+'</span></label>';
        } else {
          html+='<span class="tnc-text">'+esc(line)+'</span>\n';
        }
      }
    }
    if(meta.length>0 && markerIdx!==meta.length){ tncMismatch=true; }
    box.innerHTML=html;
    scrolledEnd=false;
    onScroll();
    updateGate();
  }
  function reqTotal(){return box.querySelectorAll('.tnc-point[data-required="1"]').length;}
  function reqChecked(){return box.querySelectorAll('.tnc-point[data-required="1"]:checked').length;}
  function collectAcceptedKeys(){ return Array.prototype.map.call(box.querySelectorAll('.tnc-point[data-key]:checked'), function(cb){return cb.getAttribute('data-key');}).filter(function(k){return !!k;}); }
  function updateGate(){
    var agree=document.getElementById('agree'), toBtn=document.getElementById('btnToSign');
    var hint=document.getElementById('scrollHint'), prog=document.getElementById('tncProgress');
    if(tncMismatch){
      agree.disabled=true; agree.checked=false; toBtn.disabled=true; prog.textContent='';
      hint.textContent='Please refresh the agreement and try again.';
      return;
    }
    var rt=reqTotal(), rc=reqChecked();
    var ready=(rt===0 || rc>=rt) && scrolledEnd;
    agree.disabled=!ready; if(!ready && agree.checked){ agree.checked=false; }
    toBtn.disabled=!(ready && agree.checked);
    prog.textContent = rt>0 ? ('Required items accepted: '+rc+' / '+rt) : '';
    if(rt>0 && rc<rt){ hint.textContent='Select every required item and scroll to the end of the document to continue.'; }
    else if(!scrolledEnd){ hint.textContent='Please scroll to the end of the document to continue.'; }
    else { hint.textContent='You may now accept and continue.'; }
  }
  
  // Track scroll on the window instead of inner box
  function onScroll(){ 
    var agreeRect = document.getElementById('btnToSign').getBoundingClientRect();
    // If the continue button is visible in viewport or window is scrolled to bottom
    if(agreeRect.top <= (window.innerHeight || document.documentElement.clientHeight) + 100 || 
       (window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) { 
      scrolledEnd=true; updateGate(); 
    } 
  }
  
  window.addEventListener('scroll',onScroll);
  window.addEventListener('resize',onScroll);
  box.addEventListener('change',function(e){ if(e.target&&e.target.classList&&e.target.classList.contains('tnc-point')){ updateGate(); } });
  document.getElementById('agree').onchange=function(){ updateGate(); };
  document.getElementById('btnToSign').onclick=function(){show('s-sign');fitSig();};

  // signature pad
  var cv=document.getElementById('sigPad'),ctx=cv.getContext('2d'),drawing=false,dirty=false;
  function fitSig(){cv.width=cv.offsetWidth;cv.height=150;ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#111';}
  function pos(e){var r=cv.getBoundingClientRect();var t=e.touches?e.touches[0]:e;return{x:t.clientX-r.left,y:t.clientY-r.top};}
  function start(e){drawing=true;dirty=true;var p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault();}
  function move(e){if(!drawing)return;var p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault();}
  function end(){drawing=false; updateFinalGate();}
  ['mousedown','touchstart'].forEach(function(ev){cv.addEventListener(ev,start);});
  ['mousemove','touchmove'].forEach(function(ev){cv.addEventListener(ev,move);});
  ['mouseup','mouseleave','touchend'].forEach(function(ev){cv.addEventListener(ev,end);});
  document.getElementById('clearSig').onclick=function(){ctx.clearRect(0,0,cv.width,cv.height);dirty=false;updateFinalGate();};

  function updateFinalGate() {
    var typedName = document.getElementById('typedName').value.trim();
    var hasConsent = document.getElementById('locConsent').checked;
    var btn = document.getElementById('btnAccept');
    btn.disabled = !(typedName && dirty && hasConsent);
  }
  document.getElementById('typedName').addEventListener('input', updateFinalGate);
  document.getElementById('locConsent').addEventListener('change', updateFinalGate);

  document.getElementById('btnAccept').onclick=function(){
    document.getElementById('signErr').textContent='';
    var typedName=document.getElementById('typedName').value.trim();
    if(!typedName){document.getElementById('signErr').textContent='Please type your full name.';return;}
    var b=this;b.disabled=true;
    var payload={acceptedVersion:tnc?tnc.version:'',tncHash:tnc?tnc.contentHash:'',agree:true,typedName:typedName,
      // Only point KEYS are sent; the server re-derives labels/required and re-validates.
      acceptedPoints: collectAcceptedKeys(),
      device:{platform:navigator.platform,language:navigator.language,timezone:(Intl.DateTimeFormat().resolvedOptions().timeZone||''),screen:(screen.width+'x'+screen.height)},
      signatureData: dirty? cv.toDataURL('image/png') : '',
      locationPermission:'unavailable'};
    function done(){post('/state-agreement/accept',payload).then(function(res){b.disabled=false;
      if(!res.ok||!res.j.ok){document.getElementById('signErr').textContent=res.j.error||'Could not record.';return;}
      if(res.j.alreadyCompleted){ document.getElementById('doneMsg').textContent='This agreement was already completed earlier (v'+res.j.version+'). No new acceptance was created.'; show('s-done'); return; }
      document.getElementById('doneMsg').textContent='Thank you. Agreement v'+res.j.version+' recorded on '+new Date(res.j.acceptedAt).toLocaleString()+'.';show('s-done');
    }).catch(function(){b.disabled=false;document.getElementById('signErr').textContent='Network error.';});}
    if(document.getElementById('locConsent').checked && navigator.geolocation){
      navigator.geolocation.getCurrentPosition(function(p){payload.locationPermission='granted';payload.latitude=p.coords.latitude;payload.longitude=p.coords.longitude;done();},
        function(){payload.locationPermission='denied';done();},{timeout:8000});
    } else { payload.locationPermission='denied'; done(); }
  };
  function esc(s){return String(s==null?'':s).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
})();
</script>
</body>
</html>
