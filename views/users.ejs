<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Users Directory' }) %>
    <link rel="stylesheet" href="/css/users-directory.css">
    </head>

    <body>
        <%- include('partials/top-nav', { pageTitle: 'Users Management', backButton: true, backUrl: '/' }) %>

            <div class="container-fluid">
                <div class="row">
                    <%- include('partials/sidebar', { activePage: 'users' }) %>

                        <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                            <div class="content-area mt-4">
                                <% 
                                    const userList = users || [];
                                    const pageStats = typeof stats !== 'undefined' ? stats : { total: userList.length, google: 0, mobile: 0, activeWeek: 0 };
                                    const totalUsers = (typeof pagination !== 'undefined' && pagination.totalUsers !== undefined) ? pagination.totalUsers : userList.length;
                                    const currentPage = (typeof pagination !== 'undefined' && pagination.currentPage) ? pagination.currentPage : 1;
                                    const totalPages = (typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1;
                                    const pageLimit = (typeof pagination !== 'undefined' && pagination.limit) ? pagination.limit : userList.length;
                                    const currentSearch = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
                                    const currentAuth = (typeof authFilter !== 'undefined' && authFilter) ? authFilter : '';
                                    let paginationQuery = '';
                                    if (currentSearch) paginationQuery += '&search=' + encodeURIComponent(currentSearch);
                                    if (currentAuth) paginationQuery += '&auth=' + currentAuth;

                                    function buildAuthHref(auth) {
                                        let q = '?';
                                        if (auth) q += 'auth=' + auth;
                                        if (currentSearch) q += (q.length > 1 ? '&' : '') + 'search=' + encodeURIComponent(currentSearch);
                                        return q === '?' ? '/admin/users' : '/admin/users' + q;
                                    }
                                %>

                                <div class="usr-page">
                                    <div class="usr-page-header">
                                        <div>
                                            <h1 class="usr-page-title">Audience Directory</h1>
                                            <p class="usr-page-subtitle">Browse registered app users, filter by sign-in method, and review engagement activity.</p>
                                        </div>
                                    </div>

                                    <div class="usr-stats">
                                        <div class="usr-stat">
                                            <div class="usr-stat-value"><%= pageStats.total %></div>
                                            <div class="usr-stat-label">Total users</div>
                                        </div>
                                        <div class="usr-stat">
                                            <div class="usr-stat-value"><%= pageStats.google %></div>
                                            <div class="usr-stat-label">Google sign-in</div>
                                        </div>
                                        <div class="usr-stat">
                                            <div class="usr-stat-value"><%= pageStats.mobile %></div>
                                            <div class="usr-stat-label">Mobile sign-in</div>
                                        </div>
                                        <div class="usr-stat">
                                            <div class="usr-stat-value"><%= pageStats.activeWeek %></div>
                                            <div class="usr-stat-label">Active this week</div>
                                        </div>
                                    </div>

                                    <div class="usr-panel">
                                        <div class="usr-panel-toolbar">
                                            <form class="usr-search-form" method="GET" action="/admin/users">
                                                <% if (currentAuth) { %>
                                                    <input type="hidden" name="auth" value="<%= currentAuth %>">
                                                <% } %>
                                                <div class="usr-search-wrap">
                                                    <i class="fas fa-search"></i>
                                                    <input type="text" name="search" class="usr-search" placeholder="Search name, email, or mobile..." value="<%= currentSearch %>">
                                                </div>
                                                <button type="submit" class="usr-search-btn">
                                                    <i class="fas fa-filter"></i> Search
                                                </button>
                                                <% if (currentSearch || currentAuth) { %>
                                                    <a href="/admin/users" class="usr-clear-btn">Clear</a>
                                                <% } %>
                                            </form>

                                            <div class="usr-segments" role="tablist">
                                                <a href="<%= buildAuthHref('') %>" class="usr-segment <%= !currentAuth ? 'active' : '' %>">
                                                    All<span class="usr-segment-count"><%= pageStats.total %></span>
                                                </a>
                                                <a href="<%= buildAuthHref('google') %>" class="usr-segment <%= currentAuth === 'google' ? 'active' : '' %>">
                                                    Google<span class="usr-segment-count"><%= pageStats.google %></span>
                                                </a>
                                                <a href="<%= buildAuthHref('mobile') %>" class="usr-segment <%= currentAuth === 'mobile' ? 'active' : '' %>">
                                                    Mobile<span class="usr-segment-count"><%= pageStats.mobile %></span>
                                                </a>
                                            </div>
                                        </div>

                                        <% if (userList.length > 0) { %>
                                        <div class="usr-table-wrap">
                                            <table class="usr-table">
                                                <thead>
                                                    <tr>
                                                        <th>User</th>
                                                        <th>Sign-in</th>
                                                        <th>Contact</th>
                                                        <th>Joined</th>
                                                        <th>Last login</th>
                                                        <th>Activity</th>
                                                        <th>Referrals</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% userList.forEach(function(user) { %>
                                                    <tr>
                                                        <td>
                                                            <div class="usr-user-cell">
                                                                <% if (user.photoUrl) { %>
                                                                    <img src="<%= user.photoUrl %>" alt="<%= user.displayName %>" class="usr-avatar">
                                                                <% } else { %>
                                                                    <div class="usr-avatar-fallback"><i class="fas fa-user"></i></div>
                                                                <% } %>
                                                                <div>
                                                                    <div class="usr-user-name"><%= user.displayName %></div>
                                                                    <div class="usr-user-id" title="<%= user._id %>"><%= user._id %></div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <% if (user.googleId) { %>
                                                                <span class="usr-pill usr-pill-google"><i class="fab fa-google"></i> Google</span>
                                                            <% } else if (user.mobileNumber) { %>
                                                                <span class="usr-pill usr-pill-mobile"><i class="fas fa-mobile-alt"></i> Mobile</span>
                                                            <% } else { %>
                                                                <span class="usr-pill usr-pill-other">Other</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <div class="usr-contact">
                                                                <% if (user.email) { %><span><%= user.email %></span><% } %>
                                                                <% if (user.mobileNumber) { %><span><%= user.mobileNumber %></span><% } %>
                                                                <% if (!user.email && !user.mobileNumber) { %>
                                                                    <span class="usr-contact-muted">Not provided</span>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <td><span class="usr-date"><%= new Date(user.createdAt).toLocaleDateString() %></span></td>
                                                        <td>
                                                            <% if (user.lastLogin) { %>
                                                                <span class="usr-date"><%= new Date(user.lastLogin).toLocaleDateString() %></span>
                                                            <% } else { %>
                                                                <span class="usr-contact-muted">Never</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <div class="usr-activity">
                                                                <span class="usr-activity-chip likes"><i class="fas fa-thumbs-up"></i> <%= user.activityCounts?.likes || 0 %></span>
                                                                <span class="usr-activity-chip dislikes"><i class="fas fa-thumbs-down"></i> <%= user.activityCounts?.dislikes || 0 %></span>
                                                                <span class="usr-activity-chip comments"><i class="fas fa-comment"></i> <%= user.activityCounts?.comments || 0 %></span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="usr-referral-stats" style="display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem;">
                                                                <% if (user.referralCode) { %>
                                                                    <span style="font-weight: 600; color: #4f46e5; background: #eef2ff; padding: 2px 6px; border-radius: 4px; width: fit-content;"><i class="fas fa-ticket-alt"></i> <%= user.referralCode %></span>
                                                                    <span style="color: #64748b;"><i class="fas fa-users" style="width: 14px;"></i> <%= user.totalReferrals || 0 %> invites</span>
                                                                    <span style="color: #059669; font-weight: 600;"><i class="fas fa-wallet" style="width: 14px;"></i> ₹<%= user.walletBalance || 0 %></span>
                                                                <% } else { %>
                                                                    <span class="usr-contact-muted">No Code</span>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <td style="display: flex; gap: 8px;">
                                                            <button type="button" class="usr-view-btn" data-user-id="<%= user._id %>" onclick="openUserModal('<%= user._id %>')">
                                                                <i class="fas fa-eye"></i> Details
                                                            </button>
                                                            <% if (user.referralCode) { %>
                                                                <a href="/admin/referrals?search=<%= user.referralCode %>" class="usr-view-btn" style="text-decoration: none; background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0;">
                                                                    <i class="fas fa-share-nodes"></i> Referrals
                                                                </a>
                                                            <% } %>
                                                            <button type="button" class="usr-view-btn" style="background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;" onclick="confirmDeleteUser('<%= user._id %>')">
                                                                <i class="fas fa-trash-alt"></i> Delete
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="usr-pagination">
                                            <div class="usr-pagination-info">
                                                Showing <%= totalUsers === 0 ? 0 : ((currentPage - 1) * pageLimit) + 1 %>–<%= Math.min(currentPage * pageLimit, totalUsers) %> of <%= totalUsers %> users
                                                <% if (totalPages > 1) { %> · Page <%= currentPage %> of <%= totalPages %><% } %>
                                            </div>
                                            <% if (totalPages > 1) { %>
                                            <div class="usr-pagination-nav">
                                                <a class="usr-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=1<%= paginationQuery %>" aria-label="First page"><i class="fas fa-angles-left"></i></a>
                                                <a class="usr-page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="?page=<%= currentPage - 1 %><%= paginationQuery %>" aria-label="Previous page"><i class="fas fa-angle-left"></i></a>
                                                <% 
                                                    let startPage = Math.max(1, currentPage - 2);
                                                    let endPage = Math.min(totalPages, currentPage + 2);
                                                    if (endPage - startPage < 4) {
                                                        if (startPage === 1) endPage = Math.min(totalPages, startPage + 4);
                                                        else startPage = Math.max(1, endPage - 4);
                                                    }
                                                    for (let i = startPage; i <= endPage; i++) { %>
                                                <a class="usr-page-btn <%= i === currentPage ? 'active' : '' %>" href="?page=<%= i %><%= paginationQuery %>"><%= i %></a>
                                                <% } %>
                                                <a class="usr-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= currentPage + 1 %><%= paginationQuery %>" aria-label="Next page"><i class="fas fa-angle-right"></i></a>
                                                <a class="usr-page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="?page=<%= totalPages %><%= paginationQuery %>" aria-label="Last page"><i class="fas fa-angles-right"></i></a>
                                            </div>
                                            <% } %>
                                        </div>
                                        <% } else { %>
                                        <div class="usr-empty">
                                            <div class="usr-empty-icon"><i class="fas fa-users"></i></div>
                                            <h3>No users found</h3>
                                            <p><% if (currentSearch || currentAuth) { %>Try adjusting your search or filters.<% } else { %>No users have registered yet.<% } %></p>
                                        </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <!-- User detail modal -->
            <div class="modal fade" id="userDetailModal" tabindex="-1" aria-labelledby="userDetailModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="usr-modal-header">
                            <div class="usr-modal-header-left">
                                <div id="usrModalAvatarWrap"></div>
                                <div>
                                    <h2 class="usr-modal-title" id="userDetailModalLabel">User details</h2>
                                    <p class="usr-modal-subtitle" id="usrModalSubtitle"></p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="usr-modal-body" id="usrModalBody"></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete User Password Modal -->
            <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteUserModalLabel">Confirm Deletion</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete this user? This action cannot be undone.</p>
                            <input type="hidden" id="deleteUserIdInput">
                            <div class="mb-3">
                                <label for="deleteUserPassword" class="form-label">Admin Password</label>
                                <input type="password" class="form-control" id="deleteUserPassword" placeholder="Enter .env password to confirm" required>
                                <small class="text-muted">Requires USER_DELETE_PASSWORD from .env</small>
                            </div>
                            <div id="deleteUserError" class="text-danger mt-2" style="display: none;"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" onclick="submitDeleteUser()">Delete User</button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                window.usersPageData = <%- JSON.stringify(userList.map(function(u) {
                    return {
                        _id: u._id,
                        displayName: u.displayName,
                        photoUrl: u.photoUrl || '',
                        googleId: u.googleId || '',
                        email: u.email || '',
                        mobileNumber: u.mobileNumber || '',
                        createdAt: u.createdAt,
                        lastLogin: u.lastLogin,
                        activityCounts: u.activityCounts || { likes: 0, dislikes: 0, comments: 0 },
                        interactions: u.interactions || { likes: [], dislikes: [], comments: [] }
                    };
                })) %>;

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                function formatDate(value) {
                    if (!value) return 'Never';
                    return new Date(value).toLocaleDateString();
                }

                function renderRichContent(text) {
                    if (typeof window.renderRichText === 'function') {
                        return window.renderRichText(text || '');
                    }
                    return escapeHtml(text || '');
                }

                function renderInteractionItems(items, type, limit) {
                    if (!items || items.length === 0) {
                        return '<p class="usr-interaction-empty">No ' + type + ' yet</p>';
                    }
                    let html = '';
                    items.slice(0, limit).forEach(function(item) {
                        html += '<div class="usr-interaction-item">';
                        html += '<p class="usr-interaction-item-title rich-text">' + renderRichContent(item.title || 'Unknown article') + '</p>';
                        if (type === 'comments' && item.comment) {
                            html += '<div class="usr-comment-text">' + escapeHtml(item.comment) + '</div>';
                        }
                        html += '<div class="usr-interaction-item-meta">';
                        html += '<span><i class="fas fa-tag"></i> ' + escapeHtml(item.category || 'General') + '</span>';
                        html += '<span><i class="fas fa-calendar"></i> ' + formatDate(item.publishedAt || item.timestamp) + '</span>';
                        html += '</div></div>';
                    });
                    if (items.length > limit) {
                        html += '<p class="usr-more-note">+ ' + (items.length - limit) + ' more ' + type + '...</p>';
                    }
                    return html;
                }

                function openUserModal(userId) {
                    const user = window.usersPageData.find(function(u) { return String(u._id) === String(userId); });
                    if (!user) return;

                    const authLabel = user.googleId ? 'Google sign-in' : (user.mobileNumber ? 'Mobile sign-in' : 'Other');
                    document.getElementById('userDetailModalLabel').textContent = user.displayName;
                    document.getElementById('usrModalSubtitle').textContent = authLabel + ' · Joined ' + formatDate(user.createdAt);

                    const avatarWrap = document.getElementById('usrModalAvatarWrap');
                    if (user.photoUrl) {
                        avatarWrap.innerHTML = '<img src="' + escapeHtml(user.photoUrl) + '" alt="" class="usr-modal-avatar">';
                    } else {
                        avatarWrap.innerHTML = '<div class="usr-modal-avatar-fallback"><i class="fas fa-user"></i></div>';
                    }

                    const counts = user.activityCounts || { likes: 0, dislikes: 0, comments: 0 };
                    const interactions = user.interactions || { likes: [], dislikes: [], comments: [] };

                    document.getElementById('usrModalBody').innerHTML =
                        '<div class="usr-modal-grid">' +
                            '<div>' +
                                '<div class="usr-info-card">' +
                                    '<h4>Profile</h4>' +
                                    '<div class="usr-info-row"><span class="usr-info-label">User ID</span><span class="usr-info-value">' + escapeHtml(String(user._id)) + '</span></div>' +
                                    (user.email ? '<div class="usr-info-row"><span class="usr-info-label">Email</span><span class="usr-info-value">' + escapeHtml(user.email) + '</span></div>' : '') +
                                    (user.mobileNumber ? '<div class="usr-info-row"><span class="usr-info-label">Mobile</span><span class="usr-info-value">' + escapeHtml(user.mobileNumber) + '</span></div>' : '') +
                                    '<div class="usr-info-row"><span class="usr-info-label">Registered</span><span class="usr-info-value">' + formatDate(user.createdAt) + '</span></div>' +
                                    '<div class="usr-info-row"><span class="usr-info-label">Last login</span><span class="usr-info-value">' + formatDate(user.lastLogin) + '</span></div>' +
                                '</div>' +
                            '</div>' +
                            '<div>' +
                                '<div class="usr-activity-summary">' +
                                    '<div class="usr-activity-stat"><div class="usr-activity-stat-value likes">' + counts.likes + '</div><div class="usr-activity-stat-label">Likes</div></div>' +
                                    '<div class="usr-activity-stat"><div class="usr-activity-stat-value dislikes">' + counts.dislikes + '</div><div class="usr-activity-stat-label">Dislikes</div></div>' +
                                    '<div class="usr-activity-stat"><div class="usr-activity-stat-value comments">' + counts.comments + '</div><div class="usr-activity-stat-label">Comments</div></div>' +
                                '</div>' +
                                '<div class="usr-interaction-section">' +
                                    '<h3 class="usr-interaction-title"><i class="fas fa-thumbs-up" style="color:#2563eb"></i> Likes (' + counts.likes + ')</h3>' +
                                    renderInteractionItems(interactions.likes, 'likes', 5) +
                                '</div>' +
                                '<div class="usr-interaction-section">' +
                                    '<h3 class="usr-interaction-title"><i class="fas fa-thumbs-down" style="color:#d97706"></i> Dislikes (' + counts.dislikes + ')</h3>' +
                                    renderInteractionItems(interactions.dislikes, 'dislikes', 5) +
                                '</div>' +
                                '<div class="usr-interaction-section">' +
                                    '<h3 class="usr-interaction-title"><i class="fas fa-comment" style="color:#059669"></i> Comments (' + counts.comments + ')</h3>' +
                                    renderInteractionItems(interactions.comments, 'comments', 3) +
                                '</div>' +
                            '</div>' +
                        '</div>';

                    const modal = new bootstrap.Modal(document.getElementById('userDetailModal'));
                    modal.show();
                }

                let deleteModalInstance;
                function confirmDeleteUser(userId) {
                    document.getElementById('deleteUserIdInput').value = userId;
                    document.getElementById('deleteUserPassword').value = '';
                    document.getElementById('deleteUserError').style.display = 'none';
                    if (!deleteModalInstance) {
                        deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteUserModal'));
                    }
                    deleteModalInstance.show();
                }

                async function submitDeleteUser() {
                    const userId = document.getElementById('deleteUserIdInput').value;
                    const password = document.getElementById('deleteUserPassword').value;
                    const errorDiv = document.getElementById('deleteUserError');

                    if (!password) {
                        errorDiv.textContent = 'Please enter the password.';
                        errorDiv.style.display = 'block';
                        return;
                    }

                    try {
                        const res = await fetch('/admin/api/users/' + userId, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ password })
                        });
                        
                        const data = await res.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            errorDiv.textContent = data.message || 'Error deleting user';
                            errorDiv.style.display = 'block';
                        }
                    } catch (err) {
                        errorDiv.textContent = 'Server error.';
                        errorDiv.style.display = 'block';
                    }
                }
            </script>

            <%- include('partials/footer') %>
    </body>

</html>
