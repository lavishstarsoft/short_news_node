<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Register Team Member' }) %>
<link rel="stylesheet" href="/css/editors-directory.css">
<link rel="stylesheet" href="/css/team-register.css">

<body>
    <%- include('partials/top-nav', { pageTitle: 'Add Team Member', backButton: true, backUrl: '/editors' }) %>

    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar', { activePage: 'register-editor' }) %>

            <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                <div class="reg-page content-area mt-4">
                    <header class="reg-hero">
                        <div>
                            <p class="reg-eyebrow"><i class="fas fa-user-plus"></i> Team onboarding</p>
                            <h1 class="reg-hero-title">Register new team member</h1>
                            <p class="reg-hero-sub">Create a reporter or sub-editor account with the right role, language, and regional coverage — they'll be ready to publish in minutes.</p>
                        </div>
                        <a href="/editors" class="reg-hero-link"><i class="fas fa-users"></i> Team directory</a>
                    </header>

                    <div id="alertContainer"></div>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="reg-alert reg-alert--error"><i class="fas fa-exclamation-circle"></i><span><%= error %></span></div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                    <div class="reg-alert reg-alert--success"><i class="fas fa-check-circle"></i><span><%= success %></span></div>
                    <% } %>

                    <div class="reg-layout">
                        <div class="reg-form-panel">
                            <form id="registerEditorForm" action="/register-editor" method="POST" novalidate>
                                <section class="reg-form-section">
                                    <div class="reg-section-head">
                                        <span class="reg-section-icon reg-section-icon--account"><i class="fas fa-key"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Account credentials</h2>
                                            <p class="reg-section-desc">Login details for the new member</p>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="username">Username <span class="reg-required">*</span></label>
                                                <input type="text" id="username" name="username" required autocomplete="off" placeholder="e.g. ravi_reporter">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="email">Email address <span class="reg-required">*</span></label>
                                                <input type="email" id="email" name="email" required placeholder="name@newsroom.com">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="password">Password <span class="reg-required">*</span></label>
                                                <div class="reg-password-wrap">
                                                    <input type="password" id="password" name="password" required minlength="6" placeholder="Minimum 6 characters">
                                                    <button type="button" class="reg-password-toggle" id="togglePassword" aria-label="Show password"><i class="fas fa-eye"></i></button>
                                                </div>
                                                <div class="reg-field-hint">Use at least 6 characters. Share securely with the member.</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="name">Full name</label>
                                                <input type="text" id="name" name="name" placeholder="Display name in bylines">
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="reg-form-section">
                                    <div class="reg-section-head">
                                        <span class="reg-section-icon reg-section-icon--role"><i class="fas fa-id-badge"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Role &amp; permissions</h2>
                                            <p class="reg-section-desc">Choose access level for this member</p>
                                        </div>
                                    </div>
                                    <div class="reg-role-cards" id="roleCards">
                                        <button type="button" class="reg-role-card is-selected" data-role="editor">
                                            <div class="reg-role-card-title"><i class="fas fa-pen-nib me-1"></i> Reporter</div>
                                            <div class="reg-role-card-desc">Create and submit news articles. Basic publishing access.</div>
                                        </button>
                                        <button type="button" class="reg-role-card" data-role="subeditor">
                                            <div class="reg-role-card-title"><i class="fas fa-user-check me-1"></i> Sub-Editor</div>
                                            <div class="reg-role-card-desc">Extended access to review, edit, and manage content workflow.</div>
                                        </button>
                                    </div>
                                    <select class="d-none" id="role" name="role" required>
                                        <option value="editor" selected>Reporter</option>
                                        <option value="subeditor">Sub-Editor</option>
                                    </select>
                                    <div class="reg-field mt-3">
                                        <label for="displayRole">Display role label</label>
                                        <input type="text" id="displayRole" name="displayRole" placeholder="e.g. Sports Reporter, District Correspondent">
                                        <div class="reg-field-hint">Shown publicly on articles and team directory</div>
                                    </div>
                                </section>

                                <section class="reg-form-section">
                                    <div class="reg-section-head">
                                        <span class="reg-section-icon reg-section-icon--region"><i class="fas fa-map-marker-alt"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Regional &amp; language</h2>
                                            <p class="reg-section-desc">Coverage area and publishing language</p>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="location">Location</label>
                                                <% if (typeof locations !== 'undefined' && locations.length) { %>
                                                <select id="assignedLocations" name="assignedLocations" multiple class="form-select" size="4">
                                                    <option value="" disabled>Select locations (hold Cmd/Ctrl for multiple)</option>
                                                    <% locations.forEach(function(loc) { %>
                                                    <option value="<%= loc.name %>"><%= loc.name %><% if (loc.code) { %> (<%= loc.code %>)<% } %></option>
                                                    <% }); %>
                                                </select>
                                                <% } else { %>
                                                <input type="text" id="assignedLocations" name="assignedLocations" placeholder="District or city">
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="constituency">Constituency</label>
                                                <input type="text" id="constituency" name="constituency" placeholder="Assembly constituency">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="workingLanguage">News language <span class="reg-required">*</span></label>
                                                <select id="workingLanguage" name="workingLanguage" required>
                                                    <%- include('partials/language-select-options', { selectedValue: defaultLanguage || 'te' }) %>
                                                </select>
                                                <div class="reg-field-hint">Primary language for this member's articles</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="reg-field">
                                                <label for="mobileNumber">Mobile number</label>
                                                <input type="tel" id="mobileNumber" name="mobileNumber" placeholder="+91 98765 43210">
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <% if (admin.role === 'superadmin' || admin.role === 'admin') { %>
                                <section class="reg-form-section">
                                    <div class="reg-section-head">
                                        <span class="reg-section-icon reg-section-icon--settings" style="background: rgba(30, 41, 59, 0.1); color: #1e293b;"><i class="fas fa-cog"></i></span>
                                        <div>
                                            <h2 class="reg-section-title">Admin Dashboard Settings</h2>
                                            <p class="reg-section-desc">Additional access options for dashboard</p>
                                        </div>
                                    </div>
                                    <div id="viewReporterDetailsWrapper" style="display: none;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                            <input type="checkbox" id="canViewReporterDetails" name="canViewReporterDetails" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canViewReporterDetails" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can view reporter details</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -10px; margin-bottom: 15px;">Allows this member to see the full details (Email, Phone, Constituency) of reporters in the news list.</div>
                                    </div>
                                    
                                    <div id="dashboardAccessWrapper" style="display: none;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                            <input type="checkbox" id="canAccessAdminDashboard" name="canAccessAdminDashboard" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canAccessAdminDashboard" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can access admin dashboard</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -10px; margin-bottom: 15px;">Allows this sub-editor to log in to this admin dashboard.</div>
                                    </div>
                                    
                                    <div id="approveNewsWrapper" style="display: none;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                            <input type="checkbox" id="canApproveNews" name="canApproveNews" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canApproveNews" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can approve/reject news</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -10px;">Allows this sub-editor to approve or reject pending news.</div>
                                    </div>

                                    <div id="viewAllNewsWrapper" style="display: none; margin-top: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                            <input type="checkbox" id="canViewAllNews" name="canViewAllNews" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canViewAllNews" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">View all articles</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -10px;">If off, sub-editor only sees their own articles and assigned reporters' articles.</div>
                                    </div>
                                    
                                    <div id="managedLocationsWrapper" style="display: none; margin-top: 15px; margin-left: 30px; padding-left: 15px; border-left: 2px solid #e2e8f0;">
                                        <div class="reg-field" style="margin-bottom: 10px;">
                                            <label style="font-size: 0.9rem;">Whose news can they approve?</label>
                                            <select id="approvalScope" name="approvalScope" class="form-select" style="font-size: 0.9rem; padding: 6px 12px; height: auto;">
                                                <option value="all">All Reporters</option>
                                                <option value="locations">Reporters in Specific Locations</option>
                                            </select>
                                        </div>
                                        <div class="reg-field" id="managedLocationsSelectWrapper" style="display: none;">
                                            <label style="font-size: 0.9rem;">Select Parent Locations</label>
                                            <% if (typeof locations !== 'undefined' && locations.length) { %>
                                            <select id="managedLocations" name="managedLocations" multiple class="form-select" size="4" style="font-size: 0.9rem;">
                                                <% locations.forEach(function(loc) { %>
                                                <option value="<%= loc.name %>"><%= loc.name %></option>
                                                <% }); %>
                                            </select>
                                            <div class="reg-field-hint">Hold Cmd/Ctrl to select multiple locations.</div>
                                            <% } else { %>
                                            <div class="alert alert-warning" style="font-size: 0.85rem; padding: 8px;">No locations found.</div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div id="subEditorPermissionsWrapper" style="display: none; margin-top: 15px;">
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="canSendNotifications" name="canSendNotifications" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canSendNotifications" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can send notifications</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -5px; margin-bottom: 15px;">Allows this sub-editor to send push notifications for news articles.</div>
                                        
                                        <div class="reg-field" style="display: flex; align-items: center; gap: 12px; margin-bottom: 5px;">
                                            <input type="checkbox" id="canEditNews" name="canEditNews" value="true" style="width: auto; height: 18px; cursor: pointer;">
                                            <label for="canEditNews" style="margin-bottom: 0; font-weight: 500; cursor: pointer;">Can edit any news</label>
                                        </div>
                                        <div class="reg-field-hint" style="margin-left: 30px; margin-top: -5px;">Allows this sub-editor to edit active, inactive, and rejected news (like super admin).</div>
                                    </div>
                                    
                                    <div id="sidebarAccessWrapper" style="display: none; margin-top: 20px;">
                                        <h5 style="margin-bottom: 15px; font-size: 1rem; border-bottom: 1px solid #eaeaea; padding-bottom: 5px;">Sidebar Menu Access</h5>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                            <% const menus = [
                                                { id: 'dashboard', label: 'Dashboard' },
                                                { id: 'newsList', label: 'News List' },
                                                { id: 'addNews', label: 'Add News' },
                                                { id: 'pendingNews', label: 'Pending News' },
                                                { id: 'rejectedNews', label: 'Rejected News' },
                                                { id: 'plagiarismReport', label: 'Plagiarism Report' },
                                                { id: 'viralVideos', label: 'Viral Videos' },
                                                { id: 'polls', label: 'Polls' },
                                                { id: 'longVideos', label: 'Long Videos / Programs' },
                                                { id: 'categories', label: 'Categories' },
                                                { id: 'programCategories', label: 'Program Categories' },
                                                { id: 'locations', label: 'Locations' },
                                                { id: 'reports', label: 'Reports' }
                                            ]; %>
                                            <% menus.forEach(menu => { %>
                                                <div class="reg-field" style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px;">
                                                    <input type="checkbox" id="sidebar_<%= menu.id %>" name="sidebar[<%= menu.id %>]" value="true" checked style="width: auto; height: 16px; cursor: pointer;">
                                                    <label for="sidebar_<%= menu.id %>" style="margin-bottom: 0; font-size: 0.9rem; cursor: pointer;"><%= menu.label %></label>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </section>
                                <% } %>

                                <div class="reg-form-footer">
                                    <button type="submit" class="reg-submit-btn" id="submitBtn">
                                        <i class="fas fa-user-plus"></i> Create team member
                                    </button>
                                </div>
                            </form>
                        </div>

                        <aside class="reg-aside">
                            <div class="reg-preview-card">
                                <div class="reg-preview-avatar" id="previewAvatar">?</div>
                                <div class="reg-preview-name" id="previewName">New member</div>
                                <div class="reg-preview-meta" id="previewEmail">email@example.com</div>
                                <div class="reg-preview-pills">
                                    <span class="reg-preview-pill reg-preview-pill--role" id="previewRole">Reporter</span>
                                    <span class="reg-preview-pill" id="previewLang">Telugu</span>
                                    <span class="reg-preview-pill" id="previewLocation" style="display:none;"></span>
                                </div>
                            </div>

                            <div class="reg-permissions-card">
                                <div class="reg-permissions-head"><i class="fas fa-shield-alt me-1"></i> Access preview</div>
                                <div class="reg-permissions-body" id="permissionsList">
                                    <div class="reg-perm-item"><i class="fas fa-check"></i><span>Create and submit news articles</span></div>
                                    <div class="reg-perm-item"><i class="fas fa-check"></i><span>Manage own published content</span></div>
                                    <div class="reg-perm-item is-muted" data-perm="subeditor"><i class="fas fa-times"></i><span>Review pending submissions</span></div>
                                    <div class="reg-perm-item is-muted" data-perm="subeditor"><i class="fas fa-times"></i><span>Approve or reject articles</span></div>
                                </div>
                            </div>

                            <div class="reg-tip-card">
                                <i class="fas fa-lightbulb me-1"></i>
                                After registration, share login credentials securely. The member can update their profile from the admin panel.
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script>
        (function () {
            const form = document.getElementById('registerEditorForm');
            const roleSelect = document.getElementById('role');
            const roleCards = document.querySelectorAll('.reg-role-card');
            const alertContainer = document.getElementById('alertContainer');
            const submitBtn = document.getElementById('submitBtn');
            const langSelect = document.getElementById('workingLanguage');

            function updatePreview() {
                const name = document.getElementById('name').value.trim();
                const username = document.getElementById('username').value.trim();
                const email = document.getElementById('email').value.trim();
                const locationEl = document.getElementById('assignedLocations');
                let location = '';
                if (locationEl && locationEl.tagName === 'SELECT') {
                    const selected = Array.from(locationEl.selectedOptions).map(opt => opt.value).filter(val => val !== "");
                    location = selected.join(', ');
                } else if (locationEl) {
                    location = locationEl.value.trim();
                }
                const displayRole = document.getElementById('displayRole').value.trim();
                const role = roleSelect.value;

                const displayName = name || username || 'New member';
                document.getElementById('previewName').textContent = displayName;
                document.getElementById('previewEmail').textContent = email || 'email@example.com';
                document.getElementById('previewAvatar').textContent = displayName.split(/[\s._-]+/).filter(Boolean).map(function (n) { return n[0]; }).join('').toUpperCase().substring(0, 2) || '?';

                document.getElementById('previewRole').textContent = displayRole || (role === 'subeditor' ? 'Sub-Editor' : 'Reporter');

                const langText = langSelect.options[langSelect.selectedIndex]?.text || 'Telugu';
                document.getElementById('previewLang').textContent = langText;

                const locPill = document.getElementById('previewLocation');
                if (location) {
                    locPill.textContent = location;
                    locPill.style.display = 'inline-flex';
                } else {
                    locPill.style.display = 'none';
                }

                document.querySelectorAll('[data-perm="subeditor"]').forEach(function (el) {
                    if (role === 'subeditor') {
                        el.classList.remove('is-muted');
                        el.querySelector('i').className = 'fas fa-check';
                    } else {
                        el.classList.add('is-muted');
                        el.querySelector('i').className = 'fas fa-times';
                    }
                });

                const dashboardAccessWrapper = document.getElementById('dashboardAccessWrapper');
                const viewReporterDetailsWrapper = document.getElementById('viewReporterDetailsWrapper');
                const approveNewsWrapper = document.getElementById('approveNewsWrapper');
                const viewAllNewsWrapper = document.getElementById('viewAllNewsWrapper');
                const managedLocationsWrapper = document.getElementById('managedLocationsWrapper');
                const sidebarAccessWrapper = document.getElementById('sidebarAccessWrapper');
                const subEditorPermissionsWrapper = document.getElementById('subEditorPermissionsWrapper');
                
                if (dashboardAccessWrapper && viewReporterDetailsWrapper && approveNewsWrapper && sidebarAccessWrapper) {
                    if (role === 'subeditor') {
                        dashboardAccessWrapper.style.display = 'block';
                        viewReporterDetailsWrapper.style.display = 'block';
                        approveNewsWrapper.style.display = 'block';
                        if (viewAllNewsWrapper) viewAllNewsWrapper.style.display = 'block';
                        sidebarAccessWrapper.style.display = 'block';
                        const subEditorPermissionsWrapper = document.getElementById('subEditorPermissionsWrapper');
                        if (subEditorPermissionsWrapper) subEditorPermissionsWrapper.style.display = 'block';
                        
                        // Check checkbox status for dependent wrappers
                        if (document.getElementById('canApproveNews').checked) {
                            managedLocationsWrapper.style.display = 'block';
                        } else {
                            managedLocationsWrapper.style.display = 'none';
                        }
                    } else {
                        dashboardAccessWrapper.style.display = 'none';
                        viewReporterDetailsWrapper.style.display = 'none';
                        approveNewsWrapper.style.display = 'none';
                        if (viewAllNewsWrapper) viewAllNewsWrapper.style.display = 'none';
                        sidebarAccessWrapper.style.display = 'none';
                        managedLocationsWrapper.style.display = 'none';
                        const subEditorPermissionsWrapper = document.getElementById('subEditorPermissionsWrapper');
                        if (subEditorPermissionsWrapper) subEditorPermissionsWrapper.style.display = 'none';
                        document.getElementById('canAccessAdminDashboard').checked = false;
                        document.getElementById('canViewReporterDetails').checked = false;
                        document.getElementById('canApproveNews').checked = false;
                        const canViewAllNews = document.getElementById('canViewAllNews');
                        if (canViewAllNews) canViewAllNews.checked = false;
                        const canSendNotifCb = document.getElementById('canSendNotifications');
                        if (canSendNotifCb) canSendNotifCb.checked = false;
                    }
                }
            }

            // Event listener for canApproveNews checkbox
            const canApproveNewsCheckbox = document.getElementById('canApproveNews');
            const managedLocationsWrapper = document.getElementById('managedLocationsWrapper');
            if (canApproveNewsCheckbox && managedLocationsWrapper) {
                canApproveNewsCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        managedLocationsWrapper.style.display = 'block';
                    } else {
                        managedLocationsWrapper.style.display = 'none';
                    }
                });
            }

            // Event listener for approvalScope dropdown
            const approvalScopeSelect = document.getElementById('approvalScope');
            const managedLocationsSelectWrapper = document.getElementById('managedLocationsSelectWrapper');
            if (approvalScopeSelect && managedLocationsSelectWrapper) {
                approvalScopeSelect.addEventListener('change', function() {
                    if (this.value === 'locations') {
                        managedLocationsSelectWrapper.style.display = 'block';
                    } else {
                        managedLocationsSelectWrapper.style.display = 'none';
                    }
                });
            }

            roleCards.forEach(function (card) {
                card.addEventListener('click', function () {
                    roleCards.forEach(function (c) { c.classList.remove('is-selected'); });
                    card.classList.add('is-selected');
                    roleSelect.value = card.getAttribute('data-role');
                    updatePreview();
                });
            });

            ['username', 'name', 'email', 'displayRole', 'assignedLocations', 'constituency'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.addEventListener('input', updatePreview);
                if (el && el.tagName === 'SELECT') el.addEventListener('change', updatePreview);
            });
            if (langSelect) langSelect.addEventListener('change', updatePreview);
            const locationSelect = document.getElementById('assignedLocations');
            if (locationSelect && locationSelect.tagName === 'SELECT') locationSelect.addEventListener('change', updatePreview);

            document.getElementById('togglePassword').addEventListener('click', function () {
                const input = document.getElementById('password');
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    input.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating account...';

                const formData = new FormData(form);
                const data = {};
                formData.forEach(function (value, key) { 
                    if (key === 'assignedLocations' || key === 'managedLocations') {
                        if (!data[key]) data[key] = [];
                        data[key].push(value);
                    } else {
                        data[key] = value; 
                    }
                });

                try {
                    const response = await fetch('/register-editor', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if (response.ok) {
                        alertContainer.innerHTML = '<div class="reg-alert reg-alert--success"><i class="fas fa-check-circle"></i><span>' + result.message + ' — ' + (result.editor.role === 'subeditor' ? 'Sub-Editor' : 'Reporter') + ' created! Redirecting...</span></div>';
                        form.reset();
                        roleCards.forEach(function (c) { c.classList.remove('is-selected'); });
                        document.querySelector('.reg-role-card[data-role="editor"]').classList.add('is-selected');
                        roleSelect.value = 'editor';
                        updatePreview();
                        setTimeout(function () { window.location.href = '/editors'; }, 1800);
                    } else {
                        alertContainer.innerHTML = '<div class="reg-alert reg-alert--error"><i class="fas fa-exclamation-circle"></i><span>' + (result.error || 'Registration failed') + '</span></div>';
                    }
                } catch (err) {
                    alertContainer.innerHTML = '<div class="reg-alert reg-alert--error"><i class="fas fa-exclamation-circle"></i><span>An error occurred. Please try again.</span></div>';
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-user-plus"></i> Create team member';
                }
            });

            updatePreview();
            setupMobileMenu();
        })();

        function setupMobileMenu() {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            if (menuToggle && sidebar) {
                menuToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    sidebar.classList.toggle('active');
                    mainContent.classList.toggle('sidebar-active');
                });
            }
            document.addEventListener('click', function (event) {
                if (window.innerWidth < 768 && sidebar && sidebar.classList.contains('active') &&
                    !sidebar.contains(event.target) && event.target !== menuToggle &&
                    (!menuToggle || !menuToggle.contains(event.target))) {
                    sidebar.classList.remove('active');
                    if (mainContent) mainContent.classList.remove('sidebar-active');
                }
            });
        }
    </script>
</body>

</html>
