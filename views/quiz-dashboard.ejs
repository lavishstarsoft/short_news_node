<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: 'Quiz Dashboard' }) %>
<body>
  <%- include('partials/top-nav', { pageTitle: 'Quiz Dashboard', backButton: true, backUrl: '/' }) %>
  <div class="container-fluid"><div class="row">
    <%- include('partials/sidebar', { activePage: 'quiz-dashboard' }) %>
    <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
      <div class="content-area py-3">
        <style>
          .qd-kpis{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
          .qd-kpi{flex:1 1 130px;border:1px solid #eef0f3;border-radius:10px;padding:10px 12px;background:#fff}
          .qd-kpi .v{font-size:22px;font-weight:800}.qd-kpi .l{font-size:11px;text-transform:uppercase;color:#8a94a6}
          table.qd-tbl{width:100%;border-collapse:collapse;font-size:13px}
          table.qd-tbl th{background:#f4f6f9;text-align:left;padding:6px 8px;font-size:11px;text-transform:uppercase;color:#6b7280}
          table.qd-tbl td{padding:6px 8px;border-top:1px solid #f1f3f6}
          .qd-b{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11px;font-weight:700}
          .qd-warn{background:#fff3e0;color:#e65100}.qd-ok{background:#e8f5e9;color:#2e7d32}
          .qd-bad{background:#fdecea;color:#b71c1c}.qd-mute{background:#f1f3f6;color:#6b7280}
          .qd-lot{border:1px solid #c8e6c9;background:#f6fbf6;border-radius:10px;padding:10px 12px;margin-top:8px;font-size:13px}
          .qd-scroll{max-height:52vh;overflow:auto}
        </style>
        <div class="mb-2 d-flex align-items-center gap-2">
          <h3 class="mb-0 d-flex align-items-center">Quiz Weekly Dashboard
            <button class="btn btn-sm btn-info text-white ms-3 fw-bold shadow-sm" onclick="toggleQuizHelp()" title="ఈ పేజీ గురించి తెలుసుకోండి"><i class="fas fa-info-circle"></i> Info / Help</button>
          </h3>
          <input id="qdWeek" class="form-control form-control-sm" style="width:150px" placeholder="weekId (Mon YYYY-MM-DD)">
          <button class="btn btn-sm btn-outline-secondary" onclick="qdLoad()">Load</button>
          <span id="qdStatus" class="small text-muted"></span>
        </div>
        <div class="qd-kpis" id="qdKpis"></div>
        <div class="card mb-3"><div class="card-body">
          <h6 class="fw-bold">Participation funnel <span class="small text-muted">(Assigned ≡ Opened — assignment happens on open)</span></h6>
          <div id="qdFunnel" class="qd-kpis" style="margin-bottom:0"></div>
        </div></div>
        <div class="card mb-3"><div class="card-body">
          <h6 class="fw-bold">Daily participation <span class="small text-muted">(click a count to see participants)</span></h6>
          <div class="qd-scroll"><table class="qd-tbl"><thead><tr><th>Day</th><th>Date (IST)</th><th>Participants</th><th>Answered</th></tr></thead><tbody id="qdDaily"></tbody></table></div>
        </div></div>
        <div class="mb-2 d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary" onclick="openParticipants(null)">👥 All participants this week</button>
          <a class="btn btn-sm btn-outline-success" id="qdExportPart" href="#"><i class="fas fa-file-csv"></i> Export participants CSV</a>
          <a class="btn btn-sm btn-outline-success" id="qdExportWin" href="#"><i class="fas fa-file-csv"></i> Export winners CSV</a>
        </div>
        <div id="qdPartOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1050" onclick="if(event.target===this)closeParticipants()">
          <div style="max-width:900px;margin:4vh auto;background:#fff;border-radius:12px;max-height:88vh;overflow:auto;padding:16px">
            <div class="d-flex align-items-center gap-2 mb-2">
              <h5 class="mb-0" id="qdPartTitle">Participants</h5>
              <input id="qdPartSearch" class="form-control form-control-sm" style="width:220px" placeholder="Search name / mobile / email">
              <button class="btn btn-sm btn-outline-secondary" onclick="qdPartGo(1)">Search</button>
              <span id="qdPartCount" class="small text-muted ms-auto"></span>
              <button class="btn btn-sm btn-light" onclick="closeParticipants()">✕</button>
            </div>
            <div id="qdPartPii" class="small text-muted mb-2"></div>
            <div class="qd-scroll"><table class="qd-tbl"><thead id="qdPartHead"></thead><tbody id="qdPartRows"></tbody></table></div>
            <div class="d-flex align-items-center gap-2 mt-2">
              <button class="btn btn-sm btn-outline-secondary" onclick="qdPartGo(window.qdPart.page-1)">Prev</button>
              <span id="qdPartPage" class="small"></span>
              <button class="btn btn-sm btn-outline-secondary" onclick="qdPartGo(window.qdPart.page+1)">Next</button>
            </div>
          </div>
        </div>
        <div class="mb-2" id="qdActions"></div>
        <div class="mb-3 p-2 rounded small" style="background:#fff7ed;border:1px solid #fed7aa;line-height:1.7">
          <b>ℹ️ 🎲 Random Lottery నియమం</b>
          <ul class="mb-0 ps-3">
            <li><b>6 రోజులూ answer చేసి, 6 కి 6 సరైనవి</b> ఇచ్చినవాళ్ళే lottery లో ఉంటారు. 5/6, 4/6 వాళ్ళు రారు.</li>
            <li><b>Winner history లో ఉన్నవాళ్ళు మళ్ళీ రారు</b> — అదే account అయినా, <b>అదే mobile number</b> తో వేరే account అయినా, <b>అదే phone</b> నుంచి ఆడినా.</li>
            <li>పేరు ఒక్కటే కలిస్తే (ఉదా: ఇద్దరు “Ravi Kumar”) తీసేయము — <span class="qd-b qd-warn">⚠ same name</span> గుర్తు చూపిస్తాం, payment ముందు మీరు చూడండి.</li>
            <li>10 కన్నా తక్కువ మంది ఉంటే — <b>ఉన్నవాళ్ళందరూ winners</b>. మిగతా slots <b>Winners (Manual)</b> page లో మీరు నింపండి.</li>
            <li><b>Admin Select</b> లో మీరే ఎంచుకుంటారు — అక్కడ ఆపము, కానీ కింద list లో tags చూసి ఎంచుకోండి.</li>
            <li>📄 కింద list పక్కన <b>Download PDF</b> — ఈ list మొత్తం + winners అందరూ 6/6 అయ్యారా, గతంలో గెలిచారా అని ఒక్క file లో proof (phone numbers ఉండవు).</li>
          </ul>
        </div>
        <div class="card"><div class="card-body">
          <div class="d-flex align-items-center gap-2 mb-2">
            <h6 class="fw-bold mb-0">Eligible users (answered all 6) — ranked by correct, earliest completion</h6>
            <a class="btn btn-sm btn-outline-danger ms-auto" id="qdEligPdf" href="#" title="ఈ list + winners 6/6 అయ్యారా, గతంలో గెలిచారా — PDF గా"><i class="fas fa-file-pdf"></i> Download PDF</a>
          </div>
          <div class="qd-scroll"><table class="qd-tbl"><thead><tr><th></th><th>#</th><th>Name</th><th>Correct</th><th>Answered</th><th>Lottery</th><th>Device</th></tr></thead><tbody id="qdElig"></tbody></table></div>
        </div></div>
        <div class="card mt-3" style="border:1px solid #ffe0b2;background:#fffdf7"><div class="card-body">
          <h6 class="fw-bold">🧪 Quiz Test Mode <span class="qd-b qd-warn">test data only — never affects live users</span></h6>
          <p class="small text-muted mb-2">Simulate any weekday for ONE app user so you can walk the full Monday→Sunday flow without waiting for a real Sunday. Enter the user's <b>Mongo _id, mobile number, email, name, or Google ID</b> — the server resolves it to their verified Google ID. Test entries/winners live under an isolated 2024 test week and are impossible to mix with production. Turn it OFF to instantly return that user to real IST behaviour.</p>
          <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
            <div><label class="form-label small mb-0">Target user (_id / mobile / email / name / googleId)</label><input id="tmUser" class="form-control form-control-sm" style="width:320px" placeholder="e.g. 69b24c19c0a5fb3988094a46 or 98765..."></div>
            <button class="btn btn-sm btn-outline-primary" onclick="tmFind()">Find user</button>
            <div><label class="form-label small mb-0">Simulated day</label>
              <select id="tmDay" class="form-select form-select-sm" style="width:150px">
                <option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option>
                <option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option>
                <option value="7">Sunday (winners)</option>
              </select>
            </div>
            <button class="btn btn-sm btn-primary" onclick="tmSave(true)">Enable / Update</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="tmSave(false)">Disable (exit test mode)</button>
            <button class="btn btn-sm btn-outline-warning" onclick="tmRefresh()">Check status</button>
          </div>
          <div id="tmFound" class="small mb-2"></div>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <button class="btn btn-sm btn-warning" onclick="tmMakeWinners()">🏆 Create Test Winners (Top 10)</button>
            <button class="btn btn-sm btn-outline-danger" onclick="tmClearWinners()">Clear Test Winners</button>
            <span class="small text-muted">Use with Sunday simulation to preview the winners screen.</span>
          </div>
          <div id="tmStatus" class="small"></div>
        </div></div>
        <div class="card mt-3"><div class="card-body">
          <h6 class="fw-bold">Winner history</h6>
          <div id="qdHistory" class="small"></div>
        </div></div>
      </div>
    </div>
  </div></div>
  <%- include('partials/quiz-help-modal') %>
  <%- include('partials/footer') %>
  <script>
  (function(){
    var esc=function(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]);});};
    var week=''; var eligible=[]; var canSelect=false; var lottery=null;
    var REASON={account:'same account',phone:'same mobile number',device:'same phone / app install'};
    function kpis(list){ return list.map(function(c){return '<div class="qd-kpi"><div class="v">'+c[1]+'</div><div class="l">'+c[0]+'</div></div>';}).join(''); }
    // The row's lottery tags: 6/6 in the draw, not 6/6, won before, same name as a winner.
    function lotteryTags(e){
      var t=[];
      if(e.pastWin) t.push('<span class="qd-b qd-bad" title="Kept out of the lottery">🏆 Won week '+esc(e.pastWin.weekId)+' · '+esc(REASON[e.pastWin.reason]||e.pastWin.reason)+(e.pastWin.wonAs&&e.pastWin.wonAs!==e.name?(' (as “'+esc(e.pastWin.wonAs)+'”)'):'')+'</span>');
      if(e.inDraw) t.push('<span class="qd-b qd-ok">6/6 ✓ in draw</span>');
      else if(!e.perfect) t.push('<span class="qd-b qd-mute">'+e.correct+'/'+e.answered+' — not in draw</span>');
      if(e.nameMatch) t.push('<span class="qd-b qd-warn" title="Only the name matches — check before paying">⚠ same name as week '+esc(e.nameMatch.weekId)+' winner</span>');
      return t.join(' ');
    }
    // "73 scored 6/6 · 9 won before · 64 in the draw", with who was kept out.
    function lotterySummary(L){
      if(!L) return '';
      var h='<div class="qd-lot">🎲 <b>Lottery picks from '+L.pool+'</b> — '+L.scoredPerfect+' scored 6/6 · '+L.pastWinners+' won before (kept out)';
      if(L.excluded&&L.excluded.length) h+=' · <a href="#" onclick="var x=document.getElementById(\'qdExcl\');x.style.display=x.style.display===\'none\'?\'block\':\'none\';return false;">see who</a>'
        +'<div id="qdExcl" style="display:none" class="mt-1">'+L.excluded.map(function(x){return '• <b>'+esc(x.name)+'</b> — won week '+esc(x.weekId)+(x.wonAs&&x.wonAs!==x.name?(' as “'+esc(x.wonAs)+'”'):'')+' · '+esc(REASON[x.reason]||x.reason);}).join('<br>')+'</div>';
      if(L.pool===0) h+='<div class="mt-1 text-danger fw-bold">No one new scored 6/6 — nothing to draw. Use the Winners (Manual) page.</div>';
      else if(L.pool<L.needed) h+='<div class="mt-1" style="color:#b26a00"><b>Only '+L.pool+' qualify</b> — all '+L.pool+' will win; add the other '+(L.needed-L.pool)+' on the Winners (Manual) page.</div>';
      return h+'</div>';
    }
    function q(id){return document.getElementById(id);}
    window.qdLoad=async function(){
      week=(q('qdWeek').value||'').trim();
      var u='/admin/quiz/api/week'+(week?('?weekId='+encodeURIComponent(week)):'');
      var d=await (await fetch(u)).json();
      week=d.weekId; q('qdWeek').value=week;
      q('qdStatus').textContent='Week '+d.meta.startDate+' → '+d.meta.endDate+' · '+(d.weekOver?'closed':'in progress')+(d.winnersSelected?' · winners selected':'');
      var winnersKpi=['Winners selected',d.winnersSelected?'Yes':'No'];
      q('qdKpis').innerHTML=kpis([['Participants',d.participants],['Answered all 6',d.eligible],winnersKpi]);
      canSelect=d.canSelect;
      var el=await (await fetch('/admin/quiz/api/week/eligible?weekId='+encodeURIComponent(week))).json();
      eligible=el.eligible||[]; lottery=el.lottery||null;
      if(lottery) q('qdKpis').innerHTML=kpis([['Participants',d.participants],['Answered all 6',d.eligible],['Scored 6/6 ✓',lottery.scoredPerfect],['Won before (kept out)',lottery.pastWinners],['In the lottery',lottery.pool],winnersKpi]);
      q('qdActions').innerHTML= d.winnersSelected ? '<span class="qd-b qd-ok">Winners already selected (immutable)</span>'
        : (canSelect ? '<button class="btn btn-warning btn-sm" onclick="qdRandom()"'+(lottery&&lottery.pool===0?' disabled':'')+'>🎲 Random Lottery</button> <button class="btn btn-primary btn-sm" onclick="qdAdmin()">👤 Admin Select (pick 10)</button>'
          : '<span class="qd-b qd-warn">Selection opens after Saturday closes.</span>')
        + (d.winnersSelected ? '' : lotterySummary(lottery));
      q('qdElig').innerHTML=eligible.map(function(e){return '<tr><td><input type="checkbox" class="qd-pick" value="'+esc(e.userId)+'"></td><td>'+e.rankIfSorted+'</td><td>'+esc(e.name)+'</td><td><b>'+e.correct+'</b></td><td>'+e.answered+'</td><td>'+lotteryTags(e)+'</td><td class="text-muted">'+esc((e.device||'').slice(0,10))+'</td></tr>';}).join('')||'<tr><td colspan="7" class="text-muted py-3">No eligible users yet.</td></tr>';
      loadAnalytics();
      loadHistory();
    };
    var DAYLBL=['Mon','Tue','Wed','Thu','Fri','Sat'];
    async function loadAnalytics(){
      q('qdExportPart').href='/admin/quiz/api/participants/export?weekId='+encodeURIComponent(week);
      q('qdExportWin').href='/admin/quiz/api/winners/export?weekId='+encodeURIComponent(week);
      q('qdEligPdf').href='/admin/quiz/api/week/eligible/pdf?weekId='+encodeURIComponent(week);
      var d=await (await fetch('/admin/quiz/api/analytics?weekId='+encodeURIComponent(week))).json();
      var f=d.funnel||{};
      var steps=[['Assigned',f.assigned],['Opened',f.opened],['Answered',f.answered],['Answered all 6',f.completed],['Eligible',f.eligible],['Winners',f.winners]];
      q('qdFunnel').innerHTML=steps.map(function(s){return '<div class="qd-kpi"><div class="v">'+(s[1]||0)+'</div><div class="l">'+s[0]+'</div></div>';}).join('');
      q('qdDaily').innerHTML=(d.days||[]).map(function(day,i){
        var today=day.dayKey===d.todayKey?' <span class="qd-b qd-ok">today</span>':'';
        var pcell=day.participants>0?'<a href="#" onclick="return openParticipants(\''+day.dayKey+'\')">'+day.participants+'</a>':'0';
        return '<tr><td>'+DAYLBL[i]+today+'</td><td class="text-muted">'+esc(day.dayKey)+'</td><td>'+pcell+'</td><td>'+day.answered+'</td></tr>';
      }).join('');
    }
    // Participant drill-down (server-paginated; PII gated to Super Admin).
    window.qdPart={dayKey:null,page:1};
    window.openParticipants=function(dayKey){ window.qdPart.dayKey=dayKey||null; q('qdPartSearch').value=''; q('qdPartOverlay').style.display='block'; window.qdPartGo(1); return false; };
    window.closeParticipants=function(){ q('qdPartOverlay').style.display='none'; };
    window.qdPartGo=async function(page){
      if(page<1)return; window.qdPart.page=page;
      var qs='weekId='+encodeURIComponent(week)+'&page='+page+'&pageSize=25';
      if(window.qdPart.dayKey)qs+='&dayKey='+encodeURIComponent(window.qdPart.dayKey);
      var s=(q('qdPartSearch').value||'').trim(); if(s)qs+='&q='+encodeURIComponent(s);
      var d=await (await fetch('/admin/quiz/api/participants?'+qs)).json();
      q('qdPartTitle').textContent=window.qdPart.dayKey?('Participants · '+window.qdPart.dayKey):'Participants · week';
      q('qdPartCount').textContent=(d.total||0)+' total';
      q('qdPartPage').textContent='Page '+d.page+' / '+d.pages;
      q('qdPartPii').innerHTML=d.pii?'<span class="qd-b qd-ok">Super Admin</span> mobile/email/location visible'
        :'<span class="qd-b qd-warn">Restricted</span> mobile/email/location hidden (Super Admin only)';
      var head=d.pii
        ? '<tr><th>Name</th><th>Mobile</th><th>Email</th><th>Location</th><th>Score</th><th>Ans</th><th>✓</th><th>✗</th><th>Done</th><th>Last submit (IST)</th></tr>'
        : '<tr><th>Name</th><th>Score</th><th>Ans</th><th>✓</th><th>✗</th><th>Done</th><th>Last submit (IST)</th></tr>';
      q('qdPartHead').innerHTML=head;
      q('qdPartRows').innerHTML=(d.participants||[]).map(function(p){
        var done=p.completed?'<span class="qd-b qd-ok">'+p.completion+'</span>':p.completion;
        var last=p.lastSubmittedAt?esc(new Date(p.lastSubmittedAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'})):'—';
        if(d.pii){
          var loc=p.location||{}; var locStr=esc(loc.state)+' → '+esc(loc.district);
          return '<tr><td>'+esc(p.name)+'</td><td>'+esc(p.mobile||'—')+'</td><td>'+esc(p.email||'—')+'</td><td class="small">'+locStr+'</td><td><b>'+p.score+'</b></td><td>'+p.answered+'</td><td>'+p.correct+'</td><td>'+p.wrong+'</td><td>'+done+'</td><td class="text-muted small">'+last+'</td></tr>';
        }
        return '<tr><td>'+esc(p.name)+'</td><td><b>'+p.score+'</b></td><td>'+p.answered+'</td><td>'+p.correct+'</td><td>'+p.wrong+'</td><td>'+done+'</td><td class="text-muted small">'+last+'</td></tr>';
      }).join('')||'<tr><td colspan="10" class="text-muted py-3">No participants.</td></tr>';
    };
    async function post(body){ var r=await fetch('/admin/quiz/api/week/winners',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); var d=await r.json(); if(!r.ok){alert(d.error||'Failed');return null;} return d; }
    window.qdRandom=async function(){
      var L=lottery||{}; var n=L.pool||0;
      if(!n){ alert('No one new scored 6/6 this week — nothing to draw.\n\nUse the Winners (Manual) page.'); return; }
      var ask='Run the random lottery?\n\nIt picks from '+n+' people who scored 6/6 and have never won before'+(L.pastWinners?(' ('+L.pastWinners+' past winners kept out)'):'')+'.\n\n'
        +(n>=10?'10 will be picked at random.':'Only '+n+' qualify — ALL '+n+' become winners. Add the other '+(10-n)+' on the Winners (Manual) page.')
        +'\n\nThe random draw itself is one-time. You can still ADJUST the winners afterwards on the "Winners (Manual)" page before they go live in the app on Sunday.';
      if(!confirm(ask))return;
      var d=await post({weekId:week,mode:'random_lottery'}); if(!d)return;
      qdLoad();
      var msg=d.winners.length+' winners picked by random lottery from '+d.pool+' people (6/6, never won before).';
      if(d.short>0) msg+='\n\nOnly '+d.winners.length+' qualified — add the other '+d.short+' on the Winners (Manual) page.';
      if(d.nameWarnings&&d.nameWarnings.length) msg+='\n\n⚠ Same NAME as a past winner (only the name matches — check before paying):\n'+d.nameWarnings.map(function(w){return '• '+w.name+' — week '+w.weekId+' winner “'+w.wonAs+'”';}).join('\n');
      if(confirm(msg+'\n\nReview / change them on the Winners (Manual) page now?')){ window.location.href='/admin/quiz/manual-winners?weekId='+encodeURIComponent(week); }
    };
    window.qdAdmin=async function(){ var ids=Array.from(document.querySelectorAll('.qd-pick:checked')).map(function(c){return c.value;}); if(ids.length!==10){alert('Select exactly 10 winners (you selected '+ids.length+').');return;}
      // Not blocked — a human choice — but never a surprise.
      var picked=eligible.filter(function(e){return ids.indexOf(e.userId)>=0;});
      var won=picked.filter(function(e){return e.pastWin;}), notPerfect=picked.filter(function(e){return !e.perfect;}), sameName=picked.filter(function(e){return e.nameMatch;});
      var warn='';
      if(won.length) warn+='\n\n🏆 WON BEFORE:\n'+won.map(function(e){return '• '+e.name+' — week '+e.pastWin.weekId+' ('+(REASON[e.pastWin.reason]||e.pastWin.reason)+')';}).join('\n');
      if(notPerfect.length) warn+='\n\nNOT 6/6:\n'+notPerfect.map(function(e){return '• '+e.name+' — '+e.correct+'/'+e.answered;}).join('\n');
      if(sameName.length) warn+='\n\n⚠ Same name as a past winner:\n'+sameName.map(function(e){return '• '+e.name+' — week '+e.nameMatch.weekId;}).join('\n');
      if(!confirm('Confirm these 10 winners?'+warn+'\n\nYou can still adjust them later on the "Winners (Manual)" page before they go live.'))return; var d=await post({weekId:week,mode:'admin_select',userIds:ids}); if(d){ qdLoad(); if(confirm('10 winners selected.\n\nReview / change them manually now?')){ window.location.href='/admin/quiz/manual-winners?weekId='+encodeURIComponent(week); } } };
    async function loadHistory(){ var d=await (await fetch('/admin/quiz/api/winners')).json(); q('qdHistory').innerHTML=(d.weeks||[]).map(function(w){return '<div class="mb-2"><b>'+esc(w.weekId)+'</b> — '+esc(w.mode)+' by '+esc(w.selectedByName||'')+'<br>'+w.winners.map(function(x){return '#'+x.rank+' '+esc(x.name)+' ('+x.score+')';}).join(' · ')+'</div>';}).join('')||'<span class="text-muted">No winners yet.</span>'; }
    // ── Test Mode controls ── (identifier is resolved server-side to the verified googleId)
    var DAYS={1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'};
    function userLine(u){ return esc(u.name||'(no name)')+(u.mobile?(' · '+esc(u.mobile)):'')+(u.email?(' · '+esc(u.email)):'')+' · googleId '+esc(u.googleId); }
    window.tmFind=async function(){
      var qv=(q('tmUser').value||'').trim(); if(!qv){alert('Enter a user _id, mobile, email, name, or googleId.');return;}
      q('tmFound').innerHTML='<span class="text-muted">Searching…</span>';
      var r=await fetch('/admin/quiz/api/resolve-user?q='+encodeURIComponent(qv));
      var d=await r.json();
      if(!r.ok){ q('tmFound').innerHTML='<span class="qd-b qd-warn">'+esc(d.error||'User not found')+'</span>'; return null; }
      q('tmFound').innerHTML='<span class="qd-b qd-ok">User found</span> '+userLine(d.user);
      return d.user;
    };
    window.tmSave=async function(active){
      var qv=(q('tmUser').value||'').trim(); if(!qv){alert('Enter a user _id, mobile, email, name, or googleId.');return;}
      var simDayIndex=parseInt(q('tmDay').value,10)||1;
      var r=await fetch('/admin/quiz/api/test-mode',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({q:qv,simDayIndex:simDayIndex,active:active})});
      var d=await r.json();
      if(!r.ok){ q('tmFound').innerHTML='<span class="qd-b qd-warn">'+esc(d.error||'Failed')+'</span>'; return; }
      q('tmFound').innerHTML='<span class="qd-b qd-ok">Resolved</span> '+userLine(d.user);
      q('tmStatus').innerHTML=active
        ? '<span class="qd-b qd-ok">TEST MODE ON</span> '+esc(d.user.name||d.user.googleId)+' → <b>'+esc(d.dayLabel)+'</b> (test week '+esc(d.testWeekId)+')'
        : '<span class="qd-b qd-warn">TEST MODE OFF</span> '+esc(d.user.name||d.user.googleId)+' is back on real IST time.';
    };
    window.tmRefresh=async function(){
      var qv=(q('tmUser').value||'').trim(); if(!qv){alert('Enter a user _id, mobile, email, name, or googleId.');return;}
      var r=await fetch('/admin/quiz/api/test-mode?q='+encodeURIComponent(qv));
      var d=await r.json();
      if(!d.resolved){ q('tmFound').innerHTML='<span class="qd-b qd-warn">No user matched.</span>'; q('tmStatus').innerHTML=''; return; }
      q('tmFound').innerHTML='<span class="qd-b qd-ok">User found</span> '+userLine(d.user);
      if(d.active){ q('tmDay').value=String(d.simDayIndex);
        q('tmStatus').innerHTML='<span class="qd-b qd-ok">TEST MODE ON</span> '+esc(d.user.name||d.user.googleId)+' → <b>'+esc(DAYS[d.simDayIndex]||'')+'</b>'; }
      else q('tmStatus').innerHTML='<span class="qd-b qd-warn">TEST MODE OFF</span> '+esc(d.user.name||d.user.googleId)+' is on real IST time.';
    };
    window.tmMakeWinners=async function(){
      if(!confirm('Create 10 TEST winners in the isolated test week? (No real payout, no live data touched.)'))return;
      var r=await fetch('/admin/quiz/api/test-winners',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
      var d=await r.json(); if(!r.ok){alert(d.error||'Failed');return;}
      q('tmStatus').innerHTML='<span class="qd-b qd-ok">Created '+d.count+' test winners</span> — set the user to <b>Sunday</b> to preview.';
    };
    window.tmClearWinners=async function(){
      var r=await fetch('/admin/quiz/api/test-winners',{method:'DELETE'});
      var d=await r.json(); if(!r.ok){alert(d.error||'Failed');return;}
      q('tmStatus').innerHTML='<span class="qd-b qd-warn">Cleared '+(d.deleted||0)+' test winners.</span>';
    };
    // On page load, read the active override(s) from MongoDB and restore the form.
    async function tmLoadActive(){
      var d=await (await fetch('/admin/quiz/api/test-mode/active')).json();
      var list=(d&&d.active)||[];
      if(!list.length){ // default empty/disabled state
        q('tmUser').value=''; q('tmDay').value='1'; q('tmFound').innerHTML='';
        q('tmStatus').innerHTML='<span class="qd-b qd-warn">TEST MODE OFF</span> No active test user. Enter an identifier to enable.';
        return;
      }
      var a=list[0]; // most recently updated active override
      q('tmUser').value=a.user.googleId||a.googleId; // Google ID stays visible after refresh
      q('tmDay').value=String(a.simDayIndex);         // selected simulated day restored
      q('tmFound').innerHTML='<span class="qd-b qd-ok">Active test user</span> '+userLine(a.user);
      q('tmStatus').innerHTML='<span class="qd-b qd-ok">TEST MODE ON</span> '+esc(a.user.name||a.googleId)+' → <b>'+esc(a.dayLabel)+'</b> (test week '+esc(d.testWeekId)+')'+
        (list.length>1?(' <span class="text-muted">(+'+(list.length-1)+' more active)</span>'):'');
    }
    qdLoad();
    tmLoadActive();
  })();
  </script>
</body>
</html>
