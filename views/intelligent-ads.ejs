<!DOCTYPE html>
<html lang="en">

<%- include('partials/header', { title: 'Intelligent Ads - Short News Admin' }) %>
<link rel="stylesheet" href="/css/editors-directory.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">
<link rel="stylesheet" href="/css/intelligence-hub.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1.0.1' %>">

<body>
    <%- include('partials/top-nav', { pageTitle: 'Intelligent Ads', backButton: true, backUrl: '/', actions: [{
        id: 'manageCampaignsBtn', icon: 'fas fa-layer-group', text: 'Campaigns', url: '/ads/ads', class: 'btn-primary'
    }] }) %>

    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar', { activePage: 'intelligent-ads' }) %>

            <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content" id="mainContent">
                <% 
                    const iahAds = typeof adsList !== 'undefined' ? adsList : [];
                    const iahTotal = typeof totalAds !== 'undefined' ? totalAds : iahAds.length;
                    const iahActive = typeof activeAds !== 'undefined' ? activeAds : 0;
                    const iahInactive = typeof inactiveAds !== 'undefined' ? inactiveAds : 0;
                    const iahActivePct = iahTotal > 0 ? Math.round((iahActive / iahTotal) * 100) : 0;
                    const iahPosStats = typeof positionStats !== 'undefined' ? positionStats : {};
                    let iahMaxPosCount = 0;
                    Object.keys(iahPosStats).forEach(function(k) {
                        if (iahPosStats[k] > iahMaxPosCount) iahMaxPosCount = iahPosStats[k];
                    });
                    const iahAdminName = typeof admin !== 'undefined' && admin ? (admin.username || admin.name || 'User') : 'User';
                %>
                <div class="iah-page content-area mt-4">
                    <header class="iah-hero">
                        <div>
                            <p class="iah-eyebrow"><i class="fas fa-brain"></i> Smart delivery engine</p>
                            <h1 class="iah-hero-title">Intelligent Monetization Analytics</h1>
                            <p class="iah-hero-sub">Welcome back, <%= iahAdminName %>. Track impressions, optimize frequency caps, and tune in-feed placement intelligence across your campaign inventory.</p>
                            <div class="mt-3">
                                <span class="iah-live-badge"><span class="iah-live-dot"></span> Auto-refresh every 30s</span>
                            </div>
                        </div>
                        <div class="iah-hero-actions">
                            <button type="button" class="iah-btn-outline" onclick="refreshAnalytics()"><i class="fas fa-sync"></i> Sync now</button>
                            <a href="/ads/add-ad" class="team-btn-primary"><i class="fas fa-plus"></i> New campaign</a>
                        </div>
                    </header>

                    <div class="iah-kpi-grid">
                        <div class="iah-kpi">
                            <div class="iah-kpi-value"><%= iahTotal.toLocaleString('en-IN') %></div>
                            <div class="iah-kpi-label">Total campaigns</div>
                            <div class="iah-kpi-meta">Inventory size</div>
                        </div>
                        <div class="iah-kpi">
                            <div class="iah-kpi-value"><%= iahActive.toLocaleString('en-IN') %></div>
                            <div class="iah-kpi-label">Live serving</div>
                            <div class="iah-kpi-meta"><%= iahActivePct %>% active</div>
                        </div>
                        <div class="iah-kpi">
                            <div class="iah-kpi-value"><%= iahInactive.toLocaleString('en-IN') %></div>
                            <div class="iah-kpi-label">Paused</div>
                            <div class="iah-kpi-meta">Not in rotation</div>
                        </div>
                        <div class="iah-kpi">
                            <div class="iah-kpi-value" id="totalImpressions">—</div>
                            <div class="iah-kpi-label">Impressions</div>
                            <div class="iah-kpi-meta">All-time views</div>
                        </div>
                        <div class="iah-kpi">
                            <div class="iah-kpi-value" id="iahTotalClicks">—</div>
                            <div class="iah-kpi-label">Clicks</div>
                            <div class="iah-kpi-meta">Engagement total</div>
                        </div>
                        <div class="iah-kpi">
                            <div class="iah-kpi-value" id="iahCtrKpi">—</div>
                            <div class="iah-kpi-label">Avg CTR</div>
                            <div class="iah-kpi-meta">Click-through rate</div>
                        </div>
                    </div>

                    <div class="iah-panel">
                        <div class="iah-panel-head">
                            <h2 class="iah-panel-title"><i class="fas fa-chart-line me-2"></i>Performance intelligence</h2>
                            <div class="iah-panel-actions">
                                <button type="button" class="iah-btn-sm" onclick="refreshAnalytics()"><i class="fas fa-sync"></i> Refresh</button>
                                <button type="button" class="iah-btn-sm iah-btn-sm--danger" onclick="resetAnalytics()"><i class="fas fa-trash-alt"></i> Reset data</button>
                            </div>
                        </div>
                        <div class="iah-analytics-grid">
                            <div class="iah-chart-wrap">
                                <p class="iah-section-label">Impressions vs clicks by campaign</p>
                                <div class="iah-chart-container">
                                    <canvas id="performanceChart"></canvas>
                                </div>
                            </div>
                            <div class="iah-insights">
                                <div class="iah-metric-stack">
                                    <div class="iah-metric-box">
                                        <div class="iah-metric-box-value" id="totalClicks">0</div>
                                        <div class="iah-metric-box-label">Total clicks</div>
                                    </div>
                                    <div class="iah-metric-box">
                                        <div class="iah-metric-box-value" id="avgCtr">0%</div>
                                        <div class="iah-metric-box-label">Average CTR</div>
                                    </div>
                                    <div class="iah-metric-box">
                                        <div class="iah-metric-box-value" id="avgViewsPerUser">0</div>
                                        <div class="iah-metric-box-label">Avg views / user</div>
                                    </div>
                                </div>
                                <div>
                                    <p class="iah-section-label">Top performers</p>
                                    <div class="iah-leaderboard" id="topAdsList">
                                        <div class="iah-empty-note">Loading analytics...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="iah-split-grid">
                        <div class="iah-panel">
                            <div class="iah-panel-head">
                                <h2 class="iah-panel-title"><i class="fas fa-sliders-h me-2"></i>Frequency intelligence</h2>
                            </div>
                            <div class="iah-settings-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="iah-field">
                                            <label for="maxViewsPerDay">Default max views / day</label>
                                            <input type="number" id="maxViewsPerDay" value="3" min="1" max="10">
                                            <div class="iah-field-hint">Cap how often the same user sees one campaign daily.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="iah-field">
                                            <label for="cooldownPeriodHours">Cooldown period (hours)</label>
                                            <input type="number" id="cooldownPeriodHours" value="24" min="1" max="168">
                                            <div class="iah-field-hint">Minimum gap before showing the same campaign again.</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="iah-switch-row">
                                    <div>
                                        <div class="iah-switch-label">Intelligent frequency control</div>
                                        <div class="iah-switch-desc">Automatically throttle over-exposed campaigns.</div>
                                    </div>
                                    <label class="iah-switch">
                                        <input type="checkbox" id="enableFrequencyControl" checked>
                                        <span class="iah-switch-slider"></span>
                                    </label>
                                </div>
                                <div class="iah-switch-row">
                                    <div>
                                        <div class="iah-switch-label">User behavior tracking</div>
                                        <div class="iah-switch-desc">Learn engagement patterns to improve delivery timing.</div>
                                    </div>
                                    <label class="iah-switch">
                                        <input type="checkbox" id="enableUserBehaviorTracking" checked>
                                        <span class="iah-switch-slider"></span>
                                    </label>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button type="button" class="iah-btn-sm iah-btn-sm--primary" onclick="saveSettings()"><i class="fas fa-save"></i> Save settings</button>
                                    <button type="button" class="iah-btn-sm" onclick="resetSettings()"><i class="fas fa-undo"></i> Reset defaults</button>
                                </div>
                            </div>
                        </div>

                        <div class="iah-panel">
                            <div class="iah-panel-head">
                                <h2 class="iah-panel-title"><i class="fas fa-mobile-alt me-2"></i>AdMob integration</h2>
                            </div>
                            <div class="iah-settings-body">
                                <div class="iah-field">
                                    <label for="defaultAdMobAppId">Default AdMob App ID</label>
                                    <input type="text" id="defaultAdMobAppId" placeholder="ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy">
                                </div>
                                <div class="iah-field">
                                    <label for="defaultAdMobUnitId">Default AdMob Unit ID</label>
                                    <input type="text" id="defaultAdMobUnitId" placeholder="ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy">
                                </div>
                                <div class="iah-info-banner">
                                    <i class="fas fa-info-circle"></i>
                                    <span>AdMob can be enabled per campaign when creating or editing. Use the <a href="/ads/add-ad">campaign composer</a> for unit-level overrides.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="iah-panel">
                        <div class="iah-panel-head">
                            <h2 class="iah-panel-title"><i class="fas fa-stream me-2"></i>Placement distribution</h2>
                        </div>
                        <div class="iah-settings-body">
                            <% if (Object.keys(iahPosStats).length === 0) { %>
                            <div class="iah-empty-note">No placement data yet. Create campaigns to see interval distribution.</div>
                            <% } else { %>
                            <div class="iah-position-bars">
                                <% Object.keys(iahPosStats).sort(function(a,b){ return Number(a)-Number(b); }).forEach(function(interval) { 
                                    const count = iahPosStats[interval];
                                    const pct = iahMaxPosCount > 0 ? Math.round((count / iahMaxPosCount) * 100) : 0;
                                %>
                                <div class="iah-position-row">
                                    <span>Every <%= interval %> items</span>
                                    <div class="iah-position-bar"><span style="width:<%= pct %>%"></span></div>
                                    <strong><%= count %></strong>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="iah-panel">
                        <div class="iah-panel-head">
                            <h2 class="iah-panel-title"><i class="fas fa-list me-2"></i>Managed campaigns</h2>
                            <a href="/ads/ads" class="iah-btn-sm iah-btn-sm--primary"><i class="fas fa-external-link-alt"></i> Open campaign center</a>
                        </div>
                        <% if (iahAds.length === 0) { %>
                        <div class="iah-empty">
                            <div class="iah-empty-icon"><i class="fas fa-chart-pie"></i></div>
                            <h4 style="margin:0 0 8px;color:#111827;">No campaigns to analyze</h4>
                            <p style="color:#6b7280;margin:0 0 16px;">Create campaigns to unlock performance tracking and smart delivery.</p>
                            <a href="/ads/add-ad" class="team-btn-primary"><i class="fas fa-plus"></i> Create campaign</a>
                        </div>
                        <% } else { %>
                        <div class="iah-table-wrap">
                            <table class="iah-table">
                                <thead>
                                    <tr>
                                        <th>Campaign</th>
                                        <th>Status</th>
                                        <th>Placement</th>
                                        <th>Priority</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% iahAds.forEach(function(ad) {
                                        const priority = ad.priority || 'medium';
                                    %>
                                    <tr>
                                        <td>
                                            <div class="iah-creative">
                                                <% if (ad.imageUrl) { %>
                                                <img src="<%= ad.imageUrl %>" alt="" class="iah-thumb">
                                                <% } else { %>
                                                <span class="iah-thumb iah-thumb--empty"><i class="fas fa-image"></i></span>
                                                <% } %>
                                                <div>
                                                    <div class="iah-creative-title"><%= ad.title || 'Untitled' %></div>
                                                    <div class="iah-creative-sub"><%= ad.content ? ad.content.substring(0, 50) : 'No description' %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="iah-pill <%= ad.isActive === false ? 'iah-pill--paused' : 'iah-pill--live' %>">
                                                <%= ad.isActive === false ? 'Paused' : 'Live' %>
                                            </span>
                                        </td>
                                        <td>Every <%= ad.positionInterval || 3 %> items</td>
                                        <td><%= priority.charAt(0).toUpperCase() + priority.slice(1) %></td>
                                        <td><%= new Date(ad.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></td>
                                        <td>
                                            <div class="iah-actions">
                                                <button type="button" class="iah-action-btn" title="Edit" onclick="editAd('<%= ad._id %>')"><i class="fas fa-pen"></i></button>
                                                <button type="button" class="iah-action-btn" title="<%= ad.isActive === false ? 'Activate' : 'Pause' %>" onclick="toggleAdStatus('<%= ad._id %>')">
                                                    <i class="fas fa-<%= ad.isActive === false ? 'play' : 'pause' %>"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="iah-toast" id="autoRefreshIndicator"><i class="fas fa-sync fa-spin"></i> Syncing analytics...</div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%- include('partials/footer') %>
    <script id="adsData" type="application/json"><%- JSON.stringify(iahAds) %></script>
    <script>
        window.adsList = JSON.parse(document.getElementById('adsData').textContent);
        const adsList = window.adsList;
        let performanceChart;

        document.addEventListener('DOMContentLoaded', function () {
            setupMobileMenu();
            initializeCharts();
            loadAnalyticsData();
            setInterval(function () {
                showAutoRefreshIndicator();
                loadAnalyticsData();
            }, 30000);
        });

        function initializeCharts() {
            const ctx = document.getElementById('performanceChart').getContext('2d');
            performanceChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Impressions',
                        data: [],
                        backgroundColor: 'rgba(99, 102, 241, 0.65)',
                        borderColor: 'rgba(99, 102, 241, 1)',
                        borderWidth: 0,
                        borderRadius: 6,
                        maxBarThickness: 36
                    }, {
                        label: 'Clicks',
                        data: [],
                        backgroundColor: 'rgba(16, 185, 129, 0.65)',
                        borderColor: 'rgba(16, 185, 129, 1)',
                        borderWidth: 0,
                        borderRadius: 6,
                        maxBarThickness: 36
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 16, font: { size: 11, weight: '600' } }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(226, 232, 240, 0.8)' },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        window.loadAnalyticsData = function () {
            fetch('/intelligent-ads/analytics')
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    document.getElementById('totalImpressions').textContent = data.totalImpressions.toLocaleString('en-IN');
                    document.getElementById('totalClicks').textContent = data.totalClicks.toLocaleString('en-IN');
                    document.getElementById('iahTotalClicks').textContent = data.totalClicks.toLocaleString('en-IN');
                    document.getElementById('avgCtr').textContent = data.ctr.toFixed(2) + '%';
                    document.getElementById('iahCtrKpi').textContent = data.ctr.toFixed(2) + '%';
                    document.getElementById('avgViewsPerUser').textContent = data.avgViewsPerUser.toFixed(2);

                    const topAdsList = document.getElementById('topAdsList');
                    topAdsList.innerHTML = '';
                    if (!data.topPerformingAds || data.topPerformingAds.length === 0) {
                        topAdsList.innerHTML = '<div class="iah-empty-note">No performance data yet. Impressions will appear as users interact with campaigns.</div>';
                    } else {
                        data.topPerformingAds.forEach(function (ad, index) {
                            const row = document.createElement('div');
                            row.className = 'iah-leader-row';
                            const rankClass = index < 3 ? ' iah-leader-rank--' + (index + 1) : '';
                            row.innerHTML =
                                '<span class="iah-leader-rank' + rankClass + '">' + (index + 1) + '</span>' +
                                '<span class="iah-leader-title" title="' + (ad.title || '') + '">' + (ad.title || 'Untitled') + '</span>' +
                                '<span class="iah-leader-stats">' + ad.impressions.toLocaleString('en-IN') + ' views · ' + ad.clicks + ' clicks · ' + ad.ctr.toFixed(2) + '%</span>';
                            topAdsList.appendChild(row);
                        });
                    }

                    if (performanceChart) {
                        const items = data.topPerformingAds || [];
                        performanceChart.data.labels = items.map(function (ad) {
                            const title = ad.title || 'Campaign';
                            return title.length > 18 ? title.substring(0, 18) + '…' : title;
                        });
                        performanceChart.data.datasets[0].data = items.map(function (ad) { return ad.impressions; });
                        performanceChart.data.datasets[1].data = items.map(function (ad) { return ad.clicks; });
                        performanceChart.update();
                    }

                    hideAutoRefreshIndicator();
                })
                .catch(function (error) {
                    console.error('Error loading analytics data:', error);
                    hideAutoRefreshIndicator();
                });
        };

        window.refreshAnalytics = function () {
            showAutoRefreshIndicator();
            loadAnalyticsData();
        };

        window.resetAnalytics = function () {
            if (!confirm('Reset all campaign analytics data? This cannot be undone.')) return;
            fetch('/intelligent-ads/analytics/reset', { method: 'POST' })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    alert(data.message);
                    loadAnalyticsData();
                })
                .catch(function () { alert('Error resetting analytics data'); });
        };

        window.saveSettings = function () {
            alert('Settings saved successfully!');
        };

        window.resetSettings = function () {
            document.getElementById('maxViewsPerDay').value = 3;
            document.getElementById('cooldownPeriodHours').value = 24;
            document.getElementById('enableFrequencyControl').checked = true;
            document.getElementById('enableUserBehaviorTracking').checked = true;
            alert('Settings reset to defaults!');
        };

        window.editAd = function (adId) {
            window.location.href = '/ads/edit-ad/' + adId;
        };

        window.toggleAdStatus = function (adId) {
            const adItem = adsList.find(function (ad) { return String(ad._id) === String(adId); });
            if (!adItem) return;
            fetch('/ads/ads/' + adId + '/toggle-status', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isActive: !adItem.isActive })
            })
                .then(async function (response) {
                    if (response.ok) location.reload();
                    const errorData = await response.json().catch(function () { return {}; });
                    alert('Error: ' + (errorData.error || 'Failed to toggle status'));
                })
                .catch(function (error) {
                    alert('Network error: ' + error.message);
                });
        };

        function showAutoRefreshIndicator() {
            const indicator = document.getElementById('autoRefreshIndicator');
            if (indicator) indicator.classList.add('is-visible');
        }

        function hideAutoRefreshIndicator() {
            const indicator = document.getElementById('autoRefreshIndicator');
            if (indicator) {
                setTimeout(function () { indicator.classList.remove('is-visible'); }, 900);
            }
        }

        function setupMobileMenu() {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');

            if (menuToggle && sidebar) {
                menuToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    sidebar.classList.toggle('active');
                    mainContent.classList.toggle('sidebar-active');
                });
            }

            document.addEventListener('click', function (event) {
                if (window.innerWidth < 768 && sidebar && sidebar.classList.contains('active') &&
                    !sidebar.contains(event.target) && event.target !== menuToggle &&
                    (!menuToggle || !menuToggle.contains(event.target))) {
                    sidebar.classList.remove('active');
                    if (mainContent) mainContent.classList.remove('sidebar-active');
                }
            });
        }
    </script>
</body>

</html>
