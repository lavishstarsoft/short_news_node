<%- include('partials/header') %>
<body>
<%- include('partials/top-nav', { pageTitle: 'App Settings', backButton: true, backUrl: '/' }) %>
<%- include('partials/sidebar') %>

    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
    /* Custom Premium Styles for App Settings */
    .settings-container {
        width: 100%;
    }
    .page-title {
        font-weight: 800;
        background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }
    .premium-card {
        border: none;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
        transition: all 0.3s ease;
        overflow: hidden;
    }
    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
    }
    .card-header-gradient {
        background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 20px 25px;
    }
    .icon-box {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-right: 15px;
    }
    .icon-android { background: rgba(61, 220, 132, 0.15); color: #3ddc84; }
    .icon-ios { background: rgba(0, 0, 0, 0.08); color: #000000; }
    .icon-global { background: rgba(255, 193, 7, 0.15); color: #ffc107; }
    .icon-game { background: rgba(13, 202, 240, 0.15); color: #0dcaf0; }
    
    .form-control {
        border-radius: 10px;
        border: 1px solid #e0e0e0;
        padding: 12px 15px;
        transition: all 0.2s ease;
        background-color: #fcfcfc;
    }
    .form-control:focus {
        border-color: #4e4376;
        box-shadow: 0 0 0 4px rgba(78, 67, 118, 0.1);
        background-color: #ffffff;
    }
    .form-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }
    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 14px 28px;
        font-weight: 700;
        font-size: 1.05rem;
        box-shadow: 0 8px 20px rgba(118, 75, 162, 0.3);
        transition: all 0.3s ease;
    }
    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(118, 75, 162, 0.4);
    }
    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: #4e4376;
        border-color: #4e4376;
    }
    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2d3748;
        display: flex;
        align-items: center;
    }
    
    /* Legal Pages styles */
    .legal-tab {
        border-radius: 10px 10px 0 0;
        font-weight: 600;
    }
    .ql-container {
        height: 350px !important;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
    }
    .mobile-preview-frame {
        width: 320px;
        height: 600px;
        border: 12px solid #2d3748;
        border-radius: 36px;
        overflow: hidden;
        background: #fff;
        position: relative;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        margin: 0 auto;
    }
    .mobile-preview-header {
        height: 60px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        padding: 0 15px;
        font-weight: 600;
        color: #333;
    }
    .mobile-preview-content {
        height: calc(100% - 60px);
        overflow-y: auto;
        padding: 20px;
        font-size: 14px;
        line-height: 1.6;
        color: #333333;
        font-family: 'Roboto', sans-serif;
    }

    /* Shortcode Preview Styles */
    .sc-section-title {
        border-left: 4px solid #FFC107;
        padding-left: 10px;
        font-weight: bold;
        font-size: 18px;
        color: #333333;
        margin: 20px 0 10px 0;
    }
    .sc-box {
        border: 1px solid #EEEEEE;
        border-radius: 12px;
        padding: 15px;
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        background: #FFFFFF;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .sc-icon {
        color: #FFC107;
        font-size: 24px;
        margin-right: 15px;
    }
    .sc-content {
        display: flex;
        flex-direction: column;
    }
    .sc-content strong {
        color: #9E9E9E;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 4px;
    }
    .sc-content span {
        color: #212121;
        font-size: 14px;
        font-weight: bold;
    }

    /* Premium Tabs Styles */
    .nav-pills .nav-link {
        color: #4a5568;
        border-radius: 12px;
        transition: all 0.3s ease;
        background: transparent;
    }
    .nav-pills .nav-link:hover {
        background: rgba(118, 75, 162, 0.05);
        color: #764ba2;
    }
    .nav-pills .nav-link.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(118, 75, 162, 0.2);
    }
</style>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content pb-5">
    <div class="settings-container pt-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-3 mb-4 border-bottom">
            <h1 class="h2 page-title">App Settings & Configurations</h1>
            <p class="text-muted mb-0">Manage mobile app versions, update behaviors, and interactive features.</p>
        </div>

        <!-- Alert Box -->
        <div id="alertBox" class="alert d-none shadow-sm rounded-3 border-0" role="alert" style="transition: all 0.3s ease;"></div>

        <form id="appSettingsForm">
            <!-- Main Setting Tabs Navigation -->
            <ul class="nav nav-pills mb-4 pb-3 border-bottom" id="settingsPills" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold px-4" id="pills-platform-tab" data-bs-toggle="pill" data-bs-target="#pills-platform" type="button" role="tab" aria-controls="pills-platform" aria-selected="true"><i class="fas fa-mobile-alt me-2"></i>Platform Updates</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold px-4 mx-2" id="pills-features-tab" data-bs-toggle="pill" data-bs-target="#pills-features" type="button" role="tab" aria-controls="pills-features" aria-selected="false"><i class="fas fa-star me-2"></i>App Features</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold px-4" id="pills-legal-tab" data-bs-toggle="pill" data-bs-target="#pills-legal" type="button" role="tab" aria-controls="pills-legal" aria-selected="false"><i class="fas fa-file-contract me-2"></i>Legal & Pages</button>
                </li>
            </ul>

            <div class="tab-content" id="settingsPillsContent">
                
                <!-- Tab 1: Platform Updates -->
                <div class="tab-pane fade show active" id="pills-platform" role="tabpanel" aria-labelledby="pills-platform-tab">
                    <div class="row g-4">
                        <!-- Left Column: Platform Versions -->
                        <div class="col-lg-6">
                            <div class="premium-card h-100">
                                <div class="card-header-gradient">
                                    <h5 class="section-title mb-0">
                                        <div class="icon-box icon-android"><i class="fab fa-android"></i></div>
                                        Android Configuration
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-4">
                                        <div class="col-md-5">
                                            <label class="form-label">Current Version</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-code-branch text-muted"></i></span>
                                                <input type="text" class="form-control border-start-0 ps-0" id="androidVersion" name="androidVersion" value="<%= settings.androidVersion %>" placeholder="e.g. 1.0.5" required>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Play Store URL</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-link text-muted"></i></span>
                                                <input type="url" class="form-control border-start-0 ps-0" id="androidUpdateUrl" name="androidUpdateUrl" value="<%= settings.androidUpdateUrl %>" placeholder="https://play.google.com/...">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-0 opacity-10">

                                <div class="card-header-gradient bg-white border-top">
                                    <h5 class="section-title mb-0">
                                        <div class="icon-box icon-ios"><i class="fab fa-apple"></i></div>
                                        iOS Configuration
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-4">
                                        <div class="col-md-5">
                                            <label class="form-label">Current Version</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-code-branch text-muted"></i></span>
                                                <input type="text" class="form-control border-start-0 ps-0" id="iosVersion" name="iosVersion" value="<%= settings.iosVersion %>" placeholder="e.g. 1.0.5" required>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">App Store URL</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-link text-muted"></i></span>
                                                <input type="url" class="form-control border-start-0 ps-0" id="iosUpdateUrl" name="iosUpdateUrl" value="<%= settings.iosUpdateUrl %>" placeholder="https://apps.apple.com/...">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: App Behaviors -->
                        <div class="col-lg-6">
                            <div class="premium-card h-100">
                                <div class="card-header-gradient">
                                    <h5 class="section-title mb-0">
                                        <div class="icon-box icon-global"><i class="fas fa-sync-alt"></i></div>
                                        Update Behavior
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="mb-4">
                                        <label class="form-label">Update Announcement Message</label>
                                        <textarea class="form-control" id="updateMessage" name="updateMessage" rows="5" required><%= settings.updateMessage %></textarea>
                                        <small class="text-muted mt-2 d-block"><i class="fas fa-info-circle me-1"></i> Shown to users when a new version is detected.</small>
                                    </div>

                                    <div class="p-3 bg-light rounded-3 border mt-4">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="forceUpdate" name="forceUpdate" <%= settings.forceUpdate ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold mb-0" for="forceUpdate">Force Immediate Update</label>
                                                <div class="text-danger small mt-1"><i class="fas fa-shield-alt me-1"></i> Blocks app usage until updated. Use for critical fixes.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: App Features -->
                <div class="tab-pane fade" id="pills-features" role="tabpanel" aria-labelledby="pills-features-tab">
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="premium-card">
                                <div class="card-header-gradient">
                                    <h5 class="section-title mb-0">
                                        <div class="icon-box icon-game"><i class="fas fa-trophy"></i></div>
                                        Gamification & Features Engine
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row align-items-center mb-4">
                                        <div class="col-md-7">
                                            <label class="form-label">Swipe Streak Target</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" id="swipeStreakMilestone" name="swipeStreakMilestone" value="<%= settings.swipeStreakMilestone || 30 %>" required>
                                                <span class="input-group-text bg-light text-muted">Swipes</span>
                                            </div>
                                            <small class="text-muted mt-2 d-block">Triggers the celebration animation.</small>
                                        </div>
                                    </div>

                                    <div class="p-3 rounded-3" style="background-color: rgba(13, 202, 240, 0.05); border: 1px solid rgba(13, 202, 240, 0.2);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="isSwipeStreakEnabled" name="isSwipeStreakEnabled" <%= settings.isSwipeStreakEnabled !== false ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="isSwipeStreakEnabled">Enable Streak Animations</label>
                                                <div class="text-muted small mt-1">Displays beautiful fireworks when users hit the target.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(78, 67, 118, 0.05); border: 1px solid rgba(78, 67, 118, 0.2);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="showLongVideos" name="showLongVideos" <%= settings.showLongVideos !== false ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="showLongVideos">Show Long Videos Page</label>
                                                <div class="text-muted small mt-1">If disabled, the long videos feature will be hidden from the app entirely.</div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(255, 152, 0, 0.05); border: 1px solid rgba(255, 152, 0, 0.2);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="showDistrictSelection" name="showDistrictSelection" <%= settings.showDistrictSelection === true ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="showDistrictSelection">Enable District Level News</label>
                                                <div class="text-muted small mt-1">If disabled, users can only select and view news up to the State level in the mobile app.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(33, 150, 243, 0.06); border: 1px solid rgba(33, 150, 243, 0.25);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="enableLocationModule" name="enableLocationModule" <%= settings.enableLocationModule !== false ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="enableLocationModule">Enable Location Module</label>
                                                <div class="text-muted small mt-1">
                                                    <strong>ON:</strong> Location onboarding + drawer location menu work as today.<br>
                                                    <strong>OFF:</strong> Skip location screen after language; hide location UI from the app.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(156, 39, 176, 0.05); border: 1px solid rgba(156, 39, 176, 0.2);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="isReferralEnabled" name="isReferralEnabled" <%= (settings.isReferralEnabled === true || settings.isReferralEnabled === undefined) ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="isReferralEnabled">Enable Refer & Earn Program</label>
                                                <div class="text-muted small mt-1">If disabled, the Refer & Earn option will be hidden or shown as "Coming Soon" in the mobile app.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <% if (admin && admin.role === 'superadmin') { %>
                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(220, 53, 69, 0.06); border: 1px solid rgba(220, 53, 69, 0.25);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="allowReporterBrowserAccess" name="allowReporterBrowserAccess" <%= settings.allowReporterBrowserAccess === true ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="allowReporterBrowserAccess">Allow Reporter Portal in Browser</label>
                                                <div class="text-muted small mt-1">
                                                    <strong>ON:</strong> reporters site opens in Chrome/Safari too (dev).<br>
                                                    <strong>OFF:</strong> Flutter WebView app only (production default).
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-3 rounded-3 mt-3" style="background-color: rgba(0, 123, 255, 0.06); border: 1px solid rgba(0, 123, 255, 0.25);">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-3" type="checkbox" id="enableAIAssistant" name="enableAIAssistant" <%= settings.enableAIAssistant !== false ? 'checked' : '' %>>
                                            <div>
                                                <label class="form-check-label fw-bold text-dark mb-0" for="enableAIAssistant">Enable AI Assistant Widget</label>
                                                <div class="text-muted small mt-1">
                                                    <strong>ON:</strong> Displays the AI Assistant icon in the admin panel.<br>
                                                    <strong>OFF:</strong> Hides the AI Assistant icon for everyone.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                                    
                                    <div class="row g-4 mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark"><i class="fas fa-rupee-sign me-2 text-success"></i>Referral Reward Amount (₹)</label>
                                            <input type="number" class="form-control" id="referralRewardAmount" name="referralRewardAmount" value="<%= settings.referralRewardAmount || 5 %>" required>
                                            <small class="text-muted mt-2 d-block">Amount awarded to the referrer per successful referral.</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark"><i class="fas fa-calendar-check me-2 text-info"></i>Required Usage Days</label>
                                            <input type="number" class="form-control" id="referralRequiredDays" name="referralRequiredDays" value="<%= settings.referralRequiredDays || 7 %>" required>
                                            <small class="text-muted mt-2 d-block">How many days the referred user must use the app.</small>
                                        </div>
                                    </div>
                                    
                                    <div class="row g-4 mt-2">
                                        <div class="col-md-12">
                                            <label class="form-label fw-bold text-dark"><i class="fas fa-shield-alt me-2 text-danger"></i>Max Daily Referral Budget (₹)</label>
                                            <input type="number" class="form-control" id="maxDailyReferralBudget" name="maxDailyReferralBudget" value="<%= settings.maxDailyReferralBudget || 5000 %>" required>
                                            <small class="text-muted mt-2 d-block">Safety Limit: If total payouts today exceed this amount, new payouts will require manual approval.</small>
                                        </div>
                                    </div>
                                    
                                    <div class="row g-4 mt-2">
                                        <div class="col-md-12">
                                            <label class="form-label fw-bold text-dark"><i class="fas fa-link me-2 text-primary"></i>Referral Share Base URL</label>
                                            <input type="url" class="form-control" id="referralShareUrl" name="referralShareUrl" value="<%= settings.referralShareUrl || 'https://play.google.com/store/apps/details?id=com.lavish.yellowsingam' %>" required>
                                            <small class="text-muted mt-2 d-block">Base URL used when users share their referral link (e.g. https://your-app.com/invite).</small>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <label class="form-label fw-bold text-dark"><i class="fas fa-gift me-2 text-primary"></i>Referral Help Text (How it works)</label>
                                        <textarea class="form-control" id="referralHelpText" name="referralHelpText" rows="4" placeholder="Enter instructions for refer and earn..."><%= settings.referralHelpText || '' %></textarea>
                                        <small class="text-muted mt-2 d-block">This text will be shown in the app when users click "How it works" on the Refer & Earn screen.</small>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-language me-2 text-primary"></i>Language-wise Features</h6>
                                        <div class="table-responsive">
                                            <table class="table table-bordered align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Language</th>
                                                        <th class="text-center">Calendar Feature</th>
                                                        <th class="text-center">Zodiac/Horoscope Feature</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (locals.languages && languages.length > 0) { %>
                                                        <% languages.forEach(function(lang) { %>
                                                            <tr>
                                                                <td class="fw-bold"><%= lang.nativeName %> (<%= lang.name %>)</td>
                                                                <td class="text-center">
                                                                    <div class="form-check form-switch d-flex justify-content-center mb-0">
                                                                        <input class="form-check-input cal-lang-toggle" type="checkbox" data-lang="<%= lang.code %>" <%= (settings.calendarEnabledLanguages && settings.calendarEnabledLanguages.includes(lang.code)) ? 'checked' : '' %>>
                                                                    </div>
                                                                </td>
                                                                <td class="text-center">
                                                                    <div class="form-check form-switch d-flex justify-content-center mb-0">
                                                                        <input class="form-check-input zod-lang-toggle" type="checkbox" data-lang="<%= lang.code %>" <%= (settings.zodiacEnabledLanguages && settings.zodiacEnabledLanguages.includes(lang.code)) ? 'checked' : '' %>>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="3" class="text-center text-muted">No active languages found.</td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    
                                    <hr class="my-4 opacity-10">
                                    
                                    <div class="mb-2">
                                        <label class="form-label fw-bold text-dark"><i class="fas fa-comment-dots me-2 text-primary"></i>Feedback Link URL</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-link text-muted"></i></span>
                                            <input type="url" class="form-control border-start-0 ps-0" id="feedbackUrl" name="feedbackUrl" value="<%= settings.feedbackUrl || 'https://wa.me/' %>" placeholder="https://wa.me/919999999999">
                                        </div>
                                        <small class="text-muted mt-2 d-block">This link will open when users tap the "Feedback" button in the app's settings.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab 3: Legal Pages Tab Section -->
