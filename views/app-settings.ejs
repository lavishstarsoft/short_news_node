<script>
    document.getElementById('appSettingsForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const saveBtn = document.querySelector('.btn-save');
        const alertBox = document.getElementById('alertBox');
        
        // UI states
        const originalBtnHtml = saveBtn.innerHTML;
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Publishing...';
        
        // Collect data
        const payload = {
            androidVersion: document.getElementById('androidVersion').value,
            iosVersion: document.getElementById('iosVersion').value,
            androidUpdateUrl: document.getElementById('androidUpdateUrl').value,
            iosUpdateUrl: document.getElementById('iosUpdateUrl').value,
            updateMessage: document.getElementById('updateMessage').value,
            forceUpdate: document.getElementById('forceUpdate').checked,
            swipeStreakMilestone: document.getElementById('swipeStreakMilestone').value,
            isSwipeStreakEnabled: document.getElementById('isSwipeStreakEnabled').checked,
            showLongVideos: document.getElementById('showLongVideos').checked,
            showDistrictSelection: document.getElementById('showDistrictSelection').checked,
            enableLocationModule: document.getElementById('enableLocationModule').checked,
            // Collect language arrays
            calendarEnabledLanguages: Array.from(document.querySelectorAll('.cal-lang-toggle')).filter(cb => cb.checked).map(cb => cb.dataset.lang),
            zodiacEnabledLanguages: Array.from(document.querySelectorAll('.zod-lang-toggle')).filter(cb => cb.checked).map(cb => cb.dataset.lang),
            contactUs: document.getElementById('contactUs').value,
            privacyPolicy: document.getElementById('privacyPolicy').value,
            aboutUs: document.getElementById('aboutUs').value,
            termsAndConditions: document.getElementById('termsAndConditions').value,
            feedbackUrl: document.getElementById('feedbackUrl').value,
            referralRewardAmount: document.getElementById('referralRewardAmount').value,
            referralRequiredDays: document.getElementById('referralRequiredDays').value,
            maxDailyReferralBudget: document.getElementById('maxDailyReferralBudget').value,
            referralShareUrl: document.getElementById('referralShareUrl').value,
            referralHelpText: document.getElementById('referralHelpText').value,
            isReferralEnabled: document.getElementById('isReferralEnabled').checked
        };

        const browserAccessToggle = document.getElementById('allowReporterBrowserAccess');
        if (browserAccessToggle) {
            payload.allowReporterBrowserAccess = browserAccessToggle.checked;
        }

        const aiAssistantToggle = document.getElementById('enableAIAssistant');
        if (aiAssistantToggle) {
            payload.enableAIAssistant = aiAssistantToggle.checked;
        }

        try {
            const response = await fetch('/api/admin/app-settings', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                alertBox.className = 'alert alert-success shadow-sm rounded-3 border-0 mt-3 mb-4';
                alertBox.innerHTML = '<i class="fas fa-check-circle me-2 fs-5 align-middle"></i> <strong>Success!</strong> Your app settings have been published live.';
            } else {
                const data = await response.json();
                alertBox.className = 'alert alert-danger shadow-sm rounded-3 border-0 mt-3 mb-4';
                alertBox.innerHTML = `<i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i> <strong>Error!</strong> ${data.error || 'Failed to update settings'}`;
            }
        } catch (error) {
            console.error('Error:', error);
            alertBox.className = 'alert alert-danger shadow-sm rounded-3 border-0 mt-3 mb-4';
            alertBox.innerHTML = '<i class="fas fa-wifi me-2 fs-5 align-middle"></i> <strong>Network Error!</strong> Could not connect to the server.';
        } finally {
            // Restore button state
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalBtnHtml;
            
            // Show alert box
            alertBox.classList.remove('d-none');
            
            // Hide alert after 4 seconds smoothly
            setTimeout(() => {
                alertBox.style.opacity = '0';
                setTimeout(() => {
                    alertBox.classList.add('d-none');
                    alertBox.style.opacity = '1';
                }, 300);
            }, 4000);
        }
    });
</script>

<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
    // Initialize Quill Editor
    var quill = new Quill('#legalEditor', {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['link', 'clean']
            ]
        }
    });

    // Track active field
    let activeField = 'contactUs';

    // Populate editor on load
    const loadEditorContent = () => {
        const html = document.getElementById(activeField).value;
        quill.root.innerHTML = html;
        updatePreview();
    };

    const updatePreview = () => {
        let html = quill.root.innerHTML;
        
        // Parse shortcodes to render them nicely in the mobile preview
        html = html.replace(/\[section-title\](.*?)\[\/section-title\]/g, '<div class="sc-section-title">$1</div>');
        html = html.replace(/\[email-box\](.*?)\[\/email-box\]/g, '<div class="sc-box"><div class="sc-icon"><i class="far fa-envelope"></i></div><div class="sc-content"><strong>Email</strong><span>$1</span></div></div>');
        html = html.replace(/\[whatsapp-box\](.*?)\[\/whatsapp-box\]/g, '<div class="sc-box"><div class="sc-icon"><i class="far fa-comment-dots"></i></div><div class="sc-content"><strong>WhatsApp</strong><span>$1</span></div></div>');
        html = html.replace(/\[address-box\](.*?)\[\/address-box\]/g, '<div class="sc-box"><div class="sc-icon"><i class="fas fa-map-marker-alt"></i></div><div class="sc-content"><strong>Address</strong><span>$1</span></div></div>');

        document.getElementById('previewContent').innerHTML = html;
    };

    // Insert shortcode function
    window.insertShortcode = (tag, defaultText) => {
        const range = quill.getSelection(true);
        quill.insertText(range.index, `\n[${tag}]${defaultText}[/${tag}]\n`);
    };

    // Listen for text changes
    quill.on('text-change', function() {
        const html = quill.root.innerHTML;
        document.getElementById(activeField).value = html;
        updatePreview();
    });

    // Handle tab changes
    const tabEls = document.querySelectorAll('.legal-tab');
    tabEls.forEach(tab => {
        tab.addEventListener('shown.bs.tab', function (event) {
            activeField = event.target.getAttribute('data-field');
            document.getElementById('previewTitle').innerText = event.target.innerText;
            loadEditorContent();
        });
    });

    // Initial load
    loadEditorContent();
</script>

