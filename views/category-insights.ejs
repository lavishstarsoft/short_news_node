<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Category Insights — Tehelka News</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.17.0/dist/tabler-icons.min.css">
<style>
  :root{
    --bg:#0a0e14;--panel:#111823;--card:#141c28;--card2:#0f1620;
    --line:#1e2a38;--line2:#273548;--tx:#e6edf3;--tx2:#8b98a9;--tx3:#5d6b7d;
    --green:#22c55e;--greenbg:rgba(34,197,94,.12);--pur1:#7c6cf6;--pur2:#a78bfa;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--tx);font-family:'Inter',-apple-system,'Segoe UI',system-ui,sans-serif;
    background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);
    background-size:34px 34px;-webkit-font-smoothing:antialiased;display:flex;min-height:100vh}
  a{text-decoration:none}
  .side{width:232px;background:var(--panel);border-right:1px solid var(--line);padding:20px 14px;flex-shrink:0}
  .brand{display:flex;align-items:center;gap:10px;padding:4px 8px 22px}
  .brand .logo{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--pur1),var(--pur2));display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px}
  .brand b{font-size:16px;font-weight:600}
  .nav-l{color:var(--tx3);font-size:11px;text-transform:uppercase;letter-spacing:.8px;padding:14px 10px 6px}
  .nav a{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:9px;color:var(--tx2);font-size:14px;margin-bottom:2px;transition:.15s}
  .nav a i{font-size:18px;width:20px}
  .nav a:hover{background:var(--card);color:var(--tx)}
  .nav a.on{background:var(--greenbg);color:var(--green)}
  .main{flex:1;padding:20px 26px;overflow:auto}
  .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
  .top h1{font-size:20px;font-weight:600}
  .top .sub{color:var(--tx2);font-size:13px;margin-top:3px}
  .top a.back{color:var(--tx2);font-size:13px;display:inline-flex;align-items:center;gap:6px}
  .panel-c{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 18px;margin-bottom:16px}
  .help{border-left:3px solid var(--green)}
  .help b{display:block;margin-bottom:6px;font-weight:600}
  .help p{color:var(--tx2);font-size:13px;line-height:1.6}
  .filt{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap}
  .pill-g a{font-size:13px;padding:8px 14px;border-radius:9px;border:1px solid var(--line2);color:var(--tx2)}
  .pill-g a.act{background:var(--greenbg);border-color:transparent;color:var(--green)}
  .fld label{display:block;font-size:11px;color:var(--tx3);margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
  .fld input{background:var(--card2);border:1px solid var(--line2);border-radius:9px;color:var(--tx);padding:8px 11px;font-size:13px;color-scheme:dark}
  .ap{background:linear-gradient(135deg,var(--pur1),var(--pur2));color:#fff;border:none;border-radius:9px;padding:9px 16px;font-size:13px;font-weight:500;cursor:pointer}
  .ph{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .ph .lg{display:flex;align-items:center;gap:10px}
  .ph .lg b{font-size:16px;font-weight:600}
  .ph .lg .code{color:var(--tx3);font-size:12px}
  .ph .tot{color:var(--tx2);font-size:12.5px}
  table{width:100%;border-collapse:collapse;font-size:13.5px}
  th{text-align:left;color:var(--tx3);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.6px;padding:0 10px 11px}
  td{padding:11px 10px;border-top:1px solid var(--line);vertical-align:middle}
  td.num{text-align:right;font-variant-numeric:tabular-nums}
  .rk{width:26px;height:26px;border-radius:50%;background:var(--card2);color:var(--tx2);display:inline-flex;align-items:center;justify-content:center;font-weight:600;font-size:12px}
  .rk1{background:var(--greenbg);color:var(--green)}
  .bar{height:7px;background:var(--card2);border-radius:5px;overflow:hidden;min-width:80px}
  .bar>i{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,var(--green),#4ade80)}
  .empty{text-align:center;color:var(--tx2);padding:40px}
</style>
</head>
<body>
  <aside class="side">
    <div class="brand"><div class="logo"><i class="ti ti-news"></i></div><b>Tehelka News</b></div>
    <div class="nav-l">Main</div>
    <nav class="nav">
      <a href="/news"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
      <a href="/add-news"><i class="ti ti-plus"></i> Add News</a>
      <a href="/news-list"><i class="ti ti-news"></i> News List</a>
      <a href="/admin/pending-news"><i class="ti ti-clock"></i> Pending</a>
      <a class="on" href="/admin/category-insights"><i class="ti ti-chart-pie"></i> Category Insights</a>
    </nav>
    <div class="nav-l">System</div>
    <nav class="nav">
      <a href="/admin/db-backups"><i class="ti ti-database"></i> DB Backups</a>
      <a href="/"><i class="ti ti-arrow-left"></i> Back to classic</a>
    </nav>
  </aside>

  <main class="main">
    <div class="top">
      <div>
        <h1>Category Insights</h1>
        <div class="sub">ఏ భాషలో ఏ category news ఎక్కువ చూస్తున్నారో — asli (organic) views ఆధారంగా</div>
      </div>
      <a class="back" href="/"><i class="ti ti-arrow-left"></i> Classic dashboard</a>
    </div>

    <div class="panel-c help">
      <b>📊 ఎలా చదవాలి</b>
      <p>ప్రతి category కి: మొత్తం real views, news సంఖ్య, సగటు views/news, శాతం. Default చివరి 30 రోజులు (publish తేదీ). "All Time" అన్నిటికీ. synthetic engine లెక్కలు కలపలేదు.</p>
    </div>

    <div class="panel-c">
      <form method="GET" action="/admin/category-insights" class="filt">
        <div class="pill-g" style="display:flex;gap:8px">
          <a class="<%= !allTime ? 'act' : '' %>" href="/admin/category-insights">Last 30 days</a>
          <a class="<%= allTime ? 'act' : '' %>" href="/admin/category-insights?range=all">All Time</a>
        </div>
        <div class="fld"><label>From</label><input type="date" name="from" value="<%= fromStr %>"></div>
        <div class="fld"><label>To</label><input type="date" name="to" value="<%= toStr %>"></div>
        <button class="ap" type="submit">Apply</button>
        <div style="margin-left:auto;color:var(--tx2);font-size:12.5px">
          <%= allTime ? 'Showing: All time' : ('Showing: ' + fromStr + ' → ' + toStr) %>
        </div>
      </form>
    </div>

    <% const langs = Object.keys(byLang).sort((a,b) => (langTotals[b]||0) - (langTotals[a]||0)); %>
    <% if (langs.length === 0) { %>
      <div class="panel-c empty">ఈ కాలంలో data లేదు. తేదీ range మార్చి చూడండి.</div>
    <% } %>

    <% langs.forEach(function(lang){ var cats = byLang[lang]; var maxV = cats.length ? cats[0].views : 1; %>
      <div class="panel-c">
        <div class="ph">
          <div class="lg"><b><%= langName[lang] || lang %></b><span class="code">(<%= lang %>)</span></div>
          <div class="tot"><%= (langTotals[lang]||0).toLocaleString('en-IN') %> total views · <%= cats.length %> categories</div>
        </div>
        <div style="overflow-x:auto">
          <table>
            <thead><tr><th style="width:42px">#</th><th>Category</th><th style="width:32%">Share</th><th class="num">Views</th><th class="num">News</th><th class="num">Avg</th></tr></thead>
            <tbody>
              <% cats.forEach(function(c,i){ %>
                <tr>
                  <td><span class="rk <%= i===0 ? 'rk1' : '' %>"><%= i+1 %></span></td>
                  <td style="font-weight:500"><%= c.category %></td>
                  <td>
                    <div style="display:flex;align-items:center;gap:10px">
                      <div class="bar" style="flex:1"><i style="width:<%= maxV ? Math.round((c.views/maxV)*100) : 0 %>%"></i></div>
                      <span style="color:var(--tx2);font-size:12px;min-width:42px"><%= c.percent %>%</span>
                    </div>
                  </td>
                  <td class="num"><%= c.views.toLocaleString('en-IN') %></td>
                  <td class="num"><%= c.count.toLocaleString('en-IN') %></td>
                  <td class="num"><%= c.avg.toLocaleString('en-IN') %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% }); %>
  </main>
</body>
</html>
