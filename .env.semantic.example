# Semantic flags (documented — not all auto-loaded)

# Phase-3B.6 — advisory compute (default OFF). Does NOT change duplicateCheck.
AI_SEMANTIC_ENABLED=false

# Phase-3B.5 — metrics-only shadow (default OFF).
AI_SEMANTIC_SHADOW_ENABLED=false

# Phase-4.1 — background PENDING embed worker (default OFF).
AI_EMBED_WORKER_ENABLED=false
# AI_EMBED_WORKER_MAX_ATTEMPTS=5
# AI_EMBED_WORKER_BASE_DELAY_MS=2000
# AI_EMBED_WORKER_MAX_DELAY_MS=300000
# AI_EMBED_WORKER_BATCH_SIZE=10
# AI_EMBED_WORKER_POLL_MS=5000
# AI_EMBED_WORKER_EMBED_TIMEOUT_MS=15000
# AI_EMBED_WORKER_LEASE_MS=60000

# AI Insights — Duplicate News Insights (Super Admin; default OFF)
AI_INSIGHTS_ENABLED=false
AI_INSIGHTS_SCAN_ENABLED=false
# AI_INSIGHTS_MIN_SIMILARITY=0.88
# AI_INSIGHTS_COMPARE_WINDOW_HOURS=72
# AI_INSIGHTS_MAX_PER_LANGUAGE=20000
# AI_INSIGHTS_PREFER_ATLAS=true
# AI_INSIGHTS_ATLAS_TOP_K=15
# AI_INSIGHTS_ATLAS_WINDOW_HOURS=168
# AI_INSIGHTS_SCAN_POLL_MS=900000
# AI_INSIGHTS_FULL_SCAN_COOLDOWN_MS=3600000

# Advisory cosine thresholds (optional)
# AI_SEMANTIC_SCORE_POSSIBLE=0.88
# AI_SEMANTIC_SCORE_STRONG=0.92
# AI_SEMANTIC_TOP_K=5
# AI_SEMANTIC_MIN_SCORE_MARGIN=0.03
