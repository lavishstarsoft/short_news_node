# Node.js side — AI duplicate infrastructure (Phase-3A)
# Production default: omit these or keep AI_DUPLICATE_ENABLED=false

AI_DUPLICATE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Hard-capped at 1000ms in config loader
AI_DETECT_TIMEOUT_MS=1000
AI_READY_TIMEOUT_MS=1000
AI_DUPLICATE_LOG=false
